# Local development: these values are read from the shell environment.
NODE_ENV=development
APP_STAGE=local
DEV_AUTH=1
OPERATIONS_USERS=ops
PORT=3000
DATA_PATH=.data/pgdata

# Required for production. Keep actual secrets out of this file.
# APP_STAGE=candidate or production (both require NODE_ENV=production)
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@host:5432/project_irl
# CHECKIN_SECRET=<at-least-32-random-bytes>
# WECHAT_APP_ID=<real-mini-program-appid>
# WECHAT_APP_SECRET=<real-mini-program-secret>
# PILOT_USER_IDS=<comma-separated-internal-user-ids-manually-verified-as-adults>
