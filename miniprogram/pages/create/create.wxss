/* CAPER source screens: pg03_ai / caper_ai / pg04. Native controls keep the existing data flow. */
page { background: #f5f6f8; color: #172033; }
.create-page { min-height: 100vh; padding-bottom: 110rpx; }
.create-page button::after { border: 0; }
.page-header { height: 96rpx; padding-left: 27rpx; padding-right: 186rpx; display: flex; justify-content: flex-start; align-items: center; gap: 8rpx; background: #fff; box-sizing: content-box; }
.header-back { flex: none; width: 57rpx; height: 70rpx; padding: 0; background: transparent; color: #172033; font-size: 52rpx; line-height: 64rpx; text-align: left; }
.header-brand { display: none; }.header-title { position: static; flex: 1; min-width: 0; text-align: center; font-size: 27rpx; font-weight: 800; white-space: nowrap; }
.header-side { position: static; flex: none; padding: 9rpx 14rpx; border-radius: 99rpx; background: #f1f3f8; color: #1d64f2; font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.notice { margin: 14rpx 28rpx; padding: 17rpx 20rpx; border-radius: 18rpx; background: #ebf2fe; color: #2857a5; font-size: 21rpx; }
.notice.warning { background: #fff5df; color: #80541b; }.inline-action { font-size: 21rpx; }
.idea-page { background: #f5f6f8; }
.hero { min-height: 240rpx; padding: 38rpx 28rpx 10rpx; gap: 7rpx; }
.hero-title { font-size: 42rpx; line-height: 1.18; letter-spacing: -1rpx; }.hero-subtitle { margin-top: 21rpx; font-size: 26rpx; color: #333f51; }.hero-caption { margin-top: 8rpx; font-size: 22rpx; color: #1d64f2; }.hero-truth { max-width: 355rpx; margin-top: 12rpx; color: #788598; font-size: 18rpx; line-height: 1.4; }
.orb-wrap { width: 167rpx; flex: none; }.orb { width: 132rpx; height: 132rpx; border-radius: 50%; background: radial-gradient(circle at 45% 27%,#6668c7,#201c57 71%); box-shadow: 0 13rpx 29rpx rgba(40,28,112,.27),0 0 24rpx rgba(88,86,214,.25); }.eyes { color: #71e9fb; font-size: 22rpx; }.cheeks { color: #ed3b72; font-size: 24rpx; }.orb-tag { top: -28rpx; left: 2rpx; background: #fff; color: #5856d6; transform: rotate(8deg); font-size: 18rpx; }
.prompt-card { margin: 18rpx 28rpx 0; padding: 26rpx; border-radius: 34rpx; background: #fff; box-shadow: 0 14rpx 35rpx rgba(25,36,66,.055); }.idea-input { height: 208rpx; font-size: 26rpx; line-height: 1.55; }.count { color: #747e8c; font-size: 21rpx; }.count::first-letter { color: #34c759; }.send-button { width: 68rpx; height: 68rpx; line-height: 68rpx; font-size: 33rpx; background: #1d64f2; }
.section-head { margin: 36rpx 28rpx 18rpx; color: #202b3a; font-size: 28rpx; font-weight: 800; }.popular { padding: 3rpx 8rpx; border-radius: 8rpx; background: #fff0f3; color: #ff2d55; font-size: 19rpx; }
.inspiration { width: calc(100% - 56rpx); min-height: 93rpx; margin: 0 28rpx 12rpx; padding: 17rpx 20rpx; border-radius: 23rpx; box-sizing: border-box; background: #fff; box-shadow: 0 5rpx 19rpx rgba(25,36,66,.045); }.inspiration-icon { width: 65rpx; height: 65rpx; flex: none; margin-right: 17rpx; border-radius: 18rpx; background: #edf2ff; font-size: 32rpx; }.inspiration-title { font-size: 24rpx; font-weight: 780; }.inspiration-subtitle { font-size: 19rpx; color: #747f91; margin-top: 4rpx; }.chevron { color: #c4cbd6; font-size: 37rpx; }
.idea-quote { color: #959daa; font-size: 20rpx; margin: 29rpx 0 16rpx; }.sticky-actions { bottom: 0; z-index: 4; padding: 16rpx 28rpx 23rpx; background: rgba(255,255,255,.96); box-shadow: 0 -5rpx 22rpx rgba(16,26,45,.055); }.sticky-actions .primary-button { width: 100%; }.primary-button { min-height: 80rpx; padding: 18rpx 25rpx; border-radius: 99rpx; background: linear-gradient(110deg,#0053d9,#1d64f2 61%,#5856d6); color: #fff; font-size: 26rpx; font-weight: 800; box-shadow: 0 9rpx 22rpx rgba(29,100,242,.19); }.text-button { margin-top: 8rpx; color: #1d64f2; font-size: 21rpx; }
.form-page,.review-page { padding: 19rpx 28rpx 80rpx; background: #f5f6f8; }
.form-hero { position: relative; overflow: hidden; margin-bottom: 19rpx; padding: 24rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(110deg,#0f1a38,#1d64f2 75%,#5e57d0); }.form-hero::after { content: '✦'; position: absolute; right: 25rpx; top: 2rpx; color: #d2f803; font-size: 95rpx; opacity: .8; }.form-kicker { color: #d2f803; font-size: 16rpx; font-weight: 800; letter-spacing: 1rpx; }.form-title { position: relative; z-index: 1; font-size: 29rpx; font-weight: 850; margin-top: 7rpx; }.form-subtitle { position: relative; z-index: 1; margin-top: 5rpx; font-size: 19rpx; opacity: .88; }
.ai-banner { gap: 17rpx; margin-bottom: 18rpx; padding: 18rpx; border: 1rpx solid #deddfb; border-radius: 22rpx; background: linear-gradient(105deg,#f1efff,#e9ebfe); }.mini-orb { width: 57rpx; height: 57rpx; border-radius: 50%; background: radial-gradient(circle at 40% 30%,#b9a5ff,#7162ef); font-size: 30rpx; box-shadow: 0 7rpx 17rpx rgba(105,77,218,.2); }.banner-title { font-size: 24rpx; font-weight: 800; }.banner-subtitle { margin-top: 4rpx; color: #6c7180; font-size: 19rpx; line-height: 1.35; }
.field-card,.suggestion-card { margin-bottom: 16rpx; padding: 21rpx 23rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(25,36,66,.045); }.section-title { margin-bottom: 11rpx; color: #202b3a; font-size: 26rpx; font-weight: 800; }.section-hint { font-size: 18rpx; color: #8994a2; }.field-row { min-height: 87rpx; border-top: 1rpx solid #edf0f4; }.field-label { color: #364457; font-size: 22rpx; font-weight: 650; }.field-value { color: #182536; font-size: 23rpx; }.field-column { padding: 17rpx 0 8rpx; }.field-grid { gap: 13rpx; padding: 15rpx 0; }.field-input { height: 69rpx; margin-top: 10rpx; border-radius: 15rpx; background: #f8f9fb; border: 1rpx solid #e6eaf1; color: #223044; font-size: 22rpx; }.picker-value { color: #1d64f2; font-size: 21rpx; }.helper { color: #8792a2; font-size: 19rpx; }.switch-row { padding: 16rpx 0; }.radio-option { font-size: 19rpx; }.suggestion-line,.unknown { font-size: 20rpx; }
.form-actions { position: sticky; bottom: 0; z-index: 4; display: flex; gap: 12rpx; padding: 15rpx 0 17rpx; margin: 24rpx -2rpx 0; background: rgba(245,246,248,.96); }.form-actions .primary-button,.form-actions .secondary-button { min-height: 76rpx; }.secondary-button { min-height: 76rpx; padding: 18rpx 19rpx; border-radius: 99rpx; color: #273448; background: #edf0f5; font-size: 23rpx; font-weight: 750; }
.review-page { background: #fff; min-height: 100vh; }.review-page .ai-banner { margin: 4rpx 0 22rpx; }.review-card { border-radius: 0; padding: 0; box-shadow: none; margin: 0; background: transparent; }.review-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; font-size: 27rpx; font-weight: 850; }.preview-version { padding: 5rpx 11rpx; border-radius: 99rpx; background: #ebf2fe; color: #1d64f2; font-size: 17rpx; font-weight: 700; }.review-row { min-height: 83rpx; padding: 16rpx 0; align-items: center; font-size: 21rpx; border-top: 1rpx solid #edf0f4; box-sizing: border-box; }.review-row text:first-child { width: 190rpx; flex: none; color: #3d4a5c; }.review-row text:last-child { flex: 1; color: #142234; font-weight: 650; text-align: right; word-break: break-all; }.review-actions { position: sticky; bottom: 0; z-index: 4; display: flex; gap: 13rpx; margin-top: 23rpx; padding: 17rpx 0; background: rgba(255,255,255,.96); }.review-actions button { flex: 1; }.review-actions .primary-button { flex: 1.5; }.review-back { width: 100%; margin-top: 12rpx; background: transparent; color: #1d64f2; font-size: 21rpx; box-shadow: none; }

.page-header { justify-content: space-between; padding-left: 28rpx; padding-right: 28rpx; }
.header-title { position: absolute; left: 50%; transform: translateX(-50%); width: 290rpx; pointer-events: none; }
.header-back { z-index: 1; }.header-side { z-index: 1; }
.quick-label { color: #58677b; font-size: 19rpx; font-weight: 650; margin: 12rpx 0 9rpx; }
.quick-grid { display: flex; gap: 8rpx; margin-bottom: 14rpx; }
.quick-grid>button,.quick-grid>picker { flex: 1; min-width: 0; }
.quick-chip { width: 100%; height: 61rpx; box-sizing: border-box; margin: 0; padding: 7rpx 4rpx; border: 1rpx solid #e5eaf2; border-radius: 16rpx; background: #f8faff; color: #48566b; font-size: 19rpx; line-height: 45rpx; text-align: center; white-space: nowrap; }
.quick-chip.active { border-color: #1d64f2; background: #eaf2ff; color: #1d64f2; font-weight: 800; }
.quick-picker { display: block; }.quick-grid-time { margin-bottom: 21rpx; }

/* Keep the form and confirmation actions above the app's fixed tab bar. */
.create-page { padding-bottom: calc(106rpx + env(safe-area-inset-bottom)); }
.sticky-actions,.form-actions,.review-actions { bottom: calc(106rpx + env(safe-area-inset-bottom)); }
