.header-profile-glyph::after{content:'';position:absolute;left:3rpx;bottom:1rpx;width:21rpx;height:11rpx;border:2rpx solid currentColor;border-radius:11rpx 11rpx 4rpx 4rpx;box-sizing:border-box}
