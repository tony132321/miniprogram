page{padding:0;background:#f5f6f8;color:#1a1b1f;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif}.create-page{min-height:100vh;padding-bottom:env(safe-area-inset-bottom)}button{margin:0}.page-header{height:96rpx;background:#fff;display:flex;align-items:center;justify-content:center;padding:0 32rpx;position:relative}.header-title{font-size:34rpx;font-weight:700}.header-side{position:absolute;right:32rpx;background:#f2f2f6;padding:10rpx 24rpx;border-radius:40rpx;color:#0053d9;font-size:24rpx;font-weight:600}.notice{margin:18rpx 30rpx;padding:20rpx 24rpx;border-radius:20rpx;background:#ebf2fe;color:#1745a3;font-size:25rpx;line-height:1.5}.warning{background:#fff6df;color:#80541b}.inline-action{display:inline-block;width:auto;padding:0 12rpx;background:transparent;color:#0053d9;font-size:24rpx;line-height:1.4}.inline-action:after{border:0}.hero{display:flex;min-height:280rpx;padding:34rpx 30rpx 18rpx;position:relative;overflow:hidden}.hero-copy{z-index:1;flex:1}.hero-title{font-size:46rpx;font-weight:800;line-height:1.25;letter-spacing:-1rpx}.hero-subtitle{margin-top:25rpx;font-size:29rpx;color:#424655}.hero-caption{margin-top:12rpx;font-size:25rpx;color:#0053d9;font-weight:700}.orb-wrap{width:180rpx;position:relative;align-self:center}.orb{width:142rpx;height:142rpx;border-radius:50%;background:radial-gradient(circle at 55% 40%,#5754b9,#1b1b53 70%);box-shadow:0 16rpx 30rpx #24247d40;display:flex;flex-direction:column;align-items:center;justify-content:center}.eyes{color:#75ebff;text-shadow:0 0 12rpx #75ebff;font-size:24rpx}.cheeks{color:#ff2d55;font-size:27rpx}.orb-tag{position:absolute;z-index:1;top:-32rpx;left:0;transform:rotate(8deg);border-radius:38rpx;background:#fff;padding:8rpx 16rpx;color:#5856d6;font-size:18rpx;font-weight:700;box-shadow:0 8rpx 20rpx #0001}.prompt-card{margin:12rpx 30rpx;background:#fff;border-radius:34rpx;padding:30rpx;box-shadow:0 8rpx 26rpx #28334d0b}.idea-input{width:100%;height:225rpx;padding:0;border:0;margin:0;bo