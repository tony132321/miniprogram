.review-actions button{flex:1}.review-actions .primary-button{flex:1.7}.review-back{width:100%;margin:13rpx 0 0;padding:8rpx;background:transparent;color:#1a64e9;font-size:20rpx}

/* Wave66: pg03_ai IDEA only. Native status/menu use existing measured insets. */
.stage-IDEA{background:#f5f6f8;color:#1a1b1f;font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:15px;font-weight:400;line-height:21px}
.stage-IDEA image{display:block;flex:none}
.stage-IDEA .page-header{position:fixed;top:0;left:0;right:0;z-index:50;height:56px;padding-left:16px;padding-right:16px;background:rgba(255,255,255,.82);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:0 1px 8px rgba(0,0,0,.03)}
.stage-IDEA .header-back{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin-left:-6px;padding:0;border-radius:9999px;line-height:normal;text-align:center}
.stage-IDEA .idea-header-back-symbol{width:24px;height:24px}
.stage-IDEA .header-title{left:54px;right:var(--idea-title-right);width:auto;transform:none;padding:0 8px;font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:17px;font-weight:600;line-height:22px;letter-spacing:-.01em;overflow:hidden;text-overflow:ellipsis}
.stage-IDEA .header-profile{display:flex;align-items:center;justify-content:center;width:32px;height:32px;background:#004cc8;line-height:normal}
.stage-IDEA .idea-header-person-symbol{width:18px;height:18px}
.stage-IDEA .header-side{display:flex;align-items:center;justify-content:center;gap:4px;width:auto;max-width:none;height:32px;padding:0 12px;background:rgba(233,231,237,.6);color:#1a1b1f;font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:13px;font-weight:600;line-height:16px}
.stage-IDEA .idea-header-drafts-symbol{width:17px;height:17px}
.stage-IDEA .header-back:active,.stage-IDEA .header-side:active{transform:scale(.95)}
.stage-IDEA .idea-header-spacer{width:100%;flex:none}
.stage-IDEA .idea-page{display:flex;flex-direction:column;gap:20px;width:100%;padding:8px 16px calc(96px + 24px + env(safe-area-inset-bottom));box-sizing:border-box;background:#f5f6f8}
.stage-IDEA .hero{position:relative;min-height:0;margin:0;padding:4px 0 0;display:flex;align-items:center;justify-content:space-between;gap:0}
.stage-IDEA .hero-copy{flex:1;min-width:0;padding-right:8px}
.stage-IDEA .hero-title{font-size:22px;font-weight:700;line-height:1.25;letter-spacing:-.025em;white-space:normal;color:#1a1b1f}
.stage-IDEA .idea-hero-substack{display:flex;flex-direction:column;gap:2px;margin-top:10px;color:#424655;font-size:13px;font-weight:400;line-height:1.625}
.stage-IDEA .hero-subtitle,.stage-IDEA .hero-middle{margin:0;color:#424655;font-size:13px;font-weight:400;line-height:1.625}
.stage-IDEA .hero-caption{display:flex;align-items:center;gap:4px;margin:0;padding-top:2px;color:#1d64f2;font-size:13px;font-weight:600;line-height:16px;white-space:normal}
.stage-IDEA .idea-hero-arrow-symbol{width:15px;height:15px}
.stage-IDEA .hero-truth{margin:6px 0 0;padding:0;color:#737687;font-size:11px;font-weight:600;line-height:16px;white-space:normal}
.stage-IDEA .orb-wrap{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;width:80px;height:80px}
.stage-IDEA .orb-tag{position:absolute;top:-12px;right:-4px;left:auto;z-index:10;display:flex;align-items:center;gap:2px;max-width:84px;padding:2px 8px;box-sizing:border-box;border-radius:9999px;background:#f2f1fd;color:#5856d6;font-size:10px;font-weight:700;line-height:15px;letter-spacing:-.025em;white-space:normal;transform:rotate(6deg);box-shadow:0 1px 2px rgba(0,0,0,.05)}
.stage-IDEA .orb-tag text{flex:1;min-width:0}
.stage-IDEA .idea-orb-sparkle-symbol{width:11px;height:11px}
.stage-IDEA .orb{position:relative;display:flex;flex-direction:row;align-items:center;justify-content:center;width:80px;height:80px;border-radius:9999px;background:linear-gradient(to top right,#141b3a,#2d2963,#5856d6);box-shadow:0 12px 28px rgba(88,86,214,.35),0 0 16px rgba(29,100,242,.3);animation:wave66-idea-pulse 2s cubic-bezier(.4,0,.6,1) infinite}
.stage-IDEA .idea-orb-reflection{position:absolute;top:8px;left:12px;width:20px;height:10px;border-radius:9999px;background:rgba(255,255,255,.4);transform:rotate(-45deg);filter:blur(1px)}
.stage-IDEA .eyes{z-index:10;display:flex;align-items:center;gap:10px;margin:0;font-size:0;text-shadow:none}
.stage-IDEA .idea-orb-eye{width:8px;height:10px;border-radius:9999px;background:#82e9ff;box-shadow:0 0 8px #3fe5ff}
.stage-IDEA .cheeks{position:absolute;bottom:16px;display:flex;align-items:center;justify-content:space-between;width:40px;padding:0 4px;box-sizing:border-box;opacity:.7;font-size:0}
.stage-IDEA .idea-orb-cheek{width:6px;height:4px;border-radius:9999px;background:#ff2d55;filter:blur(1px)}
.stage-IDEA .idea-orb-particle{position:absolute;bottom:-4px;left:-4px;width:14px;height:14px;border-radius:9999px;background:transparent;box-shadow:0 0 8px #d2f803}
.stage-IDEA .prompt-card{position:relative;display:flex;flex-direction:column;justify-content:space-between;width:100%;min-height:168px;margin:0;padding:16px;box-sizing:border-box;border-radius:24px;background:#fff;box-shadow:0 8px 24px -4px rgba(28,41,61,.06),0 1px 3px rgba(28,41,61,.02)}
.stage-IDEA .idea-input{display:block;width:100%;height:97.5px;margin:0;padding:0;border:0;background:transparent;color:#1a1b1f;font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:15px;font-weight:400;line-height:1.625}
.stage-IDEA .idea-input-placeholder{color:#c3c6d8}
.stage-IDEA .prompt-foot{display:flex;align-items:center;justify-content:space-between;height:auto;padding-top:8px}
.stage-IDEA .count{display:flex;align-items:center;gap:6px;color:#424655;font-size:11px;font-weight:700;line-height:14px;letter-spacing:.02em}
.stage-IDEA .idea-count-dot{width:6px;height:6px;border-radius:9999px;background:#34c759;animation:wave66-idea-ping 1s cubic-bezier(0,0,.2,1) infinite}
.stage-IDEA .idea-count-limit{color:#737687}
.stage-IDEA .send-button{display:flex;align-items:center;justify-content:center;width:40px;height:40px;margin:0;padding:0;border-radius:9999px;background:#1d64f2;color:#fff;line-height:normal;box-shadow:0 4px 14px rgba(29,100,242,.38)}
.stage-IDEA .idea-send-symbol{width:20px;height:20px;transform:translateX(2px) rotate(-12deg)}
.stage-IDEA .send-button:active{transform:scale(.9)}
.stage-IDEA .hint{margin:0;color:#424655;font-size:13px;line-height:18px}
.stage-IDEA .inspiration-head{display:flex;align-items:center;justify-content:space-between;margin:0;padding-top:4px}
.stage-IDEA .section-head{display:flex;align-items:center;gap:6px;color:#1a1b1f;font-size:17px;font-weight:600;line-height:22px;letter-spacing:-.01em}
.stage-IDEA .popular{margin:0;padding:2px 6px;border-radius:9999px;background:#fff0f3;color:#ff2d55;font-size:12px;font-weight:700;line-height:16px;letter-spacing:normal}
.stage-IDEA .rotate-button{display:flex;align-items:center;gap:4px;margin:0;padding:0;background:transparent;color:#1d64f2;font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:13px;font-weight:600;line-height:16px}
.stage-IDEA .idea-cached-symbol{width:16px;height:16px}
.stage-IDEA .idea-inspiration-list{display:flex;flex-direction:column;gap:10px}
.stage-IDEA .inspiration{display:flex;align-items:center;gap:14px;width:100%;min-height:0;margin:0;padding:14px;border-radius:18px;background:#fff;box-shadow:0 2px 12px -2px rgba(28,41,61,.04);font-size:15px;font-weight:400;line-height:21px;text-align:left}
.stage-IDEA .inspiration:active{transform:scale(.985);background:#f4f3f8}
.stage-IDEA .inspiration-icon{width:44px;height:44px;margin:0;border-radius:14px;background:#ebf2fe;color:#1d64f2;font-size:20px;line-height:28px;box-shadow:inset 0 2px 4px rgba(0,0,0,.05)}
.stage-IDEA .inspiration-icon.icon-1{background:#f3fee7;color:#4d5d00}
.stage-IDEA .inspiration-icon.icon-2{background:#fff0f3;color:#ff2d55}
.stage-IDEA .inspiration-title{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#1a1b1f;font-size:15px;font-weight:700;line-height:1.25;letter-spacing:-.01em}
.stage-IDEA .inspiration-unavailable{margin-left:5px;color:#737687;font-size:9px;font-weight:600;letter-spacing:normal}
.stage-IDEA .inspiration-subtitle{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;margin-top:2px;color:#424655;font-size:13px;font-weight:400;line-height:18px}
.stage-IDEA .idea-inspiration-forward-symbol{width:18px;height:18px}
.stage-IDEA .idea-quote{display:flex;align-items:center;justify-content:center;gap:6px;margin:0;padding-top:8px;color:#424655;font-size:12px;font-weight:700;font-style:italic;line-height:18px;letter-spacing:.025em;opacity:.6}
.stage-IDEA .idea-quote-arrow-symbol{width:14px;height:14px}
.stage-IDEA .sticky-actions{position:fixed;left:0;right:0;bottom:0;z-index:40;display:flex;flex-direction:column;align-items:center;margin:0;padding:12px 16px calc(32px + env(safe-area-inset-bottom));box-sizing:border-box;background:rgba(255,255,255,.82);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:0 -4px 24px rgba(0,0,0,.04)}
.stage-IDEA .primary-button{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:0;height:auto;margin:0;padding:14px 24px;border-radius:9999px;background:linear-gradient(to right,#004cc8,#1d64f2,#5856d6);color:#fff;font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:17px;font-weight:600;line-height:22px;letter-spacing:-.01em;box-shadow:0 8px 24px -4px rgba(29,100,242,.4)}
.stage-IDEA .idea-generate-symbol{width:22px;height:22px;animation:wave66-idea-spin 4s linear infinite}
.stage-IDEA .primary-button:active{transform:scale(.98)}
.stage-IDEA .manual-entry{width:100%;margin:6px 0 0;padding:0;background:transparent;color:#1d64f2;font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:12px;font-weight:600;line-height:18px}
@keyframes wave66-idea-pulse{50%{opacity:.5}}
@keyframes wave66-idea-ping{75%,100%{transform:scale(2);opacity:0}}
@keyframes wave66-idea-spin{to{transform:rotate(360deg)}}
