.profile-page { min-height: 100vh; padding: 0 28rpx 110rpx; background: #f7f8fc; color: #1a1b1f; box-sizing: border-box; }
.brand-row { display: flex; align-items: center; margin: 4rpx 0 20rpx; gap: 8rpx; }
.brand-dot { width: 34rpx; height: 34rpx; border-radius: 50%; background: #d2f803; color: #004cc8; text-align: center; line-height: 34rpx; font-size: 23rpx; font-weight: bold; }
.brand-name { font-size: 28rpx; font-weight: 800; letter-spacing: -.4rpx; }
.brand-sub { margin-left: auto; color: #686e7b; font-size: 21rpx; }
.card { background: #fff; border-radius: 30rpx; box-shadow: 0 6rpx 28rpx rgba(25, 46, 97, .045); }
.hero { padding: 28rpx; margin-bottom: 28rpx; background: linear-gradient(135deg,#fff 58%,#ebf2fe); }
.hero-top { display: flex; align-items: center; }
.avatar { width: 86rpx; height: 86rpx; border-radius: 50%; background: #e7efff; border: 5rpx solid #fff; color: #1d64f2; text-align: center; line-height: 86rpx; font-size: 36rpx; font-weight: bold; }
.hero-copy { margin-left: 20rpx; flex: 1; }
.hero-name { font-size: 35rpx; font-weight: 800; }
.hero-caption { margin-top: 6rpx; color: #737687; font-size: 23rpx; }
.hero-spark { color: #1d64f2; font-size: 42rpx; }
.hero-quick { display: flex; border-top: 1rpx solid #ecedf3; margin-top: 26rpx; padding-top: 22rpx; color: #004cc8; font-size: 24rpx; font-weight: 650; }
.hero-quick button { flex: 1; text-align: center; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #004cc8; font-size: 24rpx; line-height: 1.5; font-weight: 650; }
.hero-quick button+button { border-left: 1rpx solid #e8eaf1; }
.hero-quick button::after { border: 0; }
.section-head { display: flex; align-items: center; font-size: 28rpx; font-weight: 800; margin: 30rpx 4rpx 14rpx; }
.section-mark { display: inline-block; background: #1d64f2; width: 7rpx; height: 22rpx; border-radius: 5rpx; margin-right: 12rpx; }
.section-link { margin: 0 0 0 auto; padding: 0; color: #1d64f2; font-size: 22rpx; font-weight: 600; background: transparent; line-height: 1.5; }
.section-link::after { border: 0; }
.section-card { padding: 20rpx 26rpx; }
.section-card > view:not(.list-row):not(.notice-item):not(.hint):not(.empty):not(.setting-title):not(.dev-box) { line-height: 1.5; }
.setting-title { font-size: 27rpx; font-weight: 700; padding-top: 8rpx; }
.hint { color: #737687; font-size: 22rpx; line-height: 1.5; margin: 8rpx 0 16rpx; }
.notice-banner { border-radius: 18rpx; background: #eaf1ff; color: #004cc8; padding: 20rpx; margin: 18rpx 0; font-size: 24rpx; }
.empty { text-align: center; color: #8b90a0; padding: 28rpx 0; font-size: 24rpx; }
.list-row { padding: 20rpx 0; border-bottom: 1rpx solid #eef0f5; font-size: 24rpx; line-height: 1.5; }
.list-row:last-child { border-bottom: 0; }
.dev-box { padding: 16rpx; background: #f4f6fa; border-radius: 18rpx; }
.section-card button { font-size: 24rpx; border-radius: 18rpx; margin: 12rpx 0; background: #edf3ff; color: #0053d9; }
.section-card button::after { border: 0; }
.section-card input,.section-card textarea { width: 100%; box-sizing: border-box; border: 0; border-radius: 16rpx; padding: 20rpx; margin: 12rpx 0; background: #f4f5f8; font-size: 24rpx; }
.section-card textarea { min-height: 135rpx; }
.section-card switch { transform: scale(.85); transform-origin: left center; margin: 4rpx 0 14rpx; }
.about-row { width: 100%; box-sizing: border-box; padding: 26rpx; margin-top: 30rpx; display: flex; justify-content: space-between; align-items: center; color: #1d64f2; font-weight: 700; font-size: 26rpx; line-height: 1.4; }
.about-row::after { border: 0; }
.logout-button { margin: 26rpx 0 0; background: #fff; border-radius: 18rpx; color: #e0455a; font-size: 25rpx; }
.logout-button::after { border-color: #ffe4e8; }
.page-foot { color: #a4aabd; text-align: center; margin: 42rpx 0; font-size: 19rpx; letter-spacing: 3rpx; }
.social-grid { display: flex; gap: 16rpx; }
.social-tile { flex: 1; min-width: 0; padding: 25rpx 16rpx; margin: 0; text-align: center; background: #fff; color: #1a1b1f; line-height: 1.45; }
.social-tile::after, .quick-menu button::after { border: 0; }
.social-symbol { width: 64rpx; height: 64rpx; margin: 0 auto 12rpx; border-radius: 18rpx; line-height: 64rpx; font-size: 33rpx; font-weight: 800; }
.social-symbol.blue { color: #155fec; background: #e9f1ff; }
.social-symbol.violet { color: #5e52dc; background: #efedff; }
.social-title { font-size: 24rpx; font-weight: 800; }
.social-note { margin-top: 5rpx; color: #7c8393; font-size: 19rpx; }
.quick-menu { padding: 5rpx 22rpx; }
.quick-menu button { width: 100%; box-sizing: border-box; display: flex; align-items: center; gap: 17rpx; margin: 0; padding: 18rpx 0; border-bottom: 1rpx solid #eef0f5; border-radius: 0; background: transparent; color: #1a1b1f; text-align: left; line-height: 1.4; }
.quick-menu button:last-child { border-bottom: 0; }
.menu-icon { width: 64rpx; height: 64rpx; flex: none; border-radius: 19rpx; background: #e9f1ff; color: #1d64f2; text-align: center; line-height: 64rpx; font-size: 31rpx; }
.quick-menu button>view { flex: 1; }
.menu-title { font-size: 25rpx; font-weight: 750; }
.menu-note { color: #7c8393; font-size: 19rpx; }
.menu-arrow { color: #8990a0; font-size: 35rpx; }

/* Wave64 core tokens retain original CSS px. Native window width replaces source main 390px. */
.profile-page { width: 100%; padding-left: 16px; padding-right: 16px; padding-bottom: 170rpx; background: #f6f8fb; color: #0f172a; }
.profile-status-shield { position: fixed; top: 0; left: 0; right: 0; z-index: 12; background: #f6f8fb; }
.me-core-header, .me-core-card, .me-core-section-head, .me-core-interests, .me-core-activity-filters { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', sans-serif; }
.me-core-header { position: sticky; z-index: 11; box-sizing: border-box; height: 56px; min-height: 56px; margin: 0 -16px 8px; padding-left: 16px; justify-content: space-between; padding-right: 112px; background: rgba(246,248,251,.9); backdrop-filter: blur(12px); }
.me-core-header .brand-lockup, .me-core-header .brand-copy, .me-core-header .brand-actions { display: flex; align-items: center; flex: none; }
.me-core-header .brand-lockup { gap: 6px; }
.me-core-header .brand-dot { display: flex; align-items: center; justify-content: center; flex: none; width: 28px; height: 28px; line-height: 28px; background: #1d64f2; color: #c6ff00; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.me-core-header .brand-play { width: 16px; height: 16px; }
.me-core-header .brand-copy { gap: 4px; white-space: nowrap; align-items: baseline; }
.me-core-header .brand-name { font-size: 16px; line-height: 1; font-weight: 800; color: #0f172a; letter-spacing: -.4px; }
.me-core-header .brand-en { color: #1d64f2; font-size: 10px; line-height: 15px; font-weight: 900; letter-spacing: 1px; }
.me-core-header .brand-actions { gap: 12px; }
.me-core-header .brand-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 32px; height: 32px; padding: 0; margin: 0; line-height: 32px; border: 0; border-radius: 50%; color: #334155; background: transparent; }
.me-core-header .brand-icon image { width: 20px; height: 20px; }
.me-core-header .brand-icon::after { border: 0; }
.card { border: 1rpx solid #eef1f6; border-radius: 26rpx; box-shadow: 0 6rpx 20rpx rgba(15,23,42,.04); }
.me-core-card { box-sizing: border-box; background: #fff; border: 1px solid #f1f5f9; border-radius: 16px; box-shadow: 0 4px 20px -2px rgba(15,23,42,.05); }
.me-core-profile { position: relative; overflow: hidden; border-radius: 24px; background: #fff; padding: 16px; margin-bottom: 0; }
.me-core-profile .hero-top { align-items: flex-start; padding-right: 80px; gap: 14px; min-height: 0; }
.me-core-profile .hero-sticker { position: absolute; top: -4px; right: 8px; z-index: 1; transform: rotate(6deg); padding: 6px 10px; border-radius: 8px; border: 1px solid #fde047; background: #fff740; color: #0f172a; font-size: 11px; line-height: 1.25; font-weight: 900; letter-spacing: -.55px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.me-core-profile .hero-sticker text { display: block; }
.me-core-profile .hero-sticker text:last-child { font-size: 10px; color: #1d64f2; font-weight: 700; letter-spacing: 0; }
.me-core-profile .avatar { position: relative; box-sizing: border-box; flex: none; width: 64px; height: 64px; line-height: 60px; border: 2px solid rgba(29,100,242,.3); border-radius: 50%; background: #e9f1ff; color: #1d64f2; font-size: 24px; box-shadow: 0 0 0 2px #fff; }
.me-core-profile .hero-copy { margin-left: 0; flex: 1; min-width: 0; padding-top: 2px; }
.me-core-profile .hero-name { display: flex; align-items: center; gap: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20px; line-height: 1; font-weight: 900; }
.me-core-profile .hero-name text { font-size: 12px; }
.me-core-profile .hero-handle { margin-top: 4px; color: #94a3b8; font-size: 12px; line-height: 16px; font-weight: 500; white-space: normal; }
.me-core-profile .hero-caption { margin-top: 8px; color: #475569; font-size: 12px; line-height: 1.625; }
.me-core-profile .hero-stats { display: flex; gap: 8px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #f1f5f9; text-align: center; }
.me-core-profile .hero-stats>view { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; }
.me-core-profile .hero-stats>view text:first-child { font-size: 18px; line-height: 28px; font-weight: 900; color: #0f172a; letter-spacing: -.45px; }
.me-core-profile .hero-stats>view:nth-child(2) text:first-child { color: #1d64f2; }
.me-core-profile .hero-stats>view text:last-child { margin-top: 2px; font-size: 10px; line-height: 15px; white-space: nowrap; color: #64748b; }
.section-head { margin: 31rpx 2rpx 13rpx; font-size: 24rpx; }
.section-mark { width: 6rpx; height: 25rpx; margin-right: 10rpx; }
.section-link { color: #1d64f2; font-size: 20rpx; font-weight: 600; }
.me-core-section-head { margin: 20px 0 10px; font-size: 14px; line-height: 20px; font-weight: 900; }
.me-core-section-head .section-mark { flex: none; width: 6px; height: 14px; margin-right: 6px; border-radius: 9999px; }
.me-core-section-head .section-link { display: flex; align-items: center; gap: 2px; margin-left: auto; padding: 0; color: #1d64f2; font-size: 12px; line-height: 16px; font-weight: 500; }
.me-core-section-head .section-chevron { width: 14px; height: 14px; }
.me-core-badges { display: flex; gap: 8px; }
.me-core-badges .badge-tile { min-width: 0; flex: 1; margin: 0; padding: 10px; line-height: 16px; text-align: center; background: #fff; color: #0f172a; }
.badge-tile::after, .activity-tile::after, .tool-grid button::after, .privacy-link::after { border: 0; }
.me-core-badges .badge-tile view { width: 40px; height: 40px; margin: 4px auto; border-radius: 50%; background: #fffbeb; line-height: 40px; font-size: 20px; }
.me-core-badges .badge-tile:nth-child(2) view { background: #fff7ed; }
.me-core-badges .badge-tile:nth-child(3) view { background: #eff6ff; }
.me-core-badges .badge-tile:nth-child(4) view { background: #fff1f2; }
.me-core-badges .badge-tile text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 700; }
.me-core-badges .badge-tile text:last-child { margin-top: 2px; color: #94a3b8; font-size: 9px; line-height: 13.5px; font-weight: 400; }
.me-core-interests { display: flex; flex-wrap: wrap; gap: 8px; }
.me-core-interests .interest-chip { padding: 6px 14px; border: 1px solid #e2e8f0; border-radius: 9999px; background: #fff; color: #334155; font-size: 12px; line-height: 16px; font-weight: 500; }
.me-core-interests .interest-chip.active { color: #fff; border-color: #1d64f2; background: #1d64f2; }
.me-core-interests .interest-chip-add { width: auto; margin: 0; border-color: #1d64f2; border-style: dashed; background: rgba(239,246,255,.5); color: #1d64f2; font-weight: 700; }
.me-core-interests .interest-chip-add::after { border: 0; }
.interest-note { margin: 10rpx 0 0; color: #94a3b8; font-size: 17rpx; }
.me-core-privacy { display: flex; flex-direction: column; gap: 14px; padding: 14px; }
.me-core-privacy .privacy-line { display: flex; gap: 12px; align-items: center; padding: 0 0 14px; border-bottom: 1px solid #f1f5f9; }
.me-core-privacy .privacy-icon { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; flex: none; border-radius: 50%; background: #eff6ff; color: #1d64f2; }
.me-core-privacy .privacy-icon image { width: 16px; height: 16px; }
.me-core-privacy .privacy-icon.green { background: #ecfdf5; color: #059669; }
.me-core-privacy .privacy-icon.slate { background: #f1f5f9; color: #475569; }
.me-core-privacy .privacy-copy { flex: 1; min-width: 0; }
.me-core-privacy .privacy-copy view { font-size: 12px; line-height: 16px; font-weight: 700; color: #1e293b; }
.me-core-privacy .privacy-copy text { display: block; margin-top: 0; color: #94a3b8; font-size: 10px; line-height: 15px; }
.me-core-privacy .privacy-line switch { flex: none; transform: scale(.85); transform-origin: right center; margin: 0; }
.me-core-privacy .privacy-link { display: flex; justify-content: space-between; align-items: center; width: 100%; margin: 0; padding: 2px 0; border-radius: 0; background: transparent; color: #334155; font-size: 12px; text-align: left; line-height: 16px; }
.me-core-privacy .privacy-link text { color: #94a3b8; font-size: 11px; }
.me-core-privacy .privacy-blocks-link { gap: 12px; }
.me-core-privacy .privacy-blocks-label { flex: 1; font-weight: 700; }
.me-core-privacy .privacy-chevron { flex: none; width: 14px; height: 14px; margin-left: -8px; }
.me-core-activities { display: flex; flex-wrap: wrap; gap: 10px; }
.me-core-activities .activity-tile { width: calc(50% - 5px); box-sizing: border-box; overflow: hidden; margin: 0; padding: 8px; background: #fff; color: #0f172a; text-align: left; line-height: 16px; }
.me-core-activities .activity-cover { position: relative; height: 96px; overflow: hidden; border-radius: 12px; background: #1e293b; }
.me-core-activities .activity-photo { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
.me-core-activities .activity-cover-shade { position: absolute; inset: 0; background: linear-gradient(180deg,rgba(0,0,0,.22),transparent 45%,rgba(0,0,0,.37)); }
.me-core-activities .activity-photo-label,.me-core-activities .activity-cover-status { position: absolute; z-index: 1; padding: 2px 4px; border-radius: 9999px; background: rgba(255,255,255,.93); color: #374151; font-size: 9px; line-height: 13.5px; font-weight: 700; }
.me-core-activities .activity-photo-label { left: 6px; top: 6px; }
.me-core-activities .activity-cover-status { right: 6px; bottom: 6px; color: #1d64f2; }
.me-core-activities .activity-copy { padding: 8px 0 0; }
.me-core-activities .activity-copy view { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 700; }
.me-core-activities .activity-copy text { display: block; margin-top: 4px; color: #94a3b8; font-size: 10px; line-height: 15px; }
.advanced-toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; box-sizing: border-box; margin: 22rpx 0 0; padding: 21rpx 23rpx; background: #fff; color: #0f172a; text-align: left; }
.advanced-toggle::after { border: 0; }
.advanced-title { font-size: 23rpx; font-weight: 800; }
.advanced-subtitle { display: block; margin-top: 4rpx; color: #8490a0; font-size: 17rpx; }
.advanced-chevron { flex: none; margin-left: 12rpx; color: #1d64f2; font-size: 20rpx; font-weight: 750; }
.tool-grid { display: flex; gap: 12rpx; }
.tool-grid>button, .tool-grid>view { flex: 1; min-width: 0; margin: 0; padding: 15rpx 3rpx; border: 1rpx solid #eef1f6; border-radius: 19rpx; background: #fff; color: #0f172a; text-align: center; line-height: 1.2; box-shadow: 0 5rpx 15rpx rgba(15,23,42,.04); }
.tool-grid>button view, .tool-grid>view view { width: 54rpx; height: 54rpx; margin: 0 auto 9rpx; border-radius: 17rpx; background: #e9f1ff; color: #1d64f2; line-height: 54rpx; font-size: 31rpx; font-weight: 800; }
.tool-grid text { display: block; font-size: 17rpx; font-weight: 700; white-space: nowrap; }
.tool-grid>view { color: #94a3b8; }
.tool-grid>view view { background: #f1f5f9; color: #94a3b8; }

/* Activity and account sections follow the supplied caper_1 long profile. */
.me-core-activity-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 12px; }
.me-core-activity-filters .activity-filter { flex: none; box-sizing: border-box; margin: 0; padding: 4px 12px; border: 1px solid #e2e8f0; border-radius: 9999px; background: #fff; color: #475569; font-size: 12px; line-height: 16px; font-weight: 500; white-space: nowrap; }
.me-core-activity-filters .activity-filter::after { border: 0; }
.me-core-activity-filters .activity-filter.selected { border-color: #1d64f2; background: #1d64f2; color: #fff; }
.me-core-activity-filters .activity-filter.disabled { background: #eef0f5; color: #94a3b8; border-color: #eef0f5; }
.section-meta { margin-left: auto; color: #94a3b8; font-size: 19rpx; font-weight: 500; }
.wishlist-state { display: flex; align-items: center; gap: 15rpx; padding: 18rpx; }
.wishlist-symbol { width: 58rpx; height: 58rpx; flex: none; border-radius: 17rpx; background: #fff1f4; color: #e45075; font-size: 38rpx; text-align: center; line-height: 58rpx; }
.wishlist-state>view:nth-child(2) { flex: 1; min-width: 0; font-size: 21rpx; font-weight: 800; }
.wishlist-state>view:nth-child(2) text { display: block; margin-top: 4rpx; color: #94a3b8; font-size: 17rpx; font-weight: 400; line-height: 1.35; }
.wishlist-state button { flex: none; margin: 0; padding: 0; background: none; color: #1d64f2; font-size: 18rpx; font-weight: 700; line-height: 1.4; }
.wishlist-state button::after { border: 0; }
.hosted-preview { display: flex; align-items: center; gap: 15rpx; box-sizing: border-box; width: 100%; margin: 0; padding: 14rpx; background: #fff; color: #0f172a; text-align: left; line-height: 1.4; }
.hosted-preview::after { border: 0; }
.hosted-preview image { width: 140rpx; height: 140rpx; flex: none; border-radius: 16rpx; }
.hosted-copy { flex: 1; min-width: 0; }
.hosted-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 22rpx; font-weight: 850; }
.hosted-date,.hosted-note { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 9rpx; color: #64748b; font-size: 18rpx; }
.hosted-note { color: #1d64f2; }
.hosted-chevron { color: #94a3b8; font-size: 34rpx; }
.hosted-empty { padding: 25rpx; }
.tool-subtitle { margin: -5rpx 2rpx 12rpx; color: #94a3b8; font-size: 17rpx; }
.about-menu { margin-top: 22rpx; padding: 6rpx 20rpx; }
.about-menu button { display: flex; justify-content: space-between; align-items: center; box-sizing: border-box; width: 100%; margin: 0; padding: 15rpx 2rpx; border-bottom: 1rpx solid #eef1f6; border-radius: 0; background: none; color: #334155; text-align: left; font-size: 20rpx; line-height: 1.5; }
.about-menu button:last-child { border-bottom: 0; }
.about-menu button::after { border: 0; }
.about-menu button text:last-child { color: #94a3b8; font-size: 28rpx; }
.invite-banner { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 24rpx; padding: 24rpx 22rpx; border-radius: 25rpx; background: linear-gradient(110deg,#2175f9,#5553d9); color: #fff; box-shadow: 0 10rpx 20rpx rgba(55,79,206,.18); }
.invite-banner>view { flex: 1; min-width: 0; font-size: 23rpx; font-weight: 850; }
.invite-banner>view text { display: block; margin-top: 6rpx; color: #dce7ff; font-size: 17rpx; line-height: 1.4; font-weight: 400; }
.invite-banner button { flex: none; margin: 0; padding: 9rpx 16rpx; border-radius: 40rpx; background: #cefc19; color: #173253; font-size: 18rpx; font-weight: 800; line-height: 1.4; }
.invite-banner button::after { border: 0; }
.settings-menu { padding: 5rpx 19rpx; }
.settings-menu button { display: flex; align-items: center; gap: 15rpx; box-sizing: border-box; width: 100%; margin: 0; padding: 17rpx 0; border-bottom: 1rpx solid #eef1f6; border-radius: 0; background: none; color: #0f172a; text-align: left; line-height: 1.35; }
.settings-menu button:last-child { border-bottom: 0; }
.settings-menu button::after { border: 0; }
.settings-icon { flex: none; width: 44rpx; height: 44rpx; border-radius: 13rpx; background: #ecf3ff; color: #1d64f2; line-height: 44rpx; text-align: center; font-size: 25rpx; }
.settings-menu button>view { flex: 1; min-width: 0; font-size: 20rpx; font-weight: 750; }
.settings-menu button>view text { display: block; margin-top: 4rpx; color: #94a3b8; font-size: 16rpx; font-weight: 400; }
.settings-arrow { color: #94a3b8; font-size: 30rpx; }
.dev-box { margin-top: 15rpx; padding: 15rpx 19rpx; }
.dev-box input { box-sizing: border-box; width: 100%; margin: 10rpx 0; padding: 14rpx; border-radius: 13rpx; background: #f1f5f9; font-size: 22rpx; }
.dev-box button { margin: 9rpx 0; border-radius: 13rpx; background: #eaf1ff; color: #1d64f2; font-size: 21rpx; }
.dev-box button::after { border: 0; }
.notice-item { padding: 21rpx 0; }
.notice-offer-focused { margin: 0 -12rpx; padding: 21rpx 12rpx; border-radius: 16rpx; background: #f0f5ff; }
.offer-focus-message { color: #1554c0; }
.notice-head { display: flex; align-items: center; gap: 12rpx; }
.notice-title { flex: 1; min-width: 0; color: #0f172a; font-size: 23rpx; font-weight: 800; }
.notice-read { flex: none; padding: 5rpx 11rpx; border-radius: 30rpx; background: #e8f1ff; color: #1d64f2; font-size: 17rpx; font-weight: 700; }
.notice-read.is-opened { background: #f1f5f9; color: #94a3b8; }
.notice-context { overflow: hidden; margin-top: 8rpx; color: #475569; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.notice-external { margin-top: 7rpx; color: #94a3b8; font-size: 17rpx; }
.section-card .notice-action { width: 100%; margin: 13rpx 0 0; padding: 11rpx 15rpx; border-radius: 12rpx; background: #edf3ff; color: #1d64f2; font-size: 19rpx; font-weight: 700; line-height: 1.45; text-align: left; }

/* Wave72 caper_1 long-page source px; core, consent and advanced scopes retain their original rules. */
.me-long-reference { margin-top: 20px; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', sans-serif; }
.me-long-section + .me-long-section { margin-top: 20px; }
.me-long-heading { display: flex; align-items: center; gap: 6px; margin: 0 0 10px; color: #0f172a; font-size: 14px; line-height: 20px; font-weight: 900; }
.me-long-heading .section-mark { flex: none; width: 6px; height: 14px; margin: 0; border-radius: 9999px; background: #1d64f2; }
.me-long-heading .me-long-closed { margin-left: auto; color: #94a3b8; font-size: 12px; line-height: 16px; font-weight: 500; }
.me-long-reference .me-long-link { display: flex; align-items: center; justify-content: center; flex: none; gap: 2px; width: auto; margin: 0 0 0 auto; padding: 0; border-radius: 0; background: transparent; color: #1d64f2; font-size: 12px; line-height: 16px; font-weight: 500; white-space: nowrap; }
.me-long-reference .me-long-link::after { border: 0; }
.me-long-link image { display: block; flex: none; width: 14px; height: 14px; }
.me-long-wishlist { display: flex; align-items: center; gap: 10px; padding: 8px; border: 1px solid #f1f5f9; border-radius: 16px; background: #fff; box-shadow: 0 4px 20px -2px rgba(15,23,42,.05); }
.me-long-wishlist .wishlist-symbol { display: flex; align-items: center; justify-content: center; flex: none; width: 20px; height: 20px; border-radius: 9999px; background: rgba(255,255,255,.9); color: #f43f5e; font-size: 12px; line-height: 16px; }
.me-long-wishlist .me-long-wishlist-copy { flex: 1; min-width: 0; }
.me-long-wishlist .me-long-wishlist-copy view { color: #0f172a; font-size: 12px; line-height: 16px; font-weight: 700; }
.me-long-wishlist .me-long-wishlist-copy text { display: block; margin-top: 2px; color: #94a3b8; font-size: 10px; line-height: 15px; font-weight: 400; }
.me-long-reference .me-long-hosted { display: flex; align-items: center; gap: 12px; box-sizing: border-box; width: 100%; margin: 0; padding: 12px; border: 1px solid #f1f5f9; border-radius: 16px; background: #fff; color: #0f172a; line-height: 16px; text-align: left; box-shadow: 0 4px 20px -2px rgba(15,23,42,.05); }
.me-long-hosted::after { border: 0; }
.me-long-hosted .me-long-hosted-photo { display: block; flex: none; width: 80px; height: 80px; border-radius: 12px; }
.me-long-hosted .hosted-copy { flex: 1; min-width: 0; }
.me-long-hosted-title-line { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
.me-long-hosted .hosted-title { min-width: 0; overflow: hidden; color: #0f172a; font-size: 12px; line-height: 16px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.me-long-hosted-status { flex: none; padding: 2px 6px; border: 1px solid #e2e8f0; border-radius: 4px; background: #f1f5f9; color: #475569; font-size: 10px; line-height: 15px; font-weight: 700; }
.me-long-hosted-status-active { border-color: #a7f3d0; background: #ecfdf5; color: #059669; }
.me-long-hosted .hosted-date { margin-top: 4px; color: #64748b; font-size: 10px; line-height: 15px; font-weight: 400; }
.me-long-hosted-place { margin-top: 2px; overflow: hidden; color: #94a3b8; font-size: 10px; line-height: 15px; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.me-long-hosted .hosted-note { margin-top: 6px; color: #94a3b8; font-size: 9px; line-height: 13.5px; font-weight: 500; }
.me-long-reference .me-long-empty { padding: 12px; border: 1px solid #f1f5f9; border-radius: 16px; background: #fff; color: #94a3b8; font-size: 12px; line-height: 16px; font-weight: 400; box-shadow: 0 4px 20px -2px rgba(15,23,42,.05); }
.me-long-tools-heading { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 10px; }
.me-long-tools-heading > view { flex: 1; min-width: 0; }
.me-long-tools-heading .me-long-heading { margin: 0; }
.me-long-tool-subtitle { margin: 2px 0 0; color: #94a3b8; font-size: 10px; line-height: 15px; font-weight: 400; }
.me-long-tools { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 8px; }
.me-long-tools > button, .me-long-tools > view { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; margin: 0; padding: 12px 0; border: 1px solid #f1f5f9; border-radius: 16px; background: #fff; color: #1e293b; text-align: center; line-height: 16px; box-shadow: 0 4px 20px -2px rgba(15,23,42,.05); transition: all 150ms cubic-bezier(.4,0,.2,1); }
.me-long-tools > button::after { border: 0; }
.me-long-tools > button view, .me-long-tools > view view { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin: 0 0 4px; border-radius: 9999px; background: #eff6ff; color: #1d64f2; font-size: 18px; line-height: 28px; font-weight: 400; }
.me-long-tools text { display: block; color: #1e293b; font-size: 12px; line-height: 16px; font-weight: 700; }
.me-long-tools > view text { font-size: 10px; line-height: 15px; color: #94a3b8; }
.me-long-tools > button.me-long-tool-hover { border-color: #bfdbfe; }
.me-long-settings-group { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; }
.me-long-reference .me-long-menu { box-sizing: border-box; margin: 0; padding: 14px; border: 1px solid #f1f5f9; border-radius: 16px; background: #fff; box-shadow: 0 4px 20px -2px rgba(15,23,42,.05); }
.me-long-menu-heading { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 10px; color: #0f172a; font-size: 12px; line-height: 16px; font-weight: 900; }
.me-long-menu-heading > view { display: flex; align-items: center; gap: 6px; }
.me-long-menu-marker { display: block; flex: none; width: 4px; height: 12px; border-radius: 9999px; background: #1d64f2; }
.me-long-heading-chevron { display: block; flex: none; width: 14px; height: 14px; }
.me-long-row-chevron { display: block; flex: none; width: 12px; height: 12px; }
.me-long-menu-rows { display: flex; flex-direction: column; gap: 8px; }
.me-long-account-menu .me-long-menu-rows { gap: 10px; }
.me-long-reference .me-long-menu button { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; gap: 8px; width: 100%; margin: 0; padding: 4px 0; border: 0; border-radius: 0; background: transparent; color: #475569; text-align: left; font-size: 12px; line-height: 16px; font-weight: 400; }
.me-long-reference .me-long-menu button::after { border: 0; }
.me-long-reference .me-long-account-menu button { padding: 2px 0; color: #334155; }
.me-long-reference .me-long-notification-menu button { padding: 0; }
.me-long-menu .settings-icon, .me-long-menu .menu-icon, .me-long-menu .me-long-row-emoji { display: inline; flex: none; width: auto; height: auto; margin: 0; border-radius: 0; background: transparent; color: inherit; text-align: left; font-size: 12px; line-height: 16px; font-weight: 400; }
.me-long-menu button > view { flex: 1; min-width: 0; color: #475569; font-size: 12px; line-height: 16px; font-weight: 400; }
.me-long-account-menu button > view { color: #64748b; }
.me-long-menu .menu-title, .me-long-menu button > view > view { font-size: 12px; line-height: 16px; font-weight: 400; }
.me-long-menu button > view > text, .me-long-menu .menu-note { display: block; margin-top: 2px; color: #94a3b8; font-size: 10px; line-height: 15px; font-weight: 400; }
.me-long-row-title { flex: 1; min-width: 0; }
.me-long-public-menus > .me-long-menu + .me-long-menu { margin-top: 12px; }
.me-long-reference .me-long-invite { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 6px; overflow: hidden; margin-top: 20px; padding: 16px; border-radius: 24px; background: linear-gradient(to right,#3b82f6,#4f46e5); color: #fff; box-shadow: 0 10px 25px -5px rgba(29,100,242,.25); }
.me-long-invite .me-long-invite-orb { position: absolute; right: -24px; bottom: -32px; width: 128px; height: 128px; border-radius: 9999px; background: rgba(255,255,255,.1); filter: blur(24px); pointer-events: none; }
.me-long-invite .me-long-invite-copy { position: relative; z-index: 1; flex: 1; min-width: 0; max-width: 200px; }
.me-long-invite .me-long-invite-title { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; font-size: 14px; line-height: 20px; font-weight: 900; letter-spacing: -.35px; }
.me-long-invite .me-long-invite-title > text { display: block; margin: 0; color: #fff; font-size: inherit; line-height: inherit; font-weight: inherit; letter-spacing: inherit; }
.me-long-invite .me-long-invite-title > text:first-child { font-size: 16px; line-height: 24px; font-weight: 400; letter-spacing: 0; }
.me-long-invite .me-long-invite-description { display: block; margin: 0; color: #dbeafe; font-size: 11px; line-height: 13.75px; font-weight: 500; }
.me-long-invite .me-long-invite-button { position: relative; z-index: 1; flex: none; width: auto; margin: 0; padding: 6px 14px; border-radius: 9999px; background: #c6ff00; color: #0f172a; font-size: 12px; line-height: 16px; font-weight: 900; white-space: nowrap; box-shadow: 0 1px 2px rgba(0,0,0,.05); transition: all 150ms cubic-bezier(.4,0,.2,1); }
.me-long-invite-button::after { border: 0; }
.me-long-invite .me-long-invite-hover { background: #a3e635; transform: scale(.95); }
.me-long-danger { margin-top: 24px; }
.me-long-danger-heading { margin-bottom: 8px; padding: 0 4px; color: #94a3b8; font-size: 11px; line-height: 16.5px; font-weight: 700; letter-spacing: .55px; }
.me-long-danger .me-long-logout { box-sizing: border-box; width: 100%; margin: 0; padding: 12px 0; border: 1px solid #fecdd3; border-radius: 16px; background: #fff; color: #e11d48; font-size: 12px; line-height: 16px; font-weight: 700; box-shadow: 0 4px 20px -2px rgba(15,23,42,.05); transition: all 150ms cubic-bezier(.4,0,.2,1); }
.me-long-logout::after { border: 0; }
.me-long-danger .me-long-logout-hover { background: rgba(255,241,242,.5); transform: scale(.99); }
.me-long-privacy-request { margin-top: 8px; padding: 12px; border: 1px solid #ffe4e6; border-radius: 16px; background: rgba(255,241,242,.6); text-align: center; }
.me-long-privacy-request button { width: auto; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #e11d48; font-size: 12px; line-height: 16px; font-weight: 700; }
.me-long-privacy-request button::after { border: 0; }
.me-long-privacy-request button.me-long-privacy-hover { text-decoration-line: underline; }
.me-long-privacy-request > text { display: block; margin-top: 4px; color: #fb7185; font-size: 10px; line-height: 15px; font-weight: 400; }
.me-long-reference .me-long-foot { margin: 0; padding: 24px 0; color: #cbd5e1; text-align: center; font-size: 10px; line-height: 15px; font-weight: 700; letter-spacing: .5px; }
