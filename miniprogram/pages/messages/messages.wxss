.messages-page { min-height:100vh; box-sizing:border-box; padding:24rpx 28rpx 120rpx; background:#f7f8fc; color:#1a1b1f; }
.messages-brand { display:flex; align-items:center; gap:8rpx; font-size:25rpx; font-weight:800; }
.brand-dot { width:34rpx; height:34rpx; border-radius:50%; background:#d2f803; color:#004cc8; text-align:center; line-height:34rpx; }
.brand-light { color:#969ba7; font-size:20rpx; font-weight:500; margin-left:auto; }
.title-row { display:flex; align-items:center; justify-content:space-between; padding:34rpx 0 24rpx; }
.page-title { font-size:50rpx; font-weight:800; }
.subtitle { color:#888d9c; font-size:23rpx; margin-top:4rpx; }
.title-actions { display:flex; align-items:center; gap:12rpx; }
.title-count { color:#e92b51; background:#fff0f3; border-radius:50rpx; padding:7rpx 13rpx; font-size:20rpx; font-weight:700; white-space:nowrap; }
.mark-all-read { margin:0; padding:8rpx 14rpx; border-radius:14rpx; background:#eef2fa; color:#004cc8; font-size:20rpx; line-height:1.4; white-space:nowrap; }
.mark-all-read::after { border:0; }
.filter-row { display:flex; gap:12rpx; margin-bottom:24rpx; overflow-x:auto; white-space:nowrap; }
.filter { border-radius:30rpx; padding:12rpx 20rpx; margin:0; background:#fff; color:#3f4350; font-size:23rpx; font-weight:650; line-height:1.5; flex-shrink:0; }
.filter::after { border:0; }
.filter.active { background:#1d64f2; color:#fff; }
.card { background:#fff; border-radius:28rpx; box-shadow:0 5rpx 24rpx rgba(16,38,80,.045); }
.notice-list { padding:0 20rpx; }
.notice-row { display:flex; width:100%; box-sizing:border-box; align-items:center; padding:24rpx 0; margin:0; background:transparent; color:inherit; text-align:left; border-radius:0; line-height:1.5; border-bottom:1rpx solid #eef0f4; }
.notice-row::after { border:0; }
.notice-row:last-child { border-bottom:0; }
.notice-actions { padding:0 0 20rpx 86rpx; }
.notice-actions button { display:inline-block; margin:0; padding:8rpx 20rpx; border-radius:30rpx; background:#1d64f2; color:#fff; font-size:21rpx; line-height:1.5; }
.notice-actions button::after { border:0; }
.approval-list { margin:0 0 22rpx; }
.approval-heading { font-size:24rpx; color:#676e7b; font-weight:700; margin-bottom:10rpx; }
.approval-card { display:flex; gap:16rpx; padding:22rpx; margin-bottom:14rpx; }
.approval-icon { width:60rpx; height:60rpx; line-height:60rpx; border-radius:50%; text-align:center; flex-shrink:0; background:#f2f1fd; color:#5856d6; font-size:27rpx; }
.approval-copy { flex:1; min-width:0; }
.approval-title { font-size:27rpx; font-weight:700; }
.approval-actions { display:flex; justify-content:flex-end; gap:12rpx; margin-top:16rpx; }
.approval-actions button { margin:0; padding:9rpx 20rpx; border-radius:30rpx; font-size:22rpx; line-height:1.5; }
.approval-actions button::after { border:0; }
.approval-detail { background:#eef0f4; color:#424655; }
.approval-accept { background:#1d64f2; color:#fff; }
.approval-full { align-self:center; font-size:22rpx; color:#8a6d35; }
.notice-badge { width:66rpx; height:66rpx; line-height:66rpx; text-align:center; border-radius:50%; background:#ebf2fe; color:#1d64f2; font-size:25rpx; font-weight:800; margin-right:20rpx; flex-shrink:0; }
.notice-content { flex:1; min-width:0; }
.notice-title { font-size:26rpx; font-weight:700; }
.unread-dot { color:#ff304c; font-size:18rpx; margin-left:8rpx; }
.notice-description { margin-top:5rpx; color:#676e7b; font-size:22rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.notice-state { margin-top:4rpx; color:#9ba2af; font-size:20rpx; }
.chevron { color:#a2a7b1; font-size:34rpx; margin-left:8rpx; }
.empty { text-align:center; color:#747b8c; padding:50rpx 24rpx; font-size:25rpx; }
.empty-symbol { font-size:52rpx; color:#1d64f2; margin-bottom:18rpx; }
.empty button,.retry,.load-more { background:#ebf2fe; color:#1d64f2; font-size:24rpx; border-radius:18rpx; margin-top:20rpx; }
.hint { color:#898f9c; font-size:22rpx; margin-top:10rpx; line-height:1.5; }
.message-banner { background:#ebf2fe; color:#004cc8; padding:20rpx; margin:16rpx 0; border-radius:18rpx; font-size:23rpx; }
.unavailable { margin-top:24rpx; padding:24rpx; }
.unavailable-title { font-size:26rpx; font-weight:700; }
.messages-foot { text-align:center; color:#aab0be; font-size:19rpx; letter-spacing:3rpx; margin-top:50rpx; }

/* CAPER message layout; live rows remain backed by the R1 inbox API. */
.messages-page { padding: 0 26rpx 175rpx; background: #f8fafc; color: #0f172a; }
.messages-status-shield { position: fixed; top: 0; left: 0; right: 0; z-index: 12; background: #f8fafc; }
.messages-brand { position: sticky; z-index: 11; display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; margin: 0 -26rpx; padding: 8rpx 190rpx 6rpx 32rpx; background: #f8fafc; }
.brand-lockup { display: flex; align-items: center; gap: 9rpx; }
.brand-dot { width: 46rpx; height: 46rpx; border-radius: 50%; background: #1d64f2; color: #c6ff00; font-size: 25rpx; font-weight: 900; line-height: 46rpx; box-shadow: 0 4rpx 12rpx rgba(29,100,242,.2); }
.brand-words { display: flex; flex-direction: column; line-height: 1.08; }
.brand-words text:first-child { color: #0f172a; font-size: 22rpx; font-weight: 900; }
.brand-words text:last-child { color: #94a3b8; font-size: 15rpx; font-weight: 750; letter-spacing: 1.3rpx; }
.brand-actions { display: flex; align-items: center; gap: 8rpx; }
.brand-icon { width: 47rpx; height: 47rpx; padding: 0; margin: 0; border-radius: 50%; background: #f1f5f9; color: #334155; font-size: 27rpx; line-height: 47rpx; }
.brand-icon::after { border: 0; }
.title-row { position: relative; display: block; min-height: 101rpx; padding: 15rpx 5rpx 8rpx; }
.title-heading { display: flex; align-items: center; gap: 11rpx; }
.page-title { font-size: 43rpx; line-height: 1.15; font-weight: 900; }
.title-count { min-width: 29rpx; box-sizing: border-box; padding: 3rpx 9rpx; border-radius: 50rpx; color: #fff; background: #ff3b30; font-size: 19rpx; line-height: 1.3; text-align: center; }
.subtitle { margin-top: 7rpx; color: #64748b; font-size: 18rpx; }
.title-stickers { position: absolute; right: 1rpx; top: 1rpx; display: flex; flex-direction: column; align-items: flex-end; pointer-events: none; }
.title-stickers>text { display: block; padding: 4rpx 9rpx; border: 1rpx solid #c9dafc; border-radius: 100rpx; background: #eff6ff; color: #1d64f2; font-size: 13rpx; font-weight: 750; transform: rotate(-3deg); }
.title-stickers>view { width: 75rpx; margin: 6rpx 8rpx 0 0; padding: 7rpx 6rpx; border-radius: 5rpx; background: #fde047; box-shadow: 2rpx 5rpx 11rpx rgba(0,0,0,.1); color: #0f172a; font-size: 14rpx; line-height: 1; font-weight: 900; text-align: center; transform: rotate(4deg); }
.title-stickers>view text { display: block; }
.title-stickers>view text:last-child { margin-top: 2rpx; font-size: 11rpx; }
.filter-row { gap: 7rpx; margin: 17rpx 0 10rpx; padding-bottom: 5rpx; }
.filter { flex: 1; padding: 11rpx 6rpx; border: 1rpx solid #e2e8f0; border-radius: 100rpx; background: #fff; color: #334155; font-size: 17rpx; font-weight: 700; }
.filter.active { border-color: #1d64f2; background: #1d64f2; box-shadow: 0 3rpx 12rpx rgba(29,100,242,.18); }
.inbox-actions { display: flex; align-items: center; justify-content: space-between; padding: 0 5rpx 15rpx; color: #94a3b8; font-size: 17rpx; }
.mark-all-read { margin: 0; padding: 5rpx 14rpx; border: 0; border-radius: 100rpx; background: #eaf1ff; color: #1d64f2; font-size: 17rpx; }
.search-panel { margin: 12rpx 0; padding: 17rpx; }
.search-panel input { height: 60rpx; padding: 0 17rpx; border-radius: 15rpx; background: #f1f5f9; color: #0f172a; font-size: 21rpx; }
.search-panel view { margin-top: 10rpx; color: #94a3b8; font-size: 16rpx; }
.card { border: 1rpx solid #eef1f6; border-radius: 23rpx; box-shadow: 0 5rpx 18rpx rgba(15,23,42,.045); }
.conversation-card { display: flex; align-items: center; gap: 18rpx; margin: 5rpx 0 23rpx; padding: 18rpx 19rpx; }
.conversation-icon { flex: none; width: 68rpx; height: 68rpx; border: 1rpx solid #cbdcff; border-radius: 50%; background: linear-gradient(135deg,#1d64f2,#719dff); color: #fff; font-size: 31rpx; line-height: 68rpx; text-align: center; }
.conversation-title { color: #0f172a; font-size: 22rpx; font-weight: 800; }
.conversation-copy { flex: 1; min-width: 0; }
.conversation-title text { margin-left: 12rpx; padding: 4rpx 9rpx; border-radius: 99rpx; background: #f1f5f9; color: #64748b; font-size: 15rpx; font-weight: 600; }
.conversation-card .hint { margin-top: 5rpx; font-size: 18rpx; }
.section-label { display: flex; align-items: center; justify-content: space-between; gap: 7rpx; margin: 0; padding: 17rpx 19rpx 10rpx; font-size: 21rpx; font-weight: 800; }
.section-title { display: flex; align-items: center; gap: 7rpx; }
.section-number { color: #ff3b30; font-size: 17rpx; }
.section-count { margin-left: auto; color: #94a3b8; font-size: 16rpx; font-weight: 600; }
.approval-list { margin: 0 0 22rpx; }
.approval-heading { margin-left: 5rpx; color: #0f172a; font-size: 22rpx; }
.approval-card { border-radius: 22rpx; padding: 19rpx; }
.approval-icon { background: #eaf1ff; color: #1d64f2; }
.notice-section { margin-bottom: 17rpx; overflow: hidden; }
.notice-list { padding: 0 16rpx 3rpx; }
.notice-row { padding: 17rpx 3rpx; border-bottom: 1rpx solid #f1f5f9; }
.notice-badge { width: 68rpx; height: 68rpx; line-height: 68rpx; margin-right: 15rpx; border: 1rpx solid #c9dafc; background: #eaf1ff; color: #1d64f2; font-size: 22rpx; }
.badge-violet { border-color: #ded5ff; background: #f1edff; color: #7451c6; }
.badge-blue { border-color: #c9dafc; background: #eaf1ff; color: #1d64f2; }
.badge-amber { border-color: #ffe1b0; background: #fff5df; color: #aa6a08; }
.notice-head { display: flex; align-items: baseline; gap: 8rpx; }
.notice-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #0f172a; font-size: 21rpx; font-weight: 800; }
.notice-time { flex: none; color: #94a3b8; font-size: 15rpx; }
.notice-description { margin-top: 3rpx; color: #64748b; font-size: 18rpx; }
.notice-state { color: #94a3b8; font-size: 16rpx; }
.unread-dot { color: #ff3b30; font-size: 18rpx; }
.inbox-load-more { width: 100%; box-sizing: border-box; margin: 3rpx 0 18rpx; padding: 16rpx; font-size: 20rpx; }
.ai-card { position: relative; overflow: hidden; margin-top: 24rpx; padding: 24rpx; border-radius: 24rpx; background: linear-gradient(130deg,#27346d,#111827 55%,#020617); color: #fff; box-shadow: 0 9rpx 20rpx rgba(2,6,23,.14); }
.ai-heading { display: flex; align-items: center; gap: 14rpx; }
.ai-orb { width: 55rpx; height: 55rpx; flex: none; border: 2rpx solid #1d64f2; border-radius: 50%; color: #c6ff00; background: #030b21; line-height: 55rpx; text-align: center; font-size: 28rpx; }
.ai-heading>view:last-child>view { font-size: 22rpx; font-weight: 800; }
.ai-heading text { display: block; margin-top: 2rpx; color: #c6ff00; font-size: 16rpx; }
.ai-copy { margin: 13rpx 0 15rpx 69rpx; color: #cbd5e1; font-size: 19rpx; line-height: 1.55; }
.ai-card button { display: inline-block; margin: 0 0 0 69rpx; padding: 7rpx 18rpx; border-radius: 100rpx; background: #1d64f2; color: #fff; font-size: 18rpx; line-height: 1.5; }
.ai-card button::after { border: 0; }
.preview-card { margin-top: 22rpx; padding: 21rpx 24rpx; }
.preview-title { font-size: 21rpx; font-weight: 800; }
.preview-title text { float: right; color: #94a3b8; font-size: 16rpx; font-weight: 500; }
.preview-card .hint { margin-top: 9rpx; font-size: 18rpx; }
.gallery-scroll { width: calc(100% + 48rpx); margin: 15rpx -24rpx 0; white-space: nowrap; }
.gallery-row { display: flex; width: max-content; gap: 10rpx; padding: 0 24rpx 3rpx; }
.gallery-tile { width: 125rpx; height: 90rpx; box-sizing: border-box; border-radius: 17rpx; padding: 10rpx; color: #fff; display: flex; flex-direction: column; justify-content: space-between; }
.gallery-tile text:first-child { font-size: 28rpx; }
.gallery-tile text:last-child { font-size: 16rpx; font-weight: 750; }
.gallery-blue { background: linear-gradient(135deg,#1d64f2,#45b9ef); }
.gallery-orange { background: linear-gradient(135deg,#ff6a00,#f8ac52); }
.gallery-green { background: linear-gradient(135deg,#12a883,#41caa7); }
.gallery-violet { background: linear-gradient(135deg,#7a55ca,#b474df); }
.settings-row { display: flex; align-items: center; justify-content: space-between; width: 100%; box-sizing: border-box; margin: 24rpx 0 0; padding: 23rpx 24rpx; background: #fff; color: #0f172a; text-align: left; font-size: 21rpx; font-weight: 800; line-height: 1.4; }
.settings-row::after { border: 0; }
.settings-row view { flex: 1; }
.settings-row view text { display: block; margin-top: 5rpx; color: #94a3b8; font-size: 17rpx; font-weight: 500; }
.settings-row>text { color: #94a3b8; font-size: 31rpx; }
.messages-foot { margin-top: 33rpx; color: #94a3b8; font-size: 15rpx; letter-spacing: 1.6rpx; }
.messages-foot view { margin-top: 6rpx; color: #64748b; font-size: 15rpx; letter-spacing: 0; }
