.center-card-state { font-size:17rpx; }
.center-card-actions { margin-top:20rpx; gap:10rpx; }
.center-card-actions button { padding:13rpx 9rpx; font-size:21rpx; }
.center-empty { display:flex; align-items:center; justify-content:center; flex-direction:column; min-height:180rpx; box-sizing:border-box; padding:28rpx; }
.center-empty .empty-symbol { margin-bottom:8rpx; font-size:40rpx; }
.center-empty .hint { margin-top:6rpx; font-size:19rpx; }
.center-pink { background:#fff0f3; color:#e92b51; }

/* Notification cards follow the supplied compact stream while showing only server-backed facts. */
.center-card { padding:24rpx 23rpx; border:0; border-radius:24rpx; }
.center-approval-card { border-top:0; }
.center-notices .center-card:first-child { border-top:0; }
.center-card-layout { display:flex; align-items:flex-start; gap:15rpx; }
.center-card-body { flex:1; min-width:0; }
.center-card-icon { width:59rpx; height:59rpx; line-height:59rpx; font-size:33rpx; }
.center-lime { background:#f2fae7; color:#628400; }
.center-card-title-row { display:flex; align-items:flex-start; justify-content:space-between; gap:9rpx; }
.center-card-title { flex:1; min-width:0; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:27rpx; line-height:1.4; }
.center-approval-card .center-card-title { white-space:normal; word-break:break-word; }
.center-card-time { flex:none; padding-top:4rpx; color:#858a9a; font-size:17rpx; white-space:nowrap; }
.center-card-summary { margin-top:5rpx; color:#354052; font-size:21rpx; line-height:1.48; }
.center-card-kind { margin-top:10rpx; color:#808797; font-size:17rpx; }
.center-unread-dot { margin-left:7rpx; color:#f43f5e; font-size:16rpx; }
.center-card-state { margin-top:8rpx; font-size:16rpx; }
.center-reminder-thumb { position:relative; flex:none; width:90rpx; height:90rpx; margin-left:2rpx; overflow:hidden; border-radius:15rpx; background:#1d3f74; box-shadow:inset 0 0 0 2rpx rgba(255,255,255,.45); }
.center-reminder-thumb-photo { display:block; width:100%; height:100%; }
.center-reminder-thumb-label { position:absolute; right:0; bottom:0; left:0; background:rgba(10,21,38,.78); color:#fff; font-size:17rpx; font-weight:750; line-height:25rpx; text-align:center; white-space:nowrap; }
.center-reminder-actions,.center-approval-actions { display:flex; align-items:center; gap:10rpx; margin-top:17rpx; }
.center-reminder-actions button { flex:1; min-width:0; margin:0; padding:11rpx 7rpx; border-radius:100rpx; font-size:20rpx; font-weight:800; line-height:1.5; white-space:nowrap; }
.center-reminder-actions button::after,.center-approval-actions button::after,.center-inline-link::after,.center-status-link::after { border:0; }
.center-reminder-actions .center-secondary { background:#e9f1ff; }
.center-approval-card .center-card-icon { background:#fff0f3; color:#ef3462; }
.center-approval-meta { display:flex; align-items:center; justify-content:space-between; gap:8rpx; margin-bottom:5rpx; color:#e92b51; font-size:17rpx; font-weight:800; }
.center-approval-pill { flex:none; padding:3rpx 9rpx; border-radius:100rpx; background:#f1efff; color:#6653dd; font-size:16rpx; }
.center-approval-actions { justify-content:flex-end; }
.center-approval-actions button { flex:none; margin:0; padding:9rpx 19rpx; border-radius:100rpx; font-size:20rpx; font-weight:800; line-height:1.5; }
.center-approval-actions .center-secondary { background:#ececf1; color:#394252; }
.center-inline-link { display:inline-block; margin:11rpx 0 0; padding:6rpx 14rpx; border-radius:100rpx; background:#f3f3f8; color:#455060; font-size:17rpx; line-height:1.5; text-align:left; }
.center-status-link { display:flex; align-items:center; justify-content:space-between; width:100%; margin:12rpx 0 0; padding:8rpx 13rpx; border-radius:14rpx; background:#f2f2f8; color:#435064; font-size:17rpx; line-height:1.5; text-align:left; }
.center-status-link text:first-child { color:#178249; }
.center-status-link text:last-child { color:#788091; }
.center-card-actions-right { justify-content:flex-end; margin-top:13rpx; }
.center-card-actions-right button { flex:none; min-width:0; margin:0; padding:8rpx 16rpx; border-radius:100rpx; font-size:18rpx; line-height:1.5; }
.center-standard.center-card { padding-bottom:18rpx; }

/* The private-chat reference is a closed R1 state: no user, transcript or composer action is fabricated. */
.private-chat-shell { min-height:calc(100vh - 160rpx); margin:0 -26rpx -175rpx; padding:0 26rpx 210rpx; background:#f5f6f8; color:#1a1b1f; }
.private-chat-header { position:sticky; z-index:11; display:flex; align-items:center; gap:13rpx; height:102rpx; margin:0 -26rpx; padding-left:26rpx; box-sizing:border-box; background:#faf8fe; box-shadow:0 2rpx 9rpx rgba(27,25,58,.05); }
.private-chat-header button { flex:none; margin:0; padding:0; background:transparent; color:#1a1b1f; }
.private-chat-header button::after,.private-chat-context button::after,.private-chat-links button::after,.private-chat-composer button::after { border:0; }
.private-chat-back { width:35rpx; font-size:51rpx; line-height:60rpx; text-align:left; }
.private-chat-avatar { flex:none; width:61rpx; height:61rpx; border-radius:50%; background:#ebf2fe; color:#1d64f2; text-align:center; font-size:34rpx; line-height:61rpx; }
.private-chat-heading { min-width:0; white-space:nowrap; }
.private-chat-heading view { font-size:27rpx; font-weight:850; }
.private-chat-heading text { color:#7c7891; font-size:17rpx; }
.private-chat-context { display:flex; align-items:center; gap:15rpx; margin-top:20rpx; padding:17rpx; }
.private-chat-context image { flex:none; width:90rpx; height:90rpx; border-radius:14rpx; }
.private-chat-context-copy { flex:1; min-width:0; }
.private-chat-context-copy>view { color:#1a1b1f; font-size:23rpx; font-weight:850; }
.private-chat-context-copy>text { display:block; margin-top:3rpx; color:#798093; font-size:17rpx; }
.private-chat-context-copy button { display:inline-block; margin:7rpx 0 0; padding:0; color:#1d64f2; font-size:18rpx; font-weight:750; line-height:1.5; }
.private-chat-time { width:max-content; margin:24rpx auto 17rpx; padding:5rpx 15rpx; border-radius:99rpx; background:#e9e7ed; color:#818697; font-size:17rpx; font-weight:750; }
.private-chat-safety { display:flex; align-items:flex-start; gap:14rpx; padding:20rpx; color:#586173; font-size:20rpx; line-height:1.55; }
.private-chat-safety-icon { flex:none; width:36rpx; height:36rpx; border-radius:50%; background:#ebf2fe; color:#1d64f2; font-size:26rpx; line-height:36rpx; text-align:center; }
.private-chat-empty { margin-top:28rpx; padding:45rpx 25rpx; text-align:center; }
.private-chat-empty-icon { width:81rpx; height:81rpx; margin:auto; border-radius:50%; background:#ebf2fe; color:#1d64f2; font-size:43rpx; line-height:81rpx; }
.private-chat-empty-title { margin-top:19rpx; font-size:31rpx; font-weight:850; }
.private-chat-empty-copy { margin-top:10rpx; color:#667085; font-size:20rpx; line-height:1.65; }
.private-chat-links { display:flex; gap:12rpx; margin-top:25rpx; }
.private-chat-links button { flex:1; min-width:0; margin:0; padding:11rpx 8rpx; border-radius:99rpx; background:#ebf2fe; color:#1d64f2; font-size:18rpx; line-height:1.5; }
.private-chat-links button:first-child { background:#1d64f2; color:#fff; }
.private-chat-help { margin:19rpx 4rpx 0; color:#898f9d; font-size:18rpx; text-align:center; line-height:1.5; }
.private-chat-composer { position:fixed; z-index:12; left:0; right:0; bottom:0; display:flex; align-items:center; gap:12rpx; padding:16rpx 26rpx calc(16rpx + env(safe-area-inset-bottom)); background:#faf8fe; box-shadow:0 -2rpx 12rpx rgba(16,38,80,.055); }
.private-chat-composer button { flex:none; width:63rpx; height:63rpx; margin:0; padding:0; border-radius:50%; background:#edf0f5; color:#9ca3af; font-size:33rpx; line-height:63rpx; }
.private-chat-composer input { flex:1; min-width:0; height:63rpx; box-sizing:border-box; padding:0 22rpx; border-radius:99rpx; background:#fff; color:#9ca3af; font-size:22rpx; }
