.messages-page { min-height:100vh; box-sizing:border-box; padding:24rpx 28rpx 120rpx; background:#f7f8fc; color:#1a1b1f; }
.messages-brand { display:flex; align-items:center; gap:8rpx; font-size:25rpx; font-weight:800; }
.brand-dot { width:34rpx; height:34rpx; border-radius:50%; background:#d2f803; color:#004cc8; text-align:center; line-height:34rpx; }
.brand-light { color:#969ba7; font-size:20rpx; font-weight:500; margin-left:auto; }
.title-row { display:flex; align-items:center; justify-content:space-between; padding:34rpx 0 24rpx; }
.page-title { font-size:50rpx; font-weight:800; }
.subtitle { color:#888d9c; font-size:23rpx; margin-top:4rpx; }
.title-count { color:#fff; background:#f93450; border-radius:50%; padding:5rpx 16rpx; font-size:24rpx; font-weight:800; }
.filter-row { display:flex; gap:12rpx; margin-bottom:24rpx; }
.filter { border-radius:30rpx; padding:12rpx 20rpx; margin:0; background:#fff; color:#3f4350; font-size:23rpx; font-weight:650; line-height:1.5; }
.filter::after { border:0; }
.filter.active { background:#1d64f2; color:#fff; }
.card { background:#fff; border-radius:28rpx; box-shadow:0 5rpx 24rpx rgba(16,38,80,.045); }
.notice-list { padding:0 20rpx; }
.notice-row { display:flex; width:100%; box-sizing:border-box; align-items:center; padding:24rpx 0; margin:0; background:transparent; color:inherit; text-align:left; border-radius:0; line-height:1.5; border-bottom:1rpx solid #eef0f4; }
.notice-row::after { border:0; }
.notice-row:last-child { border-bottom:0; }
.notice-badge { width:66rpx; height:66rpx; line-height:66rpx; text-align:center; border-radius:50%; background:#ebf2fe; color:#1d64f2; font-size:25rpx; font-weight:800; margin-right:20rpx; flex-shrink:0; }
.notice-content { flex:1; min-width:0; }
.notice-title { font-size:26rpx; font-weight:700; }
.unread-dot { color:#ff304c; font-size:18rpx; margin-left:8rpx; }
.notice-description { margin-top:5rpx; color:#676e7b; font-size:22rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.notice-state { margin-top:4rpx; color:#9ba2af; font-size:20rpx; }
.chevron { color:#a2a7b1; font-size:34rpx; margin-left:8rpx; }
.empty { text-align:center; color:#747b8c; padding:50rpx 24rpx; font-size:25rpx; }
.empty-symbol { font-size:52rpx; color:#1d64f2; margin-bottom:18rpx; }
.empty button,.retry,.load-more { background:#ebf2fe; color:#1d64f2; font-size:24rpx; border-radius:18rpx; margin-top:20rpx; }
.hint { color:#898f9c; font-size:22rpx; margin-top:10rpx; line-height:1.5; }
.message-banner { background:#ebf2fe; color:#004cc8; padding:20rpx; margin:16rpx 0; border-radius:18rpx; font-size:23rpx; }
.unavailable { margin-top:24rpx; padding:24rpx; }
.unavailable-title { font-size:26rpx; font-weight:700; }
.messages-foot { text-align:center; color:#aab0be; font-size:19rpx; letter-spacing:3rpx; margin-top:50rpx; }
