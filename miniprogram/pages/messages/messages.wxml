<view class="messages-page" style="padding-top: {{statusBarHeight}}px">
  <view class="messages-status-shield" style="height: {{statusBarHeight}}px"></view>
  <block wx:if="{{viewMode === 'INBOX'}}">
  <view class="messages-brand" style="top: {{statusBarHeight}}px; padding-right: {{capsuleInset}}px"><view class="brand-lockup"><view class="brand-dot">耍</view><view class="brand-words"><text>耍起</text><text>CAPER</text></view></view><view class="brand-actions"><button class="brand-icon" bindtap="toggleSearch" aria-label="搜索已加载的站内通知">⌕</button><button class="brand-icon" bindtap="goNotificationSettings" aria-label="通知设置">⚙</button></view></view>
  <view class="title-row"><view class="title-main"><view class="title-heading"><text class="page-title">消息</text><text wx:if="{{unreadTotal > 0}}" class="title-count">{{unreadTotal}}</text></view><view class="subtitle">因一件想做的事，遇见一群有趣的人</view></view><view class="title-stickers"><text>More People Brighter Days ☺</text><view>Good<text>People</text><text>More Plans ☺</text></view></view></view>
  <view wx:if="{{loadState === 'READY'}}" class="filter-row"><button class="{{filter === 'ALL' ? 'filter active' : 'filter'}}" data-filter="ALL" bindtap="setFilter">全部消息</button><button class="{{filter === 'ACTIVITY' ? 'filter active' : 'filter'}}" data-filter="ACTIVITY" bindtap="setFilter">👥 活动相关</button><button class="{{filter === 'INTERACTION' ? 'filter active' : 'filter'}}" data-filter="INTERACTION" bindtap="setFilter">互动消息</button><button class="{{filter === 'SYSTEM' ? 'filter active' : 'filter'}}" data-filter="SYSTEM" bindtap="setFilter">📢 系统通知</button></view>
  <view wx:if="{{searchOpen}}" class="search-panel card"><input value="{{searchQuery}}" bindinput="searchInput" placeholder="搜索已加载的站内通知" /><view>仅搜索当前已加载内容；可继续点击“加载更多”。</view></view>
  <view wx:if="{{loadState === 'READY'}}" class="inbox-actions"><text>{{unreadTotal}} 条未读 · 共 {{total}} 条站内通知</text><view class="inbox-action-buttons"><button class="center-entry" bindtap="openNotificationCenter">通知中心 ›</button><button id="markAllReadButton" wx:if="{{unreadTotal > 0}}" bindtap="markAllRead" disabled="{{markingAllRead}}" class="mark-all-read">{{markingAllRead ? '处理中…' : '全部已读'}}</button></view></view>
  <view wx:if="{{message}}" class="message-banner">{{message}}</view>
  <button wx:if="{{loadState === 'ERROR'}}" bindtap="refresh" class="retry">重新加载消息</button>
  <view wx:if="{{loadState === 'UNAUTHENTICATED'}}" class="empty card"><view class="empty-symbol">✉</view><view>登录后可查看本人消息</view><button bindtap="goProfile">前往我的页面</button></view>
  <view wx:if="{{loadState === 'LOADING'}}" class="empty">正在加载站内通知…</view>
  <view wx:if="{{filter === 'INTERACTION' && approvalLoadState === 'LOADING'}}" class="empty">正在加载待审核报名…</view>
  <view wx:if="{{filter === 'INTERACTION' && approvalLoadState === 'ERROR'}}" class="empty card">待审核报名暂时无法加载<button bindtap="loadApprovals">重新加载审核</button></view>
  <view wx:if="{{filter === 'INTERACTION' && approvalLoadState === 'READY' && approvals.length > 0}}" class="approval-list">
    <view class="approval-heading">待审核报名 · {{approvalTotal}}</view>
    <view wx:for="{{approvals}}" wx:key="registrationId" class="card approval-card">
      <view class="approval-icon">✦</view><view class="approval-copy"><view class="approval-title">{{item.eventTitle}}</view><view class="hint">有一位球友申请加入，请在报名截止前确认名额。</view><view class="approval-actions"><button class="approval-detail" data-event-id="{{item.eventId}}" data-is-host="{{item.isHost}}" bindtap="viewApproval">查看详情</button><button wx:if="{{item.canApprove}}" class="approval-accept" data-id="{{item.registrationId}}" data-version="{{item.expectedVersion}}" bindtap="approveRequest" disabled="{{approvingId !== ''}}">{{approvingId === item.registrationId ? '审核中…' : '一键通过'}}</button><view wx:else class="approval-full">名额已满，暂不可通过</view></view></view>
    </view>
    <button wx:if="{{approvalNextOffset !== null}}" class="load-more" bindtap="loadMoreApprovals" disabled="{{loadingMoreApprovals}}">{{loadingMoreApprovals ? '正在加载…' : '加载更多审核'}}</button>
  </view>
  <block wx:if="{{loadState === 'READY'}}"><view wx:if="{{items.length === 0 && (filter !== 'INTERACTION' || (approvalLoadState === 'READY' && approvals.length === 0))}}" class="empty card inbox-empty"><view class="empty-symbol">✉</view><view class="inbox-empty-copy"><view>暂无站内通知</view><view class="hint">活动动态、安全处理结果会显示在这里。</view></view></view></block>
  <view wx:if="{{loadState === 'READY' && items.length > 0 && filteredCount === 0 && (filter !== 'INTERACTION' || (approvalLoadState === 'READY' && approvals.length === 0))}}" class="empty card"><view class="empty-symbol">✉</view><view>{{searchQuery ? '当前搜索无匹配通知' : filter === 'ACTIVITY' ? '暂无活动相关通知' : filter === 'INTERACTION' ? '暂无互动消息' : '暂无系统通知'}}</view><view class="hint">{{loadingMore ? '正在加载后续消息…' : nextOffset !== null ? '当前已加载消息中没有此类通知，可继续加载更多。' : '当前没有此类通知，可切换到全部消息查看。'}}</view></view>
  <view wx:if="{{loadState === 'READY' && filteredCount > 0}}" class="notice-groups">
    <block wx:for="{{noticeGroups}}" wx:key="key" wx:for-item="group">
      <view wx:if="{{group.items.length > 0}}" class="card notice-section">
        <view class="section-label"><view class="section-title"><text>{{group.icon}}</text><text>{{group.title}}</text><text class="section-number">{{group.items.length}}</text></view><text class="section-count">真实站内通知</text></view>
        <view class="notice-list">
          <block wx:for="{{group.items}}" wx:key="id" wx:for-item="notice">
            <button class="notice-row" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" bindtap="openNotice">
              <view class="notice-badge badge-{{group.tone}}">{{group.badge}}</view><view class="notice-content"><view class="notice-head"><view class="notice-title">{{notice.title}}<text wx:if="{{notice.status !== 'OPENED'}}" class="unread-dot">●</text></view><text wx:if="{{notice.timeLabel}}" class="notice-time">{{notice.timeLabel}}</text></view><view class="notice-description">{{notice.summary}}</view><view wx:if="{{notice.externalHint}}" class="notice-state">{{notice.externalHint}}</view></view><view class="chevron">›</view>
            </button>
            <view wx:if="{{notice.kind === 'EVENT_REMINDER' || notice.kind === 'MANUAL_CHECKIN_REQUEST'}}" class="notice-actions"><button data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="checkinSection" bindtap="openNotice">查看签到与入场凭证</button></view>
          </block>
        </view>
      </view>
    </block>
  </view>
  <button wx:if="{{loadState === 'READY' && nextOffset !== null}}" bindtap="loadMore" disabled="{{loadingMore}}" class="load-more inbox-load-more">{{loadingMore ? '正在加载…' : '加载更多站内通知'}}</button>
  <view class="card conversation-card"><view class="conversation-icon">✉</view><view class="conversation-copy"><view class="conversation-title">最近会话<text>尚未开放</text></view><view class="hint">当前仅展示真实站内通知；私聊功能尚未开放。</view></view><button class="conversation-jump" bindtap="openPrivateChatPreview" aria-label="查看私聊功能状态">›</button></view>
  <view class="ai-card"><view class="ai-heading"><view class="ai-orb">✦</view><view><view>🤖 AI 助手消息</view><text>尚未开放</text></view></view><view class="ai-copy">R1 还没有 AI 对话与推荐消息接口。活动状态以站内通知和活动详情为准。</view><button bindtap="goDiscover">前往活动灵感 ›</button></view>
  <view class="card preview-card"><view class="preview-title">@ 提到我 <text>尚未开放</text></view><view class="hint">当前没有群聊、提及和私聊记录接口。</view></view>
  <view class="card preview-card"><view class="preview-title">🖼 群内精彩瞬间 <text>尚未开放</text></view><view class="hint">活动相册尚未开放；下方仅为设计灵感，不是真实活动照片。</view><scroll-view class="gallery-scroll" scroll-x="true" show-scrollbar="false"><view class="gallery-row"><view class="gallery-tile gallery-blue"><text>🏸</text><text>一起运动</text></view><view class="gallery-tile gallery-orange"><text>☕</text><text>咖啡时光</text></view><view class="gallery-tile gallery-green"><text>🚶</text><text>城市漫步</text></view><view class="gallery-tile gallery-violet"><text>🎲</text><text>桌游之夜</text></view></view></scroll-view></view>
  <button class="card settings-row" bindtap="goNotificationSettings"><view><view>🔔 消息通知设置</view><text>管理活动提醒、类似邀请与个人隐私</text></view><text>›</text></button>
  <view class="messages-foot">GOOD PEOPLE · REAL MEETUPS · BRIGHTER DAYS<view>耍起 CAPER · 让有趣的人，在真实世界相聚</view></view>
  </block>
  <block wx:elif="{{viewMode === 'CHAT_UNAVAILABLE'}}">
    <view class="private-chat-shell">
      <view class="private-chat-header" style="top: {{statusBarHeight}}px; padding-right: {{capsuleInset}}px">
        <button class="private-chat-back" bindtap="backToInbox" aria-label="返回消息">‹</button>
        <view class="private-chat-avatar">✦</view>
        <view class="private-chat-heading"><view>私聊</view><text>当前 R1 尚未开放</text></view>
      </view>
      <view class="private-chat-context card"><image src="/assets/stitch/caper_home_badminton.jpg" mode="aspectFill" aria-label="羽毛球场景示意配图"/><view class="private-chat-context-copy"><view>活动内沟通</view><text>示意场景 · 这里没有真实会话</text><button bindtap="goMyActivities">查看我的活动　›</button></view></view>
      <view class="private-chat-time">当前版本</view>
      <view class="private-chat-safety card"><view class="private-chat-safety-icon">◇</view><view>因活动结识时请注意人身与财产安全，友好文明交流。活动规则与安排以已审核公告及详情为准。</view></view>
      <view class="private-chat-empty card"><view class="private-chat-empty-icon">✉</view><view class="private-chat-empty-title">私聊尚未开放</view><view class="private-chat-empty-copy">目前没有私聊会话、消息发送、语音或快捷问候服务。本页不展示虚构人物与聊天记录，也不会保存输入。</view><view class="private-chat-links"><button bindtap="goMyActivities">查看我的活动　›</button><button bindtap="openNotificationCenter">查看通知中心　›</button></view></view>
      <view class="private-chat-help">活动相关问题可在本人已参与活动的公告与问答区提出。</view>
      <view class="private-chat-composer"><button disabled="{{true}}" aria-label="添加附件未开放">＋</button><input disabled="{{true}}" placeholder="私聊尚未开放" aria-label="消息输入未开放"/><button disabled="{{true}}" aria-label="语音消息未开放">♬</button></view>
    </view>
  </block>
  <block wx:else>
    <view class="center-shell">
      <view class="center-header" style="top: {{statusBarHeight}}px; padding-right: {{capsuleInset}}px"><button class="center-back" bindtap="backToInbox" aria-label="返回消息">‹</button><text>通知中心</text><button class="center-settings" bindtap="goNotificationSettings" aria-label="通知设置">⚙</button></view>
      <view class="center-heading"><view><text class="center-heading-title">通知中心</text><text wx:if="{{unreadTotal > 0}}" class="center-heading-count">{{unreadTotal}} 条未读</text></view><button wx:if="{{loadState === 'READY' && unreadTotal > 0}}" bindtap="markAllRead" disabled="{{markingAllRead}}" class="center-read-all">{{markingAllRead ? '处理中…' : '✓ 全部已读'}}</button></view>
      <view class="center-filter-row"><button class="{{filter === 'ALL' ? 'center-filter selected' : 'center-filter'}}" data-filter="ALL" bindtap="setFilter">全部</button><button class="{{filter === 'ACTIVITY' ? 'center-filter selected' : 'center-filter'}}" data-filter="ACTIVITY" bindtap="setFilter">活动提醒</button><button class="{{filter === 'INTERACTION' ? 'center-filter selected' : 'center-filter'}}" data-filter="INTERACTION" bindtap="setFilter">互动消息</button><button class="{{filter === 'SYSTEM' ? 'center-filter selected' : 'center-filter'}}" data-filter="SYSTEM" bindtap="setFilter">系统通知</button></view>
      <view wx:if="{{message}}" class="message-banner">{{message}}</view>
      <button wx:if="{{loadState === 'ERROR'}}" bindtap="refresh" class="retry">重新加载通知</button>
      <view wx:if="{{loadState === 'UNAUTHENTICATED'}}" class="center-empty card">登录后可查看本人通知<button bindtap="goProfile">前往我的页面</button></view>
      <view wx:if="{{loadState === 'LOADING'}}" class="center-empty">正在加载站内通知…</view>
      <view wx:if="{{(filter === 'ALL' || filter === 'INTERACTION') && approvalLoadState === 'LOADING'}}" class="center-inline-status">正在核对待审核报名…</view>
      <view wx:if="{{(filter === 'ALL' || filter === 'INTERACTION') && approvalLoadState === 'ERROR'}}" class="center-inline-status">待审核报名暂时无法加载<button bindtap="loadApprovals">重新加载审核</button></view>
      <view wx:if="{{(filter === 'ALL' || filter === 'INTERACTION') && approvalLoadState === 'READY' && approvals.length > 0}}" class="center-approval-list">
        <view wx:for="{{approvals}}" wx:key="registrationId" class="center-card center-approval-card">
          <view class="center-card-layout"><view class="center-card-icon center-pink">ϟ</view><view class="center-card-body"><view class="center-approval-meta"><text>新球友加入申请</text><text class="center-approval-pill">{{item.canApprove ? '待审核' : '名额已满'}}</text></view><view class="center-card-title-row"><view class="center-card-title">{{item.eventTitle || '活动'}}有新报名申请</view><text class="center-card-time">{{item.timeLabel}}</text></view><view class="center-card-summary">请在活动报名截止前确认名额，以服务端审核结果为准。</view></view></view>
          <view class="center-approval-actions"><button class="center-secondary" data-event-id="{{item.eventId}}" data-is-host="{{item.isHost}}" bindtap="viewApproval">查看详情</button><button wx:if="{{item.canApprove}}" class="center-primary" data-id="{{item.registrationId}}" data-version="{{item.expectedVersion}}" bindtap="approveRequest" disabled="{{approvingId !== ''}}">{{approvingId === item.registrationId ? '审核中…' : '一键通过'}}</button><view wx:else class="center-capacity">名额已满，暂不可通过</view></view>
        </view>
        <button wx:if="{{approvalNextOffset !== null}}" class="center-load-more" bindtap="loadMoreApprovals" disabled="{{loadingMoreApprovals}}">{{loadingMoreApprovals ? '正在加载…' : '加载更多审核'}}</button>
      </view>
      <view wx:if="{{loadState === 'READY'}}" class="center-notices"><block wx:for="{{items}}" wx:key="id" wx:for-item="notice">
        <view wx:if="{{notice.visible}}" class="center-card center-{{notice.cardVariant}} {{notice.kind === 'EVENT_REMINDER' ? 'center-highlight' : ''}}">
          <view class="center-card-layout">
            <view class="center-card-icon center-{{notice.tone}}">{{notice.icon}}</view>
            <view class="center-card-body"><view class="center-card-title-row"><view class="center-card-title">{{notice.title}}</view><text class="center-card-time">{{notice.timeLabel}}</text></view><view class="center-card-summary">{{notice.summary}}</view><view class="center-card-kind">{{notice.categoryLabel}}<text wx:if="{{notice.status !== 'OPENED'}}" class="center-unread-dot">●</text><text wx:else> · 已读</text></view><view wx:if="{{notice.externalHint}}" class="center-card-state">{{notice.externalHint}}</view>
              <button wx:if="{{notice.cardVariant === 'update'}}" class="center-inline-link" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice">⌖ {{notice.actionLabel}} ›</button>
              <button wx:if="{{notice.cardVariant === 'milestone'}}" class="center-status-link" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice"><text>● 活动已成局</text><text>{{notice.actionLabel}} ›</text></button>
            </view>
            <view wx:if="{{notice.cardVariant === 'reminder'}}" class="center-reminder-thumb" aria-label="活动场景示意配图"><image class="center-reminder-thumb-photo" src="/assets/stitch/caper_home_badminton.jpg" mode="aspectFill"/><text class="center-reminder-thumb-label">示意配图</text></view>
          </view>
          <view wx:if="{{notice.cardVariant === 'reminder'}}" class="center-reminder-actions"><button class="center-primary" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice">▣ {{notice.actionLabel}}</button><button wx:if="{{notice.event_id}}" class="center-secondary" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" bindtap="openNotice">活动详情 ›</button></view>
          <view wx:if="{{notice.cardVariant === 'standard'}}" class="center-card-actions center-card-actions-right"><button class="center-primary" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice">{{notice.actionLabel}}</button></view>
        </view>
      </block></view>
      <view wx:if="{{loadState === 'READY' && filteredCount === 0 && (filter !== 'ALL' && filter !== 'INTERACTION' || approvalLoadState !== 'LOADING' && approvals.length === 0)}}" class="center-empty card"><view class="empty-symbol">✉</view><view>{{searchQuery ? '当前搜索无匹配通知' : '暂无此类站内通知'}}</view><view class="hint">{{nextOffset !== null ? '当前已加载消息中没有此类通知，可继续加载更多。' : '新通知会显示在这里。'}}</view></view>
      <button wx:if="{{loadState === 'READY' && nextOffset !== null}}" bindtap="loadMore" disabled="{{loadingMore}}" class="center-load-more">{{loadingMore ? '正在加载…' : '加载更多站内通知'}}</button>
      <view class="center-footer">实时同步活动动态<view>请以站内通知和活动详情为准</view></view>
    </view>
  </block>
</view>
