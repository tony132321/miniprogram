<view class="messages-page" style="padding-top: {{statusBarHeight}}px">
  <view class="messages-status-shield" style="height: {{statusBarHeight}}px"></view>
  <view class="messages-brand" style="top: {{statusBarHeight}}px; padding-right: {{capsuleInset}}px"><view class="brand-lockup"><view class="brand-dot">耍</view><view class="brand-words"><text>耍起</text><text>CAPER</text></view></view><view class="brand-actions"><button class="brand-icon" bindtap="toggleSearch" aria-label="搜索已加载的站内通知">⌕</button><button class="brand-icon" bindtap="goNotificationSettings" aria-label="通知设置">⚙</button></view></view>
  <view class="title-row"><view class="title-main"><view class="title-heading"><text class="page-title">消息</text><text wx:if="{{unreadTotal > 0}}" class="title-count">{{unreadTotal}}</text></view><view class="subtitle">因一件想做的事，遇见一群有趣的人</view></view><view class="title-stickers"><text>More People Brighter Days ☺</text><view>Good<text>People</text><text>More Plans ☺</text></view></view></view>
  <view wx:if="{{loadState === 'READY'}}" class="filter-row"><button class="{{filter === 'ALL' ? 'filter active' : 'filter'}}" data-filter="ALL" bindtap="setFilter">全部消息</button><button class="{{filter === 'ACTIVITY' ? 'filter active' : 'filter'}}" data-filter="ACTIVITY" bindtap="setFilter">👥 活动相关</button><button class="{{filter === 'INTERACTION' ? 'filter active' : 'filter'}}" data-filter="INTERACTION" bindtap="setFilter">互动消息</button><button class="{{filter === 'SYSTEM' ? 'filter active' : 'filter'}}" data-filter="SYSTEM" bindtap="setFilter">📢 系统通知</button></view>
  <view wx:if="{{searchOpen}}" class="search-panel card"><input value="{{searchQuery}}" bindinput="searchInput" placeholder="搜索已加载的站内通知" /><view>仅搜索当前已加载内容；可继续点击“加载更多”。</view></view>
  <view wx:if="{{loadState === 'READY'}}" class="inbox-actions"><text>{{unreadTotal}} 条未读 · 共 {{total}} 条站内通知</text><button id="markAllReadButton" wx:if="{{loadState === 'READY' && unreadTotal > 0}}" bindtap="markAllRead" disabled="{{markingAllRead}}" class="mark-all-read">{{markingAllRead ? '处理中…' : '全部已读'}}</button></view>
  <view wx:if="{{message}}" class="message-banner">{{message}}</view>
  <button wx:if="{{loadState === 'ERROR'}}" bindtap="refresh" class="retry">重新加载消息</button>
  <view wx:if="{{loadState === 'UNAUTHENTICATED'}}" class="empty card"><view class="empty-symbol">✉</view><view>登录后可查看本人消息</view><button bindtap="goProfile">前往我的页面</button></view>
  <view wx:if="{{loadState === 'LOADING'}}" class="empty">正在加载站内通知…</view>
  <view wx:if="{{filter === 'INTERACTION' && approvalLoadState === 'LOADING'}}" class="empty">正在加载待审核报名…</view>
  <view wx:if="{{filter === 'INTERACTION' && approvalLoadState === 'ERROR'}}" class="empty card">待审核报名暂时无法加载<button bindtap="loadApprovals">重新加载审核</button></view>
  <view class="card conversation-card"><view class="conversation-icon">✉</view><view class="conversation-copy"><view class="conversation-title">最近会话<text>尚未开放</text></view><view class="hint">私聊功能尚未开放；下方仅展示真实站内通知。</view></view></view>
  <view wx:if="{{filter === 'INTERACTION' && approvalLoadState === 'READY' && approvals.length > 0}}" class="approval-list">
    <view class="approval-heading">待审核报名 · {{approvalTotal}}</view>
    <view wx:for="{{approvals}}" wx:key="registrationId" class="card approval-card">
      <view class="approval-icon">✦</view><view class="approval-copy"><view class="approval-title">{{item.eventTitle}}</view><view class="hint">有一位球友申请加入，请在报名截止前确认名额。</view><view class="approval-actions"><button class="approval-detail" data-event-id="{{item.eventId}}" data-is-host="{{item.isHost}}" bindtap="viewApproval">查看详情</button><button wx:if="{{item.canApprove}}" class="approval-accept" data-id="{{item.registrationId}}" data-version="{{item.expectedVersion}}" bindtap="approveRequest" disabled="{{approvingId !== ''}}">{{approvingId === item.registrationId ? '审核中…' : '一键通过'}}</button><view wx:else class="approval-full">名额已满，暂不可通过</view></view></view>
    </view>
    <button wx:if="{{approvalNextOffset !== null}}" class="load-more" bindtap="loadMoreApprovals" disabled="{{loadingMoreApprovals}}">{{loadingMoreApprovals ? '正在加载…' : '加载更多审核'}}</button>
  </view>
  <block wx:if="{{loadState === 'READY'}}"><view wx:if="{{items.length === 0 && (filter !== 'INTERACTION' || (approvalLoadState === 'READY' && approvals.length === 0))}}" class="empty card"><view class="empty-symbol">✉</view><view>暂无站内通知</view><view class="hint">活动更新和安全处理结果会显示在这里。</view></view></block>
  <view wx:if="{{loadState === 'READY' && items.length > 0 && filteredCount === 0 && (filter !== 'INTERACTION' || (approvalLoadState === 'READY' && approvals.length === 0))}}" class="empty card"><view class="empty-symbol">✉</view><view>{{searchQuery ? '当前搜索无匹配通知' : filter === 'ACTIVITY' ? '暂无活动相关通知' : filter === 'INTERACTION' ? '暂无互动消息' : '暂无系统通知'}}</view><view class="hint">{{loadingMore ? '正在加载后续消息…' : nextOffset !== null ? '当前已加载消息中没有此类通知，可继续加载更多。' : '当前没有此类通知，可切换到全部消息查看。'}}</view></view>
  <view wx:if="{{loadState === 'READY' && filteredCount > 0}}" class="notice-groups">
    <block wx:for="{{noticeGroups}}" wx:key="key" wx:for-item="group">
      <view wx:if="{{group.items.length > 0}}" class="card notice-section">
        <view class="section-label"><view class="section-title"><text>{{group.icon}}</text><text>{{group.title}}</text><text class="section-number">{{group.items.length}}</text></view><text class="section-count">真实站内通知</text></view>
        <view class="notice-list">
          <block wx:for="{{group.items}}" wx:key="id" wx:for-item="notice">
            <button class="notice-row" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" bindtap="openNotice">
              <view class="notice-badge badge-{{group.tone}}">{{group.badge}}</view><view class="notice-content"><view class="notice-head"><view class="notice-title">{{notice.title}}<text wx:if="{{notice.status !== 'OPENED'}}" class="unread-dot">●</text></view><text wx:if="{{notice.timeLabel}}" class="notice-time">{{notice.timeLabel}}</text></view><view class="notice-description">{{notice.summary}}</view><view wx:if="{{notice.externalHint}}" class="notice-state">{{notice.externalHint}}</view></view><view class="chevron">›</view>
            </button>
            <view wx:if="{{notice.kind === 'EVENT_REMINDER' || notice.kind === 'MANUAL_CHECKIN_REQUEST'}}" class="notice-actions"><button data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="checkinSection" bindtap="openNotice">查看签到与入场凭证</button></view>
          </block>
        </view>
      </view>
    </block>
  </view>
  <button wx:if="{{loadState === 'READY' && nextOffset !== null}}" bindtap="loadMore" disabled="{{loadingMore}}" class="load-more inbox-load-more">{{loadingMore ? '正在加载…' : '加载更多站内通知'}}</button>
  <view class="ai-card"><view class="ai-heading"><view class="ai-orb">✦</view><view><view>🤖 AI 助手消息</view><text>尚未开放</text></view></view><view class="ai-copy">R1 还没有 AI 对话与推荐消息接口。活动状态以站内通知和活动详情为准。</view><button bindtap="goDiscover">前往活动灵感 ›</button></view>
  <view class="card preview-card"><view class="preview-title">@ 提到我 <text>尚未开放</text></view><view class="hint">当前没有群聊、提及和私聊记录接口。</view></view>
  <view class="card preview-card"><view class="preview-title">🖼 群内精彩瞬间 <text>尚未开放</text></view><view class="hint">活动相册尚未开放；下方仅为设计灵感，不是真实活动照片。</view><scroll-view class="gallery-scroll" scroll-x="true" show-scrollbar="false"><view class="gallery-row"><view class="gallery-tile gallery-blue"><text>🏸</text><text>一起运动</text></view><view class="gallery-tile gallery-orange"><text>☕</text><text>咖啡时光</text></view><view class="gallery-tile gallery-green"><text>🚶</text><text>城市漫步</text></view><view class="gallery-tile gallery-violet"><text>🎲</text><text>桌游之夜</text></view></view></scroll-view></view>
  <button class="card settings-row" bindtap="goNotificationSettings"><view><view>🔔 消息通知设置</view><text>管理活动提醒、类似邀请与个人隐私</text></view><text>›</text></button>
  <view class="messages-foot">GOOD PEOPLE · REAL MEETUPS · BRIGHTER DAYS<view>耍起 CAPER · 让有趣的人，在真实世界相聚</view></view>
</view>
