page{padding:0;background:#f5f6fa;color:#1b1e27;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif}.event-page{padding-bottom:150rpx}.poster{height:660rpx;background:linear-gradient(155deg,#073371 3%,#0053d9 42%,#087aff 86%);position:relative;overflow:hidden;color:#fff;padding:43rpx 36rpx;box-sizing:border-box}.poster:before{content:"";position:absolute;width:530rpx;height:530rpx;border:3rpx solid #ffffff24;border-radius:50%;right:-155rpx;top:115rpx;box-shadow:0 0 0 80rpx #ffffff08}.poster:after{content:"";position:absolute;width:150rpx;height:700rpx;border-left:3rpx dashed #ffffff2c;transform:rotate(21deg);right:125rpx;top:110rpx}.poster-top{font-size:23rpx;font-weight:700;letter-spacing:5rpx;display:flex;justify-content:space-between}.poster-top text{font-size:45rpx;color:#d2f803}.poster-title{font-size:85rpx;font-weight:900;font-style:italic;line-height:1.01;letter-spacing:-3rpx;text-shadow:6rpx 7rpx 0 #002664;position:relative;z-index:1;margin-top:92rpx}.poster-ribbon{display:inline-block;position:relative;z-index:1;background:#fff;color:#182343;transform:rotate(-4deg);padding:12rpx 23rpx;margin-top:28rpx;font-size:24rpx;font-weight:700;box-shadow:5rpx 6rpx 0 #d2f803}.poster-bottom{position:absolute;left:36rpx;bottom:43rpx;font-size:23rpx;font-weight:650;letter-spacing:1rpx}.event-tabs{white-space:nowrap;background:#fff;padding:16rpx 20rpx;box-sizing:border-box;position:sticky;top:0;z-index:3;box-shadow:0 5rpx 15rpx #1c265015}.event-tabs view{display:inline-block;margin:0 9rpx;padding:13rpx 19rpx;border-radius:35rpx;background:#f3f5f9;color:#4f5d73;font-size:24rpx;font-weight:600}.event-tabs view:first-child{background:#eaf1ff;color:#0053d9}.event-section{margin:22rpx 22rpx;background:#fff;border-radius:30rpx;padding:29rpx 27rpx;box-sizing:border-box;box-shadow:0 4rpx 15rpx #1f2b490a}.detail-section{margin-top:-32rpx;position:relative;z-index:1;border-radius:42rpx 42rpx 30rpx 30rpx}.detail-heading{display:flex;justify-content:space-between;align-items:center;gap:14rpx;margin-bottom:19rpx}.detail-title{font-size:37rpx;font-weight:800;flex:1}.status-pill{color:#129b57;background:#e8f9ef;padding:8rpx 17rpx;border-radius:40rpx;font-size:21rpx;white-space:nowrap}.tag{display:inline-block;background:#edf3ff;color:#215dc7;border-radius:25rpx;padding:8rpx 16rpx;font-size:21rpx;margin-bottom:10rpx}.detail-row{display:flex;gap:18rpx;align-items:flex-start;padding:20rpx 0;border-top:1rpx solid #edf0f3}.detail-icon{background:#f4f7fb;color:#2852a0;min-width:57rpx;height:57rpx;border-radius:18rpx;text-align:center;line-height:57rpx;font-size:31rpx}.detail-value{font-size:26rpx;font-weight:700;line-height:1.45}.detail-help,.muted{color:#777f90;font-size:22rpx;line-height:1.45;margin-top:6rpx}.host-strip{display:flex;align-items:center;gap:15rpx;background:#f7f8fb;border-radius:20rpx;padding:18rpx;margin:13rpx 0;font-size:25rpx;font-weight:700}.host-avatar{background:#1d64f2;color:#fff;border-radius:50%;width:56rpx;height:56rpx;text-align:center;line-height:56rpx}.info-note{background:#eef3ff;color:#395c9c;font-size:22rpx;padding:18rpx 20rpx;border-radius:15rpx;margin:14rpx 0;line-height:1.5}.alert-note{background:#fff3e8;color:#8d5422;font-size:23rpx;padding:18rpx 20rpx;border-radius:15rpx;margin:14rpx 0;line-height:1.5}.safety-note{background:#f7f8fa;color:#697286;font-size:20rpx;padding:16rpx;border-radius:15rpx;line-height:1.5;margin-top:18rpx}.detail-actions{display:flex;gap:10rpx;margin-top:16rpx}.detail-actions button{font-size:21rpx;flex:1;color:#2059b6;background:#edf3ff;padding:10rpx 8rpx}.section-heading{font-size:31rpx;font-weight:750;margin-bottom:18rpx}.registration-status{border:1rpx solid #dbe7ff;background:#f2f7ff;color:#1d64f2;padding:18rpx 20rpx;border-radius:17rpx;font-size:25rpx;font-weight:700;margin-bottom:15rpx}.event-section .item{background:#f8f9fb;border:0;border-radius:18rpx;margin:11rpx 0;padding:18rpx 19rpx;font-size:23rpx;line-height:1.5;word-break:break-all}.event-section input,.event-section textarea{background:#f8f9fb;border:1rpx solid #e5e9f0;border-radius:18rpx;width:100%;box-sizing:border-box;margin:12rpx 0;padding:16rpx 20rpx;font-size:24rpx}.event-section textarea{min-height:125rpx}.event-section button{border-radius:40rpx;font-size:23rpx;font-weight:650;background:#eef2ff;color:#1b58cc;margin:12rpx 0;padding:9rpx 20rpx}.event-section button:after{border:0}.event-section button[disabled]{opacity:.48}.event-section radio-group,.event-section checkbox-group{display:flex;flex-wrap:wrap;gap:14rpx;margin:16rpx 0}.event-section label{display:inline-flex;align-items:center;padding:10rpx 13rpx;background:#f6f7fb;border-radius:16rpx;font-size:22rpx}.event-section radio,.event-section checkbox{transform:scale(.75)}.event-section>view:not(.detail-heading){line-height:1.5}.event-section .error,.error{color:#a2313b;background:#fff1f2;padding:16rpx;border-radius:14rpx;font-size:23rpx;margin:10rpx 0}.token-text{word-break:break-all;font-size:22rpx;color:#34508b;margin:12rpx 0}.event-section canvas{display:block;margin:20rpx auto;background:#fff;border:12rpx solid #eef2ff;border-radius:18rpx}.bottom-actions{position:fixed;bottom:0;left:0;right:0;z-index:6;background:#fffffff2;padding:18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -8rpx 22rpx #19244e12}.bottom-actions button{background:#12161f;color:#fff;border-radius:60rpx;font-size:30rpx;font-weight:700;padding:17rpx 15rpx}.bottom-actions button:after{border:0}
.poster-art{position:absolute;right:58rpx;top:128rpx;font-size:195rpx;transform:rotate(-22deg);opacity:.74;filter:drop-shadow(4rpx 10rpx 18rpx #002663)}.host-overview{display:flex;gap:10rpx;margin-bottom:22rpx}.host-overview>view{flex:1;min-width:0;background:#f4f7fb;border-radius:18rpx;text-align:center;padding:18rpx 3rpx}.host-overview text{display:block}.host-overview text:first-child{font-size:36rpx;color:#1d64f2;font-weight:800}.host-overview text:last-child{font-size:19rpx;color:#697589}.formation-card{background:#eef9f4;border:1rpx solid #d9f2e7;border-radius:20rpx;padding:20rpx;color:#295f4c;font-size:23rpx;line-height:1.65;margin-bottom:20rpx}.formation-card>view:first-child{font-size:27rpx;font-weight:750;color:#16744a}
.poster-title > view { display: block; white-space: nowrap; }
.event-tabs { display: flex; overflow-x: auto; }
.event-tabs button { flex: none; display: inline-block; margin: 0 9rpx; padding: 13rpx 19rpx; border-radius: 35rpx; background: #f3f5f9; color: #4f5d73; font-size: 24rpx; font-weight: 600; line-height: normal; }
.event-tabs button:first-child { background: #eaf1ff; color: #0053d9; }
