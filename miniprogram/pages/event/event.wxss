.checkin-modes { margin: 2rpx 0 20rpx !important; }
.checkin-participant-card { position: relative; overflow: hidden; min-height: 735rpx; padding: 24rpx; border-radius: 28rpx; background: #30445e; color: #fff; }
.checkin-participant-photo, .checkin-participant-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.checkin-participant-photo { opacity: .7; }
.checkin-participant-shade { background: linear-gradient(140deg,#10263cb8,#27345099 52%,#41374abf); }
.checkin-participant-copy, .checkin-participant-brand { position: relative; z-index: 1; font-size: 26rpx; font-style: italic; font-weight: 850; line-height: 1.05; }
.checkin-participant-copy text, .checkin-participant-brand text { display: block; }
.checkin-participant-brand { position: absolute; top: 24rpx; right: 24rpx; color: #d2f803; font-size: 20rpx; font-style: normal; text-align: right; }
.checkin-entry { position: relative; z-index: 1; width: 86%; box-sizing: border-box; margin: 35rpx auto 0; padding: 28rpx 22rpx; border-radius: 28rpx; background: #fff; color: #1a1b1f; text-align: center; }
.checkin-entry-mark { font-size: 75rpx; color: #1d64f2; line-height: 1; }
.checkin-entry-title { margin: 10rpx 0; font-size: 24rpx; font-weight: 850; }
.checkin-entry button { width: 100%; margin: 12rpx 0 0; background: #1d64f2; color: #fff; }
.checkin-entry button:last-child { background: #edf2ff; color: #1d64f2; }
.checkin-entry input { height: 68rpx; box-sizing: border-box; margin: 10rpx 0; padding: 0 18rpx; background: #f5f5f8; line-height: 68rpx; text-align: center; }
.checkin-entry-divider { margin: 15rpx 0 0; color: #7b8493; font-size: 18rpx; }
.checkin-entry-locked { display: flex; flex-direction: column; justify-content: center; margin-top: 50rpx; min-height: 405rpx; }
.checkin-entry-locked .checkin-availability { margin-top: 15rpx; text-align: left; }
.checkin-section .checkin-host-card { margin-top: 0; min-height: 0; }
.checkin-section .attendance-entry { background: #fff; }
.checkin-feedback-preview { margin: 17rpx 0 0; padding: 23rpx; border-radius: 26rpx; background: #fff; color: #505b70; box-shadow: 0 5rpx 14rpx #2b23520d; font-size: 20rpx; }
.checkin-feedback-heading { margin-bottom: 5rpx; color: #1a1b1f; font-size: 28rpx; font-weight: 850; }
.checkin-feedback-options { display: flex; gap: 12rpx; margin: 17rpx 0 11rpx; }
.checkin-feedback-options text { flex: 1; padding: 14rpx 5rpx; border-radius: 17rpx; background: #eaf8ef; color: #29a95a; text-align: center; font-size: 20rpx; font-weight: 800; }
.checkin-feedback-options text:last-child { background: #f1f0f5; color: #677084; }
.checkin-feedback-notice { color: #8b93a2; font-size: 18rpx; text-align: center; }

/* PG09: photograph and authorised rows lead; legal limits sit after the account. */
.expense-section > .section-kicker { display: block; margin: 0 7rpx 8rpx 0; color: #5856d6; font-size: 20rpx; font-style: italic; text-align: right; letter-spacing: 0; }
.expense-section .expense-ledger { margin: 0 0 25rpx; }
.expense-section .expense-hero { min-height: 420rpx; padding-top: 31rpx; }
.expense-total-label { position: relative; z-index: 1; display: inline-block; padding: 7rpx 13rpx; border-radius: 50rpx; background: #1c1d22ad; color: #f4f4f4 !important; }
.expense-status-dot { color: #34c759; }
.expense-total-caption { margin-top: 65rpx; }
.expense-hero .expense-total { text-shadow: 0 5rpx 15rpx #0007; }
.expense-hero-bottom { margin-top: 79rpx; padding: 9rpx 14rpx; border-radius: 19rpx; background: #111827b8; }
.expense-record-note { display: flex; gap: 13rpx; margin: 16rpx 0 0; padding: 19rpx; border-radius: 22rpx; background: #f0eff4; color: #50576a; font-size: 20rpx; line-height: 1.5; }
.expense-record-note > text { color: #1d64f2; font-size: 27rpx; }
.expense-empty { margin: 15rpx 0 25rpx; padding: 35rpx 25rpx; border-radius: 25rpx; background: #fff; box-shadow: 0 5rpx 15rpx #28265b0d; text-align: center; }
.expense-empty > text { display: block; color: #5856d6; font-size: 44rpx; }
.expense-empty > view:nth-child(2) { margin-top: 7rpx; color: #1a1b1f; font-size: 27rpx; font-weight: 850; }
.expense-empty > view:nth-child(3) { margin-top: 5rpx; color: #71798a; font-size: 20rpx; }
.expense-empty button { margin: 19rpx auto 0; background: #edf2ff; color: #1d64f2; }

/* _2 / _4: confirmed and organizing badminton views use the supplied photo-card rhythm. */
.event-live-detail { background: #faf8fe; }
.poster.poster-live-cover { width: calc(100% - 44rpx); height: 370rpx; margin: 20rpx 22rpx 0; border-radius: 22rpx; background: #152033; box-shadow: 0 8rpx 18rpx #17244b18; }
.poster-live-cover:before, .poster-live-cover:after,
.poster-live-cover .poster-image-fade, .poster-live-cover .poster-court,
.poster-live-cover .poster-crown, .poster-live-cover .poster-headline,
.poster-live-cover .poster-tagline, .poster-live-cover .poster-bottom,
.poster-live-cover .poster-badge { display: none; }
.event-cover-photo, .event-cover-scrim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.event-cover-scrim { background: linear-gradient(0deg,#050c1de8,#050c1d15 78%); }
.event-cover-info { position: absolute; z-index: 2; left: 23rpx; right: 20rpx; bottom: 24rpx; color: #fff; }
.event-cover-status { display: flex; gap: 8rpx; margin-bottom: 34rpx; }
.event-cover-status text { padding: 5rpx 12rpx; border-radius: 100rpx; background: #d2f803; color: #142213; font-size: 18rpx; font-weight: 850; }
.event-cover-status text:last-child { background: #ffffffdd; color: #1d4abd; }
.event-cover-title { overflow: hidden; max-height: 78rpx; font-size: 32rpx; font-weight: 900; line-height: 1.18; }
.event-cover-place { overflow: hidden; margin-top: 6rpx; color: #e6e9ee; font-size: 19rpx; white-space: nowrap; text-overflow: ellipsis; }
.detail-row-label { margin-bottom: 3rpx; color: #778194; font-size: 19rpx; font-weight: 700; }
.event-live-detail .detail-section { margin: 18rpx 22rpx 0; padding: 0 0 24rpx; border-radius: 0; background: transparent; box-shadow: none; }
.event-live-detail .detail-context { margin: 15rpx 0; padding: 17rpx 20rpx; border-radius: 22rpx; background: #fff; }
.event-live-detail .detail-tagline { margin: 0 0 11rpx; font-size: 21rpx; }
.event-live-detail .detail-tagline text:first-child { color: #202938; font-weight: 750; }
.event-live-detail .detail-tag-list { gap: 8rpx; margin: 0; padding: 0; border: 0; }
.event-live-detail .detail-tag-list text { padding: 6rpx 11rpx; font-size: 18rpx; }
.detail-host-state { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 5rpx 18rpx #17244b0c; }
.detail-host-state-copy { flex: 1; min-width: 0; }
.detail-host-state-copy text { display: block; }
.detail-host-state-copy text:first-child { color: #1d64f2; font-size: 24rpx; font-weight: 850; }
.detail-host-state-copy text:last-child { margin-top: 5rpx; color: #667085; font-size: 19rpx; line-height: 1.45; }
.detail-host-state button { flex: none; margin: 0; padding: 7rpx 13rpx; background: #eaf1ff; color: #1d64f2; font-size: 19rpx; }
.event-live-member .detail-participant-card { margin: 0; box-shadow: 0 5rpx 18rpx #17244b0c; }
.event-live-detail .detail-facts { margin: 16rpx 0; padding: 20rpx; border-radius: 25rpx; background: #fff; box-shadow: 0 5rpx 18rpx #17244b0c; }
.event-live-detail .detail-facts-heading { display: flex; justify-content: space-between; gap: 10rpx; margin: 0 0 16rpx; color: #1b2432; font-size: 27rpx; font-weight: 850; }
.event-live-detail .detail-facts-heading text { align-self: center; color: #7a8595; font-size: 17rpx; font-weight: 500; }
.event-live-detail .detail-row { display: flex; align-items: flex-start; gap: 13rpx; margin: 10rpx 0; padding: 16rpx; border-radius: 18rpx; background: #f4f5f8; }
.event-live-detail .detail-row > view { flex: 1; min-width: 0; }
.event-live-detail .detail-icon { min-width: 53rpx; height: 53rpx; border: 0; border-radius: 16rpx; background: #fff; color: #1d64f2; font-size: 27rpx; line-height: 53rpx; }
.event-live-detail .detail-value { color: #171b24; font-size: 23rpx; font-weight: 800; line-height: 1.4; word-break: break-word; }
.event-live-detail .detail-help { color: #737e90; font-size: 18rpx; line-height: 1.45; }
.event-live-detail .venue-copy { align-self: center; margin: 0 !important; padding: 5rpx 10rpx !important; font-size: 18rpx !important; white-space: nowrap; }
.event-live-detail .detail-venue-evidence { margin: 10rpx 0; }
.event-live-host .detail-facts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; padding: 0; background: transparent; box-shadow: none; }
.event-live-host .detail-facts-heading, .event-live-host .detail-time-row, .event-live-host .detail-venue-row, .event-live-host .detail-venue-evidence { grid-column: 1 / -1; }
.event-live-host .detail-facts-heading { margin: 0 3rpx 2rpx; }
.event-live-host .detail-row { margin: 0; padding: 21rpx; background: #fff; box-shadow: 0 5rpx 18rpx #17244b0c; }
.event-live-host .detail-fee-row, .event-live-host .detail-members-row { display: block; min-width: 0; }
.event-live-host .detail-fee-row .detail-icon, .event-live-host .detail-members-row .detail-icon { display: block; margin-bottom: 11rpx; }
.event-live-host .detail-fee-row .detail-value, .event-live-host .detail-members-row .detail-value { font-size: 22rpx; }
.event-live-host .detail-members-row .host-arrow { display: none; }
.event-live-detail .host-strip { margin: 14rpx 0; background: #fff; box-shadow: 0 5rpx 18rpx #17244b0c; }
.event-live-detail .detail-member-preview { margin: 14rpx 0; padding: 21rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 5rpx 18rpx #17244b0c; }
.event-live-detail .detail-member-preview-title { align-items: flex-start; gap: 12rpx; color: #1b2432; font-size: 25rpx; }
.event-live-detail .detail-member-preview-title view { min-width: 0; }
.event-live-detail .detail-member-preview-title text { display: block; margin-top: 3rpx; color: #778194; font-size: 17rpx; font-weight: 500; }
.event-live-detail .detail-member-preview-title button { flex: none; margin: 0; padding: 4rpx 0; border: 0; background: transparent; color: #1d64f2; font-size: 18rpx; line-height: 1.4; }
.event-live-detail .detail-member-preview-title button::after { border: 0; }
.event-live-detail .detail-member-preview-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 11rpx; overflow: visible; margin: 15rpx 0 11rpx; padding: 0; }
.event-live-detail .detail-member-preview-person { box-sizing: border-box; max-width: none; min-width: 0; padding: 15rpx 5rpx; border-radius: 17rpx; background: #f4f5f8; }
.event-live-detail .detail-member-preview-person text { width: 57rpx; height: 57rpx; border-radius: 50%; background: #eaf1ff; color: #1d64f2; }
.event-live-detail .detail-member-preview-empty { margin: 15rpx 0 9rpx; padding: 17rpx; border-radius: 17rpx; background: #f4f5f8; color: #778194; font-size: 19rpx; }
