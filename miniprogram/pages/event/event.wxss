.poster-title > view { display: block; white-space: nowrap; }
.event-tabs { display: flex; overflow-x: auto; }
.event-tabs button { flex: none; display: inline-block; margin: 0 9rpx; padding: 13rpx 19rpx; border-radius: 35rpx; background: #f3f5f9; color: #4f5d73; font-size: 24rpx; font-weight: 600; line-height: normal; }
.event-tabs button.active { background: #eaf1ff; color: #0053d9; }
.event-tabs button::after { border: 0; }
.event-page { padding-bottom: 360rpx; }
.join-review { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 30; display: flex; flex-direction: column; background: #f8fafc; color: #172033; }
.join-review-header { height: 88rpx; flex: none; display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1rpx solid #eef0f4; padding: 0 22rpx; }
.join-review-back { margin: 0; padding: 0; min-width: 160rpx; background: transparent; color: #172033; font-size: 25rpx; text-align: left; line-height: 1.5; }
.join-review-back:after, .join-review-footer button:after { border: 0; }
.join-review-heading { font-size: 30rpx; font-weight: 800; }
.join-review-spacer { width: 160rpx; }
.join-review-scroll { flex: 1; height: 0; min-height: 0; box-sizing: border-box; padding: 22rpx 28rpx 36rpx; }
.join-review-poster { height: 360rpx; position: relative; overflow: hidden; border-radius: 29rpx; background: linear-gradient(135deg,#1467ff,#0144ce); color: #fff; padding: 28rpx; box-sizing: border-box; box-shadow: 0 13rpx 28rpx #0052ff27; }
.join-poster-kicker { font-size: 20rpx; font-weight: 850; letter-spacing: 3rpx; }
.join-poster-mark { position: absolute; right: 52rpx; top: 83rpx; font-size: 105rpx; transform: rotate(-18deg); }
.join-poster-title { position: absolute; left: 30rpx; bottom: 70rpx; font-size: 45rpx; font-weight: 900; line-height: 1; letter-spacing: 1rpx; color: #fff071; text-shadow: 3rpx 4rpx #0740b6; }
.join-poster-ribbon { position: absolute; left: 25rpx; bottom: 25rpx; background: #fff071; color: #172033; padding: 7rpx 12rpx; border-radius: 7rpx; font-size: 21rpx; font-weight: 800; transform: rotate(-2deg); }
.join-review-card { margin: 20rpx 0 0; background: #fff; border: 1rpx solid #e8edf5; border-radius: 28rpx; padding: 26rpx; box-shadow: 0 6rpx 19rpx #172c4e0c; }
.join-card-title { font-size: 34rpx; line-height: 1.3; font-weight: 800; }
.join-card-tag { display: inline-block; margin: 13rpx 0 9rpx; background: #eaf6ec; color: #237745; border-radius: 30rpx; padding: 6rpx 15rpx; font-size: 21rpx; font-weight: 700; }
.join-review-row { display: flex; gap: 18rpx; align-items: flex-start; padding: 14rpx 0; border-bottom: 1rpx solid #f0f2f6; font-size: 25rpx; line-height: 1.5; }
.join-review-row:last-of-type { border-bottom: 0; }
.join-row-icon { width: 27rpx; color: #6c7c94; text-align: center; }
.join-row-caption { font-size: 20rpx; color: #6d7789; }
.join-rule-card { margin-top: 18rpx; background: #eff5ff; border: 1rpx solid #dce9ff; border-radius: 18rpx; padding: 17rpx 19rpx; color: #324d76; font-size: 22rpx; line-height: 1.65; }
.join-rule-title { color: #173d83; font-size: 23rpx; font-weight: 800; }
.join-review-choice { margin: 30rpx 0 0; }
.join-choice-label { font-size: 22rpx; color: #697389; font-weight: 800; margin: 0 0 14rpx; }
.join-choice-selected { display: flex; gap: 16rpx; align-items: center; background: #fff; border: 3rpx solid #0052ff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 6rpx 20rpx #0052ff15; }
.join-choice-check { width: 31rpx; height: 31rpx; flex: none; border-radius: 50%; background: #0052ff; color: #fff; text-align: center; line-height: 31rpx; font-size: 23rpx; font-weight: 800; }
.join-choice-title { font-size: 25rpx; font-weight: 800; }
.join-choice-hint { font-size: 21rpx; color: #697389; line-height: 1.5; margin-top: 5rpx; }
.join-review-caution { color: #5f6b7e; font-size: 21rpx; line-height: 1.6; margin: 21rpx 0 45rpx; }
.join-review-footer { display: flex; gap: 18rpx; flex: none; padding: 20rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); background: #ffffffed; border-top: 1rpx solid #eef0f4; box-shadow: 0 -6rpx 20rpx #1b29420d; }
.join-review-footer button { margin: 0; height: 86rpx; line-height: 86rpx; border-radius: 19rpx; font-size: 26rpx; font-weight: 800; padding: 0 18rpx; }
.join-cancel { width: 160rpx; background: #f0f2f5; color: #344055; }
.join-confirm { flex: 1; background: #0052ff; color: #fff; box-shadow: 0 8rpx 17rpx #0052ff29; }
.join-review-footer button[disabled] { opacity: .55; }
