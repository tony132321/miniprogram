<view class="event-topbar {{loadState === 'READY' && activeSection === 'detailsSection' && !successState && !(display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')) ? 'event-topbar-ready' : ''}} {{successState ? 'event-topbar-success' : ''}}" style="padding-top: {{statusBarHeight}}px"><button class="event-back" bindtap="goBack" aria-label="返回上一页">‹</button><view class="event-nav-copy"><text>{{successState === 'JOINED' ? '报名成功' : successState === 'PUBLISHED' ? (event.reviewStatus === 'APPROVED' ? '发布成功' : '提交审核') : sectionTitle}}</text><text>{{successState ? 'CAPER · 线下见面' : sectionSubtitle}}</text></view><button class="event-nav-share" bindtap="shareCurrentEvent" aria-label="分享或复制活动信息">↥</button><button class="event-nav-safety" bindtap="openEventActions" aria-label="更多活动操作">···</button><button class="event-nav-person" data-section="registrationSection" bindtap="jumpToSection" aria-label="报名与成员">♙</button></view>
<view wx:if="{{joinConfirmation}}" class="join-review" aria-label="报名确认">
  <view class="join-review-header" style="padding-top: {{statusBarHeight}}px"><button class="join-review-back" bindtap="cancelJoin" disabled="{{joinSubmitting}}" aria-label="返回活动详情">‹ 返回活动</button><view class="join-review-heading">报名确认</view><view class="join-review-spacer"></view></view>
  <scroll-view scroll-y="true" show-scrollbar="false" class="join-review-scroll">
    <view class="join-review-poster"><view class="join-poster-kicker"><text>{{joinConfirmation.isBadminton ? 'SAME' : 'GOOD'}}</text><text>{{joinConfirmation.isBadminton ? 'SPORT' : 'PEOPLE'}}</text><text>{{joinConfirmation.isBadminton ? 'BRIGHTER' : 'GREAT'}}</text><text>{{joinConfirmation.isBadminton ? 'PEOPLE' : 'PLANS'}}</text></view><view class="join-poster-note"><text>Good People</text><text>{{joinConfirmation.isBadminton ? 'Great Rallies' : 'Great Plans'}}</text></view><view class="join-poster-mark">{{joinConfirmation.isBadminton ? '🏸' : '✦'}}</view><view class="join-poster-title" wx:if="{{joinConfirmation.isBadminton}}"><text>BADMINTON</text><text>TOGETHER</text></view><view class="join-poster-title" wx:else><text>GOOD PEOPLE</text><text>GREAT PLANS</text></view><view class="join-poster-ribbon">{{joinConfirmation.isBadminton ? '运动让生活更好一点！' : '线下见面更精彩！'}}</view><view class="join-poster-signature">CAPER STYLE ✦</view></view>
    <view class="join-review-card"><view class="join-card-title">{{joinConfirmation.title}}</view><view class="join-card-tag">请核对活动版本 {{joinConfirmation.version}}</view>
      <view class="join-review-row"><text class="join-row-icon">▣</text><view><view>{{joinConfirmation.date}} – {{joinConfirmation.end}}</view><view class="join-row-caption">活动时间以当前版本为准</view></view></view>
      <view class="join-review-row"><text class="join-row-icon">⌖</text><view>{{joinConfirmation.location}}</view></view>
      <view wx:if="{{joinConfirmation.confirmed !== null && joinConfirmation.capacity !== null}}" class="join-review-row"><text class="join-row-icon">♧</text><view>已确认 {{joinConfirmation.confirmed}} / {{joinConfirmation.capacity}} 人</view></view>
      <view class="join-review-row"><text class="join-row-icon">◉</text><view>{{joinConfirmation.fee}}</view></view>
      <view wx:if="{{joinConfirmation.skillLevel}}" class="join-review-row"><text class="join-row-icon">✦</text><view>水平要求：{{joinConfirmation.skillLevel}}</view></view>
      <view class="join-rule-card"><view class="join-rule-title">报名与取消规则</view><view>{{joinConfirmation.approval}}</view><view>取消规则：{{joinConfirmation.cancellationRule}}</view></view>
    </view>
    <view class="join-review-choice"><view class="join-choice-label">选择你的参与方式</view><view class="join-choice-grid"><button class="join-choice-option {{joinChoice === 'JOIN' ? 'selected' : ''}}" data-choice="JOIN" bindtap="selectJoinChoice"><view class="join-choice-line"><view class="join-choice-check">{{joinChoice === 'JOIN' ? '✓' : ''}}</view><view class="join-choice-title">参加这次活动</view></view><view class="join-choice-hint">报名结果以当前审核和名额为准。</view></button><button wx:if="{{canExpressInterest}}" class="join-choice-option {{joinChoice === 'INTERESTED' ? 'selected' : ''}}" data-choice="INTERESTED" bindtap="selectJoinChoice"><view class="join-choice-line"><view class="join-choice-check">{{joinChoice === 'INTERESTED' ? '✓' : ''}}</view><view class="join-choice-title">先标记待定</view></view><view class="join-choice-hint">不占名额，也不进入候补队列。</view></button></view></view>
    <view class="join-message-unavailable">给主办人留言 · 当前报名接口尚未开放此功能</view>
    <view class="join-review-caution">报名后可能是待审批或候补。只有活动页回读为“已确认报名”才表示已获得席位；本页面不承诺场地或费用已由平台核实。</view>
  </scroll-view>
  <view class="join-review-footer"><button class="join-cancel" bindtap="cancelJoin" disabled="{{joinSubmitting}}">取消</button><button id="confirmJoinButton" class="join-confirm" bindtap="confirmJoin" disabled="{{joinSubmitting}}">{{joinSubmitting ? '正在核对最新规则…' : joinChoice === 'INTERESTED' ? '记录待定意向' : '确认报名'}}</button></view>
</view>
<view wx:if="{{event && loadState === 'READY'}}" class="event-page event-view-{{activeSection}} {{successState ? 'event-success' : ''}} {{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED') ? 'event-live-detail' : ''}} {{display.isBadminton && isHost ? 'event-live-host' : ''}} {{display.isBadminton && !isHost && myRegistration.status === 'CONFIRMED' ? 'event-live-member' : ''}}" aria-hidden="{{joinConfirmation ? 'true' : 'false'}}">
  <view wx:if="{{successState === 'PUBLISHED'}}" class="success-panel published-success">
    <view class="published-hero"><view class="success-mark">✓</view><view class="success-kicker">{{event.reviewStatus === 'APPROVED' ? '组局成功创建 · 招募已就绪' : '草稿已发布 · 等待运营审核'}}</view><view class="success-title">{{event.reviewStatus === 'APPROVED' ? '活动已成功发布！' : '活动已提交审核'}}</view><view class="success-copy">{{event.reviewStatus === 'APPROVED' ? (display.isBadminton ? '当前可以准备邀请卡，让球友了解这场活动。' : '当前可以准备邀请卡，让朋友了解这场活动。') : '审核通过后才能分享邀请和接受报名，请在主办工作台查看最新状态。'}}</view></view>
    <view class="published-event-card"><view class="published-cover"><image src="{{display.isBadminton ? '/assets/stitch/caper_home_badminton.jpg' : '/assets/stitch/caper_home_shanghai.jpg'}}" mode="aspectFill"/><view class="published-cover-shade"></view><view class="published-cover-top"><text>{{event.reviewStatus === 'APPROVED' ? display.status : '待审核'}}</text><text>{{display.isBadminton ? '羽毛球 · 运动社交' : '线下活动'}}</text></view><view class="published-cover-title">{{display.title}}</view><view class="published-cover-fee">{{display.fee}}</view></view><view class="published-facts"><view><text>▣</text><text>{{display.date}} – {{display.end}}</text></view><view><text>⌖</text><text>{{display.location}}</text></view><view><text>♙</text><text>{{event.stats.confirmed}} / {{event.payload.maxParticipants}} 人已确认 · {{event.payload.minParticipants}} 人成局</text></view></view></view>
    <view class="published-actions-title">邀请与管理 <text>{{event.reviewStatus === 'APPROVED' ? '按活动当前资格操作' : '邀请需等待审核通过'}}</text></view>
    <view class="published-actions"><button bindtap="openShareCard"><text>↗</text><text>{{event.reviewStatus === 'APPROVED' ? '分享邀请卡' : '查看分享资格'}}</text><text>微信分享与邀请口令</text></button><button data-section="contentSection" bindtap="jumpToSection"><text>▤</text><text>活动公告与问答</text><text>发布更新、回复成员</text></button><button id="publishedInviteCopyButton" data-copy="{{canCopyPublishedInvite}}" bindtap="openShareCard"><text>⌁</text><text>{{canCopyPublishedInvite ? '复制小程序口令' : '查看口令资格'}}</text><text>核对资格并复制当前口令</text></button><button data-section="hostSection" bindtap="jumpToSection"><text>✦</text><text>成局与协办管理</text><text>查看活动实时状态</text></button></view>
    <view class="published-ai-note">本地助手只提供草稿建议；自动邀约与 AI 群聊尚未开放。</view>
    <button class="success-primary" data-section="hostSection" bindtap="jumpToSection">进入主办方工作台 →</button><button class="success-secondary" bindtap="viewSuccessDetails">查看活动详情</button>
  </view>
  <view wx:if="{{successState === 'JOINED'}}" class="success-panel joined-success">
    <view class="joined-hero"><view class="success-mark">✓</view><view class="success-kicker">YOU'RE IN · 当前报名已确认</view><view class="success-title">报名成功，已确认席位！</view><view class="success-copy">你已加入 {{display.title}}。好活动总会让人相遇！</view></view>
    <view class="joined-ticket"><view class="joined-ticket-head"><view class="joined-ticket-label"><text>● {{display.status}} · {{event.stats.confirmed}} / {{event.payload.maxParticipants}} 已确认</text><text>活动卡</text></view><view class="joined-ticket-title">{{display.title}}</view><view class="joined-ticket-tagline">{{event.payload.skillLevel || '和有趣的人一起出发'}}</view></view><view class="joined-ticket-body"><view class="joined-ticket-row"><text>▣</text><view><view>活动时间</view><view>{{display.date}} – {{display.end}}</view></view></view><view class="joined-ticket-row joined-ticket-venue"><text>⌖</text><view class="joined-ticket-row-main"><view>场地地址</view><view>{{display.location}}</view></view><button wx:if="{{event.payload.venueName}}" class="joined-venue-copy" bindtap="copyJoinedVenue" aria-label="复制当前活动集合地点">复制地点</button></view><view class="joined-ticket-row"><text>◉</text><view><view>费用模式</view><view>{{display.fee}}</view></view></view><view class="joined-ticket-proof"><text>现场签到</text><view>报名确认已由当前服务端回读；现场使用有时效的动态签到码。</view><button data-section="checkinSection" bindtap="jumpToSection">查看签到 ›</button></view></view></view>
    <view class="joined-success-card joined-roster-card"><view class="joined-card-heading">本场公开昵称 <button class="joined-roster-link" data-section="registrationSection" bindtap="jumpToSection" aria-label="查看全部报名与成员">查看全部 ›</button></view><view class="joined-roster-count">已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants}} 人；下方昵称可能包含候补，席位以服务端统计为准。</view><view wx:if="{{memberCards.length}}" class="joined-roster-preview"><block wx:for="{{memberCards}}" wx:key="id"><view wx:if="{{index < 4}}" class="joined-roster-person"><text>{{item.avatarGlyph}}</text><text>{{item.displayName}}</text></view></block></view><view wx:else class="joined-roster-empty">暂无本人同意公开的本场昵称。</view><button data-section="registrationSection" bindtap="jumpToSection">查看报名与成员 ›</button></view>
    <view class="joined-success-card"><view class="joined-card-heading">活动公告与问答</view><view>查看主办方更新，或在活动内按当前事实提问。</view><button data-section="contentSection" bindtap="jumpToSection">查看公告 ›</button></view>
    <view class="joined-rule-card">取消规则：{{event.payload.cancellationRule || '以活动当前规则为准'}}。时间、场地及人数请在活动详情中核对。</view>
    <view class="joined-success-footer"><button bindtap="goToItinerary">我的行程</button><button bindtap="viewSuccessDetails">查看活动详情 →</button><button bindtap="shareCurrentEvent" aria-label="复制活动信息">↥</button></view>
  </view>
  <view class="poster {{activeSection !== 'detailsSection' ? 'section-hidden' : ''}} {{display.isBadminton ? 'poster-badminton' : ''}} {{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED') ? 'poster-live-cover' : ''}}"><image wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="event-cover-photo" src="/assets/stitch/caper_home_badminton.jpg" mode="aspectFill"/><view wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="event-cover-scrim"></view><view wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="event-cover-info"><view class="event-cover-status"><text>{{display.status}}</text><text wx:if="{{event.stats}}">已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants}} 人</text></view><view class="event-cover-title">{{display.title}}</view><view class="event-cover-place">⌖ {{display.location}}</view></view><image wx:if="{{display.isBadminton && !isHost && myRegistration.status !== 'CONFIRMED'}}" class="poster-athlete" src="/assets/stitch/pg01_badminton_player.jpg" mode="aspectFill"/><view class="poster-image-fade"></view><view class="poster-court"></view><view class="poster-crown">♛</view><view class="poster-headline" wx:if="{{display.isBadminton}}"><text>BADMINTON</text><text>TOGETHER</text></view><view class="poster-headline poster-headline-generic" wx:else><text>GOOD PEOPLE</text><text>GREAT PLANS</text></view><view class="poster-tagline"><text>{{display.isBadminton ? '运动让生活更好看！' : '线下见面更精彩！'}}</text><text>{{display.isBadminton ? '好球友 总会相遇！' : 'Good People · Great Plans'}}</text></view><view class="poster-bottom"><text>Play More</text><text>Meet Cool People ☺</text></view><view class="poster-badge"><text>{{display.isBadminton ? 'SPORTS,' : 'GOOD'}}</text><text>{{display.isBadminton ? 'FRIENDS' : 'PEOPLE'}}</text><text>GOOD VIBES ☺</text></view></view>
  <view id="detailsSection" class="event-section detail-section {{activeSection !== 'detailsSection' ? 'section-hidden' : ''}}"><view class="detail-heading" wx:if="{{!(display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED'))}}"><text class="detail-title">{{display.title}}</text><text class="status-pill"><text class="status-dot">●</text>{{display.status}}</text></view>
    <view wx:if="{{display.isBadminton && isHost}}" class="detail-host-state"><view class="detail-host-state-copy"><text>主办方视图 · {{display.status}}</text><text wx:if="{{event.stats}}">已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人；报名与现场状态以服务端为准。</text><text wx:else>报名人数待同步；请到报名与成员核对。</text></view><button data-section="checkinSection" bindtap="jumpToSection">签到管理 ›</button></view>
    <view wx:if="{{!isHost && myRegistration && myRegistration.status === 'CONFIRMED'}}" class="detail-participant-card"><view class="detail-pass-mark">✓</view><view class="detail-pass-copy"><view>已确认席位</view><view>入场以当前报名状态与现场动态签到码为准</view></view><button data-section="checkinSection" bindtap="jumpToSection">查看签到 ›</button></view>
    <view wx:if="{{!(display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED'))}}" class="detail-context">
      <view class="detail-tagline" wx:if="{{display.isBadminton}}"><text>运动流汗，认识有趣的人！</text><text>{{event.payload.skillLevel ? '水平要求：' : '无论水平高低，都欢迎加入～'}}{{event.payload.skillLevel}}</text></view>
      <view class="detail-tagline" wx:else>活动安排以主办方当前发布的信息为准。</view>
      <view class="detail-tag-list"><text># {{event.payload.visibility === 'PUBLIC' ? '受控公开' : '仅邀请'}}</text><text wx:if="{{display.isBadminton}}" class="highlight"># 羽毛球</text><text wx:if="{{event.payload.city}}"># {{event.payload.city}}</text><text wx:if="{{event.payload.skillLevel}}"># {{event.payload.skillLevel}}</text></view>
    </view>
    <view id="aiSuggestionNoticeView" wx:if="{{event.aiSuggestionGenerated}}" class="info-note">本活动曾生成 AI 草稿建议；请以主办方确认及当前审核通过的活动信息为准。</view>
    <view wx:if="{{event.payload.skillLevel}}" class="tag">水平要求：{{event.payload.skillLevel}}</view>
    <view class="detail-facts"><view wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="detail-facts-heading">活动信息 <text>以当前服务端活动为准</text></view>
      <view class="detail-row detail-time-row"><text class="detail-icon">▣</text><view><view class="detail-row-label">活动时间</view><view class="detail-value">{{display.date}} – {{display.end}}</view><view class="detail-help">活动时间以主办方最终确认版本为准</view></view></view>
      <view class="detail-row venue-row detail-venue-row"><text class="detail-icon">⌖</text><view class="detail-row-main"><view class="detail-row-label">场地地点</view><view class="detail-value">{{display.location}}</view><view class="detail-help">场地状态：{{event.payload.venueStatus === 'HOST_CONFIRMED' ? '主办方已核实' : '待主办方确认'}}</view></view><button class="venue-copy" bindtap="copyVenue">复制地点 ›</button></view>
      <view id="venueEvidenceView" wx:if="{{event.venueEvidence}}" class="info-note detail-venue-evidence">场地依据为主办方声明，未由场馆接口锁位。</view>
      <view class="detail-row detail-fee-row"><text class="detail-icon">◉</text><view><view class="detail-row-label">费用说明</view><view class="detail-value">{{display.fee}}</view><view class="detail-help">取消规则：{{event.payload.cancellationRule || '请查看活动规则'}}</view></view></view>
      <view wx:if="{{event.stats}}" class="detail-row detail-members-row" data-section="registrationSection" bindtap="jumpToSection"><text class="detail-icon">♧</text><view class="detail-row-main"><view class="detail-row-label">报名席位</view><view class="detail-value">已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人</view><view class="detail-help">主办预留 {{event.stats.reserved}} · 候补 {{event.stats.waitlisted}} · 待审核 {{event.stats.requested}} · 待重新确认 {{event.stats.reconfirmRequired}}</view></view><text class="host-arrow">›</text></view>
    </view>
    <view wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="detail-context"><view class="detail-tagline"><text>运动流汗，认识有趣的人！</text><text>{{event.payload.skillLevel ? '水平要求：' : '无论水平高低，都欢迎加入～'}}{{event.payload.skillLevel}}</text></view><view class="detail-tag-list"><text># {{event.payload.visibility === 'PUBLIC' ? '受控公开' : '仅邀请'}}</text><text class="highlight"># 羽毛球</text><text wx:if="{{event.payload.city}}"># {{event.payload.city}}</text><text wx:if="{{event.payload.skillLevel}}"># {{event.payload.skillLevel}}</text></view></view>
    <view class="host-strip" data-section="registrationSection" bindtap="jumpToSection"><text class="host-avatar">★</text><view><view>由 {{hostAlias || '主办方'}} 发起</view><view class="detail-help">活动内授权昵称 · 查看报名与成员</view></view><text class="host-arrow">›</text></view>
    <view wx:if="{{event.stats && display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="detail-member-preview"><view class="detail-member-preview-title"><view>报名与成员<text>已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人 · 授权昵称独立展示</text></view><button data-section="registrationSection" bindtap="jumpToSection">查看报名与成员 ›</button></view><view wx:if="{{aliasLoadState === 'READY' && memberCards.length}}" class="detail-member-preview-list" data-section="registrationSection" bindtap="jumpToSection"><block wx:for="{{memberCards}}" wx:key="id"><view wx:if="{{index < 6}}" class="detail-member-preview-person"><text>{{item.avatarGlyph}}</text><view>{{item.displayName}}</view></view></block></view><view wx:else class="detail-member-preview-empty">{{aliasLoadState === 'READY' ? '暂无成员授权公开本场昵称。' : '昵称列表暂不可用，请到报名与成员核对。'}}</view><view class="detail-help">仅展示成员自愿公开的本场昵称，可能包含候补；确认席位数以服务端统计为准。</view></view>
    <view wx:if="{{!(display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')) && aliasLoadState === 'READY' && memberCards.length}}" class="detail-member-preview"><view class="detail-member-preview-title">活动内已授权昵称 <text>点按查看成员 ›</text></view><view class="detail-member-preview-list" data-section="registrationSection" bindtap="jumpToSection"><view wx:for="{{memberCards}}" wx:key="id" class="detail-member-preview-person"><text>{{item.avatarGlyph}}</text><view>{{item.displayName}}</view></view></view><view class="detail-help">仅展示成员自愿公开的本场昵称；确认席位数以服务端统计为准。</view></view>
    <view class="detail-help">报名方式：{{event.payload.approvalMode === 'MANUAL' ? '主办方逐一审批' : '自动接受或候补'}} · {{event.payload.visibility === 'PUBLIC' ? '受控公开' : '仅邀请'}}</view>
    <view wx:if="{{event.stats && (event.status === 'RECRUITING' || event.status === 'CONFIRMED')}}" class="detail-seats-note">尚余 {{event.payload.maxParticipants - event.stats.confirmed - event.stats.reserved > 0 ? event.payload.maxParticipants - event.stats.confirmed - event.stats.reserved : 0}} 个非预留名额，报名结果以服务端为准。</view>
    <view wx:if="{{event.updatedAt}}" class="detail-help">更新时间：{{event.updatedAt}}</view>
    <view wx:if="{{event.visibleContentVersion && event.visibleContentVersion !== event.version}}" class="info-note">当前展示已审核版本 {{event.visibleContentVersion}} 的活动信息；最新版本仍在审核或未通过审核。</view>
    <view wx:if="{{event.visibleContentVersion === null}}" class="info-note">活动文字尚无已审核版本，请联系主办方核对安排。</view>
    <view wx:if="{{event.formationRisk}}" class="alert-note">当前确认人数不足，成局有风险。</view>
    <view wx:if="{{event.reviewStatus === 'PENDING'}}" class="alert-note">活动内容正在人工审核；通过前不开放新报名或分享。</view>
    <view wx:if="{{event.reviewStatus === 'REJECTED'}}" class="alert-note">活动内容未通过审核；主办方修改后可重新提交。</view>
