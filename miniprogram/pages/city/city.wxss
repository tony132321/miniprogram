page { background: #faf8fe; color: #1a1b1f; }
.city-page { min-height: 100vh; padding-bottom: 56rpx; box-sizing: border-box; }
.safe-area { width: 100%; }
.city-nav { height: 96rpx; padding: 0 200rpx 0 22rpx; display: flex; align-items: center; gap: 8rpx; position: relative; box-sizing: border-box; background: rgba(250,248,254,.96); box-shadow: 0 2rpx 10rpx rgba(28,41,61,.025); }
.city-nav button { flex: none; margin: 0; padding: 0; background: transparent; color: #1a1b1f; }
.city-nav button::after,.search-clear::after,.relocate-hint::after,.popular::after,.city-row::after,.missing-city button::after,.alphabet-rail button::after { border: 0; }
.nav-back { width: 64rpx; height: 68rpx; line-height: 62rpx; text-align: left; font-size: 52rpx; }
.nav-title { position: absolute; left: 70rpx; right: 160rpx; text-align: center; pointer-events: none; font-size: 27rpx; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nav-options { width: 53rpx; height: 64rpx; line-height: 52rpx; margin-left: auto!important; font-size: 31rpx; }
.city-nav .nav-profile { width: 54rpx; height: 54rpx; line-height: 54rpx; border-radius: 50%; background: #004cc8; color: #fff; text-align: center; font-size: 31rpx; }
.city-content { padding: 10rpx 32rpx 0; }
.search-wrap { height: 88rpx; background: #e9e7ed; border-radius: 22rpx; display: flex; align-items: center; gap: 13rpx; padding: 0 22rpx; box-sizing: border-box; }
.search-icon { color: #737687; font-size: 39rpx; line-height: 1; }
.search-input { flex: 1; width: 0; font-size: 25rpx; color: #1a1b1f; }
.search-clear { width: 42rpx; height: 42rpx; padding: 0; border-radius: 50%; background: #d8d9df; color: #424655; line-height: 37rpx; font-size: 34rpx; }
.current-card { margin-top: 19rpx; padding: 22rpx 24rpx; background: #fff; border-radius: 22rpx; box-shadow: 0 8rpx 26rpx rgba(28,41,61,.045); }
.current-heading { display: flex; align-items: center; gap: 7rpx; color: #424655; font-size: 22rpx; font-weight: 700; }
.location-mark { color: #1d64f2; font-size: 28rpx; line-height: 1; }
.relocate-hint { margin-left: auto; color: #1d64f2; font-size: 21rpx; line-height: 36rpx; height: 36rpx; }
.current-main { margin-top: 15rpx; display: flex; align-items: center; gap: 12rpx; }
.current-name { font-size: 43rpx; font-weight: 800; line-height: 1.2; }
.selected-tag { background: #ebf9f0; color: #1f9a49; padding: 4rpx 11rpx; border-radius: 99rpx; font-size: 19rpx; font-weight: 700; }
.current-pin { margin-left: auto; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 50%; background: #ebf2fe; color: #1d64f2; font-size: 30rpx; }
.current-help { display: flex; align-items: center; gap: 9rpx; margin-top: 18rpx; color: #737687; font-size: 19rpx; line-height: 1.35; }
.green-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #34c759; flex: none; }
.city-tip { display: flex; align-items: center; gap: 15rpx; margin-top: 20rpx; padding: 18rpx; border-radius: 20rpx; background: linear-gradient(100deg,#ebf2fe,#f2f1fd,#fff); }
.tip-orb { flex: none; width: 58rpx; height: 58rpx; line-height: 58rpx; text-align: center; border-radius: 50%; background: #fff; color: #5856d6; font-size: 34rpx; box-shadow: 0 0 16rpx rgba(88,86,214,.18); }
.tip-copy { flex: 1; min-width: 0; }
.tip-title { font-size: 23rpx; font-weight: 750; }
.tip-badge { display: inline-block; margin-left: 6rpx; border-radius: 5rpx; background: #fff0f3; color: #ff2d55; padding: 2rpx 5rpx; font-size: 15rpx; }
.tip-caption { font-size: 19rpx; color: #636879; margin-top: 3rpx; line-height: 1.3; }
.tip-arrow { color: #858998; font-size: 30rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx; margin-top: 34rpx; margin-bottom: 15rpx; font-size: 28rpx; font-weight: 750; }
.section-hint { color: #858998; font-size: 19rpx; font-weight: 400; }
.popular-grid { display: flex; flex-wrap: wrap; gap: 13rpx; }
.popular { position: relative; width: calc((100% - 39rpx) / 4); height: 83rpx; margin: 0; padding: 0; border-radius: 19rpx; background: #fff; color: #1a1b1f; font-size: 23rpx; font-weight: 650; box-shadow: 0 5rpx 16rpx rgba(28,41,61,.04); line-height: 83rpx; }
.popular.active { background: #1d64f2; color: #fff; box-shadow: 0 8rpx 20rpx rgba(29,100,242,.23); }
.selected-corner { position: absolute; right: -3rpx; top: -3rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #d2f803; border: 3rpx solid #faf8fe; }
.list-heading { margin-top: 42rpx; }
.city-group,.search-results { overflow: hidden; margin-bottom: 23rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(28,41,61,.035); }
.group-letter { height: 47rpx; line-height: 47rpx; padding: 0 23rpx; background: #f4f3f8; color: #1d64f2; font-size: 22rpx; font-weight: 800; }
.city-row { width: calc(100% - 40rpx); height: 88rpx; margin: 0 20rpx; padding: 0; border-radius: 0; background: #fff; border-bottom: 1rpx solid #efedf3; display: flex; justify-content: space-between; align-items: center; text-align: left; line-height: normal; }
.city-row:last-child { border-bottom: 0; }
.city-label { display: flex; align-items: center; gap: 9rpx; min-width: 0; }
.city-name,.search-city-name { font-size: 25rpx; color: #1a1b1f; }
.search-city-name { color: #1d64f2; }
.city-badge { font-size: 17rpx; color: #5856d6; background: #f2f1fd; padding: 3rpx 8rpx; border-radius: 8rpx; }
.city-badge.lime { color: #4d5d00; background: #f3fee7; }
.city-check { font-size: 21rpx; color: #1d64f2; font-weight: 800; }
.province { color: #858998; font-size: 19rpx; }
.province.selected { color: #1d64f2; }
.empty { border-radius: 22rpx; padding: 60rpx 25rpx; background: #fff; color: #737687; text-align: center; }
.empty-icon { display: block; color: #737687; font-size: 62rpx; margin-bottom: 10rpx; }
.empty view { color: #1a1b1f; font-size: 28rpx; font-weight: 700; }
.empty text:last-child { font-size: 20rpx; }
.missing-city { margin-top: 26rpx; padding: 28rpx 20rpx 32rpx; background: #f4f3f8; border-radius: 24rpx; text-align: center; }
.missing-icon { width: 60rpx; height: 60rpx; line-height: 60rpx; margin: 0 auto 10rpx; border-radius: 50%; background: #fff; color: #1d64f2; font-size: 30rpx; }
.missing-title { font-size: 25rpx; font-weight: 750; }
.missing-copy { color: #737687; font-size: 19rpx; line-height: 1.4; margin: 9rpx 0 17rpx; }
.missing-city button { display: inline-block; height: 47rpx; line-height: 47rpx; padding: 0 20rpx; border-radius: 99rpx; background: #fff; color: #1d64f2; font-size: 19rpx; font-weight: 700; }
.alphabet-rail { position: fixed; z-index: 5; right: 4rpx; top: 45%; transform: translateY(-20%); padding: 7rpx 3rpx; border-radius: 99rpx; background: rgba(255,255,255,.78); box-shadow: 0 3rpx 16rpx rgba(28,41,61,.07); }
.alphabet-rail button { display: block; width: 29rpx; height: 29rpx; line-height: 29rpx; padding: 0; margin: 0; background: transparent; color: #424655; font-size: 17rpx; font-weight: 600; }
