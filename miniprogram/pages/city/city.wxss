page { background:#faf8fe; color:#1a1b1f; }
.city-page { min-height:100vh; padding-bottom:calc(96rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.safe-area { width:100%; }
.city-status { position:fixed; top:0; right:0; left:0; z-index:51; background:#faf8fe; pointer-events:none; }
.city-nav { position:sticky; z-index:50; box-sizing:border-box; height:112rpx; display:flex; align-items:center; gap:16rpx; padding-left:32rpx; background:rgba(250,248,254,.85); backdrop-filter:blur(48rpx); box-shadow:0 2rpx 16rpx rgba(0,0,0,.03); }
.city-nav button { box-sizing:border-box; flex:none; display:flex; align-items:center; justify-content:center; min-width:0; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:#1a1b1f; }
.city-nav button::after,.search-clear::after,.relocate-hint::after,.popular::after,.city-row::after,.missing-city button::after,.alphabet-rail button::after { border:0; }
.city-nav .nav-back { width:88rpx; height:88rpx; margin-left:-8rpx; justify-content:flex-start; }
.nav-back image { width:48rpx; height:48rpx; }
.nav-title { flex:1; min-width:0; padding:0 8rpx; text-align:center; pointer-events:none; font-size:34rpx; line-height:44rpx; font-weight:600; letter-spacing:-.34rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.nav-actions { display:flex; flex:none; align-items:center; gap:8rpx; }
.city-nav .nav-options { width:88rpx; height:88rpx; margin-right:-8rpx; }
.nav-options image { width:44rpx; height:44rpx; }
.city-nav .nav-profile { width:64rpx; height:64rpx; margin-left:8rpx; border-radius:50%; background:#004cc8; }
.nav-profile image { width:36rpx; height:36rpx; }
.city-search-sticky { position:sticky; z-index:45; padding:8rpx 32rpx 16rpx; background:rgba(250,248,254,.9); backdrop-filter:blur(48rpx); }
.search-wrap { position:relative; height:88rpx; }
.search-icon { position:absolute; z-index:1; left:24rpx; top:24rpx; width:40rpx; height:40rpx; pointer-events:none; }
.search-input { box-sizing:border-box; width:100%; height:88rpx; padding:0 80rpx; border-radius:24rpx; background:#e9e7ed; color:#1a1b1f; font-size:30rpx; line-height:42rpx; }
.search-input:focus { background:#fff; box-shadow:0 8rpx 32rpx rgba(29,100,242,.12); }
.search-clear { position:absolute; right:16rpx; top:16rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:56rpx; height:56rpx; margin:0; padding:0; border-radius:50%; background:#e3e2e7; }
.search-clear image { width:32rpx; height:32rpx; }
.city-content { padding:0 32rpx; }
.city-browse { display:flex; flex-direction:column; gap:32rpx; margin-top:8rpx; }
.current-card { padding:24rpx; background:#fff; border-radius:24rpx; box-shadow:0 8rpx 40rpx -4rpx rgba(28,41,61,.05); }
.current-heading,.current-label { display:flex; align-items:center; gap:8rpx; color:#424655; font-size:26rpx; line-height:32rpx; font-weight:600; }
.current-heading { justify-content:space-between; }
.location-mark { flex:none; width:36rpx; height:36rpx; }
.relocate-hint { display:flex; align-items:center; gap:8rpx; min-width:0; margin:0; padding:0; background:transparent; color:#1d64f2; font-size:26rpx; line-height:32rpx; font-weight:600; }
.relocate-hint image { width:32rpx; height:32rpx; }
.current-main { margin-top:24rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.current-city { display:flex; align-items:center; gap:8rpx; min-width:0; }
.current-name { font-size:44rpx; line-height:56rpx; font-weight:700; letter-spacing:-.88rpx; }
.selected-tag { flex:none; background:#ebf9f0; color:#34c759; padding:4rpx 16rpx; border-radius:999rpx; font-size:22rpx; line-height:28rpx; font-weight:700; letter-spacing:.44rpx; }
.current-pin { flex:none; display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:50%; background:#ebf2fe; }
.current-pin image { width:40rpx; height:40rpx; }
.current-help { display:flex; align-items:center; gap:8rpx; margin-top:16rpx; padding-top:8rpx; color:#737687; font-size:26rpx; line-height:36rpx; }
.current-help > text:last-child { flex:1; min-width:0; }
.green-dot { width:12rpx; height:12rpx; border-radius:50%; background:#34c759; flex:none; }
.city-tip { display:flex; align-items:center; gap:16rpx; padding:24rpx; border-radius:24rpx; background:linear-gradient(to right,#ebf2fe,#f2f1fd,#fff); }
.tip-orb { flex:none; display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:50%; background:#fff; box-shadow:0 0 24rpx rgba(88,86,214,.25); }
.tip-orb image { width:36rpx; height:36rpx; }
.tip-copy { flex:1; min-width:0; }
.tip-title { display:flex; align-items:center; gap:8rpx; color:#1a1b1f; font-size:26rpx; line-height:32rpx; font-weight:600; }
.tip-badge { flex:none; border-radius:999rpx; background:#fff0f3; color:#ff2d55; padding:4rpx 12rpx; font-size:22rpx; line-height:28rpx; font-weight:700; letter-spacing:.44rpx; }
.tip-caption { color:#424655; font-size:26rpx; line-height:36rpx; }
.tip-arrow { flex:none; width:36rpx; height:36rpx; }
.popular-section { display:flex; flex-direction:column; gap:16rpx; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:8rpx; font-size:34rpx; line-height:44rpx; font-weight:600; letter-spacing:-.34rpx; }
.section-hint { flex:none; color:#737687; font-size:26rpx; line-height:36rpx; font-weight:400; letter-spacing:0; }
.popular-grid { display:flex; flex-wrap:wrap; gap:24rpx; }
.popular { position:relative; width:calc((100% - 72rpx) / 4); height:88rpx; display:flex; align-items:center; justify-content:center; margin:0; padding:0; border-radius:24rpx; background:#fff; color:#1a1b1f; font-size:30rpx; line-height:40rpx; font-weight:600; box-shadow:0 4rpx 16rpx rgba(28,41,61,.04); overflow:visible; }
.popular.active { background:#1d64f2; color:#fff; box-shadow:0 8rpx 32rpx rgba(29,100,242,.3); }
.selected-corner { position:absolute; right:-8rpx; top:-8rpx; width:20rpx; height:20rpx; border-radius:50%; background:#d2f803; box-shadow:0 0 0 4rpx #faf8fe; }
.city-list { display:flex; flex-direction:column; gap:24rpx; margin-top:8rpx; }
.city-group,.search-results { overflow:hidden; border-radius:24rpx; background:#fff; box-shadow:0 4rpx 24rpx rgba(28,41,61,.03); }
.group-letter { padding:8rpx 24rpx; background:#f4f3f8; color:#1d64f2; font-size:30rpx; line-height:40rpx; font-weight:700; }
.city-row { position:relative; box-sizing:border-box; width:100%; height:96rpx; margin:0; padding:0 24rpx; border:0; border-radius:0; background:#fff; display:flex; justify-content:space-between; align-items:center; text-align:left; line-height:normal; font-weight:400; }
.city-divider { height:2rpx; margin-left:24rpx; background:#efedf3; }
.city-label { display:flex; align-items:center; gap:8rpx; min-width:0; }
.city-name,.search-city-name { font-size:30rpx; line-height:42rpx; font-weight:400; color:#1a1b1f; }
.city-badge { font-size:22rpx; line-height:28rpx; font-weight:700; letter-spacing:.44rpx; color:#5856d6; background:#f2f1fd; padding:4rpx 12rpx; border-radius:999rpx; }
.city-badge.lime { color:#4d5d00; background:#f3fee7; }
.city-check,.search-place { flex:none; width:36rpx; height:36rpx; }
.province { flex:none; color:#737687; font-size:22rpx; line-height:28rpx; font-weight:700; letter-spacing:.44rpx; }
.province.selected { color:#1d64f2; font-weight:600; }
.city-search-state { min-height:600rpx; padding:16rpx 0; }
.search-pinyin { text-transform:uppercase; }
.empty { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:128rpx 0; color:#737687; text-align:center; }
.empty-icon { width:88rpx; height:88rpx; margin-bottom:16rpx; }
.empty-title { color:#1a1b1f; font-size:34rpx; line-height:44rpx; font-weight:600; letter-spacing:-.34rpx; }
.empty-copy { margin-top:8rpx; font-size:26rpx; line-height:36rpx; }
.missing-city { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; margin-top:16rpx; margin-bottom:32rpx; padding:32rpx; background:#f4f3f8; border-radius:24rpx; text-align:center; }
.missing-icon { flex:none; display:flex; align-items:center; justify-content:center; width:80rpx; height:80rpx; border-radius:50%; background:#fff; box-shadow:0 2rpx 4rpx rgba(0,0,0,.05); }
.missing-icon image { width:44rpx; height:44rpx; }
.missing-title { font-size:34rpx; line-height:44rpx; font-weight:600; letter-spacing:-.34rpx; }
.missing-copy { max-width:540rpx; color:#737687; font-size:26rpx; line-height:36rpx; }
.missing-city button { display:flex; align-items:center; gap:8rpx; height:72rpx; margin:8rpx 0 0; padding:0 24rpx; border-radius:999rpx; background:#fff; color:#1d64f2; font-size:26rpx; line-height:32rpx; font-weight:600; box-shadow:0 2rpx 4rpx rgba(0,0,0,.05); }
.missing-city button image { width:32rpx; height:32rpx; }
.alphabet-rail { position:fixed; z-index:40; right:8rpx; bottom:160rpx; box-sizing:border-box; width:72rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:16rpx 8rpx; pointer-events:none; }
.alphabet-pill { display:flex; flex-direction:column; align-items:center; gap:8rpx; padding:8rpx; border-radius:999rpx; background:rgba(255,255,255,.65); backdrop-filter:blur(24rpx); box-shadow:0 4rpx 20rpx rgba(0,0,0,.06); pointer-events:auto; }
.alphabet-pill button { display:flex; align-items:center; justify-content:center; width:40rpx; height:40rpx; padding:0; margin:0; background:transparent; color:#424655; font-size:22rpx; line-height:28rpx; font-weight:700; letter-spacing:.44rpx; }
