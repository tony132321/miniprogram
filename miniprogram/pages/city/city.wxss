page { background: #faf8fe; color: #1a1b1f; }
.city-page { min-height: 100vh; padding-bottom: 72rpx; box-sizing: border-box; }
.safe-area { width: 100%; }
.city-nav { height: 96rpx; padding: 0 188rpx 0 32rpx; display: flex; align-items: center; position: relative; box-sizing: border-box; background: rgba(250,248,254,.96); }
.nav-back { width: 72rpx; height: 72rpx; line-height: 60rpx; text-align: left; padding: 0; background: transparent; color: #20232c; font-size: 54rpx; flex: none; }
.nav-back::after,.search-clear::after,.popular::after,.city-row::after { border: 0; }
.nav-title { position: absolute; left: 0; right: 144rpx; top: 0; height: 96rpx; line-height: 96rpx; font-size: 30rpx; font-weight: 750; text-align: center; pointer-events: none; }
.city-content { padding: 8rpx 32rpx 0; }
.search-wrap { height: 88rpx; background: #e9e7ed; border-radius: 22rpx; display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; box-sizing: border-box; }
.search-icon { color: #737687; font-size: 42rpx; line-height: 1; }
.search-input { flex: 1; width: 0; font-size: 26rpx; color: #1a1b1f; }
.search-clear { width: 46rpx; height: 46rpx; padding: 0; border-radius: 50%; background: #d8d9df; color: #424655; line-height: 40rpx; font-size: 36rpx; }
.current-card { margin-top: 22rpx; padding: 24rpx; background: #fff; border-radius: 22rpx; box-shadow: 0 8rpx 26rpx rgba(28,41,61,.045); }
.current-heading { display: flex; align-items: center; gap: 8rpx; color: #424655; font-size: 23rpx; font-weight: 700; }
.location-mark { color: #1d64f2; font-size: 29rpx; line-height: 1; }
.current-main { margin-top: 17rpx; display: flex; align-items: center; gap: 14rpx; }
.current-name { font-size: 45rpx; font-weight: 800; line-height: 1.25; }
.selected-tag { background: #ebf9f0; color: #1f9a49; padding: 4rpx 12rpx; border-radius: 99rpx; font-size: 20rpx; font-weight: 700; }
.current-pin { margin-left: auto; width: 58rpx; height: 58rpx; line-height: 58rpx; text-align: center; border-radius: 50%; background: #ebf2fe; color: #1d64f2; font-size: 30rpx; }
.current-help { display: flex; align-items: center; gap: 9rpx; margin-top: 20rpx; color: #737687; font-size: 21rpx; }
.green-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #34c759; }
.city-tip { display: flex; align-items: center; gap: 16rpx; margin-top: 19rpx; padding: 19rpx; border-radius: 20rpx; background: linear-gradient(100deg,#ebf2fe,#f2f1fd,#fff); }
.tip-orb { flex: none; width: 58rpx; height: 58rpx; line-height: 58rpx; text-align: center; border-radius: 50%; background: #fff; color: #5856d6; font-size: 35rpx; box-shadow: 0 0 16rpx rgba(88,86,214,.18); }
.tip-copy { min-width: 0; }
.tip-title { font-size: 24rpx; font-weight: 750; }
.tip-caption { font-size: 20rpx; color: #636879; margin-top: 3rpx; line-height: 1.3; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx; margin-top: 35rpx; margin-bottom: 16rpx; font-size: 29rpx; font-weight: 750; }
.section-hint { color: #858998; font-size: 20rpx; font-weight: 400; }
.popular-grid { display: flex; flex-wrap: wrap; gap: 13rpx; }
.popular { position: relative; width: calc((100% - 39rpx) / 4); height: 84rpx; margin: 0; padding: 0; border-radius: 20rpx; background: #fff; color: #1a1b1f; font-size: 24rpx; font-weight: 650; box-shadow: 0 5rpx 16rpx rgba(28,41,61,.04); line-height: 84rpx; }
.popular.active { background: #1d64f2; color: #fff; box-shadow: 0 8rpx 20rpx rgba(29,100,242,.23); }
.selected-corner { position: absolute; right: -3rpx; top: -3rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #d2f803; border: 3rpx solid #faf8fe; }
.list-heading { margin-top: 38rpx; }
.city-group { overflow: hidden; margin-bottom: 20rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(28,41,61,.035); }
.group-letter { height: 48rpx; line-height: 48rpx; padding: 0 23rpx; background: #f4f3f8; color: #1d64f2; font-size: 22rpx; font-weight: 800; }
.city-row { width: calc(100% - 40rpx); height: 88rpx; margin: 0 20rpx; padding: 0; border-radius: 0; background: #fff; border-bottom: 1rpx solid #efedf3; display: flex; justify-content: space-between; align-items: center; text-align: left; line-height: normal; }
.city-row:last-child { border-bottom: 0; }
.city-name { font-size: 26rpx; color: #1a1b1f; }
.province { color: #858998; font-size: 21rpx; }
.empty { border-radius: 22rpx; padding: 50rpx 25rpx; background: #fff; color: #737687; text-align: center; font-size: 23rpx; }
