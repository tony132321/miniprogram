    </view>

    <view wx:if="{{stateView}}" class="state-feed-foot state-feed-{{activeTab}}"><view class="reference-footer-symbol"><image wx:if="{{activeTab === 'pending'}}" src="./assets/w70-check_circle-f0-737687.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{activeTab === 'organized'}}" src="./assets/w70-verified-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><block wx:elif="{{activeTab === 'history'}}"><view class="reference-footer-line"></view><image class="reference-footer-heart" src="./assets/w70-favorite-f1-ff2d55.svg" mode="aspectFit" aria-hidden="true" /><view class="reference-footer-line"></view></block><block wx:else>{{activeTab === 'history' ? '♡' : '✦'}}</block></view><text wx:if="{{activeTab === 'history'}}" class="history-footer-quote">“Every moment outside was worth it.”</text><text>{{activeTab === 'pending' ? '以上是当前需要你关注的活动' : activeTab === 'organized' ? '好的活动，让普通的日子发光' : activeTab === 'history' ? '把真实的相聚，变成往后闪闪发光的回忆' : '协办事项以每场活动当前授权为准'}}</text><text wx:if="{{activeTab === 'organized'}}" class="reference-footer-caption">More People · Brighter Days</text></view>
    <view wx:if="{{!stateView}}">
    <view class="section-heading discover-heading"><view><text class="section-mark">⌖</text><text>看看更多可能</text></view><button class="section-link" bindtap="goDiscover">去发现　›</button></view>
    <view class="discovery-preview"><view class="preview-cover"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><view class="preview-shade"></view><text class="preview-poster">Good People Better Days</text></view><view class="preview-body"><view class="preview-title">公开找局暂未开放</view><view class="preview-copy">目前通过朋友邀请加入活动；也可以自己发起一场。</view><button bindtap="goDiscover" class="preview-action">了解当前状态　→</button></view></view>

    <view class="invite-panel"><view class="invite-title">收到朋友的邀请？</view><view class="invite-copy">输入邀请口令，打开对应的真实活动。</view><view class="invite-row"><input placeholder="输入邀请口令" value="{{tokenInput}}" bindinput="tokenChanged" /><button bindtap="openInvite">打开邀请</button></view><view wx:if="{{message}}" class="invite-message">{{message}}</view></view>
    <view class="home-foot"><view>GOOD PEOPLE · REAL MEETUPS · BRIGHTER DAYS</view><view>耍起 CAPER · 让有趣的事，真的发生</view><view class="home-foot-links"><button bindtap="goAbout">关于我们</button><text>·</text><button bindtap="goPrivacy">隐私政策</button><text>·</text><button bindtap="goSupport">联系我们</button></view></view>
