<view class="home-page {{stateView ? 'state-view' : 'ordinary-view'}} {{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history' ? 'home-state-reference home-state-' + activeTab : ''}}">
  <view class="home-status-shield" style="height: {{statusBarHeight}}px"></view>
  <view class="safe-area" style="height: {{statusBarHeight}}px"></view>
  <view class="home-header" style="top: {{statusBarHeight}}px; padding-right: {{headerPaddingRight}}">
    <view wx:if="{{!stateView}}" class="brand"><view class="brand-mark">⁂</view><view class="brand-word"><text class="brand-cn">耍起</text><text class="brand-en">CAPER</text></view></view>
    <view wx:else class="state-brand"><view class="state-brand-mark"><block wx:if="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history'}}"><image class="state-brand-icon" src="./assets/w70-auto_awesome-f0-004cc8.svg" mode="aspectFit" aria-hidden="true" /></block><block wx:else>✦</block></view><text>Home Feed</text></view>
    <button wx:if="{{!stateView}}" class="city-chip" bindtap="goCity" aria-label="选择城市"><text class="city-pin">📍</text><text>{{city}}</text><image class="city-chevron" src="./assets/city-chevron.svg" mode="aspectFit" aria-hidden="true"/></button>
    <view class="header-space"></view>
    <button class="header-round" bindtap="goMessages" aria-label="查看消息"><image wx:if="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history'}}" class="reference-header-bell" src="./assets/w70-notifications-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><image wx:else class="header-bell-image" src="./assets/notification-bell.svg" mode="aspectFit" aria-hidden="true"/><view wx:if="{{unreadTotal > 0}}" class="header-unread-dot"></view></button>
    <button class="header-avatar" bindtap="goProfile" aria-label="进入我的页面"><image wx:if="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history'}}" class="reference-header-person" src="./assets/w70-person-f0-ffffff.svg" mode="aspectFit" aria-hidden="true"/><view wx:else class="avatar-glyph"></view></button>
  </view>

  <view class="home-main {{stateView ? 'state-main' : ''}}">
    <view wx:if="{{!stateView}}" class="caper-top">
    <view class="home-reference-core">
    <view class="hero">
      <view class="hero-sticker"><view class="hero-sticker-dot"></view><text>Good People More Plans</text></view>
      <view class="hero-content">
      <view class="hero-kicker">More People, Brighter Days ☺</view>
      <view class="hero-title">今晚想要什么？</view>
      <view class="hero-subtitle">一句话开始，本地助手整理活动草稿</view>
      <view class="hero-search"><image class="hero-search-icon" src="./assets/microphone.svg" mode="aspectFit" aria-hidden="true"/><input class="hero-search-input" value="{{heroIdeaText}}" bindinput="heroIdeaInput" bindconfirm="submitHeroIdea" confirm-type="go" maxlength="300" placeholder="比如：周六和朋友打场羽毛球..." placeholder-style="color:#8f98a2" aria-label="输入活动想法"/><button class="hero-arrow" bindtap="submitHeroIdea" aria-label="用这句话开始构思"><image class="hero-arrow-image" src="./assets/idea-arrow.svg" mode="aspectFit" aria-hidden="true"/></button></view>
      </view>
    </view>

    <scroll-view class="category-strip" scroll-x="true" show-scrollbar="false"><view class="category-row"><button wx:for="{{categoryIdeas}}" wx:key="label" class="category-card" data-label="{{item.label}}" bindtap="openCategory" aria-label="查看{{item.label}}活动灵感"><view class="category-bubble {{item.tone}}">{{index === 2 ? '🍸' : item.icon}}</view><text class="category-name">{{item.label}}</text></button></view></scroll-view>
    <view wx:if="{{availabilityMessage}}" class="availability-message">{{availabilityMessage}}</view>

    <button wx:if="{{featuredItem}}" class="feature-card" data-id="{{featuredItem.id}}" bindtap="openEvent" aria-label="查看{{featuredItem.title}}活动详情">
      <view class="feature-cover"><image class="feature-image" src="{{featuredItem.cover}}" mode="aspectFill" /><view class="feature-shade"></view><view class="feature-top"><text class="feature-badge">🏸 运动</text><view class="feature-top-arrow"><image src="./assets/feature-chevron.svg" mode="aspectFit" aria-hidden="true"/></view></view><view class="feature-poster"><text class="feature-display">{{featuredItem.posterWord}}</text><text class="feature-tagline">Same Game & New Friends</text></view></view>
      <view class="feature-detail"><view class="feature-detail-head"><text class="feature-detail-title">{{featuredItem.title}}</text><text class="feature-status feature-status-{{featuredItem.status}}">{{featuredItem.statusLabel}}</text></view><view class="feature-detail-facts"><view class="feature-detail-meta"><image src="./assets/calendar.svg" mode="aspectFit" aria-hidden="true"/><text>{{featuredItem.dateLabel}}</text></view><view class="feature-detail-meta"><image src="./assets/map-pin.svg" mode="aspectFit" aria-hidden="true"/><text>{{featuredItem.venueName || '场地信息请到活动详情查看'}}</text></view></view><view wx:if="{{featuredItem.capacityLabel}}" class="feature-attendance"><view class="feature-attendance-markers"><text>✦</text><text>✦</text><text>✦</text></view><text class="feature-attendance-count">{{featuredItem.capacityLabel}}</text></view><view class="feature-detail-foot {{featuredItem.capacityLabel ? 'feature-detail-foot-with-count' : ''}}"><text>配图仅作示意 · 以详情为准</text><text class="feature-detail-action">查看详情　→</text></view></view>
    </button>
    <button wx:else class="feature-card" bindtap="goCreate" aria-label="发起一场真实活动">
      <view class="feature-cover"><image class="feature-image" src="/assets/stitch/caper_home_badminton.jpg" mode="aspectFill" /><view class="feature-shade"></view><view class="feature-top"><text class="feature-badge">🏸 发起灵感</text><view class="feature-top-arrow"><image src="./assets/feature-chevron.svg" mode="aspectFit" aria-hidden="true"/></view></view><view class="feature-poster"><text class="feature-display">BADMINTON TOGETHER</text><text class="feature-tagline">Same Game & New Friends</text></view></view>
      <view class="feature-detail"><view class="feature-detail-head"><text class="feature-detail-title">让有趣的事，真的发生</text><text class="feature-status feature-status-idea">从想法开始</text></view><view class="feature-detail-facts"><view class="feature-detail-meta"><image src="./assets/calendar.svg" mode="aspectFit" aria-hidden="true"/><text>发起你的第一场真实活动</text></view><view class="feature-detail-meta"><image src="./assets/map-pin.svg" mode="aspectFit" aria-hidden="true"/><text>时间、场地与规则由你填写并确认</text></view></view><view class="feature-detail-foot"><text>这是一张发起灵感卡</text><text class="feature-detail-action">去发起　→</text></view></view>
    </button>
    </view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>活动灵感</text></view><button class="section-link" bindtap="goCreate">去发起　›</button></view>
    <view class="inspiration-grid">
      <button class="inspiration-card" data-title="周末聚餐" bindtap="openInspiration" aria-label="查看美食聚会灵感"><view class="inspiration-cover"><image src="/assets/stitch/caper_home_dinner.jpg" mode="aspectFill" /><text class="inspiration-label">发起灵感</text></view><view class="inspiration-copy"><view class="inspiration-title">周末聚餐 · 好友小聚</view><view class="inspiration-sub">一场好玩的局，从邀请开始</view></view></button>
      <button class="inspiration-card" data-title="户外徒步" bindtap="openInspiration" aria-label="查看徒步活动灵感"><view class="inspiration-cover"><image src="/assets/stitch/caper_home_hiking.jpg" mode="aspectFill" /><text class="inspiration-label">发起灵感</text></view><view class="inspiration-copy"><view class="inspiration-title">走出去，遇见新朋友</view><view class="inspiration-sub">时间、地点与规则由你决定</view></view></button>
    </view>

    <view class="brand-ribbon"><image class="ribbon-image" src="/assets/stitch/pg08_checkin_rooftop.jpg" mode="aspectFill" /><view class="ribbon-shade"></view><view class="ribbon-content"><view class="ribbon-title">让有趣的事，<text>真的发生</text></view><view class="ribbon-kicker">TURN PLANS INTO REAL MEETUPS</view><view class="ribbon-bottom"><text class="ribbon-smile">☺</text><text>Good People Better Days</text></view></view></view>

    <view class="home-long-section"><view class="home-long-head"><text>同城热门灵感</text><button bindtap="goDiscover">查看更多　›</button></view><view class="home-long-note">场景照片仅供构思，不代表附近有公开招募的活动。</view><view class="home-hot-grid">
      <button data-title="网球新手局" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_basketball.jpg" mode="aspectFill"/><text>运动新手局</text><text>发起灵感</text></button>
      <button data-title="咖啡探店" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill"/><text>咖啡探店</text><text>发起灵感</text></button>
      <button data-title="户外轻运动" bindtap="openInspiration"><image src="/assets/stitch/caper_home_hiking.jpg" mode="aspectFill"/><text>户外轻运动</text><text>发起灵感</text></button>
      <button data-title="桌游之夜" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_boardgame.jpg" mode="aspectFill"/><text>桌游之夜</text><text>发起灵感</text></button>
    </view></view>

    <view class="home-long-section home-theme-section"><view class="home-long-head"><text>主题精选</text></view><view class="home-theme-grid">
      <button class="home-theme-amber" data-title="下班快乐局" bindtap="openInspiration"><text>🍹</text><view>下班快乐局<text>轻松认识新朋友 →</text></view></button>
      <button class="home-theme-sky" data-title="周末出逃" bindtap="openInspiration"><text>🏔️</text><view>周末出逃<text>城市周边轻走 →</text></view></button>
      <button class="home-theme-pink" data-title="女生友好" bindtap="openInspiration"><text>♡</text><view>女生友好<text>舒适社交氛围 →</text></view></button>
      <button class="home-theme-green" data-title="新手友好" bindtap="openInspiration"><text>🌱</text><view>新手友好<text>从一场活动开始 →</text></view></button>
    </view></view>

    <view class="home-long-section"><view class="home-long-head"><text>我的活动近况</text><button bindtap="goItinerary">查看行程　›</button></view><view class="home-long-note">只显示与你当前账号有关的活动；附近公开找局暂未开放。</view><scroll-view wx:if="{{homePreviewItems.length > 0}}" scroll-x="true" class="home-personal-scroll" show-scrollbar="false"><view class="home-personal-row"><button wx:for="{{homePreviewItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent" class="home-personal-card"><image src="{{item.cover}}" mode="aspectFill"/><view><text>{{item.title}}</text><text>{{item.dateLabel}}</text><text>{{item.statusLabel}}</text></view></button></view></scroll-view><view wx:else class="home-personal-empty"><text>还没有近期本人活动</text><button bindtap="goCreate">从一场羽毛球活动开始　→</button></view></view>

    <view class="home-long-section"><view class="home-long-head"><text>构思灵感</text><button bindtap="goCreate">去构思　›</button></view><view class="home-long-note">提供本地规则建议；不会按位置或兴趣自动匹配他人的活动。</view><button class="home-idea-banner" bindtap="goCreate"><text>✦</text><text>一句话整理你的羽毛球活动草稿</text><text>›</text></button><view class="home-idea-list">
      <button bindtap="goCreate"><image src="/assets/stitch/caper_home_badminton.jpg" mode="aspectFill"/><view><text>周末羽毛球 · 新手友好</text><text>写想法 → 核对草稿 → 由你发布</text></view></button>
      <button data-title="周末咖啡局" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill"/><view><text>周末咖啡局 · 聊聊最近</text><text>主题示意 · 暂未开放发起</text></view></button>
      <button data-title="城市漫步" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill"/><view><text>城市漫步 · 遇见更多可能</text><text>主题示意 · 暂未开放发起</text></view></button>
    </view></view>

    <view class="home-long-section"><view class="home-long-head"><text>好日子灵感</text><button bindtap="goDiscover">查看更多　›</button></view><view class="home-long-note home-blue-tag"># 耍起现场 · 视觉示意</view><view class="home-photo-collage"><button class="home-photo-main" data-title="朋友相聚" bindtap="openInspiration"><image src="/assets/stitch/caper_home_dinner.jpg" mode="aspectFill"/><text>Same People Real Vibes</text></button><view><button data-title="朋友聚餐" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill"/></button><button data-title="户外相聚" bindtap="openInspiration"><image src="/assets/stitch/caper_home_hiking.jpg" mode="aspectFill"/></button></view><text class="home-photo-sticker">Nice!<text>More People Brighter Days ☺</text></text></view></view>

    <view class="home-long-section"><view class="home-long-head"><text>活动如何运转</text><button bindtap="goAbout">了解更多　›</button></view><view class="home-long-note">以下是当前功能说明，非用户评价或真实活动照片。</view><scroll-view scroll-x="true" class="home-trust-scroll" show-scrollbar="false"><view class="home-trust-row"><button bindtap="goAbout"><text>“</text><text>从朋友邀请进入，或自己发起一场活动；报名和状态以服务端当前记录为准。</text><view>✦　了解当前功能</view></button><button bindtap="goGuidelines"><text>“</text><text>线下见面前核对时间、地点和活动规则；需要帮助时可通过安全入口举报。</text><view>✦　阅读安全守则</view></button></view></scroll-view></view>

    <view class="home-city-banner"><image src="/assets/stitch/caper_home_shanghai.jpg" mode="aspectFill"/><view><text>这座城市<br/>更好玩了</text><text>选好城市偏好，发起真实的线下相聚。</text><button bindtap="goCity">选择城市　→</button><text>Good People Make Better Cities ☺</text></view></view>
    <view class="home-final-cta"><view>💡</view><text>有想法？那就耍起！</text><text>让本地构思助手整理羽毛球草稿，由你确认发布。</text><button bindtap="goCreate">＋　发起一个活动</button><text>GOOD PEOPLE · REAL MEETUPS · BRIGHTER DAYS</text></view>
    </view>

    <button wx:if="{{stateView}}" class="state-ai-banner state-ai-{{activeTab}}" bindtap="goCreate" aria-label="打开活动构思" hover-class="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history' ? 'home-reference-banner-pressed' : 'button-hover'}}"><block wx:if="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history'}}"><view class="reference-banner-glow"></view><view class="reference-banner-pink" wx:if="{{activeTab === 'pending'}}"></view><view class="reference-ai-orb"><view class="reference-ai-orb-inner"><image src="{{activeTab === 'pending' ? './assets/w70-smart_toy-f1-5856d6.svg' : activeTab === 'organized' ? './assets/w70-neurology-f0-ffffff.svg' : './assets/w70-arrow_back_ios_new-f0-ffffff.svg'}}" mode="aspectFit" aria-hidden="true"/></view><view class="reference-ai-status"><view wx:if="{{activeTab === 'pending' || activeTab === 'organized'}}" class="reference-ai-ping"></view><view class="reference-ai-solid"></view></view></view><view class="reference-ai-copy"><view class="reference-ai-heading"><text>{{activeTab === 'history' ? '活动构思助手' : '想组什么局？一句话开始'}}</text><image wx:if="{{activeTab === 'pending'}}" class="reference-heading-arrow" src="./assets/w70-arrow_forward-f0-d2f803.svg" mode="aspectFit" aria-hidden="true"/><image class="reference-heading-spark" src="./assets/w70-auto_awesome-f0-5856d6.svg" mode="aspectFit" aria-hidden="true" wx:elif="{{activeTab === 'organized'}}"/><text wx:else class="reference-ai-tag">本地</text></view><text class="reference-ai-subtitle">{{activeTab === 'history' ? '发起新局，或从已结束活动整理相似草稿' : '本地整理活动草稿，发布前由你确认'}}</text></view><view wx:if="{{activeTab !== 'pending'}}" class="reference-ai-arrow"><image src="{{activeTab === 'organized' ? './assets/w70-arrow_forward-f0-004cc8.svg' : './assets/w70-arrow_forward-f0-ffffff.svg'}}" mode="aspectFit" aria-hidden="true"/></view></block><block wx:else><view class="state-ai-orb">✦</view><view class="state-ai-copy"><view>{{activeTab === 'history' ? '让好活动继续发生' : '想组什么局？一句话开始'}}</view><text>{{activeTab === 'history' ? '发起新局，或在已结束活动中生成相似草稿' : '构思助手整理草稿，发布前由你确认'}}</text></view><view class="state-ai-arrow">→</view></block></button>
    <view wx:if="{{!stateView}}" class="section-heading dashboard-heading"><view><text class="section-mark">✦</text><text>我的活动</text></view><view class="dashboard-links"><button class="section-link" bindtap="goItinerary">我的行程　›</button><button class="section-link" bindtap="goMessages">消息　›</button></view></view>
    <scroll-view scroll-x="true" class="tabs" show-scrollbar="false"><view class="tab-row">
      <button class="tab {{activeTab === 'attending' ? 'selected' : ''}}" data-key="attending" bindtap="selectTab" hover-class="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history' ? 'home-reference-tab-pressed' : 'button-hover'}}">即将参加 <text>{{attending.length}}</text></button>
      <button class="tab {{activeTab === 'pending' ? 'selected' : ''}}" data-key="pending" bindtap="selectTab" hover-class="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history' ? 'home-reference-tab-pressed' : 'button-hover'}}">待确认 <text>{{pending.length}}</text></button>
      <button class="tab {{activeTab === 'organized' ? 'selected' : ''}}" data-key="organized" bindtap="selectTab" hover-class="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history' ? 'home-reference-tab-pressed' : 'button-hover'}}">我组织的 <text>{{organized.length}}</text></button>
      <button class="tab {{activeTab === 'cohosting' ? 'selected' : ''}}" data-key="cohosting" bindtap="selectTab" hover-class="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history' ? 'home-reference-tab-pressed' : 'button-hover'}}">协办 <text>{{cohosting.length}}</text></button>
      <button class="tab {{activeTab === 'history' ? 'selected' : ''}}" data-key="history" bindtap="selectTab" hover-class="{{activeTab === 'pending' || activeTab === 'organized' || activeTab === 'history' ? 'home-reference-tab-pressed' : 'button-hover'}}">历史 <text>{{history.length}}</text></button>
    </view></scroll-view>
    <view wx:if="{{draftsOnly}}" class="draft-list-heading"><view><text class="draft-list-title">我的草稿</text><text class="draft-list-copy">仅显示当前账号尚未发布的活动</text></view><button bindtap="showAllOrganized">查看全部我组织的　›</button></view>
    <view wx:if="{{loadState === 'LOADING'}}" class="state-card">正在加载我的活动…</view>
    <view wx:if="{{loadState === 'ERROR'}}" class="state-card error">{{message}} <button class="retry" bindtap="retry">{{errorCode === 'UNAUTHENTICATED' ? '微信登录' : '重试'}}</button></view>
    <view wx:if="{{loadState === 'READY' && draftsOnly && visibleItems.length === 0}}" class="state-card muted"><view class="empty-icon">✹</view><view class="empty-title">还没有保存的草稿</view><view class="empty-copy">发起活动后保存草稿，就能在这里继续编辑。</view><button class="empty-action" bindtap="goCreate">去发起活动　→</button></view>
    <view wx:if="{{loadState === 'READY' && items.length === 0 && !draftsOnly}}" class="state-card muted"><view class="empty-icon">✹</view><view class="empty-title">下一场相聚，从这里开始</view><view class="empty-copy">暂无活动。可从邀请进入或发起真实活动。</view><button class="empty-action" bindtap="goCreate">发起一个活动　→</button></view>
    <view wx:if="{{loadState === 'READY' && !draftsOnly && visibleItems.length === 0 && items.length > 0}}" class="state-card muted">这个分类里暂时没有活动。</view>
    <view wx:if="{{loadState === 'READY'}}" class="cards">
      <view wx:for="{{visibleItems}}" wx:key="id" class="event-card card-{{item.cardKind}} {{(item.cardKind === 'pending' && (item.myRegistrationStatus === 'REQUESTED' || item.myRegistrationStatus === 'RECONFIRM_REQUIRED' || item.myRegistrationStatus === 'WAITLISTED')) || (item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')) || (item.cardKind === 'history' && item.status === 'COMPLETED') ? 'home-reference-card' : ''}} registration-{{item.myRegistrationStatus}} status-{{item.status}} {{item.primaryAction === 'hostRepeat' ? 'history-repeat-card' : 'history-record-card'}} {{item.primaryAction === 'checkinSection' ? 'history-feedback-card' : ''}}">
        <view wx:if="{{stateView && item.cardKind === 'pending' && item.myRegistrationStatus === 'RECONFIRM_REQUIRED'}}" class="reference-change-band"><image class="reference-glyph" src="./assets/w70-warning-f0-ff2d55.svg" mode="aspectFit" aria-hidden="true" /><text>活动信息有变更，需重新确认参加</text></view>
        <button class="cover-wrap" data-id="{{item.id}}" bindtap="openEvent" aria-label="查看{{item.title || '活动'}}详情"><image class="cover" src="{{activeTab === 'organized' && item.cover === '/assets/stitch/caper_home_badminton.jpg' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS') ? './assets/w70-organized-badminton.jpg' : activeTab === 'history' && item.status === 'COMPLETED' && item.cover === '/assets/stitch/caper_home_badminton.jpg' ? './assets/w70-history-badminton.jpg' : item.cover}}" mode="aspectFill" /><view class="cover-tint"></view><view wx:if="{{stateView && item.cardKind === 'history'}}" class="cover-sticker history-sticker-{{item.historyTone}}"><image wx:if="{{item.status === 'COMPLETED'}}" class="reference-sticker-icon" src="{{item.primaryAction === 'checkinSection' ? './assets/w70-rate_review-f0-ff2d55.svg' : './assets/w70-verified-f0-1a1b1f.svg'}}" mode="aspectFit" aria-hidden="true"/><text>{{item.primaryAction === 'checkinSection' ? '结项反馈' : item.historyStickerLabel}}</text></view><view class="cover-status {{item.coverStatusLabel ? 'cover-status-progress' : ''}} history-cover-status-{{item.historyTone}}"><block wx:if="{{stateView && item.cardKind === 'pending' && (item.myRegistrationStatus === 'REQUESTED' || item.myRegistrationStatus === 'RECONFIRM_REQUIRED' || item.myRegistrationStatus === 'WAITLISTED')}}"><image class="reference-status-icon" src="{{item.myRegistrationStatus === 'RECONFIRM_REQUIRED' ? './assets/w70-edit_calendar-f0-ffffff.svg' : item.myRegistrationStatus === 'WAITLISTED' ? './assets/w70-filter_list-f0-5856d6.svg' : './assets/w70-hourglass_top-f0-181e00.svg'}}" mode="aspectFit" aria-hidden="true"/></block><view wx:elif="{{stateView && ((item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')) || (item.cardKind === 'history' && item.status === 'COMPLETED'))}}" class="reference-status-dot"></view><text>{{item.coverStatusLabel || item.cardLabel}}</text></view><view wx:if="{{activeTab === 'organized' && item.shareReady && item.cover === '/assets/stitch/caper_home_badminton.jpg'}}" class="reference-game-sticker"><text>Good Game!</text><image class="reference-game-icon" src="./assets/w70-sports_tennis-f0-1a1b1f.svg" mode="aspectFit" aria-hidden="true" /></view><view wx:if="{{stateView && item.cardKind === 'history'}}" class="history-cover-copy {{item.feeMode === 'AA' ? 'history-with-fee' : ''}}"><text class="history-cover-date">{{item.historyPosterDateLabel}}</text><text class="history-cover-title">{{item.title || '未命名活动'}}</text></view><view wx:elif="{{stateView}}" class="cover-poster"><text class="cover-poster-word">{{activeTab === 'organized' && item.status === 'CONFIRMED' ? 'CONFIRMED & READY' : activeTab === 'organized' && item.status === 'IN_PROGRESS' ? 'IN PROGRESS' : item.posterWord}}</text><text class="cover-poster-line">{{activeTab === 'organized' ? 'REAL PEOPLE · REAL PLANS' : 'GOOD PEOPLE · REAL PLANS'}}</text></view><view wx:else class="cover-title">{{item.title || '未命名草稿'}}</view><view wx:if="{{stateView && item.cardKind === 'history' && item.feeMode === 'AA'}}" class="history-cover-fee">AA 活动</view><view wx:if="{{stateView}}" class="cover-credit">配图为活动类型示意</view></button>
        <view class="card-body"><view wx:if="{{!stateView || item.cardKind !== 'history'}}" class="card-heading"><text class="card-title">{{item.title || '未命名草稿'}}</text><text class="pill pill-{{item.cardKind}}">{{item.cardKind === 'pending' ? item.registrationLabel : item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS') ? '我主办的' : item.statusLabel}}</text></view><view wx:if="{{stateView && item.cardKind === 'history'}}" class="history-facts"><view class="history-fact history-fact-date"><image wx:if="{{item.status === 'COMPLETED'}}" class="reference-history-icon" src="{{item.primaryAction === 'checkinSection' ? './assets/w70-schedule-f0-1d64f2.svg' : './assets/w70-calendar_today-f0-1d64f2.svg'}}" mode="aspectFit" aria-hidden="true"/><text wx:else class="history-fact-icon">▣</text><text>{{item.dateRangeLabel}}</text></view><view class="history-fact history-fact-place"><image wx:if="{{item.status === 'COMPLETED'}}" class="reference-history-icon" src="{{item.primaryAction === 'checkinSection' ? './assets/w70-pin_drop-f0-5856d6.svg' : './assets/w70-location_on-f0-5856d6.svg'}}" mode="aspectFit" aria-hidden="true"/><text wx:else class="history-fact-icon">⌖</text><text class="history-place-label">{{item.venueLabel}}</text></view></view><view wx:else class="card-meta reference-date-meta"><block wx:if="{{stateView && ((item.cardKind === 'pending' && (item.myRegistrationStatus === 'REQUESTED' || item.myRegistrationStatus === 'RECONFIRM_REQUIRED' || item.myRegistrationStatus === 'WAITLISTED')) || (item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')) || (item.cardKind === 'history' && item.status === 'COMPLETED'))}}"><image class="reference-meta-icon" src="{{item.cardKind === 'pending' && item.myRegistrationStatus === 'WAITLISTED' ? './assets/w70-calendar_month-f0-004cc8.svg' : item.cardKind === 'organized' && (item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS') ? './assets/w70-schedule-f0-004cc8.svg' : './assets/w70-calendar_today-f0-004cc8.svg'}}" mode="aspectFit" aria-hidden="true"/><text>{{item.dateRangeLabel}}</text></block><block wx:else>▣　{{item.dateRangeLabel}}</block></view><view wx:if="{{stateView && item.cardKind !== 'history'}}" class="card-meta reference-place-meta"><block wx:if="{{(item.cardKind === 'pending' && (item.myRegistrationStatus === 'REQUESTED' || item.myRegistrationStatus === 'RECONFIRM_REQUIRED' || item.myRegistrationStatus === 'WAITLISTED')) || (item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')) || (item.cardKind === 'history' && item.status === 'COMPLETED')}}"><image class="reference-meta-icon" src="{{item.cardKind === 'pending' && item.myRegistrationStatus === 'WAITLISTED' ? './assets/w70-storefront-f0-5856d6.svg' : item.cardKind === 'organized' && (item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS') ? './assets/w70-route-f0-5856d6.svg' : './assets/w70-location_on-f0-5856d6.svg'}}" mode="aspectFit" aria-hidden="true"/><text>{{item.venueLabel}}</text></block><block wx:else>⌖　{{item.venueLabel}}</block></view><view wx:if="{{stateView && item.capacityLabel && item.cardKind === 'pending'}}" class="capacity-row">{{item.capacityLabel}}</view>
          <view wx:if="{{stateView && item.cardKind === 'organized' && item.hostCounts}}" class="host-counts"><view><text>{{item.hostCounts.confirmed}}</text><text>已确认</text></view><view><text>{{item.hostCounts.reserved}}</text><text>预留名额</text></view><view><text>{{item.hostCounts.requested}}</text><text>待审核</text></view><view><text>{{item.hostCounts.gap}}</text><text>成局缺口</text></view></view>
          <view wx:if="{{item.cardKind === 'pending'}}" class="card-state pending-state"><view wx:if="{{stateView && item.myRegistrationStatus === 'WAITLISTED'}}" class="reference-notification-orb"><image class="reference-glyph" src="./assets/w70-notifications_active-f0-1d64f2.svg" mode="aspectFit" aria-hidden="true" /></view><image wx:elif="{{stateView && item.myRegistrationStatus === 'RECONFIRM_REQUIRED'}}" class="reference-state-icon" src="./assets/w70-warning-f0-ff2d55.svg" mode="aspectFit" aria-hidden="true"/><text wx:else class="state-icon">!</text><text>{{item.cardNote}}</text></view>
          <view wx:elif="{{item.cardKind === 'organized'}}" class="card-state organized-state"><image wx:if="{{stateView && (item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')}}" class="reference-state-icon" src="./assets/w70-check_circle-f0-4d5d00.svg" mode="aspectFit" aria-hidden="true"/><text wx:else class="state-icon">✦</text><text>{{item.cardNote}}</text></view>
          <view wx:elif="{{item.cardKind === 'history'}}" class="card-state history-state history-state-{{item.historyTone}}"><image wx:if="{{stateView && item.status === 'COMPLETED'}}" class="reference-state-icon" src="./assets/w70-verified-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><text wx:else class="state-icon">{{item.historyStateIcon}}</text><text>{{item.cardNote}}</text></view>
          <view wx:else class="card-note">{{item.isCohost ? '你是协办方 · 点开查看本场权限与安排' : item.cardNote}}</view>
          <button wx:if="{{item.shortcutAction && item.cardKind === 'history'}}" class="card-shortcut" data-id="{{item.id}}" data-action="{{item.shortcutAction}}" bindtap="openCardAction" aria-label="{{item.shortcutLabel}}，进入{{item.title || '活动'}}详情页">{{item.shortcutLabel}}　›</button>
          <view class="card-actions"><button class="card-primary {{item.primaryAction === 'hostRepeat' ? 'card-repeat' : ''}}" data-id="{{item.id}}" data-action="{{item.primaryAction}}" bindtap="openCardAction" hover-class="{{stateView && ((item.cardKind === 'pending' && (item.myRegistrationStatus === 'REQUESTED' || item.myRegistrationStatus === 'RECONFIRM_REQUIRED' || item.myRegistrationStatus === 'WAITLISTED')) || (item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')) || (item.cardKind === 'history' && item.status === 'COMPLETED')) ? 'home-reference-card-pressed' : 'button-hover'}}"><block wx:if="{{stateView && ((item.cardKind === 'pending' && (item.myRegistrationStatus === 'REQUESTED' || item.myRegistrationStatus === 'RECONFIRM_REQUIRED' || item.myRegistrationStatus === 'WAITLISTED')) || (item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')) || (item.cardKind === 'history' && item.status === 'COMPLETED'))}}"><image wx:if="{{item.primaryAction === 'hostRepeat'}}" class="reference-action-icon" src="./assets/w70-auto_awesome-f0-ffffff.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.cardKind === 'history' && item.primaryAction === 'checkinSection'}}" class="reference-action-icon" src="./assets/w70-edit_note-f0-ffffff.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.cardKind === 'organized' && (item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')}}" class="reference-action-icon" src="./assets/w70-tune-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><text>{{item.primaryLabel}}</text><image wx:if="{{item.cardKind === 'organized' && item.shareReady}}" class="reference-action-icon" src="./assets/w70-arrow_forward-f0-ffffff.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.cardKind === 'pending' && item.myRegistrationStatus === 'RECONFIRM_REQUIRED'}}" class="reference-action-icon" src="./assets/w70-check_circle-f0-ffffff.svg" mode="aspectFit" aria-hidden="true"/></block><block wx:else>{{item.primaryLabel}}　→</block></button><button wx:if="{{item.secondaryAction}}" class="card-secondary" data-id="{{item.id}}" data-action="{{item.secondaryAction}}" bindtap="openCardAction" hover-class="{{stateView && ((item.cardKind === 'pending' && (item.myRegistrationStatus === 'REQUESTED' || item.myRegistrationStatus === 'RECONFIRM_REQUIRED' || item.myRegistrationStatus === 'WAITLISTED')) || (item.cardKind === 'organized' && (item.shareReady || item.status === 'CONFIRMED' || item.status === 'IN_PROGRESS')) || (item.cardKind === 'history' && item.status === 'COMPLETED')) ? 'home-reference-card-pressed' : 'button-hover'}}"><image wx:if="{{stateView && item.cardKind === 'organized' && item.secondaryAction === 'hostAnnouncement'}}" class="reference-action-icon" src="./assets/w70-campaign-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{stateView && item.cardKind === 'organized' && item.secondaryAction === 'checkinSection'}}" class="reference-action-icon" src="./assets/w70-qr_code_scanner-f0-ffffff.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{stateView && item.cardKind === 'history' && item.status === 'COMPLETED' && item.secondaryAction === 'expenseSection'}}" class="reference-action-icon" src="./assets/w70-receipt_long-f0-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text>{{item.secondaryLabel}}</text></button><view wx:elif="{{item.cardKind === 'history'}}" class="card-disabled"><image wx:if="{{stateView && item.status === 'COMPLETED'}}" class="reference-action-icon" src="./assets/w70-photo_library-f0-5856d6.svg" mode="aspectFit" aria-hidden="true"/><text>相册未开放</text></view><button wx:if="{{item.shareReady}}" class="card-share" data-id="{{item.id}}" bindtap="openHostShare" aria-label="分享{{item.title}}的邀请" hover-class="{{stateView && item.cardKind === 'organized' ? 'home-reference-card-pressed' : 'button-hover'}}"><image wx:if="{{stateView && item.cardKind === 'organized'}}" class="reference-share-icon" src="./assets/w70-share-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><block wx:else>↗</block></button></view>
          <button wx:if="{{item.shortcutAction && item.cardKind !== 'history'}}" class="card-shortcut" hover-class="{{stateView && item.cardKind === 'pending' && item.myRegistrationStatus === 'WAITLISTED' ? 'home-reference-card-pressed' : 'button-hover'}}" data-id="{{item.id}}" data-action="{{item.shortcutAction}}" bindtap="openCardAction" aria-label="{{item.shortcutLabel}}，进入{{item.title || '活动'}}详情页">{{item.shortcutLabel}}　›</button>
        </view>
