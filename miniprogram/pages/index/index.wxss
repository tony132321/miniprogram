.caper-top .home-reference-core .hero::after { display: none; }
.caper-top .home-reference-core .hero-sticker { display: flex; align-items: center; gap: 6px; right: -12px; top: 8px; padding: 6px 12px; border: 1px solid rgba(255,255,255,.6); border-radius: 16px; color: #1f2937; background: rgba(255,255,255,.9); font-size: 11px; line-height: 16.5px; font-weight: 900; letter-spacing: -.275px; transform: rotate(12deg); backdrop-filter: blur(12px); box-shadow: 0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -2px rgba(0,0,0,.1); }
