.home-long-footer{margin:0 calc(16px - 28rpx);padding:8px 0 24px;color:#9ca3af;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","PingFang SC","Hiragino Sans GB",sans-serif;font-size:10px;line-height:15px;font-weight:400;text-align:center}.home-long-footer .home-footer-brand{display:flex;align-items:center;justify-content:center;gap:4px;margin-bottom:4px}.home-long-footer .home-footer-brand>text:first-child{color:#374151;font-size:14px;line-height:20px;font-weight:900;letter-spacing:-.35px}.home-long-footer .home-footer-brand>text:last-child{color:#1d64f2;font-size:9px;line-height:13.5px;font-weight:800;letter-spacing:.9px}.home-long-footer .home-footer-copy{color:#9ca3af;font-size:10px;line-height:15px;font-weight:400}.home-long-footer .home-foot-links{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:12px;font-size:10px;line-height:15px;font-weight:500}.home-long-footer .home-foot-links button{padding:0;background:transparent;color:#9ca3af;font-size:10px;line-height:15px;font-weight:500}

/* Original interactive CSS roles, scoped to the ordinary long feed. */
.home-long-reference .home-long-gray-hover{color:#4b5563}.home-long-reference .home-hot-grid image,.home-long-reference .home-hot-grid .home-hot-photo{transition-property:color,background-color,border-color,fill,stroke,opacity,box-shadow,transform,filter,-webkit-text-decoration-color,-webkit-backdrop-filter;transition-property:color,background-color,border-color,text-decoration-color,fill,stroke,opacity,box-shadow,transform,filter,backdrop-filter;transition-property:color,background-color,border-color,text-decoration-color,fill,stroke,opacity,box-shadow,transform,filter,backdrop-filter,-webkit-text-decoration-color,-webkit-backdrop-filter;transition-timing-function:cubic-bezier(.4,0,.2,1);transition-duration:150ms}.home-long-reference .home-hot-grid .home-hot-hover image,.home-long-reference .home-hot-grid .home-hot-hover .home-hot-photo{transform:scale(1.05)}.home-long-reference .home-city-banner .home-city-hover{background:#b5e028}.home-long-footer .home-foot-links .home-footer-hover{color:#4b5563}
.home-long-reference .home-long-head .home-long-chevron-hover{display:none}.home-long-reference .home-long-head .home-long-gray-hover .home-long-chevron-default{display:none}.home-long-reference .home-long-head .home-long-gray-hover .home-long-chevron-hover{display:block}

/* Source hot frame is fixed; only the contained source image scales. */
.home-long-reference .home-hot-grid .home-hot-frame{display:block;flex:none;width:100%;height:80px;margin-bottom:6px;overflow:hidden;border-radius:16px;background:#e5e7eb;box-shadow:0 1px 2px 0 rgba(0,0,0,.05)}
