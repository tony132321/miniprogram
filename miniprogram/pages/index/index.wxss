page { background: #f5f7fa; color: #172033; }
.home-page { min-height: 100vh; padding-bottom: 250rpx; box-sizing: border-box; background: #fff; }
.safe-area { width: 100%; background: #fff; }
.home-status-shield { position: fixed; top: 0; left: 0; right: 0; z-index: 12; background: #fff; }
.home-page button { margin: 0; line-height: normal; }
.home-page button::after { border: 0; }
.home-header { position: sticky; z-index: 11; min-height: 92rpx; padding: 0 112px 0 30rpx; box-sizing: border-box; display: flex; align-items: center; gap: 12rpx; background: #fff; }
.brand { display: flex; align-items: center; gap: 7rpx; flex: none; }
.brand-mark { width: 42rpx; height: 42rpx; border-radius: 12rpx; background: linear-gradient(135deg,#d2f803,#1d64f2 55%,#6b21a8); color: #fff; line-height: 42rpx; text-align: center; font-size: 26rpx; font-weight: 900; }
.brand-word { display: flex; flex-direction: column; line-height: 1; }
.brand-cn { font-size: 27rpx; font-weight: 900; white-space: nowrap; letter-spacing: -2rpx; }
.brand-en { font-size: 15rpx; font-weight: 800; color: #1d64f2; letter-spacing: 1rpx; margin-top: 2rpx; }
.city-chip { flex: none; padding: 8rpx 14rpx; border-radius: 99rpx; background: #f3f5f8; color: #172033; font-size: 20rpx; font-weight: 650; white-space: nowrap; }
.header-space { flex: 1; }
.header-round,.header-avatar { width: 48rpx; height: 48rpx; flex: none; border-radius: 50%; text-align: center; line-height: 48rpx!important; font-size: 26rpx; }
.header-round { position: relative; background: #f3f5f8; color: #1d64f2; }
.header-unread-dot { position: absolute; top: 0; right: -2rpx; width: 13rpx; height: 13rpx; box-sizing: border-box; border: 2rpx solid #fff; border-radius: 50%; background: #f43f5e; }
.header-bell { position: relative; display: block; width: 19rpx; height: 21rpx; margin: 11rpx auto 0; box-sizing: border-box; border: 2rpx solid currentColor; border-radius: 11rpx 11rpx 4rpx 4rpx; }
.header-bell::before { content: ''; position: absolute; left: -5rpx; right: -5rpx; bottom: -4rpx; height: 3rpx; border-radius: 3rpx; background: currentColor; }
.header-bell::after { content: ''; position: absolute; left: 5rpx; bottom: -9rpx; width: 5rpx; height: 3rpx; border-radius: 3rpx; background: currentColor; }
.header-avatar { box-sizing: border-box; border: 2rpx solid rgba(29,100,242,.35); background: #0758cb; color: #fff; }
.avatar-glyph { position: relative; display: block; width: 26rpx; height: 29rpx; margin: 9rpx auto 0; }
.avatar-glyph::before { content: ''; position: absolute; top: 1rpx; left: 8rpx; width: 10rpx; height: 10rpx; border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.avatar-glyph::after { content: ''; position: absolute; left: 3rpx; bottom: 1rpx; width: 20rpx; height: 11rpx; border: 2rpx solid currentColor; border-radius: 10rpx 10rpx 4rpx 4rpx; box-sizing: border-box; }
.home-main { padding: 0 28rpx; }
.hero { position: relative; overflow: hidden; min-height: 208rpx; margin-top: 8rpx; padding: 25rpx 24rpx 22rpx; border-radius: 28rpx; box-sizing: border-box; background: linear-gradient(118deg,#d2f803 0%,#c9f542 39%,#b9eec9 68%,#91bfff 100%); }
.hero::after { content: ''; position: absolute; width: 220rpx; height: 220rpx; right: -110rpx; bottom: -140rpx; background: rgba(29,100,242,.3); border-radius: 50%; filter: blur(28rpx); }
.hero-sticker { position: absolute; right: -16rpx; top: 13rpx; z-index: 1; transform: rotate(10deg); background: #fff; border-radius: 99rpx; padding: 5rpx 15rpx; color: #204f1b; font-size: 15rpx; font-weight: 800; }
.hero-kicker { font-size: 17rpx; font-weight: 750; color: #315a16; }
.hero-title { font-size: 39rpx; font-weight: 900; letter-spacing: -1rpx; color: #151b16; margin-top: 11rpx; }
.hero-subtitle { font-size: 23rpx; color: #234823; margin-top: 4rpx; }
.hero-search { position: relative; z-index: 1; display: flex; align-items: center; width: 100%; height: 59rpx; border-radius: 99rpx; margin-top: 20rpx!important; padding: 0 8rpx 0 18rpx; box-sizing: border-box; background: #fff; text-align: left; box-shadow: 0 4rpx 12rpx rgba(24,53,59,.09); }
.hero-search-icon { font-size: 21rpx; color: #1d64f2; margin-right: 9rpx; }
.hero-search-input { flex: 1; min-width: 0; height: 100%; padding: 0; background: transparent; color: #1c2939; font-size: 20rpx; }
.hero-arrow { width: 43rpx; height: 43rpx; flex: none; padding: 0; line-height: 43rpx !important; text-align: center; border-radius: 50%; background: #1d64f2; color: #fff; font-size: 24rpx; }
.category-strip { margin: 18rpx -28rpx 20rpx; width: calc(100% + 56rpx); white-space: nowrap; }
.category-row { display: flex; width: max-content; padding: 0 28rpx; gap: 23rpx; }
.category-card { width: 86rpx; padding: 0; display: flex; align-items: center; flex-direction: column; background: transparent; flex: none; }
.category-bubble { width: 69rpx; height: 69rpx; line-height: 69rpx; border-radius: 25rpx; text-align: center; font-size: 34rpx; }
.category-bubble.mint { background: #e4f8f2; }.category-bubble.peach { background: #fff0db; }.category-bubble.cream { background: #fff3db; }.category-bubble.sky { background: #e7f1fa; }.category-bubble.pink { background: #faeafa; }.category-bubble.gray { background: #f1f2f5; color: #5b6372; font-size: 21rpx; }
.category-name { margin-top: 6rpx; color: #283343; font-size: 18rpx; white-space: nowrap; }
.availability-message { margin: -6rpx 0 16rpx; padding: 12rpx 15rpx; border-radius: 13rpx; background: #fff7e7; color: #805b18; font-size: 19rpx; line-height: 1.4; }
.feature-card { display: block; width: 100%; overflow: hidden; padding: 0; border-radius: 27rpx; background: #fff; color: #172033; text-align: left; box-shadow: 0 8rpx 24rpx rgba(25,36,51,.08); }
.feature-cover { position: relative; display: block; width: 100%; height: 380rpx; overflow: hidden; background: #172033; color: #fff; }
.feature-image,.cover,.inspiration-cover image,.preview-cover image { width: 100%; height: 100%; }
.feature-shade { position: absolute; inset: 0; background: linear-gradient(180deg,rgba(0,0,0,.28),rgba(0,0,0,.1) 38%,rgba(0,0,0,.65)); }
.feature-top { position: absolute; top: 18rpx; left: 19rpx; right: 18rpx; display: flex; justify-content: space-between; align-items: start; }
.feature-badge { border-radius: 99rpx; background: rgba(25,33,37,.72); color: #fff; border: 1rpx solid rgba(255,255,255,.25); padding: 7rpx 14rpx; font-size: 18rpx; font-weight: 750; }
.feature-top-arrow { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; background: rgba(0,0,0,.5); text-align: center; font-size: 30rpx; }
.feature-poster { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 0 26rpx; box-sizing: border-box; text-align: center; }
.feature-display { color: #fff; font-size: 42rpx; font-weight: 900; font-style: italic; letter-spacing: -1rpx; line-height: 1.1; text-shadow: 0 3rpx 12rpx rgba(0,0,0,.55); }
.feature-tagline { margin-top: 5rpx; color: #d2f803; font-size: 22rpx; font-weight: 800; font-style: italic; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.6); }
.feature-detail { display: block; padding: 21rpx 22rpx 17rpx; background: #fff; }
.feature-detail-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.feature-detail-title { flex: 1; color: #182333; font-size: 28rpx; font-weight: 850; line-height: 1.3; }
.feature-status { flex: none; max-width: 150rpx; padding: 5rpx 12rpx; border-radius: 99rpx; background: #f0f2f5; color: #536071; font-size: 18rpx; font-weight: 800; text-align: center; }
.feature-status-RECRUITING { background: #e9f9ef; color: #168a47; }
.feature-status-CONFIRMED,.feature-status-IN_PROGRESS { background: #e9f1ff; color: #1d64f2; }
.feature-status-CANCELLED,.feature-status-EXPIRED { background: #fff1f3; color: #b9435a; }
.feature-status-idea { color: #1d64f2; background: #e9f1ff; }
.feature-detail-meta { margin-top: 10rpx; color: #6d7785; font-size: 20rpx; line-height: 1.35; }
.feature-attendance { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 17rpx; padding-top: 13rpx; border-top: 1rpx solid #edf0f4; }
.feature-attendance-markers { display: flex; flex: none; align-items: center; padding-left: 4rpx; }
.feature-attendance-markers text { display: block; width: 28rpx; height: 28rpx; margin-left: -4rpx; border: 2rpx solid #fff; border-radius: 50%; background: #edf2f7; color: #6b7b8c; font-size: 14rpx; line-height: 28rpx; text-align: center; }
.feature-attendance-markers text:nth-child(2) { background: #eaf5ec; color: #5b956a; }
.feature-attendance-markers text:nth-child(3) { background: #f4eef8; color: #9774a7; }
.feature-attendance-count { color: #6d7785; font-size: 18rpx; font-weight: 800; }
.feature-detail-foot { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 20rpx; padding-top: 13rpx; border-top: 1rpx solid #edf0f4; color: #97a0ad; font-size: 18rpx; }
.feature-detail-foot-with-count { margin-top: 11rpx; padding-top: 0; border-top: 0; }
.feature-detail-action { flex: none; color: #1d64f2; font-size: 20rpx; font-weight: 800; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 30rpx 0 17rpx; font-size: 28rpx; font-weight: 850; }
.section-heading > view { display: flex; align-items: center; gap: 9rpx; }
.section-mark { color: #1d64f2; font-size: 26rpx; }
.section-link { padding: 4rpx 0; background: transparent; color: #1d64f2; font-size: 20rpx; font-weight: 650; white-space: nowrap; }
.inspiration-grid { display: flex; gap: 15rpx; }
.inspiration-card { width: calc((100% - 15rpx) / 2); overflow: hidden; padding: 0; border-radius: 21rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(25,36,51,.055); text-align: left; }
.inspiration-cover { position: relative; height: 180rpx; }
.inspiration-label { position: absolute; left: 9rpx; top: 9rpx; padding: 5rpx 10rpx; border-radius: 99rpx; color: #1d64f2; background: #fff; font-size: 17rpx; font-weight: 700; }
.inspiration-copy { padding: 13rpx 14rpx 16rpx; }
.inspiration-title { color: #1d2733; font-size: 23rpx; font-weight: 750; line-height: 1.3; }
.inspiration-sub { color: #727d8c; font-size: 18rpx; line-height: 1.4; margin-top: 6rpx; }
.brand-ribbon { position: relative; overflow: hidden; height: 300rpx; margin-top: 28rpx; padding: 25rpx; border-radius: 25rpx; box-sizing: border-box; background: #101827; color: #fff; }
.ribbon-image,.ribbon-shade { position: absolute; inset: 0; width: 100%; height: 100%; }.ribbon-shade { background: linear-gradient(90deg,rgba(3,10,24,.88),rgba(8,16,32,.55) 60%,rgba(8,16,32,.2)); }.ribbon-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; height: 100%; }
.ribbon-kicker { margin-top: 5rpx; color: rgba(255,255,255,.78); font-size: 16rpx; font-weight: 750; letter-spacing: 1rpx; }
.ribbon-title { font-size: 37rpx; font-weight: 900; line-height: 1.15; }.ribbon-title text { color: #fff; }
.ribbon-bottom { display: flex; align-items: center; gap: 11rpx; margin-top: auto; font-size: 25rpx; font-weight: 800; font-style: italic; transform: rotate(-3deg); }
.ribbon-smile { width: 34rpx; height: 34rpx; border-radius: 50%; background: #d2f803; color: #111827; line-height: 34rpx; text-align: center; font-size: 24rpx; font-style: normal; }
.dashboard-heading { margin-bottom: 10rpx; }
.tabs { width: calc(100% + 56rpx); margin: 0 -28rpx 18rpx; box-sizing: border-box; white-space: nowrap; }
.tab-row { display: flex; width: max-content; padding: 0 28rpx; }
.tab { flex: none; display: inline-flex; align-items: center; gap: 8rpx; margin-right: 10rpx!important; padding: 12rpx 19rpx; border-radius: 99rpx; background: #f1f3f6; color: #455061; font-size: 21rpx; font-weight: 650; }
.tab text { padding: 1rpx 8rpx; border-radius: 99rpx; background: rgba(0,0,0,.05); font-size: 17rpx; }
.tab.selected { color: #fff; background: #1d64f2; }.tab.selected text { color: #153263; background: #d2f803; }
.draft-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 0 0 18rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: #eef4ff; }
.draft-list-heading view { display: flex; flex-direction: column; gap: 3rpx; }
.draft-list-title { color: #173b78; font-size: 25rpx; font-weight: 800; }
.draft-list-copy { color: #65768f; font-size: 18rpx; }
.draft-list-heading button { flex: none; margin: 0!important; padding: 8rpx 10rpx; color: #1d64f2; background: transparent; font-size: 19rpx; font-weight: 750; }
.state-card { margin: 0 0 22rpx; border-radius: 24rpx; padding: 32rpx 20rpx; background: #f5f7fa; color: #6b7786; text-align: center; font-size: 23rpx; }
.state-card.error { color: #b62442; }.state-card.muted { color: #6b7786; }
.retry,.empty-action { display: block; margin: 20rpx auto 0!important; padding: 12rpx 25rpx; border-radius: 99rpx; color: #fff; background: #1d64f2; font-size: 22rpx; }
.empty-icon { width: 70rpx; height: 70rpx; line-height: 70rpx; margin: 0 auto 9rpx; border-radius: 50%; color: #1d64f2; background: #ebf2fe; font-size: 33rpx; }
.empty-title { color: #1b2633; font-size: 27rpx; font-weight: 800; }.empty-copy { margin-top: 7rpx; font-size: 21rpx; }
.event-card { width: 100%; margin: 0 0 20rpx!important; padding: 0; overflow: hidden; border-radius: 23rpx; background: #fff; box-shadow: 0 7rpx 23rpx rgba(25,36,51,.065); text-align: left; }
.cover-wrap { position: relative; height: 218rpx; overflow: hidden; }
.cover-tint { position: absolute; inset: 0; background: linear-gradient(180deg,transparent 45%,rgba(0,0,0,.62)); }
.cover-status { position: absolute; left: 14rpx; top: 14rpx; padding: 5rpx 13rpx; border-radius: 99rpx; background: #d2f803; color: #1b281e; font-size: 18rpx; font-weight: 750; }
.cover-title { position: absolute; left: 17rpx; right: 17rpx; bottom: 13rpx; color: #fff; font-size: 29rpx; font-weight: 850; text-shadow: 0 2rpx 7rpx rgba(0,0,0,.35); }
.card-body { padding: 16rpx 17rpx 19rpx; }.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.card-title { flex: 1; color: #202a36; font-size: 25rpx; font-weight: 750; }.pill { padding: 5rpx 10rpx; border-radius: 99rpx; background: #ebf9f0; color: #1e9850; font-size: 17rpx; white-space: nowrap; }
.card-meta { margin-top: 11rpx; color: #586678; font-size: 20rpx; }.card-note { margin-top: 8rpx; color: #778493; font-size: 19rpx; }.card-action { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid #edf0f4; color: #1d64f2; font-size: 20rpx; font-weight: 750; display: flex; justify-content: space-between; }
.discover-heading { margin-top: 27rpx; }
.discovery-preview { overflow: hidden; border-radius: 23rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(25,36,51,.06); }
.preview-cover { position: relative; height: 168rpx; }.preview-shade { position: absolute; inset: 0; background: linear-gradient(transparent,rgba(0,0,0,.4)); }.preview-poster { position: absolute; bottom: 14rpx; left: 17rpx; color: #fff; font-size: 24rpx; font-weight: 800; font-style: italic; }
.preview-body { padding: 17rpx; }.preview-title { font-size: 25rpx; font-weight: 800; }.preview-copy { margin-top: 6rpx; color: #738092; font-size: 20rpx; line-height: 1.4; }.preview-action { margin-top: 12rpx!important; padding: 0; background: transparent; color: #1d64f2; font-size: 20rpx; font-weight: 750; }
.invite-panel { margin-top: 30rpx; padding: 21rpx; border-radius: 24rpx; background: #eff3fb; }.invite-title { font-size: 26rpx; font-weight: 800; }.invite-copy { margin-top: 5rpx; color: #6d7788; font-size: 20rpx; }
.invite-row { display: flex; align-items: center; gap: 10rpx; margin-top: 13rpx; }.invite-row input { flex: 1; width: 0; height: 70rpx; padding: 0 13rpx; border-radius: 15rpx; background: #fff; font-size: 21rpx; }.invite-row button { flex: none; height: 70rpx; padding: 0 17rpx; border-radius: 15rpx; background: #1d64f2; color: #fff; font-size: 20rpx; line-height: 70rpx; }
.invite-message { margin-top: 10rpx; color: #b62442; font-size: 20rpx; }.home-foot { margin: 36rpx 0 13rpx; color: #a2a9b4; text-align: center; font-size: 17rpx; line-height: 1.7; }
.home-foot-links { display: flex; justify-content: center; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.home-foot-links button { padding: 0; background: transparent; color: #8d96a4; font-size: 17rpx; line-height: 1.7; }

/* PG02-B/C/D: actual membership, host and history cards from /me/events. */
.event-card { display: block; }
.cover-wrap { display: block; position: relative; width: 100%; height: 218rpx; padding: 0; overflow: hidden; border-radius: 0; background: #172033; text-align: left; }
.cover-wrap .cover { display: block; }
.card-pending .cover-status { background: #fff0f2; color: #df3158; }
.card-organized .cover-status { background: #d2f803; color: #183127; }
.card-history .cover-status { background: rgba(28,34,42,.82); color: #fff; }
.card-state { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 15rpx; padding: 16rpx 17rpx; border-radius: 17rpx; font-size: 20rpx; line-height: 1.42; }
.card-state text:last-child { flex: 1; }
.pending-state { color: #a32942; background: #fff1f3; }
.organized-state { color: #174c8d; background: #edf4ff; }
.history-state { color: #34724d; background: #eef9e9; }
.state-icon { flex: none; width: 27rpx; height: 27rpx; border-radius: 50%; background: currentColor; color: #fff; text-align: center; line-height: 27rpx; font-size: 18rpx; font-weight: 800; }
.card-actions { display: flex; align-items: center; gap: 11rpx; margin-top: 17rpx; }
.card-actions button,.card-disabled { min-height: 65rpx; padding: 13rpx 11rpx; border-radius: 99rpx; box-sizing: border-box; font-size: 21rpx; font-weight: 750; text-align: center; line-height: 39rpx; }
.card-primary { flex: 1.3; color: #fff; background: #1d64f2; box-shadow: 0 5rpx 14rpx rgba(29,100,242,.16); }
.card-secondary,.card-disabled { flex: 1; color: #3c4654; background: #f0f2f6; }
.card-actions .card-share { flex: 0 0 72rpx; width: 72rpx; color: #1d64f2; background: #edf3ff; font-size: 32rpx; }
.card-disabled { color: #8993a2; font-weight: 550; }
.card-shortcut { box-sizing: border-box; width: 100%; min-height: 58rpx; margin: 10rpx 0 0; padding: 10rpx 18rpx; border-radius: 16rpx; background: #eef3ff; color: #1d64f2; text-align: left; line-height: 1.4; font-size: 20rpx; font-weight: 750; }
.card-shortcut::after { border: 0; }
.card-history .card-shortcut { color: #5856d6; background: #f1effd; }
.card-history .card-primary { background: #5856d6; box-shadow: 0 5rpx 14rpx rgba(88,86,214,.15); }
.dashboard-links { display: flex!important; align-items: center; gap: 14rpx!important; }
.pending-state .state-icon { background: #e74766; }
.organized-state .state-icon { background: #1d64f2; }
.history-state .state-icon { background: #35ad66; }

/* PG02-B/C/D: compact status feed, leaving the CAPER default feed intact. */
.state-view { background: #faf8fe; }
.state-view .safe-area,.state-view .home-status-shield,.state-view .home-header { background: #faf8fe; }
.state-view .home-main { min-height: calc(100vh - 150rpx); }
.state-brand { display: flex; align-items: center; gap: 12rpx; flex: none; color: #1a1b1f; font-size: 32rpx; font-weight: 850; white-space: nowrap; letter-spacing: -1rpx; }
.state-brand-mark { width: 49rpx; height: 49rpx; border-radius: 50%; background: #ebf2fe; color: #1d64f2; line-height: 49rpx; text-align: center; font-size: 29rpx; box-shadow: 0 3rpx 16rpx rgba(29,100,242,.16); }
.state-main { padding-top: 13rpx; }
.state-ai-banner { position: relative; display: flex; align-items: center; gap: 16rpx; width: 100%; min-height: 119rpx; padding: 16rpx 18rpx; border-radius: 27rpx; box-sizing: border-box; text-align: left; color: #fff; background: linear-gradient(105deg,#2666ed,#5856d6); box-shadow: 0 12rpx 25rpx rgba(29,100,242,.18); overflow: hidden; }
.state-ai-banner::after { content: ''; position: absolute; width: 145rpx; height: 145rpx; right: -77rpx; bottom: -94rpx; border-radius: 50%; background: rgba(210,248,3,.2); filter: blur(23rpx); }
.state-ai-organized { color: #1a1b1f; background: linear-gradient(110deg,#e7eeff,#e9f0ff 65%,#f2f0ff); box-shadow: 0 9rpx 22rpx rgba(29,100,242,.08); }
.state-ai-history { background: linear-gradient(105deg,#2666ed,#5856d6); }
.state-ai-orb { position: relative; z-index: 1; width: 65rpx; height: 65rpx; flex: none; border-radius: 50%; text-align: center; line-height: 65rpx; font-size: 35rpx; background: rgba(255,255,255,.18); box-shadow: inset 0 0 0 10rpx rgba(255,255,255,.11); }
.state-ai-organized .state-ai-orb { color: #fff; background: #1d64f2; box-shadow: 0 7rpx 16rpx rgba(29,100,242,.16); }
.state-ai-copy { position: relative; z-index: 1; flex: 1; min-width: 0; }
.state-ai-copy view { font-size: 25rpx; font-weight: 850; line-height: 1.2; }
