.state-view .card-history .cover-status { background: #e9f9ed; color: #18813e; }
.cover-sticker { position: absolute; left: 17rpx; top: 17rpx; padding: 8rpx 13rpx; border-radius: 10rpx; color: #1b2518; background: #d2f803; font-size: 17rpx; font-weight: 850; transform: rotate(-3deg); }
.cover-poster { position: absolute; left: 20rpx; right: 18rpx; bottom: 26rpx; display: flex; flex-direction: column; align-items: flex-start; color: #fff; text-align: left; }
.cover-poster-word { max-width: 100%; font-size: 39rpx; font-style: italic; font-weight: 950; line-height: 1.04; letter-spacing: -2rpx; text-shadow: 0 3rpx 10rpx rgba(0,0,0,.48); }
.cover-poster-line { margin-top: 4rpx; color: #d2f803; font-size: 17rpx; font-weight: 850; letter-spacing: .5rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5); }
