.home-final-cta { display: flex; flex-direction: column; align-items: center; margin-top: 30rpx; padding: 29rpx 22rpx; border: 1rpx solid #eff1f4; border-radius: 25rpx; background: linear-gradient(#fff,#f7f9fc); box-shadow: 0 6rpx 22rpx rgba(25,36,51,.05); text-align: center; }.home-final-cta > view { width: 55rpx; height: 55rpx; border-radius: 17rpx; color: #1d64f2; background: #eaf1ff; font-size: 28rpx; line-height: 55rpx; }.home-final-cta > text:nth-child(2) { margin-top: 10rpx; color: #172033; font-size: 28rpx; font-weight: 900; }.home-final-cta > text:nth-child(3) { margin-top: 6rpx; color: #9aa3af; font-size: 17rpx; }.home-final-cta button { width: 100%; margin-top: 19rpx!important; padding: 16rpx; border-radius: 13rpx; color: #fff; background: linear-gradient(90deg,#1d64f2,#28c0b0); font-size: 21rpx; font-weight: 850; }.home-final-cta > text:last-child { margin-top: 13rpx; color: #a6afbb; font-size: 13rpx; letter-spacing: 1rpx; }

/* Wave64 caper_2 first components: literal source CSS px. Native status/capsule
   uses the existing data bindings; the 56px app header is a platform adaptation.
   Explicit ordinary-view and home-reference-core scopes isolate PG02-B/C/D,
   drafts and the existing long feed. Handwriting fonts remain fallback fonts. */
.ordinary-view .home-header { min-height: 56px; padding-left: 20px; gap: 10px; background: rgba(255,255,255,.9); backdrop-filter: blur(12px); font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang SC", "Hiragino Sans GB", sans-serif; }
.ordinary-view .brand { gap: 6px; }
.ordinary-view .brand-mark { width: 28px; height: 28px; border-radius: 12px; background: linear-gradient(to bottom right,#c8f233 0%,#1d64f2 50%,#9333ea 100%); line-height: 28px; font-size: 16px; font-weight: 900; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.ordinary-view .brand-word { line-height: 1.25; }
.ordinary-view .brand-cn { color: #111827; font-size: 16px; font-weight: 900; letter-spacing: -.8px; }
.ordinary-view .brand-en { margin-top: -4px; font-size: 9px; font-weight: 800; letter-spacing: .9px; }
.ordinary-view .city-chip { display: flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 9999px; color: #1f2937; background: #f3f4f6; font-size: 12px; line-height: 16px; font-weight: 600; }
.ordinary-view .city-pin { color: #1d64f2; font-size: 13px; }
.ordinary-view .city-chevron { display: block; width: 12px; height: 12px; flex: none; }
.ordinary-view .header-space { min-width: 0; margin: 0 -10px; }
.ordinary-view .header-round { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; background: #f3f4f6; color: #374151; line-height: 32px!important; }
.ordinary-view .header-bell-image { width: 16px; height: 16px; margin: 0; }
.ordinary-view .header-unread-dot { top: 6px; right: 6px; width: 8px; height: 8px; border: 2px solid #fff; background: #ef4444; }
.ordinary-view .header-avatar { width: 36px; height: 36px; padding: 1.5px; border: 0; background: #0758cb; box-shadow: 0 0 0 2px rgba(29,100,242,.3); line-height: 36px!important; }
.ordinary-view .avatar-glyph { width: 19px; height: 22px; margin: 5px auto 0; }
.ordinary-view .avatar-glyph::before { top: 1px; left: 6px; width: 8px; height: 8px; border: 1.5px solid currentColor; }
.ordinary-view .avatar-glyph::after { left: 2px; bottom: 1px; width: 15px; height: 9px; border: 1.5px solid currentColor; border-radius: 8px 8px 3px 3px; }
.caper-top .home-reference-core { margin: 0 calc(16px - 28rpx); padding-top: 8px; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang SC", "Hiragino Sans GB", sans-serif; }
