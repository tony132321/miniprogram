.state-view .cover-wrap { height: 343rpx; }
.state-view .cover-tint { background: linear-gradient(180deg,rgba(0,0,0,.18),transparent 38%,rgba(0,0,0,.7)); }
.state-view .cover-status { left: auto; right: 17rpx; top: 17rpx; padding: 8rpx 16rpx; font-size: 18rpx; box-shadow: 0 3rpx 11rpx rgba(0,0,0,.13); }
