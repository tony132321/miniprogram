page { background: #f7f9fc; color: #172033; }
.discover-page { min-height: 100vh; padding-bottom: 100rpx; background: #fff; box-sizing: border-box; }
.safe-area { width: 100%; background: #fff; }
.discover-status-shield { position: fixed; top: 0; left: 0; right: 0; z-index: 12; background: #fff; }
.discover-page button { margin: 0; line-height: normal; }.discover-page button::after { border: 0; }
.discover-nav { position: sticky; z-index: 11; height: 88rpx; padding: 0 112px 0 28rpx; display: flex; align-items: center; gap: 12rpx; box-sizing: border-box; background: #fff; }
.brand { display: flex; align-items: center; gap: 7rpx; padding: 0; background: transparent; flex: none; }.brand-mark { width: 43rpx; height: 43rpx; line-height: 43rpx; border-radius: 15rpx; background: #1d64f2; color: #fff; text-align: center; font-size: 26rpx; }.brand-name { font-size: 23rpx; font-weight: 850; white-space: nowrap; }.brand-name text { font-size: 16rpx; color: #1d64f2; }
.nav-fill { flex: 1; }.nav-city { padding: 9rpx 14rpx; border-radius: 99rpx; background: #f4f6f9; color: #324056; font-size: 19rpx; white-space: nowrap; }
.discover-main { padding: 0 28rpx; }
.page-head { display: flex; justify-content: space-between; align-items: flex-end; margin: 12rpx 0 20rpx; }.head-title { color: #141a25; font-size: 42rpx; font-weight: 900; letter-spacing: -1rpx; }.head-caption { color: #758194; font-size: 22rpx; margin-top: 2rpx; }.head-actions { display: flex; gap: 8rpx; }.head-actions button { width: 53rpx; height: 53rpx; line-height: 53rpx; border-radius: 50%; background: #f1f4f9; color: #253446; font-size: 30rpx; text-align: center; }
.category-scroll { width: calc(100% + 56rpx); margin: 0 -28rpx 15rpx; white-space: nowrap; }.category-row { display: flex; width: max-content; padding: 0 28rpx; gap: 8rpx; }.category { padding: 11rpx 18rpx; border-radius: 99rpx; background: #f1f3f7; color: #6c7787; font-size: 21rpx; white-space: nowrap; }.category.first { color: #fff; background: #1d64f2; }
.availability { display: flex; align-items: center; gap: 11rpx; padding: 13rpx 15rpx; margin-top: 18rpx; border-radius: 15rpx; background: #eff5ff; color: #365581; }.availability-icon { flex: none; width: 34rpx; height: 34rpx; line-height: 34rpx; border-radius: 50%; background: #fff; color: #1d64f2; text-align: center; font-size: 20rpx; }.availability-title { color: #164cc0; font-size: 20rpx; font-weight: 750; }.availability-copy { margin-top: 1rpx; font-size: 17rpx; line-height: 1.35; }.availability-reply { margin: 8rpx 0 0; color: #1d64f2; font-size: 19rpx; }
.section-heading { margin: 26rpx 0 14rpx; display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx; color: #1d2736; font-size: 28rpx; font-weight: 850; }.section-heading > view { display: flex; align-items: center; gap: 7rpx; }.section-mark { color: #1d64f2; font-size: 22rpx; }.section-caption { color: #929baa; font-size: 18rpx; font-weight: 400; }.section-link { padding: 0; background: transparent; color: #1d64f2; font-size: 18rpx; font-weight: 650; }
.featured-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }.featured-card { width: calc((100% - 14rpx) / 2); padding: 0; overflow: hidden; border-radius: 19rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(23,38,60,.08); text-align: left; }.featured-cover { position: relative; height: 350rpx; overflow: hidden; }.featured-cover image { width: 100%; height: 100%; }.cover-shade { position: absolute; inset: 0; background: linear-gradient(transparent 42%,rgba(0,0,0,.58)); }.card-spark { position: absolute; left: 13rpx; bottom: 13rpx; color: #fff; font-size: 25rpx; font-weight: 900; font-style: italic; text-shadow: 0 2rpx 6rpx rgba(0,0,0,.3); }.idea-label { position: absolute; left: 10rpx; top: 11rpx; padding: 4rpx 9rpx; border-radius: 99rpx; background: #fff; color: #1d64f2; font-size: 15rpx; font-weight: 750; }.featured-body { padding: 13rpx 13rpx 14rpx; }.featured-title { font-size: 22rpx; font-weight: 800; }.featured-copy { margin-top: 5rpx; height: 51rpx; color: #748092; font-size: 18rpx; line-height: 1.4; }.featured-foot { margin-top: 7rpx; display: flex; align-items: center; justify-content: space-between; color: #8893a0; font-size: 17rpx; }.foot-arrow { color: #1d64f2; font-size: 25rpx; }
.recommend-note { color: #8992a1; font-size: 19rpx; margin: -6rpx 0 13rpx; }.recommend-scroll { width: calc(100% + 56rpx); margin: 0 -28rpx; white-space: nowrap; }.recommend-row { display: flex; width: max-content; padding: 0 28rpx 12rpx; gap: 13rpx; }.recommend-card { width: 245rpx; overflow: hidden; border-radius: 18rpx; background: #fff; text-align: left; box-shadow: 0 5rpx 15rpx rgba(23,38,60,.065); }.recommend-card image { width: 100%; height: 143rpx; }.recommend-card-copy { display: flex; flex-direction: column; gap: 4rpx; padding: 10rpx 12rpx 13rpx; }.recommend-card-copy text:first-child { color: #172033; font-size: 20rpx; font-weight: 750; }.recommend-card-copy text:last-child { color: #8994a2; font-size: 16rpx; }
.nearby-card { overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(23,38,60,.065); }.nearby-map { position: relative; height: 169rpx; overflow: hidden; background: #e5f1ed; }.map-grid { position: absolute; inset: 0; background: linear-gradient(28deg,transparent 42%,#fff 42%,#fff 47%,transparent 47%),linear-gradient(122deg,transparent 52%,#fff 52%,#fff 57%,transparent 57%),linear-gradient(0deg,transparent 58%,#fff 58%,#fff 62%,transparent 62%),linear-gradient(90deg,#d1eee1,#ecf5e8); }.map-pin { position: absolute; left: 47%; top: 39rpx; width: 48rpx; height: 48rpx; line-height: 48rpx; border-radius: 50%; background: #1d64f2; color: #fff; text-align: center; box-shadow: 0 0 0 10rpx rgba(29,100,242,.15); font-size: 27rpx; }.map-label { position: absolute; left: 10rpx; bottom: 10rpx; border-radius: 99rpx; padding: 5rpx 10rpx; background: rgba(255,255,255,.92); color: #45676a; font-size: 16rpx; }.nearby-body { padding: 17rpx; }.nearby-title { font-size: 24rpx; font-weight: 800; }.nearby-copy { margin-top: 5rpx; color: #718092; font-size: 19rpx; }.nearby-action { margin-top: 13rpx!important; padding: 0; color: #1d64f2; background: transparent; font-size: 19rpx; font-weight: 750; }
.theme-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }.theme-card { position: relative; overflow: hidden; width: calc((100% - 12rpx) / 2); height: 117rpx; padding: 15rpx; border-radius: 19rpx; color: #142032; text-align: left; display: flex; flex-direction: column; }.theme-lime { background: #d2f803; }.theme-blue { background: #1d64f2; color: #fff; }.theme-pink { background: #ffdfdf; }.theme-night { background: #172142; color: #fff; }.theme-kicker { font-size: 14rpx; font-weight: 800; letter-spacing: 1rpx; opacity: .8; }.theme-name { margin-top: 10rpx; font-size: 26rpx; font-weight: 850; }.theme-icon { position: absolute; right: 11rpx; bottom: 7rpx; font-size: 42rpx; opacity: .7; }
.moment-note { color: #8e98a6; font-size: 19rpx; margin-top: -8rpx; margin-bottom: 12rpx; }.moment-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }.moment-grid image { width: calc((100% - 10rpx) / 2); height: 155rpx; border-radius: 16rpx; }
.invite-card { padding: 22rpx; margin-top: 30rpx; border-radius: 22rpx; background: #eff3fb; }.invite-heading { font-size: 26rpx; font-weight: 800; }.invite-copy { margin-top: 5rpx; color: #6f7b8c; font-size: 20rpx; }.invite-row { display: flex; align-items: center; gap: 10rpx; margin-top: 15rpx; }.invite-row input { flex: 1; width: 0; height: 69rpx; padding: 0 13rpx; border-radius: 13rpx; background: #fff; font-size: 21rpx; }.invite-row button { flex: none; height: 69rpx; padding: 0 15rpx; border-radius: 13rpx; color: #fff; background: #1d64f2; line-height: 69rpx; font-size: 20rpx; }.message { margin-top: 10rpx; color: #b62442; font-size: 20rpx; }
.create-card { width: 100%; padding: 19rpx; margin-top: 20rpx!important; display: flex; align-items: center; gap: 15rpx; border-radius: 23rpx; color: #fff; background: #1d64f2; text-align: left; }.create-icon { width: 58rpx; height: 58rpx; flex: none; line-height: 58rpx; border-radius: 50%; background: rgba(255,255,255,.2); text-align: center; font-size: 39rpx; }.create-title { font-size: 25rpx; font-weight: 800; }.create-copy { margin-top: 4rpx; font-size: 18rpx; opacity: .87; }.create-arrow { margin-left: auto; font-size: 30rpx; }.discover-foot { margin: 30rpx 0 7rpx; color: #a4aeb9; text-align: center; font-size: 16rpx; }
