.d74-long .d74-place-cover > image { width: 100%; height: 100%; }
.d74-long .d74-place-shade { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(0,0,0,.4); font-size: 12px; line-height: 16px; font-weight: 900; }
.d74-long .d74-place-body { padding: 8px; }
.d74-long .d74-place-title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #0f172a; font-size: 12px; line-height: 16px; font-weight: 700; }
.d74-long .d74-place-fact { display: flex; align-items: center; gap: 2px; margin-top: 2px; color: #94a3b8; font-size: 10px; line-height: 15px; font-weight: 400; }
.d74-long .d74-place-fact image { flex: none; width: 10px; height: 10px; }
.d74-long .d74-place-action { margin-top: 2px; color: #1d64f2; font-size: 10px; line-height: 15px; font-weight: 600; white-space: normal; }
.discover-page .d74-cta-scope { width: calc(100% + 48rpx - 24px); margin: 24px calc(12px - 24rpx); font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", sans-serif; }
.discover-page .d74-cta-scope .d74-create-card { position: relative; display: flex; align-items: center; justify-content: space-between; width: 100%; overflow: hidden; padding: 16px; border-radius: 24px; color: #fff; background: linear-gradient(to right,#2563eb,#4f46e5 50%,#1d4ed8); box-shadow: 0 10px 15px -3px #bfdbfe,0 4px 6px -4px #bfdbfe; }
.d74-cta-scope .d74-create-left { position: relative; z-index: 10; display: flex; align-items: center; gap: 12px; min-width: 0; }
.d74-cta-scope .d74-create-mascot { flex: none; display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid rgba(255,255,255,.2); border-radius: 16px; color: #fff; background: rgba(255,255,255,.1); backdrop-filter: blur(12px); font-size: 24px; line-height: 32px; box-shadow: inset 0 2px 4px rgba(0,0,0,.05); }
.d74-cta-scope .d74-create-copy { min-width: 0; }
.d74-cta-scope .d74-create-title { color: #fff; font-size: 14px; line-height: 20px; font-weight: 900; letter-spacing: -.35px; }
.d74-cta-scope .d74-create-subtitle { margin-top: 2px; color: #dbeafe; font-size: 11px; line-height: 16.5px; font-weight: 400; }
.d74-cta-scope .d74-create-arrow { position: relative; z-index: 10; flex: none; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin-left: 8px; border-radius: 50%; background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -2px rgba(0,0,0,.1); transition: transform .15s cubic-bezier(.4,0,.2,1); }
.d74-cta-scope .d74-create-arrow image { width: 16px; height: 16px; }
.d74-cta-scope .d74-cta-pressed .d74-create-arrow { transform: scale(1.05); }
.d74-cta-scope .d74-create-glow { position: absolute; right: -24px; bottom: -24px; width: 96px; height: 96px; border-radius: 50%; background: rgba(255,255,255,.1); filter: blur(24px); }
@keyframes d74-ping { 75%,100% { transform: scale(2); opacity: 0; } }
@keyframes d74-pulse { 50% { opacity: .5; } }
/* Wave74 caper_4 ordinary long modules END. */
