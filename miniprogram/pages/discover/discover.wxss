page { background: #faf8fe; color: #172033; }
.discover-page { min-height: 100vh; padding: 0 32rpx 56rpx; box-sizing: border-box; }
.brand-row { height: 102rpx; display: flex; align-items: center; gap: 11rpx; }
.brand-spacer { flex: 1; }
.brand-city { padding: 12rpx 18rpx; border-radius: 28rpx; background: #fff; color: #1d64f2; font-size: 24rpx; font-weight: 700; line-height: normal; }
.brand-city::after,.category::after,.create-card::after { border: 0; }
.heading-row { display: flex; justify-content: space-between; align-items: center; margin: 22rpx 0 25rpx; }.eyebrow { color: #1d64f2; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }.page-title { font-size: 46rpx; font-weight: 900; margin-top: 5rpx; }.sparkle { color: #1d64f2; font-size: 44rpx; }
.search-box { height: 84rpx; display: flex; align-items: center; gap: 12rpx; border-radius: 21rpx; padding: 0 20rpx; background: #fff; box-shadow: 0 7rpx 22rpx rgba(25,31,67,.05); }.search-box text { font-size: 40rpx; color: #1d64f2; }.search-box input { flex: 1; border: 0; margin: 0; width: auto; font-size: 26rpx; }
.search-box.inactive { background: #f1f2f6; box-shadow: none; }.search-box.inactive text { color: #9196a3; }.search-box .search-placeholder { font-size: 25rpx; }
.category-scroll { display: flex; overflow-x: auto; white-space: nowrap; margin: 25rpx -32rpx 30rpx; padding-left: 32rpx; box-sizing: border-box; }.category { display: inline-block; flex: none; padding: 13rpx 26rpx; margin-right: 12rpx; border-radius: 35rpx; background: #fff; color: #5c6070; font-size: 25rpx; line-height: normal; }.category.active { background: #1d64f2; color: #fff; font-weight: 700; }
.category.inactive { background: #f1f2f6; color: #9196a3; }
.section-title { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18rpx; font-size: 29rpx; font-weight: 850; }.section-note { color: #8b90a0; font-size: 21rpx; font-weight: 500; }
.availability { background: #fff; border-radius: 28rpx; padding: 56rpx 36rpx; text-align: center; box-shadow: 0 10rpx 30rpx rgba(25,31,67,.06); }.availability-icon { width: 92rpx; height: 92rpx; border-radius: 50%; background: #eef3ff; color: #1d64f2; font-size: 47rpx; line-height: 92rpx; margin: auto; }.availability-title { font-size: 31rpx; font-weight: 800; margin-top: 24rpx; }.availability-copy { color: #6a7080; font-size: 24rpx; line-height: 1.5; margin-top: 12rpx; }
.invite-card { background: #fff; border-radius: 26rpx; padding: 26rpx; margin-top: 28rpx; }.invite-heading { font-size: 28rpx; font-weight: 800; margin-bottom: 16rpx; }.invite-row { display: flex; gap: 12rpx; align-items: center; }.invite-row input { flex: 1; width: auto; margin: 0; background: #f4f5f9; border: 0; border-radius: 16rpx; font-size: 23rpx; }.invite-row button { margin: 0; border-radius: 17rpx; background: #1d64f2; color: #fff; font-size: 23rpx; }.message { color: #b62442; font-size: 22rpx; margin-top: 12rpx; }
.create-card { width: 100%; margin-top: 24rpx; background: #1d64f2; color: #fff; border-radius: 28rpx; padding: 27rpx; display: flex; align-items: center; gap: 21rpx; text-align: left; line-height: normal; }.create-icon { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,255,255,.2); font-size: 43rpx; text-align: center; line-height: 64rpx; }.create-title { font-size: 28rpx; font-weight: 800; }.create-copy { font-size: 21rpx; opacity: .86; margin-top: 6rpx; }.create-arrow { margin-left: auto; font-size: 38rpx; }
