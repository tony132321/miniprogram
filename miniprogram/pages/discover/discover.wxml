<view class="discover-page">
  <view class="discover-status-shield" style="height: {{statusBarHeight}}px"></view>
  <view class="discover-menu-shield" style="top: {{statusBarHeight}}px"></view>
  <view class="safe-area" style="height: {{statusBarHeight}}px"></view>
  <view class="discover-nav" style="padding-right: {{headerPaddingRight}}">
    <button class="brand" bindtap="goHome" aria-label="返回首页"><text class="brand-mark">耍</text><view class="brand-words"><text class="brand-name">耍起</text><text class="brand-en">CAPER</text></view></button>
    <view class="nav-context"><text>找局</text><text>发现身边有趣的人和活动</text></view>
    <view class="nav-actions"><button data-name="搜索公开活动" bindtap="showUnavailable" aria-label="搜索公开活动暂未开放"><image src="./assets/ph-magnifying-glass-bold.svg" mode="aspectFit" /></button><button data-name="筛选公开活动" bindtap="showUnavailable" aria-label="筛选公开活动暂未开放"><image src="./assets/ph-funnel-simple-bold.svg" mode="aspectFit" /></button></view>
    <view class="brand-sticker">GOOD PEOPLE MORE PLANS ✦</view>
  </view>
  <view class="discover-main">
    <scroll-view class="category-scroll" style="top: calc({{statusBarHeight}}px + 56px)" scroll-x="true" show-scrollbar="false"><view class="category-row"><button wx:for="{{categories}}" wx:key="*this" class="category {{index === 0 ? 'first' : ''}}" data-name="{{item}}分类" bindtap="selectCategory" aria-label="{{index === 0 ? '查看全部活动灵感' : item === '附近' ? '查看附近活动状态与城市选择' : item + '分类暂未开放'}}">{{item}}</button></view></scroll-view>
    <view class="featured-grid" aria-label="活动发起灵感">
      <button wx:for="{{inspirationCards}}" wx:key="title" class="featured-card" data-title="{{item.title}}" bindtap="openInspiration" aria-label="查看{{item.title}}活动灵感">
        <view class="featured-cover featured-cover-{{item.stickerVariant}}">
          <image src="{{item.image}}" mode="aspectFill" />
          <view class="cover-shade"></view>
          <view class="featured-sticker featured-sticker-{{item.stickerVariant}}"><view class="sticker-head"><text wx:for="{{item.stickerLines}}" wx:for-item="line" wx:key="*this">{{line}}</text></view><view class="sticker-note"><text wx:for="{{item.stickerNoteLines}}" wx:for-item="line" wx:key="*this">{{line}}</text></view></view>
          <view class="featured-favorite" data-name="收藏灵感" catchtap="showUnavailable"><image src="./assets/ph-heart-bold.svg" mode="aspectFit" /></view>
          <view class="featured-tags"><view class="featured-tag-primary"><image wx:if="{{item.stickerVariant === 'city'}}" src="./assets/ph-compass-fill.svg" mode="aspectFit" /><image wx:elif="{{item.stickerVariant === 'basketball'}}" src="./assets/ph-barbell-fill.svg" mode="aspectFit" /><image wx:elif="{{item.stickerVariant === 'coffee'}}" src="./assets/ph-fork-knife-fill.svg" mode="aspectFit" /><image wx:else src="./assets/ph-game-controller-fill.svg" mode="aspectFit" /><text>{{item.tags[0]}}</text></view><view class="featured-tag-secondary"><text>{{item.tags[1]}}</text></view></view>
        </view>
        <view class="featured-body">
          <view><view class="featured-title">{{item.title}}</view><view class="featured-copy">{{item.subtitle}}</view><view class="featured-facts"><view><image src="./assets/ph-calendar-blank-regular.svg" mode="aspectFit" /><text>暂无活动时间</text></view><view><image src="./assets/ph-map-pin-regular.svg" mode="aspectFit" /><text>暂无真实场地</text></view></view></view>
          <view class="featured-foot"><text>仅供构思 · 暂不可报名</text><view><text class="featured-theme featured-theme-{{item.stickerVariant}}">{{item.tags[0]}}</text></view></view>
        </view>
      </button>
    </view>
    <view class="discovery-entry-strip" id="discoveryAvailability"><text>公开找局暂未开放 · 暂不可搜索或报名</text><button bindtap="jumpToInvite" aria-label="跳转到邀请口令输入">输入邀请口令　›</button></view>
    <view wx:if="{{availabilityMessage}}" class="availability-reply">{{availabilityMessage}}</view>

    <!-- Wave74 caper_4 ordinary long modules BEGIN -->
<view class="d74-long">
  <view class="d74-section d74-recommend-section" data-source="ai-recommendations">
    <view class="d74-heading"><view class="d74-heading-copy"><view class="d74-heading-title d74-heading-tight"><image class="d74-sparkle" src="./assets/w74-ph-sparkle-fill-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text>灵感推荐</text><text class="d74-inline-caption">静态主题 · 非智能推荐</text></view></view><button bindtap="rotateRecommendations" class="d74-link" hover-class="d74-link-pressed" hover-start-time="0"><text>换一批</text><image src="./assets/w74-ph-arrows-clockwise-bold-1d64f2.svg" mode="aspectFit" aria-hidden="true"/></button></view>
    <view class="d74-note">照片为发起灵感，不是公开招募列表；当前仅支持创建羽毛球活动。</view>
    <scroll-view class="d74-wide-scroll" scroll-x="true" show-scrollbar="false"><view class="d74-recommend-row"><button wx:for="{{recommendationCards}}" wx:key="title" class="d74-recommend-card" data-title="{{item.title}}" bindtap="openInspiration" aria-label="查看{{item.title}}发起灵感"><view class="d74-recommend-cover"><image src="{{item.image}}" mode="aspectFill"/><view class="d74-recommend-shade"></view><view class="d74-recommend-favorite" data-name="收藏灵感" catchtap="showUnavailable" aria-label="收藏灵感暂未开放"><image src="./assets/ph-heart-bold.svg" mode="aspectFit" aria-hidden="true"/></view></view><view class="d74-recommend-body"><view class="d74-recommend-title">{{item.title}}</view><view class="d74-recommend-facts"><view><image src="./assets/w74-ph-calendar-blank-regular-64748b.svg" mode="aspectFit" aria-hidden="true"/><text>暂无活动时间</text></view><view><image src="./assets/w74-ph-map-pin-regular-64748b.svg" mode="aspectFit" aria-hidden="true"/><text>暂无真实场地</text></view></view><view class="d74-recommend-foot"><text>仅供构思 · 暂不可报名</text><text class="d74-category-tag {{item.category === '文艺' ? 'd74-category-art' : ''}}">{{item.category}}</text></view></view></button></view></scroll-view>
  </view>
  <view class="d74-section d74-nearby-section" data-source="nearby-events">
    <view class="d74-heading" id="nearbySection"><view class="d74-heading-copy"><view class="d74-heading-title"><image src="./assets/w74-ph-map-pin-fill-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text wx:if="{{personalState === 'READY' && nearbyPersonalEvents.length > 0}}">我在{{city}}的活动</text><text wx:else>附近正在发生</text></view><text class="d74-caption">本人活动 · 非公开定位列表</text></view><button bindtap="openCity" class="d74-link"><text>{{city}}</text><image src="./assets/w74-ph-caret-right-bold-1d64f2.svg" mode="aspectFit" aria-hidden="true"/></button></view>
    <view class="d74-nearby-grid"><view class="d74-nearby-map" aria-label="非定位地图示意，未读取精确位置"><view class="d74-map-grid"></view><view class="d74-map-middle"><view class="d74-map-center"><view class="d74-map-ping"></view><view class="d74-map-pin"><image src="./assets/w74-ph-navigation-arrow-fill-ffffff.svg" mode="aspectFit" aria-hidden="true"/></view></view><view class="d74-map-badge d74-map-badge-top"><view></view><text>示意</text></view><view class="d74-map-badge d74-map-badge-bottom"><view></view><text>非定位</text></view></view><view class="d74-map-label">没有读取精确位置</view></view><view class="d74-nearby-body {{personalState === 'READY' && nearbyPersonalEvents.length > 0 ? 'd74-has-personal' : ''}}"><block wx:if="{{personalState === 'READY' && nearbyPersonalEvents.length > 0}}"><view class="d74-nearby-title">本人的活动</view><view class="d74-nearby-own-note">仅本人可见 · 非公开附近列表</view><button wx:for="{{nearbyPersonalEvents}}" wx:key="id" class="d74-nearby-personal-row" data-id="{{item.id}}" bindtap="openPersonalEvent" aria-label="查看{{item.title}}本人活动详情" hover-class="d74-nearby-pressed" hover-start-time="0"><view class="d74-nearby-cover"><image src="{{item.cover}}" mode="aspectFill"/><view></view></view><view class="d74-nearby-personal-copy"><text class="d74-nearby-personal-title">{{item.title}}</text><text class="d74-nearby-personal-fact">{{item.dateLabel}} · {{item.statusLabel}}</text><view class="d74-nearby-place"><image src="./assets/w74-ph-map-pin-regular-64748b.svg" mode="aspectFit" aria-hidden="true"/><text>{{item.locationLabel}}</text></view></view></button></block><block wx:else><view class="d74-nearby-empty"><view class="d74-nearby-title">附近活动待开放</view><view class="d74-nearby-copy">公开找局列表未开放</view><view class="d74-nearby-copy">{{city}}仅为浏览偏好</view><button bindtap="openCity" class="d74-nearby-action">选择城市　→</button></view></block></view></view>
  </view>
  <scroll-view class="d74-campaign-scroll" scroll-x="true" show-scrollbar="false"><view class="d74-campaign-row"><button class="d74-campaign-card d74-campaign-pink" data-title="女生友好" bindtap="openInspiration"><view><text class="d74-campaign-kicker">GIRLS SUPPORT</text><view class="d74-campaign-title">女生友好</view></view><image class="d74-campaign-symbol" src="./assets/w74-ph-sparkle-bold-ffffff.svg" mode="aspectFit" aria-hidden="true"/></button><button class="d74-campaign-card d74-campaign-mint" data-title="新手友好" bindtap="openInspiration"><view><text class="d74-campaign-kicker">NEW EXPLORER</text><view class="d74-campaign-title">新手友好</view></view><image class="d74-campaign-symbol" src="./assets/w74-ph-compass-bold-000000.svg" mode="aspectFit" aria-hidden="true"/></button><button class="d74-campaign-card d74-campaign-lime" data-title="今晚有空" bindtap="openInspiration"><view><text class="d74-campaign-kicker">TONIGHT ?</text><view class="d74-campaign-title">今晚有空 ☾</view></view><image class="d74-campaign-symbol" src="./assets/w74-ph-moon-stars-bold-000000.svg" mode="aspectFit" aria-hidden="true"/></button></view></scroll-view>
  <view class="d74-section" data-source="organizer-list"><view class="d74-heading"><view class="d74-heading-copy"><view class="d74-heading-title"><text class="d74-crown">👑</text><text>活动主理人推荐</text></view><text class="d74-caption">公开主理人目录尚未开放</text></view><view class="d74-link d74-closed-link" aria-disabled="true">暂未开放</view></view><scroll-view class="d74-organizer-scroll" scroll-x="true" show-scrollbar="false"><view class="d74-organizer-row" aria-label="原稿目录空槽示意，不代表实际人物、数量或认证"><view class="d74-organizer-slot"><view class="d74-organizer-ring d74-organizer-lime" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view><view class="d74-organizer-slot"><view class="d74-organizer-ring d74-organizer-blue" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view><view class="d74-organizer-slot"><view class="d74-organizer-ring" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view><view class="d74-organizer-slot"><view class="d74-organizer-ring" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view><view class="d74-organizer-slot"><view class="d74-organizer-ring" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view><view class="d74-organizer-slot"><view class="d74-organizer-ring" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view><view class="d74-organizer-slot"><view class="d74-organizer-ring" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view><view class="d74-organizer-slot"><view class="d74-organizer-ring" aria-hidden="true"><view>—</view></view><text class="d74-organizer-name">暂无公开人物</text><text class="d74-organizer-specialty">目录待开放</text></view></view></scroll-view><view class="d74-note">当前不展示公开主理人、人物头像或认证；真实活动仍可在本人活动内查看。</view></view>
  <view class="d74-section" data-source="friends-attending">
    <view class="d74-heading" id="personalEventsSection"><view class="d74-heading-copy"><view class="d74-heading-title"><image src="./assets/w74-ph-users-three-fill-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text>与你有关的活动</text></view><text class="d74-caption">仅本人已参与或主办</text></view><button bindtap="goPersonalAll" class="d74-link"><text>查看全部</text><image src="./assets/w74-ph-caret-right-bold-1d64f2.svg" mode="aspectFit" aria-hidden="true"/></button></view>
    <view class="d74-note">仅展示本人已参与或主办的活动；公开好友找局尚未开放。</view>
    <view wx:if="{{personalState === 'LOADING'}}" class="d74-personal-state">正在核对本人活动…</view>
    <view wx:if="{{personalState === 'ERROR'}}" class="d74-personal-state">活动暂时无法读取，返回首页可重试。</view>
    <view wx:if="{{personalState === 'READY' && personalEvents.length === 0}}" class="d74-personal-state"><view>还没有可展示的活动</view><button bindtap="goCreate">发起第一场羽毛球活动　→</button></view>
    <scroll-view wx:if="{{personalState === 'READY' && personalEvents.length > 0}}" class="d74-personal-scroll" scroll-x="true" show-scrollbar="false"><view class="d74-personal-row"><button wx:for="{{personalEvents}}" wx:key="id" class="d74-personal-card" data-id="{{item.id}}" bindtap="openPersonalEvent" aria-label="查看{{item.title}}活动详情"><view class="d74-personal-cover"><image src="{{item.cover}}" mode="aspectFill"/><text>{{item.statusLabel}}</text></view><view class="d74-personal-title"><text>{{item.title}}</text><image src="./assets/w74-ph-caret-right-bold-94a3b8.svg" mode="aspectFit" aria-hidden="true"/></view><view class="d74-personal-time">{{item.dateLabel}}{{item.endTimeLabel}}</view><view class="d74-personal-location">{{item.locationLabel}}</view><view class="d74-personal-source">{{item.isHost ? '我主办的活动' : '我参与的活动'}} · 查看详情 ↗</view></button></view></scroll-view>
  </view>
  <view class="d74-section" data-source="social-moments"><view class="d74-heading"><view class="d74-heading-copy"><view class="d74-heading-title"><image src="./assets/w74-ph-camera-bold-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text>真实的人，真实的瞬间</text></view><text class="d74-caption">灵感影像示意 · 非社区实拍</text></view><view class="d74-link d74-closed-link" aria-disabled="true">暂未开放</view></view><view class="d74-note">灵感影像展示 · 活动照片与好友动态尚未开放</view><view class="d74-moment-grid"><view class="d74-moment-cell d74-moment-good"><reference-image photo-key="discover-park" photo-class="d74-park-slot" /><view class="d74-moment-shade"></view><view class="d74-moment-hand"><text class="d74-moment-good-title">Good People</text><text class="d74-moment-lime">Brighter Days ☺</text></view></view><view class="d74-moment-cell d74-moment-caption"><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill"/><view class="d74-moment-shade"></view><text class="d74-moment-photo-label">日落合影</text></view><view class="d74-moment-cell d74-moment-better"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill"/><view class="d74-moment-shade"></view><view class="d74-moment-better-copy"><text>LIFE IS BETTER</text><text>together ♡</text></view></view><view class="d74-moment-cell d74-moment-caption"><image src="/assets/stitch/caper_discover_camping.jpg" mode="aspectFill"/><view class="d74-moment-shade"></view><text class="d74-moment-photo-label">星空露营</text></view><view class="d74-moment-cell d74-moment-caption"><image src="/assets/stitch/caper_discover_boardgame.jpg" mode="aspectFill"/><view class="d74-moment-shade"></view><text class="d74-moment-photo-label">周五桌游</text></view><view class="d74-moment-cell d74-moment-vibes"><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill"/><view class="d74-moment-shade"></view><view class="d74-moment-hand"><text class="d74-moment-lime">Same Vibes</text><text>More Friends ⚡</text></view></view></view></view>
  <view class="d74-section" data-source="user-reviews"><view class="d74-heading"><view class="d74-heading-copy"><view class="d74-heading-title"><image src="./assets/w74-ph-chat-circle-dots-fill-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text>大家都在说</text></view><text class="d74-caption">当前没有公开评价</text></view><button bindtap="goPersonalAll" class="d74-link"><text>我的活动</text><image src="./assets/w74-ph-caret-right-bold-1d64f2.svg" mode="aspectFit" aria-hidden="true"/></button></view><scroll-view class="d74-review-scroll" scroll-x="true" show-scrollbar="false"><view class="d74-review-row"><view class="d74-review-card"><view class="d74-review-copy"><text class="d74-review-quote" aria-hidden="true">“</text><text>当前没有可公开展示的成员评价。参加活动后的反馈以本人活动详情为准。</text></view><view class="d74-review-foot"><view class="d74-review-empty" aria-hidden="true">—</view><text>尚无公开评价</text></view></view></view></scroll-view></view>
