<view class="discover-page">
  <view class="discover-status-shield" style="height: {{statusBarHeight}}px"></view>
  <view class="discover-menu-shield" style="top: {{statusBarHeight}}px"></view>
  <view class="safe-area" style="height: {{statusBarHeight}}px"></view>
  <view class="discover-nav" style="padding-right: {{headerPaddingRight}}">
    <button class="brand" bindtap="goHome" aria-label="返回首页"><text class="brand-mark">耍</text><view class="brand-words"><text class="brand-name">耍起</text><text class="brand-en">CAPER</text></view></button>
    <view class="nav-context"><text>找局</text><text>发现身边有趣的人和活动</text></view>
    <view class="nav-actions"><button data-name="搜索公开活动" bindtap="showUnavailable" aria-label="搜索公开活动暂未开放"><image src="./assets/ph-magnifying-glass-bold.svg" mode="aspectFit" /></button><button data-name="筛选公开活动" bindtap="showUnavailable" aria-label="筛选公开活动暂未开放"><image src="./assets/ph-funnel-simple-bold.svg" mode="aspectFit" /></button></view>
    <view class="brand-sticker">GOOD PEOPLE MORE PLANS ✦</view>
  </view>
  <view class="discover-main">
    <scroll-view class="category-scroll" style="top: calc({{statusBarHeight}}px + 56px)" scroll-x="true" show-scrollbar="false"><view class="category-row"><button wx:for="{{categories}}" wx:key="*this" class="category {{index === 0 ? 'first' : ''}}" data-name="{{item}}分类" bindtap="selectCategory" aria-label="{{index === 0 ? '查看全部活动灵感' : item === '附近' ? '查看附近活动状态与城市选择' : item + '分类暂未开放'}}">{{item}}</button></view></scroll-view>
    <view class="featured-grid" aria-label="活动发起灵感">
      <button wx:for="{{inspirationCards}}" wx:key="title" class="featured-card" data-title="{{item.title}}" bindtap="openInspiration" aria-label="查看{{item.title}}活动灵感">
        <view class="featured-cover featured-cover-{{item.stickerVariant}}">
          <image src="{{item.image}}" mode="aspectFill" />
          <view class="cover-shade"></view>
          <view class="featured-sticker featured-sticker-{{item.stickerVariant}}"><view class="sticker-head"><text wx:for="{{item.stickerLines}}" wx:for-item="line" wx:key="*this">{{line}}</text></view><view class="sticker-note"><text wx:for="{{item.stickerNoteLines}}" wx:for-item="line" wx:key="*this">{{line}}</text></view></view>
          <view class="featured-favorite" data-name="收藏灵感" catchtap="showUnavailable"><image src="./assets/ph-heart-bold.svg" mode="aspectFit" /></view>
          <view class="featured-tags"><view class="featured-tag-primary"><image wx:if="{{item.stickerVariant === 'city'}}" src="./assets/ph-compass-fill.svg" mode="aspectFit" /><image wx:elif="{{item.stickerVariant === 'basketball'}}" src="./assets/ph-barbell-fill.svg" mode="aspectFit" /><image wx:elif="{{item.stickerVariant === 'coffee'}}" src="./assets/ph-fork-knife-fill.svg" mode="aspectFit" /><image wx:else src="./assets/ph-game-controller-fill.svg" mode="aspectFit" /><text>{{item.tags[0]}}</text></view><view class="featured-tag-secondary"><text>{{item.tags[1]}}</text></view></view>
        </view>
        <view class="featured-body">
          <view><view class="featured-title">{{item.title}}</view><view class="featured-copy">{{item.subtitle}}</view><view class="featured-facts"><view><image src="./assets/ph-calendar-blank-regular.svg" mode="aspectFit" /><text>暂无活动时间</text></view><view><image src="./assets/ph-map-pin-regular.svg" mode="aspectFit" /><text>暂无真实场地</text></view></view></view>
          <view class="featured-foot"><text>仅供构思 · 暂不可报名</text><view><text class="featured-theme featured-theme-{{item.stickerVariant}}">{{item.tags[0]}}</text></view></view>
        </view>
      </button>
    </view>
    <view class="discovery-entry-strip" id="discoveryAvailability"><text>公开找局暂未开放 · 暂不可搜索或报名</text><button bindtap="jumpToInvite" aria-label="跳转到邀请口令输入">输入邀请口令　›</button></view>
    <view wx:if="{{availabilityMessage}}" class="availability-reply">{{availabilityMessage}}</view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>灵感推荐</text></view><button bindtap="rotateRecommendations" class="section-link">换一批　↻</button></view>
    <view class="recommend-note">照片为发起灵感，不是公开招募列表；当前仅支持创建羽毛球活动。</view>
    <scroll-view class="recommend-scroll" scroll-x="true" show-scrollbar="false"><view class="recommend-row"><button wx:for="{{recommendationCards}}" wx:key="title" class="recommend-card" data-title="{{item.title}}" bindtap="openInspiration" aria-label="查看{{item.title}}发起灵感"><view class="recommend-cover"><image src="{{item.image}}" mode="aspectFill" /><view class="recommend-favorite" data-name="收藏灵感" catchtap="showUnavailable" aria-label="收藏灵感暂未开放">♡</view></view><view class="recommend-card-copy"><text>{{item.title}}</text><text>发起灵感 · {{item.category}}</text><text>仅供构思 · 暂不可报名</text></view></button></view></scroll-view>

    <view class="section-heading" id="nearbySection"><view><text class="section-mark">⌖</text><text wx:if="{{personalState === 'READY' && nearbyPersonalEvents.length > 0}}">我在{{city}}的活动</text><text wx:else>附近正在发生</text></view><button bindtap="openCity" class="section-link">{{city}}　›</button></view>
    <view class="nearby-card"><view class="nearby-map"><view class="map-grid"></view><view class="map-pin">⌖</view><text class="map-label">没有读取精确位置</text></view><view class="nearby-body {{personalState === 'READY' && nearbyPersonalEvents.length > 0 ? 'has-personal' : ''}}"><block wx:if="{{personalState === 'READY' && nearbyPersonalEvents.length > 0}}"><view class="nearby-title">本人的活动</view><view class="nearby-own-note">仅本人可见 · 非公开附近列表</view><button wx:for="{{nearbyPersonalEvents}}" wx:key="id" class="nearby-personal-row" data-id="{{item.id}}" bindtap="openPersonalEvent" aria-label="查看{{item.title}}本人活动详情"><image src="{{item.cover}}" mode="aspectFill" /><view class="nearby-personal-copy"><text class="nearby-personal-title">{{item.title}}</text><text class="nearby-personal-fact">{{item.dateLabel}} · {{item.statusLabel}}</text><text class="nearby-personal-fact">{{item.locationLabel}}</text></view></button></block><block wx:else><view class="nearby-title">附近活动待开放</view><view class="nearby-copy">公开找局列表未开放</view><view class="nearby-copy">{{city}}仅为浏览偏好</view><button bindtap="openCity" class="nearby-action">选择城市　→</button></block></view></view>

    <scroll-view class="campaign-scroll" scroll-x="true" show-scrollbar="false"><view class="campaign-row"><button class="campaign-card campaign-pink" data-title="女生友好" bindtap="openInspiration"><text class="campaign-kicker">GIRLS SUPPORT</text><text class="campaign-title">女生友好</text><text class="campaign-icon">✦</text></button><button class="campaign-card campaign-mint" data-title="新手友好" bindtap="openInspiration"><text class="campaign-kicker">NEW EXPLORER</text><text class="campaign-title">新手友好</text><text class="campaign-icon">⌖</text></button><button class="campaign-card campaign-lime" data-title="今晚有空" bindtap="openInspiration"><text class="campaign-kicker">TONIGHT ?</text><text class="campaign-title">今晚有空 ☾</text><text class="campaign-icon">☾</text></button></view></scroll-view>

    <view class="section-heading" id="personalEventsSection"><view><text class="section-mark">♧</text><text>与你有关的活动</text></view><button bindtap="goPersonalAll" class="section-link">查看全部　›</button></view>
    <view class="personal-note">仅展示本人已参与或主办的活动；公开好友找局尚未开放。</view>
    <view wx:if="{{personalState === 'LOADING'}}" class="personal-state">正在核对本人活动…</view>
    <view wx:if="{{personalState === 'ERROR'}}" class="personal-state">活动暂时无法读取，返回首页可重试。</view>
    <view wx:if="{{personalState === 'READY' && personalEvents.length === 0}}" class="personal-state"><view>还没有可展示的活动</view><button bindtap="goCreate">发起第一场羽毛球活动　→</button></view>
    <scroll-view wx:if="{{personalState === 'READY' && personalEvents.length > 0}}" class="personal-scroll" scroll-x="true" show-scrollbar="false"><view class="personal-row"><button wx:for="{{personalEvents}}" wx:key="id" class="personal-card" data-id="{{item.id}}" bindtap="openPersonalEvent" aria-label="查看{{item.title}}活动详情"><view class="personal-cover"><image src="{{item.cover}}" mode="aspectFill" /><text>{{item.statusLabel}}</text></view><view class="personal-body"><view>{{item.title}}</view><text class="personal-time">▣　{{item.dateLabel}}{{item.endTimeLabel}}</text><text class="personal-location">⌖　{{item.locationLabel}}</text><text class="personal-source">{{item.isHost ? '我主办的活动' : '我参与的活动'}} · 查看详情 ↗</text></view></button></view></scroll-view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>真实的人，真实的瞬间</text></view></view>
    <view class="moment-note">灵感影像展示 · 活动照片与好友动态尚未开放</view>
    <view class="moment-grid"><view class="moment-cell"><image src="/assets/stitch/caper_discover_basketball.jpg" mode="aspectFill" /><text>GOOD PEOPLE</text></view><view class="moment-cell"><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill" /><text>城市漫步</text></view><view class="moment-cell"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><text>BETTER TOGETHER</text></view><view class="moment-cell"><image src="/assets/stitch/caper_discover_camping.jpg" mode="aspectFill" /><text>星空灵感</text></view><view class="moment-cell"><image src="/assets/stitch/caper_discover_boardgame.jpg" mode="aspectFill" /><text>桌游时光</text></view><view class="moment-cell"><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill" /><text>SAME VIBES</text></view></view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>大家都在说</text></view><button bindtap="goPersonalAll" class="section-link">我的活动　›</button></view>
    <view class="voices-card"><view class="voices-orb">☺</view><view><view class="voices-title">下一段真实故事，从见面开始</view><view class="voices-copy">当前没有可公开展示的成员评价。参加活动后的反馈以本人活动详情为准。</view></view></view>

    <view class="section-heading"><view><text class="section-mark">🔥</text><text>本周精选灵感</text></view><button bindtap="goCreate" class="section-link">去发起　›</button></view>
    <view class="weekly-grid"><button class="weekly-card" data-title="春日野餐" bindtap="openInspiration"><view class="weekly-cover weekly-sage">野餐</view><view class="weekly-copy">春日野餐<text>发起灵感 · 户外</text></view></button><button class="weekly-card" data-title="胶片摄影" bindtap="openInspiration"><view class="weekly-cover weekly-purple">胶片</view><view class="weekly-copy">胶片摄影<text>发起灵感 · 文艺</text></view></button><button class="weekly-card" data-title="烘焙体验" bindtap="openInspiration"><view class="weekly-cover weekly-amber">烘焙</view><view class="weekly-copy">烘焙体验<text>发起灵感 · 美食</text></view></button><button class="weekly-card" data-title="城市走读" bindtap="openInspiration"><view class="weekly-cover weekly-indigo">走读</view><view class="weekly-copy">城市走读<text>发起灵感 · 城市</text></view></button><button class="weekly-card" data-title="近郊徒步" bindtap="openInspiration"><view class="weekly-cover weekly-teal">徒步</view><view class="weekly-copy">近郊徒步<text>发起灵感 · 户外</text></view></button><button class="weekly-card" data-title="咖啡馆聊天" bindtap="openInspiration"><view class="weekly-cover weekly-stone">咖啡</view><view class="weekly-copy">咖啡馆聊天<text>发起灵感 · 美食</text></view></button></view>

    <view class="section-heading"><view><text class="section-mark">⌖</text><text>城市探索 · City Walk</text></view><button bindtap="openCity" class="section-link">选择城市　›</button></view>
    <view class="walk-grid"><button data-title="城市漫步" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill" /><view><text>城市漫步</text><text>走出家门，遇见同路的人</text></view></button><button data-title="山野徒步" bindtap="openInspiration"><image src="/assets/stitch/caper_home_hiking.jpg" mode="aspectFill" /><view><text>山野徒步</text><text>把周末还给自然</text></view></button></view>

    <view class="section-heading"><view><text class="section-mark">⌂</text><text>你可能喜欢的好地方</text></view></view>
    <view class="place-note">以下照片仅是活动场景灵感；没有预订场地或验证营业信息。</view>
    <view class="place-grid"><button data-title="咖啡馆聊天" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><text>咖啡馆聊天</text></button><button data-title="球场约局" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_basketball.jpg" mode="aspectFill" /><text>球场约局</text></button><button data-title="周末看展" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill" /><text>周末看展</text></button><button data-title="户外公园" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill" /><text>户外公园</text></button></view>

    <view class="invite-card" id="inviteEntry"><view class="invite-heading">收到朋友的邀请？</view><view class="invite-copy">输入口令或扫描活动邀请卡，查看真实状态与报名规则。</view><view class="invite-row"><input placeholder="输入邀请口令" value="{{tokenInput}}" bindinput="tokenChanged" /><button bindtap="openInvite">打开邀请</button></view><button class="invite-preview-action" bindtap="previewInvite" disabled="{{invitePreviewState === 'LOADING'}}">{{invitePreviewState === 'LOADING' ? '正在核对邀请…' : '先预览这场邀请　›'}}</button><view wx:if="{{invitePreview}}" class="invite-preview"><image src="{{invitePreview.cover}}" mode="aspectFill" aria-label="活动场景示意配图"/><view class="invite-preview-body"><view class="invite-preview-heading"><text>凭口令可见 · {{invitePreview.statusLabel}}</text><text>示意配图</text></view><view class="invite-preview-title">{{invitePreview.title}}</view><view class="invite-preview-fact">▣　{{invitePreview.dateLabel}}{{invitePreview.endTimeLabel}}</view><view class="invite-preview-fact">⌖　{{invitePreview.locationLabel}}</view><button bindtap="openPreviewedInvite">查看活动详情与报名规则　↗</button></view></view><button class="invite-scan" bindtap="scanInviteQr" aria-label="扫描活动邀请卡二维码">⌗　扫描邀请二维码</button><view wx:if="{{message}}" class="message">{{message}}</view></view>
    <button class="create-card" bindtap="goCreate"><view class="create-icon">＋</view><view><view class="create-title">发起自己的活动</view><view class="create-copy">填写真实时间与规则，确认后再发布</view></view><text class="create-arrow">→</text></button>
    <view class="discover-foot">GOOD PEOPLE · REAL MEETUPS · BRIGHTER DAYS</view>
  </view>
</view>
