<view class="discover-page">
  <view class="discover-status-shield" style="height: {{statusBarHeight}}px"></view>
  <view class="safe-area" style="height: {{statusBarHeight}}px"></view>
  <view class="discover-nav" style="top: {{statusBarHeight}}px; padding-right: {{headerPaddingRight}}"><button class="brand" bindtap="goHome" aria-label="返回首页"><text class="brand-mark">✹</text><text class="brand-name">耍起<text> CAPER</text></text></button><view class="nav-fill"></view><button class="nav-city" bindtap="openCity">📍 {{city}} ⌄</button></view>
  <view class="discover-main">
    <view class="page-head"><view><view class="head-title">找局</view><view class="head-caption">发现身边有趣的人和活动</view></view><view class="head-actions"><button bindtap="showUnavailable" aria-label="搜索公开活动">⌕</button><button bindtap="showUnavailable" aria-label="筛选公开活动">☷</button></view></view>
    <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false"><view class="category-row"><button wx:for="{{categories}}" wx:key="*this" class="category {{index === 0 ? 'first' : ''}}" bindtap="showUnavailable">{{item}}</button></view></scroll-view>
    <view class="featured-grid" aria-label="活动发起灵感"><button wx:for="{{inspirationCards}}" wx:key="title" class="featured-card" data-title="{{item.title}}" bindtap="openInspiration" aria-label="查看{{item.title}}活动灵感"><view class="featured-cover"><image src="{{item.image}}" mode="aspectFill" /><view class="cover-shade"></view><text class="card-spark">{{item.title}}</text><text class="idea-label">发起灵感</text></view><view class="featured-body"><view class="featured-title">{{item.title}}</view><view class="featured-copy">{{item.subtitle}}</view><view class="featured-foot"><text>{{item.tag}}</text><text class="foot-arrow">↗</text></view></view></button></view>
    <view class="availability" id="discoveryAvailability"><view class="availability-icon">✦</view><view><view class="availability-title">公开找局暂未开放</view><view class="availability-copy">上方仅为发起灵感，暂不可搜索或报名。收到邀请可在下方输入口令。</view></view></view>
    <view wx:if="{{availabilityMessage}}" class="availability-reply">{{availabilityMessage}}</view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>更多活动灵感</text></view><button bindtap="showUnavailable" class="section-link">公开推荐待开放　›</button></view>
    <view class="recommend-note">先选一个灵感，本地规则可帮助整理羽毛球草稿；发布仍由你确认。</view>
    <scroll-view class="recommend-scroll" scroll-x="true" show-scrollbar="false"><view class="recommend-row"><button class="recommend-card" data-title="冲浪体验课" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_surf.jpg" mode="aspectFill" /><view class="recommend-card-copy"><text>冲浪体验课</text><text>发起灵感 · 户外运动</text></view></button><button class="recommend-card" data-title="周末一起看展" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill" /><view class="recommend-card-copy"><text>周末一起看展</text><text>发起灵感 · 文艺生活</text></view></button><button class="recommend-card" data-title="咖啡馆里聊一聊" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><view class="recommend-card-copy"><text>咖啡馆里聊一聊</text><text>发起灵感 · 美食社交</text></view></button></view></scroll-view>

    <view class="section-heading"><view><text class="section-mark">⌖</text><text>附近正在发生</text></view><button bindtap="openCity" class="section-link">{{city}}　›</button></view>
    <view class="nearby-card"><view class="nearby-map"><view class="map-grid"></view><view class="map-pin">⌖</view><text class="map-label">城市位置仅作浏览偏好</text></view><view class="nearby-body"><view class="nearby-title">附近活动待开放</view><view class="nearby-copy">当前没有公开找局列表，也没有读取你的精确位置。</view><button bindtap="openCity" class="nearby-action">选择城市　→</button></view></view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>主题精选</text></view><text class="section-caption">找到你的下一场灵感</text></view>
    <view class="theme-grid"><button class="theme-card theme-lime" data-title="新手友好" bindtap="openInspiration"><text class="theme-kicker">START HERE</text><text class="theme-name">新手友好</text><text class="theme-icon">☺</text></button><button class="theme-card theme-blue" data-title="运动起来" bindtap="openInspiration"><text class="theme-kicker">MOVE TOGETHER</text><text class="theme-name">运动起来</text><text class="theme-icon">🏸</text></button><button class="theme-card theme-pink" data-title="城市漫步" bindtap="openInspiration"><text class="theme-kicker">TAKE A WALK</text><text class="theme-name">城市漫步</text><text class="theme-icon">✦</text></button><button class="theme-card theme-night" data-title="周末有约" bindtap="openInspiration"><text class="theme-kicker">GOOD TIMES</text><text class="theme-name">周末有约</text><text class="theme-icon">☾</text></button></view>

    <view class="section-heading"><view><text class="section-mark">♧</text><text>与你有关的活动</text></view><button bindtap="goHome" class="section-link">查看全部　›</button></view>
    <view class="personal-note">仅展示本人已参与或主办的活动；公开好友找局尚未开放。</view>
    <view wx:if="{{personalState === 'LOADING'}}" class="personal-state">正在核对本人活动…</view>
    <view wx:if="{{personalState === 'ERROR'}}" class="personal-state">活动暂时无法读取，返回首页可重试。</view>
    <view wx:if="{{personalState === 'READY' && personalEvents.length === 0}}" class="personal-state"><view>还没有可展示的活动</view><button bindtap="goCreate">发起第一场羽毛球活动　→</button></view>
    <scroll-view wx:if="{{personalState === 'READY' && personalEvents.length > 0}}" class="personal-scroll" scroll-x="true" show-scrollbar="false"><view class="personal-row"><button wx:for="{{personalEvents}}" wx:key="id" class="personal-card" data-id="{{item.id}}" bindtap="openPersonalEvent" aria-label="查看{{item.title}}活动详情"><view class="personal-cover"><image src="{{item.cover}}" mode="aspectFill" /><text>{{item.statusLabel}}</text></view><view class="personal-body"><view>{{item.title}}</view><text>{{item.dateLabel}} · 以活动详情为准</text></view></button></view></scroll-view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>真实的人，真实的瞬间</text></view></view>
    <view class="moment-note">灵感影像展示 · 活动照片与好友动态尚未开放</view>
    <view class="moment-grid"><image src="/assets/stitch/caper_discover_boardgame.jpg" mode="aspectFill" /><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill" /><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill" /></view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>大家都在说</text></view><button bindtap="goHome" class="section-link">我的活动　›</button></view>
    <view class="voices-card"><view class="voices-orb">☺</view><view><view class="voices-title">下一段真实故事，从见面开始</view><view class="voices-copy">当前没有可公开展示的成员评价。参加活动后的反馈以本人活动详情为准。</view></view></view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>本周精选灵感</text></view><button bindtap="goCreate" class="section-link">去发起　›</button></view>
    <view class="weekly-grid"><button class="weekly-card" data-title="羽毛球友好局" bindtap="openInspiration"><image src="/assets/stitch/caper_home_badminton.jpg" mode="aspectFill" /><view class="weekly-shade"></view><view class="weekly-copy">羽毛球友好局<text>发起灵感 · 运动</text></view></button><button class="weekly-card" data-title="露营与户外" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_camping.jpg" mode="aspectFill" /><view class="weekly-shade"></view><view class="weekly-copy">露营与户外<text>发起灵感 · 户外</text></view></button><button class="weekly-card" data-title="周末桌游" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_boardgame.jpg" mode="aspectFill" /><view class="weekly-shade"></view><view class="weekly-copy">周末桌游<text>发起灵感 · 兴趣</text></view></button></view>

    <view class="section-heading"><view><text class="section-mark">⌖</text><text>城市探索 · City Walk</text></view><button bindtap="openCity" class="section-link">选择城市　›</button></view>
    <view class="walk-grid"><button data-title="城市漫步" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill" /><view><text>城市漫步</text><text>走出家门，遇见同路的人</text></view></button><button data-title="山野徒步" bindtap="openInspiration"><image src="/assets/stitch/caper_home_hiking.jpg" mode="aspectFill" /><view><text>山野徒步</text><text>把周末还给自然</text></view></button></view>

    <view class="section-heading"><view><text class="section-mark">⌂</text><text>你可能喜欢的好地方</text></view></view>
    <view class="place-note">以下照片仅是活动场景灵感；没有预订场地或验证营业信息。</view>
    <view class="place-grid"><button data-title="咖啡馆聊天" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><text>咖啡馆聊天</text></button><button data-title="球场约局" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_basketball.jpg" mode="aspectFill" /><text>球场约局</text></button><button data-title="周末看展" bindtap="openInspiration"><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill" /><text>周末看展</text></button></view>

    <view class="invite-card"><view class="invite-heading">收到朋友的邀请？</view><view class="invite-copy">输入口令，查看这场活动的真实状态与报名规则。</view><view class="invite-row"><input placeholder="输入邀请口令" value="{{tokenInput}}" bindinput="tokenChanged" /><button bindtap="openInvite">打开邀请</button></view><view wx:if="{{message}}" class="message">{{message}}</view></view>
    <button class="create-card" bindtap="goCreate"><view class="create-icon">＋</view><view><view class="create-title">发起自己的活动</view><view class="create-copy">填写真实时间与规则，确认后再发布</view></view><text class="create-arrow">→</text></button>
    <view class="discover-foot">GOOD PEOPLE · REAL MEETUPS · BRIGHTER DAYS</view>
  </view>
</view>
