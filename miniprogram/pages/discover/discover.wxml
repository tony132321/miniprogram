<view class="discover-page">
  <view class="safe-area" style="height: {{statusBarHeight}}px"></view>
  <view class="discover-nav"><button class="brand" bindtap="goHome" aria-label="返回首页"><text class="brand-mark">✹</text><text class="brand-name">耍起<text> CAPER</text></text></button><view class="nav-fill"></view><button class="nav-city" bindtap="openCity">📍 {{city}} ⌄</button></view>
  <view class="discover-main">
    <view class="page-head"><view><view class="head-title">找局</view><view class="head-caption">发现身边有趣的人和活动</view></view><view class="head-actions"><button bindtap="showUnavailable" aria-label="搜索公开活动">⌕</button><button bindtap="showUnavailable" aria-label="筛选公开活动">☷</button></view></view>
    <view class="search-row"><button class="search-placeholder" bindtap="showUnavailable"><text>⌕</text><text>公开找局未开放，暂不可搜索</text></button></view>
    <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false"><view class="category-row"><button wx:for="{{categories}}" wx:key="*this" class="category {{index === 0 ? 'first' : ''}}" bindtap="showUnavailable">{{item}}</button></view></scroll-view>
    <view class="availability" id="discoveryAvailability"><view class="availability-icon">✦</view><view><view class="availability-title">公开找局暂未开放</view><view class="availability-copy">以下是活动灵感，不是正在招募的活动。收到邀请可用口令加入，或自己发起一场。</view></view></view>
    <view wx:if="{{availabilityMessage}}" class="availability-reply">{{availabilityMessage}}</view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>精选活动灵感</text></view><text class="section-caption">从想法开始</text></view>
    <view class="featured-grid"><button wx:for="{{inspirationCards}}" wx:key="title" class="featured-card" bindtap="goCreate" aria-label="发起{{item.title}}活动"><view class="featured-cover"><image src="{{item.image}}" mode="aspectFill" /><view class="cover-shade"></view><text class="card-spark">{{item.title}}</text><text class="idea-label">发起灵感</text></view><view class="featured-body"><view class="featured-title">{{item.title}}</view><view class="featured-copy">{{item.subtitle}}</view><view class="featured-foot"><text>{{item.tag}}</text><text class="foot-arrow">↗</text></view></view></button></view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>AI 为你推荐</text></view><button bindtap="showUnavailable" class="section-link">公开推荐待开放　›</button></view>
    <view class="recommend-note">先选一个灵感，AI 可以帮助整理活动草稿；发布仍由你确认。</view>
    <scroll-view class="recommend-scroll" scroll-x="true" show-scrollbar="false"><view class="recommend-row"><button class="recommend-card" bindtap="goCreate"><image src="/assets/stitch/caper_discover_surf.jpg" mode="aspectFill" /><view class="recommend-card-copy"><text>冲浪体验课</text><text>发起灵感 · 户外运动</text></view></button><button class="recommend-card" bindtap="goCreate"><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill" /><view class="recommend-card-copy"><text>周末一起看展</text><text>发起灵感 · 文艺生活</text></view></button><button class="recommend-card" bindtap="goCreate"><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><view class="recommend-card-copy"><text>咖啡馆里聊一聊</text><text>发起灵感 · 美食社交</text></view></button></view></scroll-view>

    <view class="section-heading"><view><text class="section-mark">⌖</text><text>附近正在发生</text></view><button bindtap="openCity" class="section-link">{{city}}　›</button></view>
    <view class="nearby-card"><view class="nearby-map"><view class="map-grid"></view><view class="map-pin">⌖</view><text class="map-label">城市位置仅作浏览偏好</text></view><view class="nearby-body"><view class="nearby-title">附近活动待开放</view><view class="nearby-copy">当前没有公开找局列表，也没有读取你的精确位置。</view><button bindtap="openCity" class="nearby-action">选择城市　→</button></view></view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>主题精选</text></view><text class="section-caption">找到你的下一场灵感</text></view>
    <view class="theme-grid"><button class="theme-card theme-lime" bindtap="goCreate"><text class="theme-kicker">START HERE</text><text class="theme-name">新手友好</text><text class="theme-icon">☺</text></button><button class="theme-card theme-blue" bindtap="goCreate"><text class="theme-kicker">MOVE TOGETHER</text><text class="theme-name">运动起来</text><text class="theme-icon">🏸</text></button><button class="theme-card theme-pink" bindtap="goCreate"><text class="theme-kicker">TAKE A WALK</text><text class="theme-name">城市漫步</text><text class="theme-icon">✦</text></button><button class="theme-card theme-night" bindtap="goCreate"><text class="theme-kicker">GOOD TIMES</text><text class="theme-name">周末有约</text><text class="theme-icon">☾</text></button></view>

    <view class="section-heading"><view><text class="section-mark">✦</text><text>真实的人，真实的瞬间</text></view></view>
    <view class="moment-note">灵感影像展示 · 活动照片与好友动态尚未开放</view>
    <view class="moment-grid"><image src="/assets/stitch/caper_discover_boardgame.jpg" mode="aspectFill" /><image src="/assets/stitch/caper_discover_coffee.jpg" mode="aspectFill" /><image src="/assets/stitch/caper_discover_citywalk.jpg" mode="aspectFill" /><image src="/assets/stitch/caper_discover_art.jpg" mode="aspectFill" /></view>

    <view class="invite-card"><view class="invite-heading">收到朋友的邀请？</view><view class="invite-copy">输入口令，查看这场活动的真实状态与报名规则。</view><view class="invite-row"><input placeholder="输入邀请口令" value="{{tokenInput}}" bindinput="tokenChanged" /><button bindtap="openInvite">打开邀请</button></view><view wx:if="{{message}}" class="message">{{message}}</view></view>
    <button class="create-card" bindtap="goCreate"><view class="create-icon">＋</view><view><view class="create-title">发起自己的活动</view><view class="create-copy">填写真实时间与规则，确认后再发布</view></view><text class="create-arrow">→</text></button>
    <view class="discover-foot">GOOD PEOPLE · REAL MEETUPS · BRIGHTER DAYS</view>
  </view>
</view>
