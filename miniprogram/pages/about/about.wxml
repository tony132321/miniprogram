<view class="about-page" style="padding-top: {{statusBarHeight}}px">
  <view class="about-status" style="height: {{statusBarHeight}}px"></view>
  <view class="about-header" style="padding-right: {{headerPaddingRight}}; top: {{statusBarHeight}}px">
    <button class="about-back" bindtap="back" aria-label="返回"><image src="./assets/arrow_back_ios_new.svg" mode="aspectFit" /></button>
    <view class="about-header-title">关于 Project IRL</view>
    <view class="about-header-actions"><button class="about-header-more" bindtap="toggleMore" aria-label="更多页面入口" aria-expanded="{{moreOpen}}"><image src="./assets/more_horiz.svg" mode="aspectFit" /></button><button class="about-header-avatar" bindtap="goProfile" aria-label="返回我的页面"><image src="./assets/person.svg" mode="aspectFit" /></button></view>
    <view wx:if="{{moreOpen}}" class="about-header-menu" style="right: {{headerPaddingRight}}"><button bindtap="goReleaseNotes">版本说明　›</button><button bindtap="goGuidelines">社区公约　›</button><button bindtap="goOpenSource">开源致谢　›</button></view>
  </view>
  <view class="brand-hero">
    <view class="brand-aura blue-aura"></view><view class="brand-aura lime-aura"></view>
    <view class="logo"><view class="logo-inner"><image class="logo-symbol" src="./assets/infinity-spark.svg" mode="aspectFit" /><view class="logo-dot"></view></view></view>
    <view class="title">Project IRL</view>
    <view class="slogan">把有趣的人聚在真实世界 <text class="slogan-separator">·</text> <text>MORE REAL CONNECTIONS</text></view>
    <view class="version-line"><view class="version-pill">R1 本地测试候选</view><view class="candidate-pill"><image src="./assets/check_circle.svg" mode="aspectFit" /><text>功能状态见下方</text></view></view>
  </view>
  <view class="card manifesto-card"><image class="manifesto-quote" src="./assets/format_quote.svg" mode="aspectFit" /><view class="manifesto-icon"><image src="./assets/favorite.svg" mode="aspectFit" /></view><view class="manifesto-copy"><view class="eyebrow">MANIFESTO</view><view class="manifesto">「在屏幕之外，找回真实相聚的心跳与温度。」</view><view class="body">Project IRL 用技术支持受控线下相聚。报名、通知和安全处理以应用中的真实记录为准。</view></view></view>
  <view class="section-label">探索与规范</view>
  <view class="card action-list">
    <button bindtap="goReleaseNotes"><view class="list-icon lime"><image src="./assets/auto_awesome.svg" mode="aspectFit" /></view><view class="list-copy"><view class="list-title">当前功能与版本说明 <text>R1</text></view><view class="list-note">了解已接通的能力与待开放方向</view></view><image class="list-arrow" src="./assets/arrow_forward_ios.svg" mode="aspectFit" /></button><view class="list-divider"></view>
    <button bindtap="goGuidelines"><view class="list-icon blue"><image src="./assets/diversity_1.svg" mode="aspectFit" /></view><view class="list-copy"><view class="list-title">社区公约与真实社交价值观</view><view class="list-note">友善包容、守时守约、共建纯净氛围</view></view><image class="list-arrow" src="./assets/arrow_forward_ios.svg" mode="aspectFit" /></button><view class="list-divider"></view>
    <button bindtap="goOpenSource"><view class="list-icon violet"><image src="./assets/code.svg" mode="aspectFit" /></view><view class="list-copy"><view class="list-title">开源许可与致谢</view><view class="list-note"><text decode="{{true}}">Open Source Software &amp; Frameworks</text></view></view><image class="list-arrow" src="./assets/arrow_forward_ios.svg" mode="aspectFit" /></button>
  </view>
  <view class="section-label network-label">项目与官方渠道</view>
  <view class="card network-card"><view class="network-head"><view class="network-heading"><view class="network-dot"></view><text>官方账号尚未公布</text></view><text class="network-name">Project IRL</text></view>
    <view class="network-grid"><view><view class="network-icon green"><image src="./assets/chat.svg" mode="aspectFit" /></view><text>微信公众号</text><text class="network-sub">待公布</text></view><view><view class="network-icon pink"><image src="./assets/photo_camera.svg" mode="aspectFit" /></view><text>小红书</text><text class="network-sub">待公布</text></view><view><view class="network-icon lime"><image src="./assets/forum.svg" mode="aspectFit" /></view><text>即刻</text><text class="network-sub">待公布</text></view></view>
    <button class="repository-link" bindtap="goOpenSource"><view><image class="repository-globe" src="./assets/public.svg" mode="aspectFit" /><text>公开工程与依赖说明</text></view><view class="repository-action"><text>查看</text><image src="./assets/open_in_new.svg" mode="aspectFit" /></view></button>
  </view>
  <view class="about-actions"><button bindtap="goDiscover"><image src="./assets/star.svg" mode="aspectFit" /><text>浏览活动灵感</text></button><button bindtap="goCreate"><image src="./assets/group_add.svg" mode="aspectFit" /><text>发起受控活动</text></button></view>
  <view class="foot"><view class="foot-statement"><view class="foot-dot"></view><text>当前为本地测试候选</text><view class="foot-dot"></view></view><view class="foot-status">正式主体与发布信息待核实。</view><view class="foot-tagline">REAL PEOPLE · REAL MEETUPS</view></view>
</view>
