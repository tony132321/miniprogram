page { padding: 16px; box-sizing: border-box; font-size: 16px; }
button { margin: 8px 0; }
input, textarea { border: 1px solid #aaa; padding: 8px; margin: 6px 0; width: 100%; box-sizing: border-box; }
.item { border-bottom: 1px solid #ddd; padding: 12px 0; }
.muted { color: #555; }
.error { color: #9d1b1b; }
