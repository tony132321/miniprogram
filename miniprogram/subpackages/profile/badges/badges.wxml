<view class="pg10-page badge-page" style="padding-top: {{statusBarHeight}}px">
  <view class="pg10-header"><button class="pg10-back" bindtap="back" aria-label="返回">‹</button><view class="pg10-header-title">Edit Profile</view><view class="pg10-header-spacer"></view></view>
  <view class="badge-status"><view><text class="muted-dot"></text>勋章系统尚未启用</view><text class="status-pill">待开放</text></view>
  <view class="badge-summary"><view class="summary-top"><view class="badge-orb"><view>✧</view><text>—</text></view><view class="summary-copy"><view class="summary-title">成长印记 <text>真实经历</text></view><view class="summary-description">勋章、等级与经验值尚未接入</view><view class="summary-next">✦ 活动记录可在首页查看</view></view></view><view class="xp-card"><view class="xp-row"><text>ϟ　当前经验值</text><text>待开放</text></view><view class="xp-track"></view><view class="xp-note">不会根据未经核验的数据授予称号</view></view></view>
  <view class="showcase"><view class="showcase-head"><view>♧　主页展示位</view><text>最多挂载 4 枚</text></view><view class="showcase-slots"><view wx:for="{{showcaseSlots}}" wx:key="*this" class="showcase-slot"><view class="slot-icon">＋</view><text>待佩戴</text></view></view></view>
  <scroll-view class="badge-tabs" scroll-x="true" show-scrollbar="false"><button wx:for="{{categories}}" wx:key="id" class="badge-tab {{activeCategory === item.id ? 'selected' : ''}}" data-category="{{item.id}}" bindtap="selectCategory">{{item.title}}</button></scroll-view>
  <view class="badge-grid"><button wx:for="{{visibleBadges}}" wx:key="id" class="badge-cell" data-id="{{item.id}}" bindtap="openBadge"><view class="badge-circle {{item.color}}">{{item.icon}}</view><view class="badge-title">{{item.title}}</view><text>{{item.note}} · 待开放</text></button></view>
  <view wx:if="{{badgeMessage}}" class="badge-message">{{badgeMessage}}</view>
  <button class="pg10-primary badge-action" bindtap="goActivities">查看我的真实活动记录　›</button>
</view>
