@import "../common.wxss";
.badge-page { padding-left: 30rpx; padding-right: 30rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.badge-page .pg10-header { position: sticky; z-index: 11; box-sizing: border-box; margin-left: -30rpx; margin-right: -30rpx; padding-left: 28rpx; height: 92rpx; }
.badge-page .pg10-header-title { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 600; }
.badge-header-actions { display: flex; flex: none; align-items: center; gap: 6rpx; }
.badge-header-more,.badge-header-avatar { display: block; flex: none; margin: 0; padding: 0; border: 0; text-align: center; }
.badge-header-more { width: 48rpx; height: 54rpx; background: transparent; color: #171a24; line-height: 54rpx; font-size: 32rpx; font-weight: 800; }
.badge-header-avatar { width: 54rpx; height: 54rpx; border-radius: 50%; background: #064dca; color: #fff; line-height: 54rpx; font-size: 28rpx; font-weight: 800; }
.badge-header-more::after,.badge-header-avatar::after,.badge-header-menu button::after { border: 0; }
.badge-header-menu { position: absolute; top: 86rpx; z-index: 12; width: 245rpx; padding: 8rpx; border: 1rpx solid #edf0f5; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(15,23,42,.14); }
.badge-header-menu button { display: block; box-sizing: border-box; width: 100%; margin: 0; padding: 13rpx 10rpx; border-bottom: 1rpx solid #edf0f5; border-radius: 0; background: transparent; color: #334155; text-align: left; line-height: 1.4; font-size: 20rpx; }
.badge-header-menu button:last-child { border-bottom: 0; }
.badge-status { display: flex; align-items: center; justify-content: space-between; margin: 17rpx 0 16rpx; font-size: 21rpx; color: #424a5a; font-weight: 650; }
.muted-dot { display: inline-block; width: 13rpx; height: 13rpx; border-radius: 50%; background: #a5b0c2; margin-right: 8rpx; }
.status-pill { color: #607049; background: #f2fbe6; border-radius: 30rpx; padding: 7rpx 16rpx; font-size: 19rpx; }
.badge-summary { padding: 26rpx; margin-bottom: 28rpx; border-radius: 31rpx; background: linear-gradient(145deg,#f2effe,#fafdff 60%,#eaf1fe); box-shadow: 0 6rpx 18rpx rgba(39,58,116,.05); }
.summary-top { display: flex; align-items: center; gap: 22rpx; }
.badge-orb { width: 150rpx; height: 150rpx; flex: none; border-radius: 31rpx; background: linear-gradient(135deg,#3e78ed,#6660cd); color: white; text-align: center; box-shadow: 0 10rpx 20rpx rgba(64,69,174,.16); }
.badge-orb view { line-height: 103rpx; font-size: 79rpx; }
.badge-orb text { display: block; font-size: 22rpx; font-weight: 800; }
.summary-copy { flex: 1; min-width: 0; }
.summary-title { color: #171a23; font-size: 29rpx; font-weight: 800; }
.summary-title text { display: inline-block; padding: 4rpx 10rpx; border-radius: 20rpx; background: #eaf1ff; color: #2165ec; font-size: 18rpx; }
.summary-description { color: #5d6678; font-size: 21rpx; margin-top: 9rpx; }
.summary-next { color: #235fe3; font-size: 20rpx; font-weight: 700; margin-top: 9rpx; }
.xp-card { padding: 17rpx 20rpx; margin-top: 19rpx; border-radius: 24rpx; background: rgba(255,255,255,.91); }
.xp-row { display: flex; justify-content: space-between; color: #3d4658; font-size: 21rpx; font-weight: 700; }
.xp-track { height: 12rpx; border-radius: 12rpx; margin: 16rpx 0 8rpx; background: #e8e8f0; }
.xp-note { color: #81889a; text-align: right; font-size: 19rpx; }
.showcase { padding: 23rpx; border-radius: 31rpx; background: #fff; margin-bottom: 30rpx; }
.showcase-head { display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; font-weight: 750; }
.showcase-head text { color: #7d8495; border-radius: 26rpx; padding: 4rpx 12rpx; background: #eeeeF2; font-size: 18rpx; font-weight: 500; }
.showcase-slots { display: flex; gap: 9rpx; margin-top: 17rpx; }
.showcase-slot { flex: 1; min-width: 0; padding: 10rpx 4rpx; border-radius: 17rpx; background: #f4f3f8; text-align: center; color: #7f8797; font-size: 18rpx; }
.slot-icon { width: 52rpx; height: 52rpx; line-height: 52rpx; margin: 0 auto 8rpx; border-radius: 50%; background: #e5e5ed; font-size: 32rpx; }
.badge-tabs { white-space: nowrap; margin-bottom: 20rpx; }
.badge-tab { display: inline-block; width: auto; padding: 12rpx 25rpx; margin: 0 9rpx 0 0; border-radius: 36rpx; background: #fff; color: #3e4656; font-size: 21rpx; line-height: 1.4; }
.badge-tab::after,.badge-cell::after { border: 0; }
.badge-tab.selected { background: #054cc9; color: white; }
.badge-grid { display: flex; flex-wrap: wrap; gap: 15rpx; }
.badge-cell { box-sizing: border-box; width: calc((100% - 30rpx) / 3); min-height: 226rpx; margin: 0; padding: 30rpx 6rpx 21rpx; border-radius: 27rpx; background: #fff; text-align: center; color: #171a23; line-height: 1.35; box-shadow: 0 4rpx 18rpx rgba(40,48,85,.035); }
.badge-circle { width: 98rpx; height: 98rpx; margin: 0 auto 17rpx; border-radius: 29rpx; background: #e9f1ff; color: #225ee8; font-size: 49rpx; line-height: 98rpx; box-shadow: 0 9rpx 20rpx rgba(64,82,118,.10); }
.badge-circle.amber { background: linear-gradient(135deg,#ffd148,#ffaf14); color: white; }
.badge-circle.violet { background: linear-gradient(135deg,#7069df,#433bc8); color: white; }
.badge-circle.lime { background: linear-gradient(135deg,#d2f803,#94c700); color: #253000; }
.badge-circle.pink { background: linear-gradient(135deg,#ff7693,#ff2856); color: white; }
.badge-circle.orange { background: linear-gradient(135deg,#ffc45e,#fc7b66); color: white; }
.badge-circle.coffee { background: linear-gradient(135deg,#d69c0a,#a76504); color: white; }
.badge-circle.blue { background: linear-gradient(135deg,#24b7fa,#205ff0); color: white; }
.badge-circle.muted { background: #e6e5ed; color: #a2a8b7; box-shadow: none; }
.badge-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 700; }
.badge-cell text { display: block; color: #838a9b; font-size: 17rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.badge-activities-link { display: block; width: 100%; margin: 26rpx 0 0; padding: 16rpx; background: transparent; color: #175beb; font-size: 22rpx; font-weight: 700; line-height: 1.5; text-align: center; }
.badge-activities-link::after,.badge-share-action::after { border: 0; }
.badge-bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 15; box-sizing: border-box; padding: 14rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg,rgba(248,247,252,0),#f8f7fc 24%,#f8f7fc); }
.badge-share-note { margin-bottom: 8rpx; color: #747b8b; text-align: center; font-size: 18rpx; }
.badge-share-action { display: flex; align-items: center; justify-content: center; gap: 13rpx; width: 100%; min-height: 90rpx; margin: 0; padding: 0 20rpx; border-radius: 48rpx; background: linear-gradient(105deg,#1764f6,#6356d9); color: #fff; font-size: 27rpx; font-weight: 750; box-shadow: 0 12rpx 27rpx rgba(43,91,218,.22); }
.badge-share-icon { font-size: 31rpx; }
.badge-detail-backdrop { position: fixed; inset: 0; z-index: 20; background: rgba(13,20,41,.45); }
.badge-detail-sheet { position: fixed; z-index: 21; left: 0; right: 0; bottom: 0; box-sizing: border-box; padding: 11rpx 32rpx 45rpx; border-radius: 36rpx 36rpx 0 0; background: #fff; box-shadow: 0 -12rpx 35rpx rgba(13,20,41,.13); }
.badge-detail-handle { width: 72rpx; height: 7rpx; margin: 0 auto 23rpx; border-radius: 8rpx; background: #d5d8e2; }
.badge-detail-top { position: relative; display: flex; align-items: center; justify-content: center; }
.badge-detail-icon { width: 102rpx; height: 102rpx; border-radius: 28rpx; background: #e9f1ff; color: #225ee8; text-align: center; line-height: 102rpx; font-size: 55rpx; box-shadow: 0 10rpx 20rpx rgba(64,82,118,.13); }
.badge-detail-icon.amber { background: linear-gradient(135deg,#ffd148,#ffaf14); color: #fff; }
.badge-detail-icon.violet { background: linear-gradient(135deg,#7069df,#433bc8); color: #fff; }
.badge-detail-icon.lime { background: linear-gradient(135deg,#d2f803,#94c700); color: #253000; }
.badge-detail-icon.pink { background: linear-gradient(135deg,#ff7693,#ff2856); color: #fff; }
.badge-detail-icon.orange { background: linear-gradient(135deg,#ffc45e,#fc7b66); color: #fff; }
.badge-detail-icon.coffee { background: linear-gradient(135deg,#d69c0a,#a76504); color: #fff; }
.badge-detail-icon.blue { background: linear-gradient(135deg,#24b7fa,#205ff0); color: #fff; }
.badge-detail-icon.muted { background: #e6e5ed; color: #a2a8b7; box-shadow: none; }
.badge-detail-close { position: absolute; right: 0; top: 0; width: 56rpx; height: 56rpx; margin: 0; padding: 0; border-radius: 50%; background: #f1f2f6; color: #687385; line-height: 56rpx; font-size: 39rpx; }
.badge-detail-close::after,.badge-detail-activities::after { border: 0; }
.badge-detail-title { margin-top: 17rpx; color: #171a23; text-align: center; font-size: 31rpx; font-weight: 800; }
.badge-detail-category { margin-top: 4rpx; color: #667085; text-align: center; font-size: 20rpx; }
.badge-detail-notice { margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; background: #f5f6fa; color: #555f72; font-size: 21rpx; line-height: 1.55; }
.badge-detail-activities { width: 100%; margin: 24rpx 0 0; border-radius: 38rpx; background: #2164f0; color: #fff; line-height: 2.4; font-size: 23rpx; font-weight: 700; }

/* Wave60: source tokens at 375px; closed-service copy may grow naturally. */
.badge-page { padding-left: 32rpx; padding-right: 32rpx; background: #faf8fe; color: #1a1b1f; font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif; }
.badge-page .pg10-header { height: 112rpx; margin-left: -32rpx; margin-right: -32rpx; margin-bottom: 0; padding-left: 32rpx; background: rgba(250,248,254,.85); }
.badge-page .pg10-back { width: 88rpx; min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; }
.badge-page .pg10-header-title { font-size: 34rpx; line-height: 44rpx; font-weight: 600; }
.badge-header-actions { gap: 8rpx; }
.badge-header-more { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.badge-header-avatar { width: 64rpx; height: 64rpx; background: #004cc8; display: flex; align-items: center; justify-content: center; }
.badge-header-menu { top: 104rpx; }
.badge-status { margin: 8rpx 0 16rpx; font-size: 26rpx; line-height: 32rpx; font-weight: 600; color: #424655; }
.muted-dot { width: 16rpx; height: 16rpx; }
.status-pill { background: #F3FEE7; color: #4d5d00; padding: 4rpx 16rpx; font-size: 22rpx; line-height: 28rpx; }
.badge-summary { position: relative; padding: 32rpx; margin-bottom: 32rpx; border-radius: 32rpx; background: linear-gradient(135deg,#F2F1FD,#FFFFFF 50%,#EBF2FE); }
.summary-top { gap: 24rpx; }
.badge-orb { box-sizing: border-box; width: 160rpx; height: 160rpx; padding: 8rpx; border-radius: 32rpx; background: linear-gradient(135deg,#1D64F2,#4c4aca,#5856D6); }
.badge-orb-inner { width: 100%; height: 100%; border-radius: 24rpx; background: rgba(255,255,255,.2); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.badge-orb text { font-size: 22rpx; line-height: 28rpx; }
.summary-title { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; font-size: 40rpx; line-height: 52rpx; font-weight: 700; color: #1a1b1f; }
.summary-title text { padding: 4rpx 16rpx; font-size: 22rpx; line-height: 28rpx; color: #1D64F2; background: #EBF2FE; font-weight: 700; }
.summary-description { margin-top: 4rpx; font-size: 26rpx; line-height: 36rpx; color: #424655; }
.summary-next { display: flex; align-items: flex-start; gap: 8rpx; margin-top: 8rpx; font-size: 22rpx; line-height: 28rpx; color: #004cc8; font-weight: 600; }
.xp-card { margin-top: 24rpx; padding: 16rpx; border-radius: 24rpx; }
.xp-row { font-size: 22rpx; line-height: 28rpx; font-weight: 700; color: #424655; }
.xp-label { display: flex; align-items: center; gap: 8rpx; }
.xp-track { box-sizing: border-box; height: 20rpx; padding: 4rpx; margin: 12rpx 0; background: #efedf3; }
.xp-note { font-size: 22rpx; line-height: 28rpx; font-weight: 700; color: #737687; }
.showcase { padding: 24rpx; margin-bottom: 32rpx; border-radius: 32rpx; }
.showcase-head { gap: 8rpx; font-size: 34rpx; line-height: 44rpx; font-weight: 600; }
.showcase-heading { display: flex; align-items: center; gap: 12rpx; }
.showcase-head text { padding: 4rpx 16rpx; font-size: 22rpx; line-height: 28rpx; background: #e9e7ed; color: #424655; }
.showcase-slots { gap: 24rpx; margin-top: 16rpx; }
.showcase-slot { padding: 16rpx; border-radius: 24rpx; font-size: 22rpx; line-height: 28rpx; color: #737687; }
.slot-icon { width: 80rpx; height: 80rpx; margin-bottom: 8rpx; display: flex; align-items: center; justify-content: center; background: #e3e2e7; }
.badge-tabs { padding: 8rpx 0; margin-bottom: 24rpx; }
.badge-tab { padding: 12rpx 28rpx; margin-right: 8rpx; font-size: 26rpx; line-height: 32rpx; font-weight: 600; color: #424655; }
.badge-tab.selected { background: #004cc8; }
.badge-grid { gap: 24rpx; align-items: stretch; }
.badge-cell { position: relative; width: calc((100% - 48rpx) / 3); min-height: 0; padding: 16rpx; border-radius: 32rpx; color: #1a1b1f; }
.badge-icon-frame { position: relative; width: 112rpx; height: 112rpx; margin: 24rpx auto 16rpx; display: flex; align-items: center; justify-content: center; }
.badge-circle { position: relative; width: 96rpx; height: 96rpx; margin: 0; border-radius: 32rpx; display: flex; align-items: center; justify-content: center; }
.badge-halo { position: absolute; inset: 0; border-radius: 50%; filter: blur(16rpx); opacity: .3; background: #EBF2FE; }
.badge-halo.amber { background: linear-gradient(45deg,#fbbf24,#fef08a); }
.badge-halo.violet { background: linear-gradient(45deg,#5856D6,#f9a8d4); }
.badge-halo.lime { background: #D2F803; opacity: .4; }
.badge-halo.pink { background: #FFF0F3; opacity: .8; }
.badge-halo.orange { background: #fed7aa; opacity: .4; }
.badge-halo.coffee { background: #fef08a; opacity: .4; }
.badge-halo.muted { display: none; }
.badge-circle.amber,.badge-detail-icon.amber { background: linear-gradient(135deg,#fcd34d,#fbbf24,#eab308); }
.badge-circle.violet,.badge-detail-icon.violet { background: linear-gradient(135deg,#5856D6,#4c4aca,#4f46e5); }
.badge-circle.lime,.badge-detail-icon.lime { background: linear-gradient(135deg,#a3e635,#D2F803,#34d399); }
.badge-circle.pink,.badge-detail-icon.pink { background: linear-gradient(135deg,#f472b6,#FF2D55,#f43f5e); }
.badge-circle.orange,.badge-detail-icon.orange { background: linear-gradient(135deg,#fbbf24,#fb923c,#fb7185); }
.badge-circle.coffee,.badge-detail-icon.coffee { background: linear-gradient(135deg,#ca8a04,#d97706,#854d0e); }
.badge-circle.blue,.badge-detail-icon.blue { background: linear-gradient(135deg,#22d3ee,#1D64F2,#2563eb); }
.badge-circle.muted,.badge-detail-icon.muted { background: #e3e2e7; }
.badge-cell.locked { background: #f4f3f8; opacity: .75; box-shadow: none; color: #424655; }
.badge-lock { position: absolute; top: 16rpx; right: 16rpx; width: 32rpx; height: 32rpx; }
.badge-title { white-space: normal; overflow: visible; font-size: 30rpx; line-height: 40rpx; font-weight: 600; }
.badge-cell text { white-space: normal; overflow: visible; margin-top: 4rpx; font-size: 22rpx; line-height: 28rpx; font-weight: 700; color: #737687; }
.badge-bottom-bar { padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg,rgba(250,248,254,0),#faf8fe 24%,#faf8fe); }
.badge-share-action { min-height: 112rpx; gap: 16rpx; font-size: 34rpx; line-height: 44rpx; font-weight: 600; background: linear-gradient(90deg,#1D64F2,#4c4aca,#5856D6); }
.badge-detail-sheet { max-height: 85vh; overflow-y: auto; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 48rpx 48rpx 0 0; }
.badge-detail-handle { width: 80rpx; height: 8rpx; margin-bottom: 24rpx; background: #dbd9df; }
.badge-detail-icon { width: 160rpx; height: 160rpx; border-radius: 32rpx; display: flex; align-items: center; justify-content: center; }
.badge-detail-title { margin-top: 16rpx; font-size: 40rpx; line-height: 52rpx; font-weight: 700; }
.badge-detail-category { font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.badge-detail-notice { font-size: 30rpx; line-height: 42rpx; color: #424655; }
.material-icon { display: block; width: 48rpx; height: 48rpx; flex: none; }
.header-more-icon { width: 44rpx; height: 44rpx; margin: auto; }
.header-person-icon,.showcase-symbol { width: 36rpx; height: 36rpx; }
.orb-symbol { width: 72rpx; height: 72rpx; }
.next-symbol { width: 30rpx; height: 30rpx; }
.xp-symbol { width: 26rpx; height: 26rpx; }
.slot-symbol { width: 40rpx; height: 40rpx; }
.badge-symbol { width: 56rpx; height: 56rpx; }
.detail-symbol { width: 88rpx; height: 88rpx; }
.badge-detail-close { display: flex; align-items: center; justify-content: center; }

.badge-icon-frame.featured { margin-top: 8rpx; }
.badge-symbol.quick { width: 60rpx; height: 60rpx; }
.badge-symbol.coffee,.badge-symbol.night,.badge-symbol.crowd { width: 52rpx; height: 52rpx; }

/* Native safe area stays opaque while source-like header sticks below it. */
.badge-status-cover { position: fixed; z-index: 20; top: 0; left: 0; right: 0; background: #faf8fe; pointer-events: none; }
