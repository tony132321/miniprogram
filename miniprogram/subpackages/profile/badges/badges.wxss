.xp-note { color: #81889a; text-align: right; font-size: 9.5px; }
.showcase { padding: 11.5px; border-radius: 15.5px; background: #fff; margin-bottom: 15px; }
.showcase-head { display: flex; align-items: center; justify-content: space-between; font-size: 13.5px; font-weight: 750; }
