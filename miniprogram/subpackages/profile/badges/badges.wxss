.badge-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 700; }
.badge-cell text { display: block; color: #838a9b; font-size: 8.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.badge-activities-link { display: block; width: 100%; margin: 13px 0 0; padding: 8px; background: transparent; color: #175beb; font-size: 11px; font-weight: 700; line-height: 1.5; text-align: center; }
.badge-activities-link::after,.badge-share-action::after { border: 0; }
.badge-bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 15; box-sizing: border-box; padding: 7px 15px calc(9px + env(safe-area-inset-bottom)); background: linear-gradient(180deg,rgba(248,247,252,0),#f8f7fc 24%,#f8f7fc); }
.badge-share-note { margin-bottom: 4px; color: #747b8b; text-align: center; font-size: 9px; }
.badge-share-action { display: flex; align-items: center; justify-content: center; gap: 6.5px; width: 100%; min-height: 45px; margin: 0; padding: 0 10px; border-radius: 24px; background: linear-gradient(105deg,#1764f6,#6356d9); color: #fff; font-size: 13.5px; font-weight: 750; box-shadow: 0 6px 13.5px rgba(43,91,218,.22); }
.badge-share-icon { font-size: 15.5px; }
.badge-detail-backdrop { position: fixed; inset: 0; z-index: 20; background: rgba(13,20,41,.45); }
.badge-detail-sheet { position: fixed; z-index: 21; left: 0; right: 0; bottom: 0; box-sizing: border-box; padding: 5.5px 16px 22.5px; border-radius: 18px 18px 0 0; background: #fff; box-shadow: 0 -6px 17.5px rgba(13,20,41,.13); }
.badge-detail-handle { width: 36px; height: 3.5px; margin: 0 auto 11.5px; border-radius: 4px; background: #d5d8e2; }
.badge-detail-top { position: relative; display: flex; align-items: center; justify-content: center; }
.badge-detail-icon { width: 51px; height: 51px; border-radius: 14px; background: #e9f1ff; color: #225ee8; text-align: center; line-height: 51px; font-size: 27.5px; box-shadow: 0 5px 10px rgba(64,82,118,.13); }
.badge-detail-icon.amber { background: linear-gradient(135deg,#ffd148,#ffaf14); color: #fff; }
.badge-detail-icon.violet { background: linear-gradient(135deg,#7069df,#433bc8); color: #fff; }
.badge-detail-icon.lime { background: linear-gradient(135deg,#d2f803,#94c700); color: #253000; }
.badge-detail-icon.pink { background: linear-gradient(135deg,#ff7693,#ff2856); color: #fff; }
.badge-detail-icon.orange { background: linear-gradient(135deg,#ffc45e,#fc7b66); color: #fff; }
