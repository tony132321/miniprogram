.showcase-slots { display: flex; gap: 4.5px; margin-top: 8.5px; }
.showcase-slot { flex: 1; min-width: 0; padding: 5px 2px; border-radius: 8.5px; background: #f4f3f8; text-align: center; color: #7f8797; font-size: 9px; }
.slot-icon { width: 26px; height: 26px; line-height: 26px; margin: 0 auto 4px; border-radius: 50%; background: #e5e5ed; font-size: 16px; }
.badge-tabs { white-space: nowrap; margin-bottom: 10px; }
.badge-tab { display: inline-block; width: auto; padding: 6px 12.5px; margin: 0 4.5px 0 0; border-radius: 18px; background: #fff; color: #3e4656; font-size: 10.5px; line-height: 1.4; }
