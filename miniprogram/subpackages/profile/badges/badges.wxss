@import "../common.wxss";
.badge-emblem { width: 104rpx; height: 104rpx; margin-bottom: 22rpx; border-radius: 28rpx; background: linear-gradient(135deg,#2a65e8,#7362db); color: #fff; line-height: 104rpx; text-align: center; font-size: 68rpx; }
.badge-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.badge-cell { box-sizing: border-box; width: 47.5%; margin-bottom: 20rpx; padding: 30rpx 10rpx; border-radius: 26rpx; background: #fff; text-align: center; color: #303545; font-size: 24rpx; font-weight: 700; }
.badge-circle { width: 78rpx; height: 78rpx; margin: 0 auto 14rpx; border-radius: 24rpx; background: #edf2ff; color: #2862e9; font-size: 42rpx; line-height: 78rpx; }
.badge-cell text { display: block; margin-top: 6rpx; color: #949aac; font-size: 19rpx; font-weight: 400; }
