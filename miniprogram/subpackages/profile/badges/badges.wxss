.badge-header-more::after,.badge-header-avatar::after,.badge-header-menu button::after { border: 0; }
.badge-header-menu { position: absolute; top: 43px; z-index: 12; width: 122.5px; padding: 4px; border: 0.5px solid #edf0f5; border-radius: 10px; background: #fff; box-shadow: 0 6px 15px rgba(15,23,42,.14); }
.badge-header-menu button { display: block; box-sizing: border-box; width: 100%; margin: 0; padding: 6.5px 5px; border-bottom: 0.5px solid #edf0f5; border-radius: 0; background: transparent; color: #334155; text-align: left; line-height: 1.4; font-size: 10px; }
.badge-header-menu button:last-child { border-bottom: 0; }
.badge-status { display: flex; align-items: center; justify-content: space-between; margin: 8.5px 0 8px; font-size: 10.5px; color: #424a5a; font-weight: 650; }
.muted-dot { display: inline-block; width: 6.5px; height: 6.5px; border-radius: 50%; background: #a5b0c2; margin-right: 4px; }
.status-pill { color: #607049; background: #f2fbe6; border-radius: 15px; padding: 3.5px 8px; font-size: 9.5px; }
.badge-summary { padding: 13px; margin-bottom: 14px; border-radius: 15.5px; background: linear-gradient(145deg,#f2effe,#fafdff 60%,#eaf1fe); box-shadow: 0 3px 9px rgba(39,58,116,.05); }
.summary-top { display: flex; align-items: center; gap: 11px; }
.badge-orb { width: 75px; height: 75px; flex: none; border-radius: 15.5px; background: linear-gradient(135deg,#3e78ed,#6660cd); color: white; text-align: center; box-shadow: 0 5px 10px rgba(64,69,174,.16); }
.badge-orb view { line-height: 51.5px; font-size: 39.5px; }
.badge-orb text { display: block; font-size: 11px; font-weight: 800; }
.summary-copy { flex: 1; min-width: 0; }
.summary-title { color: #171a23; font-size: 14.5px; font-weight: 800; }
.summary-title text { display: inline-block; padding: 2px 5px; border-radius: 10px; background: #eaf1ff; color: #2165ec; font-size: 9px; }
.summary-description { color: #5d6678; font-size: 10.5px; margin-top: 4.5px; }
.summary-next { color: #235fe3; font-size: 10px; font-weight: 700; margin-top: 4.5px; }
.xp-card { padding: 8.5px 10px; margin-top: 9.5px; border-radius: 12px; background: rgba(255,255,255,.91); }
.xp-row { display: flex; justify-content: space-between; color: #3d4658; font-size: 10.5px; font-weight: 700; }
