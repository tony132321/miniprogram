.badge-tab.selected { background: #054cc9; color: white; }
.badge-grid { display: flex; flex-wrap: wrap; gap: 7.5px; }
.badge-cell { box-sizing: border-box; width: calc((100% - 15px) / 3); min-height: 113px; margin: 0; padding: 15px 3px 10.5px; border-radius: 13.5px; background: #fff; text-align: center; color: #171a23; line-height: 1.35; box-shadow: 0 2px 9px rgba(40,48,85,.035); }
.badge-circle { width: 49px; height: 49px; margin: 0 auto 8.5px; border-radius: 14.5px; background: #e9f1ff; color: #225ee8; font-size: 24.5px; line-height: 49px; box-shadow: 0 4.5px 10px rgba(64,82,118,.10); }
.badge-circle.amber { background: linear-gradient(135deg,#ffd148,#ffaf14); color: white; }
