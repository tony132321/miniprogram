.badge-detail-notice { width: 100%; margin: 8px 0 12px; padding: 0; border-radius: 0; background: transparent; }
.badge-detail-stats { display: flex; gap: 8px; width: 100%; margin-bottom: 12px; }
.badge-detail-stat { flex: 1; min-width: 0; box-sizing: border-box; border-radius: 12px; padding: 8px; background: #f5f6f8; text-align: left; }
.badge-stat-label { color: #737687; font-size: 11px; line-height: 14px; font-weight: 700; letter-spacing: .22px; }
.badge-stat-value { color: #1a1b1f; font-size: 17px; line-height: 22px; font-weight: 700; letter-spacing: -.17px; }
.badge-stat-value.blue-value { color: #1d64f2; }
.badge-detail-actions { display: flex; gap: 8px; width: 100%; }
.badge-detail-dismiss,.badge-detail-wear { box-sizing: border-box; flex: 1; min-width: 0; margin: 0; padding: 12px 0; border-radius: 9999px; color: #1a1b1f; background: #e9e7ed; font-size: 15px; line-height: 20px; font-weight: 600; }
.badge-detail-dismiss::after,.badge-detail-wear::after { border: 0; }
.badge-detail-wear { display: flex; align-items: center; justify-content: center; gap: 4px; }
.badge-detail-wear[disabled] { background: #1d64f2; color: #fff; opacity: .55; box-shadow: 0 4px 6px -1px rgba(0,76,200,.3), 0 2px 4px -2px rgba(0,76,200,.3); }
.badge-pin-symbol { display: block; width: 18px; height: 18px; flex: none; }
.badge-detail-activities { width: 100%; margin: 12px 0 0; padding: 8px 0; border-radius: 0; background: transparent; color: #1d64f2; font-size: 13px; line-height: 16px; font-weight: 600; }
