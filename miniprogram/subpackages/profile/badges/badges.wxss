.badge-detail-close::after,.badge-detail-activities::after { border: 0; }
.badge-detail-title { margin-top: 8.5px; color: #171a23; text-align: center; font-size: 15.5px; font-weight: 800; }
.badge-detail-category { margin-top: 2px; color: #667085; text-align: center; font-size: 10px; }
