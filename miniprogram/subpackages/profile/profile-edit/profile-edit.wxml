<view class="pg10-page edit-page" style="padding-top: {{statusBarHeight}}px">
  <view class="edit-status-cover" style="height: {{statusBarHeight}}px" aria-hidden="true"></view>
  <view class="pg10-header edit-header" style="padding-right: {{headerPaddingRight}}; top: {{statusBarHeight}}px"><button class="pg10-back" bindtap="back" aria-label="返回"><image class="material-icon back" src="./assets/arrow_back_ios_new.svg" aria-hidden="true" /></button><view class="pg10-header-title">Edit Profile</view><view class="edit-header-actions"><button class="edit-header-more" bindtap="toggleMore" aria-label="更多页面入口" aria-expanded="{{moreOpen}}"><image class="material-icon more" src="./assets/more_horiz.svg" aria-hidden="true" /></button><button class="edit-header-avatar" bindtap="goProfile" aria-label="返回我的页面"><image class="material-icon" src="./assets/person.svg" aria-hidden="true" /></button></view><view wx:if="{{moreOpen}}" class="edit-header-menu" style="right: {{headerPaddingRight}}"><button bindtap="goPrivacySafety">隐私与安全　›</button><button bindtap="goLegal">隐私与使用说明　›</button><button bindtap="goProfile">我的页面　›</button></view></view>
  <view class="sync-bar"><view class="sync-copy"><text class="sync-dot"></text>资料保存暂未开放</view><view class="save-unavailable"><image class="material-icon medium" src="./assets/check.svg" aria-hidden="true" />保存待开放</view></view>
  <view class="edit-identity"><view class="identity-avatar"><image class="material-icon identity" src="./assets/person-anonymous.svg" aria-hidden="true" /><button class="camera-chip" disabled="{{true}}" aria-label="头像上传待开放"><image class="material-icon medium" src="./assets/photo_camera.svg" aria-hidden="true" /></button></view><view class="handle"><text class="handle-at">@</text><text>全局 ID 尚未设置</text><image class="material-icon small" src="./assets/content_copy.svg" aria-hidden="true" /></view><view class="identity-photo-note">头像上传待开放</view></view>
  <view class="pg10-card edit-card">
    <view class="field-heading">昵称 <text>活动内昵称可单独设置</text></view><view class="disabled-field">全局昵称暂未开放 <image class="material-icon" src="./assets/edit.svg" aria-hidden="true" /></view>
    <button class="alias-entry" bindtap="openAliasPicker" aria-label="选择活动并设置本场昵称"><view><view class="alias-entry-title">设置本场昵称</view><view class="alias-entry-note">仅在选定活动内展示，需本人确认</view></view><text>›</text></button>
    <view wx:if="{{aliasPickerOpen}}" class="alias-picker">
      <view class="alias-picker-heading"><view>选择我的活动</view><button bindtap="closeAliasPicker" aria-label="关闭活动选择"><image class="material-icon small" src="./assets/close.svg" aria-hidden="true" /></button></view>
      <view wx:if="{{aliasLoadState === 'LOADING'}}" class="alias-picker-note">正在加载我的活动…</view>
      <view wx:elif="{{aliasLoadState === 'UNAUTHENTICATED'}}" class="alias-picker-state"><view>请先登录，才能查看可设置昵称的活动。</view><button bindtap="goProfile">前往我的页面登录　›</button></view>
      <view wx:elif="{{aliasLoadState === 'EMPTY'}}" class="alias-picker-state"><view>暂无可设置昵称的活动。主办方、已确认成员及候补中的成员可在对应活动内设置。</view><button bindtap="goActivities">查看我的活动　›</button></view>
      <view wx:elif="{{aliasLoadState === 'ERROR'}}" class="alias-picker-state"><view>{{aliasError}}</view><button bindtap="openAliasPicker">重新加载　›</button></view>
      <view wx:elif="{{aliasLoadState === 'READY'}}" class="alias-picker-list"><button wx:for="{{aliasCandidates}}" wx:key="id" class="alias-activity" data-id="{{item.id}}" bindtap="goAliasActivity"><view><view class="alias-activity-title">{{item.title}}</view><view class="alias-activity-role">{{item.role}} · 在活动详情设置或撤回</view></view><text>›</text></button></view>
    </view>
    <view class="field-heading gender-heading">性别 <text>性别选择待开放</text></view><view class="gender-options"><button disabled="{{true}}" aria-label="女，选择未开放"><text>女</text><image class="material-icon small" src="./assets/female.svg" aria-hidden="true" /></button><button disabled="{{true}}" aria-label="男，选择未开放"><text>男</text><image class="material-icon small" src="./assets/male.svg" aria-hidden="true" /></button><button disabled="{{true}}" aria-label="保密，选择未开放"><text>保密</text><image class="material-icon small" src="./assets/visibility_off.svg" aria-hidden="true" /></button></view>
    <view class="field-heading bio-heading">个性签名 / 组局宣言 <text>暂不可编辑</text></view><view class="bio-field">把相遇带回真实世界<view class="field-hint">示意文案 · 未保存为个人资料</view></view>
    <button class="city-row" bindtap="goCity"><view class="city-icon"><image class="material-icon" src="./assets/location_on.svg" aria-hidden="true" /></view><view class="city-copy"><view>我的浏览城市</view><text>{{city}} · 仅在本机用于浏览</text></view><view class="city-arrow"><image class="material-icon chevron" src="./assets/chevron_right.svg" aria-hidden="true" /></view></button>
  </view>
  <view id="interestInfoSection" class="pg10-card edit-card"><view class="section-heading">兴趣标签 <text class="soft-tag">设计示意</text><button class="interest-add" disabled="{{true}}" aria-label="添加兴趣待开放"><image class="material-icon" src="./assets/add_circle.svg" aria-hidden="true" /><text>添加</text></button></view><view class="interest-list"><view class="interest-chip blue"><text>羽毛球</text><button class="interest-close" disabled="{{true}}" aria-label="羽毛球，移除待开放"><image class="material-icon small" src="./assets/close-blue.svg" aria-hidden="true" /></button></view><view class="interest-chip"><text>精品咖啡</text><button class="interest-close" disabled="{{true}}" aria-label="精品咖啡，移除待开放"><image class="material-icon small" src="./assets/close.svg" aria-hidden="true" /></button></view><view class="interest-chip violet"><text>胶片摄影</text><button class="interest-close" disabled="{{true}}" aria-label="胶片摄影，移除待开放"><image class="material-icon small" src="./assets/close-violet.svg" aria-hidden="true" /></button></view><view class="interest-chip"><text>骑行</text><button class="interest-close" disabled="{{true}}" aria-label="骑行，移除待开放"><image class="material-icon small" src="./assets/close.svg" aria-hidden="true" /></button></view><view class="interest-chip"><text>周末桌游</text><button class="interest-close" disabled="{{true}}" aria-label="周末桌游，移除待开放"><image class="material-icon small" src="./assets/close.svg" aria-hidden="true" /></button></view><view class="interest-chip"><text>徒步</text><button class="interest-close" disabled="{{true}}" aria-label="徒步，移除待开放"><image class="material-icon small" src="./assets/close.svg" aria-hidden="true" /></button></view></view><view class="field-hint">标签还不能选择或保存；活动中的真实要求请查看详情。</view></view>
  <view class="pg10-card edit-card"><view class="section-heading">社交名片 & 水平认证 <text class="green-note">当前未开放</text></view><view class="visibility-row"><view><view>微信可见性</view><text>按活动内授权单独决定</text></view><view class="unavailable-switch">待开放</view></view><view class="muted-label">水平认证（待开放）</view><view class="certificate-row"><view class="certificate"><view class="certificate-icon"><image class="material-icon medium" src="./assets/sports_tennis.svg" aria-hidden="true" /></view><view class="certificate-copy"><text class="certificate-title">羽毛球水平</text><text class="certificate-note">未认证</text></view></view><view class="certificate"><view class="certificate-icon violet"><image class="material-icon medium" src="./assets/casino.svg" aria-hidden="true" /></view><view class="certificate-copy"><text class="certificate-title">桌游经验</text><text class="certificate-note">未认证</text></view></view></view><view class="field-hint">平台没有全局水平认证或社交名片保存能力。</view><button class="settings-link" bindtap="goProfile">前往账号、活动内身份与隐私设置　›</button></view>
  <button class="deletion-note" bindtap="goPrivacyRequests">申请注销账号　›</button>
</view>
