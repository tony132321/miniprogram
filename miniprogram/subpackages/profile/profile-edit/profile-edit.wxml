<view class="pg10-page edit-page" style="padding-top: {{statusBarHeight}}px">
  <view class="pg10-header edit-header" style="padding-right: {{headerPaddingRight}}"><button class="pg10-back" bindtap="back" aria-label="返回">‹</button><view class="pg10-header-title">Edit Profile</view><view class="edit-header-actions"><button class="edit-header-more" bindtap="toggleMore" aria-label="更多页面入口" aria-expanded="{{moreOpen}}">···</button><button class="edit-header-avatar" bindtap="goProfile" aria-label="返回我的页面">人</button></view><view wx:if="{{moreOpen}}" class="edit-header-menu" style="right: {{headerPaddingRight}}"><button bindtap="goPrivacySafety">隐私与安全　›</button><button bindtap="goLegal">隐私与使用说明　›</button><button bindtap="goProfile">我的页面　›</button></view></view>
  <view class="sync-bar"><view class="sync-copy"><text class="sync-dot"></text>资料保存暂未开放</view><view class="save-unavailable">✓ 保存待开放</view></view>
  <view class="edit-identity"><view class="identity-avatar">人<button class="camera-chip" disabled="{{true}}" aria-label="头像上传待开放">⌕</button></view><view class="handle">@ 全局 ID 尚未设置</view><view class="identity-photo-note">头像上传待开放</view></view>
  <view class="pg10-card edit-card">
    <view class="field-heading">昵称 <text>活动内昵称可单独设置</text></view><view class="disabled-field">尚未设置全局昵称 <text>✎</text></view>
    <view class="field-heading gender-heading">性别 <text>性别选择待开放</text></view><view class="gender-options"><button disabled="{{true}}" aria-label="女，选择未开放">女 ♀</button><button disabled="{{true}}" aria-label="男，选择未开放">男 ♂</button><button disabled="{{true}}" aria-label="保密，选择未开放">保密 ◉</button></view>
    <view class="field-heading bio-heading">个性签名 / 组局宣言 <text>暂不可编辑</text></view><view class="bio-field">把相遇带回真实世界<view class="field-hint">示意文案 · 未保存为个人资料</view></view>
    <button class="city-row" bindtap="goCity"><view class="city-icon">⌖</view><view class="city-copy"><view>我的浏览城市</view><text>{{city}} · 仅在本机用于浏览</text></view><view class="city-arrow">›</view></button>
  </view>
  <view id="interestInfoSection" class="pg10-card edit-card"><view class="section-heading">兴趣标签 <text class="soft-tag">设计示意</text></view><view class="interest-list"><view class="interest-chip blue">羽毛球</view><view class="interest-chip">精品咖啡</view><view class="interest-chip violet">胶片摄影</view><view class="interest-chip">骑行</view><view class="interest-chip">周末桌游</view><view class="interest-chip">徒步</view></view><view class="field-hint">标签还不能选择或保存；活动中的真实要求请查看详情。</view></view>
  <view class="pg10-card edit-card"><view class="section-heading">社交名片 & 水平认证 <text class="green-note">当前未开放</text></view><view class="visibility-row"><view><view>微信可见性</view><text>按活动内授权单独决定</text></view><view class="unavailable-switch">待开放</view></view><view class="muted-label">水平认证（待开放）</view><view class="certificate-row"><view>⌕　羽毛球水平 · 未认证</view><view>⚄　桌游经验 · 未认证</view></view><view class="field-hint">平台没有全局水平认证或社交名片保存能力。</view><button class="settings-link" bindtap="goProfile">前往账号、活动内身份与隐私设置　›</button></view>
  <button class="deletion-note" bindtap="goPrivacyRequests">申请注销账号　›</button>
</view>
