@import "../common.wxss";
.edit-header-more,.edit-header-avatar { display: block; flex: none; min-width: 0; margin: 0; padding: 0; border: 0; text-align: center; }
.edit-header-more::after,.edit-header-avatar::after,.edit-header-menu button::after { border: 0; }
.edit-header-menu button { display: block; box-sizing: border-box; width: 100%; min-width: 0; margin: 0; padding: 13rpx 10rpx; border-bottom: 1rpx solid #edf0f5; border-radius: 0; background: transparent; color: #334155; text-align: left; line-height: 1.4; font-size: 20rpx; }
.edit-header-menu button:last-child { border-bottom: 0; }
.sync-copy { display: flex; align-items: center; gap: 8rpx; }
.camera-chip::after,.gender-options button::after { border: 0; }
.edit-card { padding: 24rpx; }
.field-heading,.section-heading { color: #303849; font-size: 26rpx; font-weight: 700; }
.disabled-field text { color: #afb6c8; }
.alias-entry { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 16rpx 0 0; padding: 18rpx 20rpx; border: 1rpx solid #dbe7ff; border-radius: 17rpx; background: #f1f6ff; color: #1d5ed5; text-align: left; }
.alias-entry::after,.alias-picker button::after { border: 0; }
.alias-entry-title { font-size: 25rpx; font-weight: 700; line-height: 1.4; }
.alias-entry-note { margin-top: 3rpx; color: #536b93; font-size: 19rpx; line-height: 1.4; }
.alias-entry > text { font-size: 38rpx; line-height: 1; }
.alias-picker { margin-top: 13rpx; padding: 17rpx; border: 1rpx solid #dce6f4; border-radius: 18rpx; background: #fff; }
.alias-picker-heading { display: flex; align-items: center; justify-content: space-between; color: #243247; font-size: 23rpx; font-weight: 700; }
.alias-picker-heading button { width: 42rpx; height: 42rpx; margin: 0; padding: 0; border-radius: 50%; background: #f1f3f8; color: #667085; line-height: 42rpx; font-size: 29rpx; }
.alias-picker-note,.alias-picker-state { padding: 19rpx 2rpx 4rpx; color: #626f83; font-size: 21rpx; line-height: 1.5; }
.alias-picker-state button { width: auto; margin: 11rpx 0 0; padding: 3rpx 0; background: transparent; color: #1e62d7; text-align: left; font-size: 21rpx; }
.alias-picker-list { margin-top: 10rpx; }
.alias-activity { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 0; padding: 16rpx 2rpx; border-radius: 0; border-top: 1rpx solid #edf0f6; background: transparent; color: #253248; text-align: left; }
.alias-activity-title { font-size: 22rpx; font-weight: 650; line-height: 1.4; }
.alias-activity-role { margin-top: 4rpx; color: #748197; font-size: 18rpx; line-height: 1.4; }
.alias-activity > text { color: #7b8daa; font-size: 29rpx; }
.gender-heading { margin-top: 28rpx; }
.bio-heading { margin-top: 28rpx; }
.city-row::after,.settings-link::after { border: 0; }
.unavailable-switch { border-radius: 22rpx; padding: 8rpx 15rpx; background: #eff0f5; color: #8c94a4; font-size: 18rpx; }
.settings-link { margin: 22rpx 0 0; padding: 0; background: transparent; color: #1c62e8; text-align: left; font-size: 21rpx; line-height: 2; }
.deletion-note::after { border: 0; }

/* Wave60: source tokens at 375px, scoped to PG10-A. */
.edit-page { padding-left: 32rpx; padding-right: 32rpx; background: #faf8fe; color: #1a1b1f; }
.edit-page .pg10-header { height: 112rpx; margin: 0 -32rpx; padding-left: 32rpx; background: rgba(250,248,254,.85); box-shadow: 0 2rpx 16rpx rgba(0,0,0,.03); }
.edit-page .pg10-back { display: flex; align-items: center; width: 88rpx; min-width: 88rpx; height: 88rpx; margin-left: -8rpx; line-height: 1; }
.edit-page .pg10-header-title { font-size: 34rpx; line-height: 44rpx; letter-spacing: -.34rpx; font-weight: 600; }
.edit-header-actions { gap: 8rpx; }
.edit-header-more { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }
.edit-header-avatar { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; background: #004cc8; }
.edit-header-menu { top: 112rpx; }
.sync-bar { min-height: 72rpx; padding-top: 16rpx; box-sizing: border-box; font-size: 22rpx; line-height: 28rpx; color: #424655; font-weight: 700; }
.sync-dot { width: 16rpx; height: 16rpx; }
.save-unavailable { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; font-size: 26rpx; line-height: 32rpx; background: #e9e7ed; color: #737687; font-weight: 600; }
.edit-identity { padding: 48rpx 0 32rpx; }
.identity-avatar { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 192rpx; height: 192rpx; border: 6rpx solid #e9e7ed; margin: 0 auto 24rpx; background: #f4f3f8; box-shadow: 0 8rpx 12rpx rgba(0,0,0,.1); }
.camera-chip { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; right: 0; bottom: 0; background: #1a1b1f !important; }
.handle { display: inline-flex; align-items: center; gap: 12rpx; padding: 8rpx 24rpx; background: #f4f3f8; color: #424655; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.handle-at { color: #1d64f2; }
.identity-photo-note { font-size: 22rpx; line-height: 28rpx; color: #737687; }
.edit-page .edit-card { padding: 24rpx; border-radius: 24rpx; margin-bottom: 32rpx; box-shadow: 0 2rpx 4rpx rgba(0,0,0,.05); }
.field-heading { font-size: 26rpx; line-height: 32rpx; font-weight: 600; color: #424655; }
.field-heading text { font-size: 22rpx; line-height: 28rpx; font-weight: 700; color: #737687; }
.disabled-field { align-items: center; padding: 8rpx 24rpx; margin-top: 8rpx; background: #f4f3f8; font-size: 34rpx; line-height: 44rpx; font-weight: 600; color: #737687; }
.gender-heading,.bio-heading { margin-top: 24rpx; padding-top: 8rpx; }
.gender-options { padding: 8rpx; gap: 8rpx; margin-top: 12rpx; background: #f4f3f8; border-radius: 16rpx; }
.gender-options button { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 12rpx 0; border-radius: 8rpx; font-size: 26rpx; line-height: 32rpx; font-weight: 600; color: #737687 !important; }
.bio-heading text { color: #1d64f2; font-weight: 500; }
.bio-field { margin-top: 12rpx; min-height: 186rpx; padding: 20rpx; background: #f4f3f8; font-size: 30rpx; line-height: 48.75rpx; color: #424655; }
.field-hint { font-size: 22rpx; line-height: 28rpx; color: #737687; }
.city-row { box-sizing: border-box; padding: 16rpx 0; margin-top: 24rpx; line-height: normal; }
.city-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; margin-right: 16rpx; background: #ebf2fe; }
.city-copy { min-width: 0; font-size: 22rpx; line-height: 28rpx; font-weight: 700; color: #737687; }
.city-copy text { font-size: 34rpx; line-height: 44rpx; font-weight: 600; color: #1a1b1f; }
.city-arrow { flex: none; margin-left: 8rpx; }
.section-heading { flex-wrap: wrap; gap: 12rpx; font-size: 34rpx; line-height: 44rpx; font-weight: 600; color: #1a1b1f; }
.soft-tag { padding: 4rpx 12rpx; font-size: 22rpx; line-height: 28rpx; font-weight: 700; background: #f3fee7; color: #4d5d00; }
.interest-list { gap: 16rpx; margin-top: 32rpx; }
.interest-chip { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; background: #e9e7ed; color: #1a1b1f; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.interest-chip.blue { background: #ebf2fe; color: #1d64f2; }
.interest-chip.violet { background: #f2f1fd; color: #5856d6; }
.interest-close,.interest-add { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; background: transparent !important; }
.interest-close { width: 28rpx; height: 32rpx; }
.interest-close::after,.interest-add::after { border: 0; }
.interest-add { gap: 4rpx; margin-left: auto; color: #737687 !important; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.green-note { font-size: 22rpx; line-height: 28rpx; color: #737687; }
.visibility-row { margin: 24rpx 0; padding: 8rpx 0; gap: 16rpx; color: #1a1b1f; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.visibility-row text { color: #424655; font-size: 26rpx; line-height: 36rpx; }
.muted-label { font-size: 22rpx; line-height: 28rpx; color: #737687; }
.certificate-row { gap: 8rpx; margin-top: 16rpx; }
.certificate-row .certificate { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; padding: 20rpx; border-radius: 16rpx; background: #f4f3f8; }
.certificate-row .certificate-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 56rpx; height: 56rpx; padding: 0; border-radius: 50%; background: #d2f803; }
.certificate-row .certificate-icon.violet { background: #f2f1fd; }
.certificate-row .certificate-copy { min-width: 0; padding: 0; background: transparent; }
.certificate-title { color: #1a1b1f; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.certificate-note { display: block; color: #737687; font-size: 22rpx; line-height: 28rpx; font-weight: 700; }
.deletion-note { font-size: 22rpx; line-height: 28rpx; color: #737687; text-decoration: underline; padding-top: 32rpx; }
.material-icon { display: block; width: 36rpx; height: 36rpx; flex: none; }
.material-icon.back { width: 48rpx; height: 48rpx; }
.material-icon.more { width: 44rpx; height: 44rpx; }
.material-icon.identity { width: 96rpx; height: 96rpx; }
.material-icon.small { width: 28rpx; height: 28rpx; }
.material-icon.medium { width: 32rpx; height: 32rpx; }
.material-icon.chevron { width: 40rpx; height: 40rpx; }
.edit-page .pg10-header { position: sticky; z-index: 11; box-sizing: border-box; }
.edit-page .pg10-header-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-header-menu { position: absolute; z-index: 12; width: 258rpx; padding: 8rpx; border: 1rpx solid #edf0f5; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(15,23,42,.14); }
.edit-header-actions { display: flex; flex: none; align-items: center; }
.edit-header-more { background: transparent; }
.edit-header-avatar { border-radius: 50%; }
.sync-bar { display: flex; align-items: center; justify-content: space-between; }
.sync-dot { border-radius: 50%; background: #aab1be; }
.save-unavailable { border-radius: 40rpx; }
.edit-identity { text-align: center; }
.identity-avatar { position: relative; border-radius: 50%; }
.camera-chip { position: absolute; margin: 0; padding: 0; border-radius: 50%; }
.handle { border-radius: 40rpx; }
.identity-photo-note { margin-top: 9rpx; }
.disabled-field { display: flex; justify-content: space-between; border-radius: 16rpx; }
.field-heading text { float: right; }
.gender-options { display: flex; }
.gender-options button { flex: 1; min-width: 0; margin: 0; background: transparent !important; }
.bio-field { box-sizing: border-box; border-radius: 16rpx; }
.field-hint { margin-top: 16rpx; }
.city-row { display: flex; align-items: center; width: 100%; background: transparent; text-align: left; }
.city-icon { border-radius: 50%; }
.city-copy { flex: 1; }
.city-copy text { display: block; }
.section-heading { display: flex; align-items: center; }
.soft-tag { border-radius: 20rpx; }
.interest-list { display: flex; flex-wrap: wrap; }
.interest-chip { border-radius: 34rpx; }
.green-note { margin-left: auto; }
.visibility-row { display: flex; align-items: center; justify-content: space-between; }
.visibility-row text { display: block; font-weight: 400; }
.certificate-row { display: flex; }
.deletion-note { width: auto; padding-bottom: 4rpx; margin: 0 auto; border: 0; background: transparent; text-align: center; }
.alias-picker-heading button { display: flex; align-items: center; justify-content: center; }

/* Native safe area stays opaque while source-like header sticks below it. */
.edit-status-cover { position: fixed; z-index: 20; top: 0; left: 0; right: 0; background: #faf8fe; pointer-events: none; }
