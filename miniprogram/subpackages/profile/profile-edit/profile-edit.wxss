@import "../common.wxss";
.edit-page { padding-left: 30rpx; padding-right: 30rpx; }
.edit-page .pg10-header { position: relative; z-index: 11; box-sizing: border-box; margin-left: -30rpx; margin-right: -30rpx; padding-left: 28rpx; }
.edit-page .pg10-header-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.edit-header-actions { display: flex; flex: none; align-items: center; gap: 6rpx; }
.edit-header-more,.edit-header-avatar { display: block; flex: none; min-width: 0; margin: 0; padding: 0; border: 0; text-align: center; }
.edit-header-more { width: 48rpx; height: 54rpx; background: transparent; color: #171a24; line-height: 54rpx; font-size: 32rpx; font-weight: 800; }
.edit-header-avatar { width: 54rpx; height: 54rpx; border-radius: 50%; background: #064dca; color: #fff; line-height: 54rpx; font-size: 28rpx; font-weight: 800; }
.edit-header-more::after,.edit-header-avatar::after,.edit-header-menu button::after { border: 0; }
.edit-header-menu { position: absolute; top: 86rpx; z-index: 12; width: 258rpx; padding: 8rpx; border: 1rpx solid #edf0f5; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(15,23,42,.14); }
.edit-header-menu button { display: block; box-sizing: border-box; width: 100%; min-width: 0; margin: 0; padding: 13rpx 10rpx; border-bottom: 1rpx solid #edf0f5; border-radius: 0; background: transparent; color: #334155; text-align: left; line-height: 1.4; font-size: 20rpx; }
.edit-header-menu button:last-child { border-bottom: 0; }
.sync-bar { min-height: 72rpx; display: flex; align-items: center; justify-content: space-between; color: #394256; font-size: 21rpx; font-weight: 650; }
.sync-copy { display: flex; align-items: center; gap: 8rpx; }
.sync-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #aab1be; }
.save-unavailable { padding: 13rpx 21rpx; border-radius: 40rpx; background: #e9ebf1; color: #687183; font-size: 21rpx; }
.edit-identity { text-align: center; padding: 32rpx 0 29rpx; }
.identity-avatar { position: relative; width: 168rpx; height: 168rpx; margin: 0 auto 22rpx; border: 7rpx solid #fff; border-radius: 50%; background: linear-gradient(145deg,#d8e5ff,#f4f1ff); color: #2164e9; line-height: 168rpx; font-size: 66rpx; box-shadow: 0 8rpx 22rpx rgba(40,60,105,.13); }
.camera-chip { position: absolute; right: -5rpx; bottom: -7rpx; width: 55rpx; height: 55rpx; margin: 0; padding: 0; border-radius: 50%; background: #555b67 !important; color: white !important; font-size: 31rpx; line-height: 55rpx; }
.camera-chip::after,.gender-options button::after { border: 0; }
.handle { display: inline-block; border-radius: 40rpx; padding: 9rpx 23rpx; background: #f0eff5; color: #4e5871; font-size: 22rpx; }
.identity-photo-note { margin-top: 9rpx; color: #8c94a6; font-size: 19rpx; }
.edit-card { padding: 24rpx; }
.field-heading,.section-heading { color: #303849; font-size: 26rpx; font-weight: 700; }
.field-heading text { float: right; color: #8c94a6; font-size: 20rpx; font-weight: 500; }
.disabled-field { display: flex; justify-content: space-between; padding: 18rpx 22rpx; margin-top: 9rpx; border-radius: 16rpx; background: #f1f1f6; color: #7b8392; font-size: 26rpx; }
.disabled-field text { color: #afb6c8; }
.gender-heading { margin-top: 28rpx; }
.gender-options { display: flex; margin-top: 9rpx; padding: 7rpx; border-radius: 18rpx; background: #f1f1f6; gap: 7rpx; }
.gender-options button { flex: 1; min-width: 0; margin: 0; padding: 10rpx 0; border-radius: 13rpx; background: transparent !important; color: #9198a6 !important; text-align: center; font-size: 24rpx; font-weight: 650; line-height: 1.4; }
.bio-heading { margin-top: 28rpx; }
.bio-heading text { color: #1c63e9; }
.bio-field { min-height: 142rpx; box-sizing: border-box; margin-top: 9rpx; padding: 20rpx; border-radius: 16rpx; background: #f1f1f6; color: #596173; font-size: 23rpx; }
.field-hint { margin-top: 16rpx; color: #8a92a3; font-size: 19rpx; line-height: 1.45; }
.city-row { display: flex; align-items: center; width: 100%; padding: 29rpx 0 0; margin: 0; background: transparent; text-align: left; color: #202532; font-size: 24rpx; }
.city-row::after,.settings-link::after { border: 0; }
.city-icon { width: 58rpx; height: 58rpx; border-radius: 50%; margin-right: 14rpx; background: #e7f0ff; color: #2468ed; text-align: center; line-height: 58rpx; font-size: 34rpx; }
.city-copy { flex: 1; color: #7e8799; font-size: 20rpx; font-weight: 600; }
.city-copy text { display: block; color: #171c25; font-size: 26rpx; font-weight: 700; }
.city-arrow { color: #747b8d; font-size: 37rpx; }
.section-heading { display: flex; align-items: center; gap: 13rpx; }
.soft-tag { border-radius: 20rpx; padding: 3rpx 12rpx; background: #f2fbe5; color: #677d1a; font-size: 19rpx; font-weight: 500; }
.interest-list { display: flex; flex-wrap: wrap; gap: 10rpx 12rpx; margin-top: 24rpx; }
.interest-chip { border-radius: 34rpx; padding: 9rpx 19rpx; background: #ecebf1; color: #394051; font-size: 22rpx; font-weight: 650; }
.interest-chip.blue { background: #eaf1ff; color: #1d64f2; }
.interest-chip.violet { background: #f0efff; color: #5b54d2; }
.green-note { margin-left: auto; color: #8c94a4; font-size: 18rpx; font-weight: 600; }
.visibility-row { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 0; color: #303744; font-size: 23rpx; font-weight: 700; }
.visibility-row text { display: block; color: #697386; font-size: 19rpx; font-weight: 400; }
.unavailable-switch { border-radius: 22rpx; padding: 8rpx 15rpx; background: #eff0f5; color: #8c94a4; font-size: 18rpx; }
.muted-label { color: #848d9e; font-size: 20rpx; }
.certificate-row { display: flex; gap: 8rpx; margin-top: 14rpx; }
.certificate-row view { flex: 1; padding: 14rpx 8rpx; border-radius: 17rpx; background: #f2f1f7; color: #596174; font-size: 20rpx; }
.settings-link { margin: 22rpx 0 0; padding: 0; background: transparent; color: #1c62e8; text-align: left; font-size: 21rpx; line-height: 2; }
.deletion-note { width: auto; padding: 30rpx 0 4rpx; margin: 0 auto; border: 0; background: transparent; color: #8992a2; text-align: center; font-size: 20rpx; line-height: 1.5; }
.deletion-note::after { border: 0; }
