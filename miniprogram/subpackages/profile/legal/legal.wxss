@import "../common.wxss";

.legal-page { background: #faf8fe; color: #1a1b1f; padding: 0 32rpx; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.legal-header { position: sticky; z-index: 11; box-sizing: border-box; height: 112rpx; margin: 0 -32rpx; padding-left: 32rpx; background: rgba(250,248,254,.85); backdrop-filter: blur(24rpx); box-shadow: 0 2rpx 16rpx rgba(0,0,0,.03); }
.legal-back { display: flex; align-items: center; width: 88rpx; min-width: 88rpx; height: 88rpx; }
.legal-back-icon { width: 48rpx; height: 48rpx; }
.legal-header .pg10-header-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.34rpx; }
.legal-header .profile-header-actions { gap: 8rpx; }
.legal-header .profile-header-more { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }
.legal-more-icon { width: 44rpx; height: 44rpx; }
.legal-header .profile-header-avatar { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; background: #004cc8; margin-left: 8rpx; }
.legal-person-icon { width: 36rpx; height: 36rpx; }
.legal-header .profile-header-menu { top: 104rpx; }
.legal-page .pg10-card { border-radius: 24rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 40rpx -4rpx rgba(28,41,61,.05); }
.legal-meta { display: flex; align-items: center; gap: 8rpx; padding: 24rpx 0 16rpx; }
.legal-meta-chip, .legal-meta-pending { padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; line-height: 28rpx; font-weight: 600; white-space: nowrap; }
.legal-meta-chip { background: #EBF2FE; color: #1D64F2; }
.legal-meta-pending { background: #efedf3; color: #424655; }
.legal-text-size, .legal-meta-share { display: flex; align-items: center; justify-content: center; flex: none; box-sizing: border-box; width: 64rpx; min-width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: #efedf3; }
.legal-text-size { margin-left: auto; }
.legal-symbol { width: 36rpx; height: 36rpx; }
.legal-text-size::after, .legal-meta-share::after { border: 0; }
.legal-text-size.active { background: #EBF2FE; }
.legal-summary { padding: 24rpx; }
.legal-document-meta { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; color: #424655; font-size: 26rpx; line-height: 32rpx; }
.legal-document-date { display: flex; align-items: center; gap: 8rpx; }
.legal-schedule-icon { width: 32rpx; height: 32rpx; flex: none; }
.legal-document-status { font-size: 22rpx; line-height: 28rpx; white-space: nowrap; }
.legal-summary-digest { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; margin-top: 16rpx; border-radius: 16rpx; background: linear-gradient(90deg,#EBF2FE,#faf8fe,#F2F1FD); }
.legal-shield { width: 56rpx; height: 56rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #1D64F2; box-shadow: 0 0 24rpx rgba(29,100,242,.35); }
.legal-digest-icon { width: 32rpx; height: 32rpx; }
.legal-summary-body { min-width: 0; flex: 1; }
.legal-summary-title { color: #1a1b1f; font-size: 26rpx; font-weight: 600; line-height: 32rpx; }
.legal-summary-copy { color: #424655; font-size: 26rpx; line-height: 36rpx; margin-top: 4rpx; }
.legal-tabs { box-sizing: border-box; width: 100%; margin-bottom: 24rpx; white-space: nowrap; }
.legal-tabs-track { display: inline-flex; padding: 8rpx; gap: 8rpx; border-radius: 999rpx; background: #efedf3; }
.legal-tab { display: inline-block; flex: none; box-sizing: border-box; width: auto; min-width: 0; margin: 0; padding: 12rpx 24rpx; border-radius: 999rpx; color: #424655; background: transparent; font-size: 26rpx; font-weight: 600; line-height: 32rpx; text-align: center; white-space: nowrap; }
.legal-tab::after, .legal-pdf::after, .legal-privacy::after { border: 0; }
.legal-tab.selected { color: #1D64F2; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); }
.legal-tab.unavailable { color: #737687; }
.legal-section { padding: 32rpx; }
.legal-section-head { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 16rpx; }
.legal-number { width: 64rpx; height: 64rpx; min-width: 64rpx; border-radius: 50%; text-align: center; line-height: 64rpx; font-size: 34rpx; font-weight: 600; }
.legal-number.blue { background: #EBF2FE; color: #1D64F2; }
.legal-number.violet { background: #F2F1FD; color: #5856D6; }
.legal-number.green { background: #EBF9F0; color: #34C759; }
.legal-number.pink { background: #FFF0F3; color: #FF2D55; }
.legal-number.slate { background: #efedf3; color: #1a1b1f; }
.legal-section-title { flex: 1; color: #1a1b1f; font-size: 34rpx; font-weight: 600; line-height: 44rpx; letter-spacing: -.34rpx; padding-top: 10rpx; }
.legal-label { flex: none; padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; line-height: 28rpx; font-weight: 600; white-space: nowrap; }
.blue-label { color: #4d5d00; background: #F3FEE7; }
.violet-label { color: #5856D6; background: #F2F1FD; }
.neutral-label { color: #424655; background: #efedf3; }
.pink-label { color: #FF2D55; background: #FFF0F3; }
.green-label { color: #34C759; background: #EBF9F0; }
.legal-section-copy { color: #424655; font-size: 30rpx; line-height: 1.625; }
.legal-info-box { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 24rpx; padding: 24rpx; border-radius: 16rpx; background: #f4f3f8; color: #1a1b1f; font-size: 26rpx; line-height: 36rpx; }
.legal-info-icon { flex: none; width: 36rpx; height: 36rpx; margin-top: 4rpx; }
.legal-request { display: flex; align-items: flex-start; gap: 16rpx; padding: 32rpx; background: linear-gradient(135deg,#fff,#faf8fe,#EBF2FE); }
.legal-request-icon { width: 80rpx; height: 80rpx; min-width: 80rpx; border-radius: 50%; background: #1D64F2; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(29,100,242,.3); }
.legal-request-shield { width: 40rpx; height: 40rpx; }
.legal-request-title { color: #1a1b1f; font-size: 34rpx; line-height: 44rpx; font-weight: 600; }
.legal-request-copy { color: #424655; font-size: 26rpx; line-height: 36rpx; margin-top: 4rpx; }
.legal-actions { position: sticky; bottom: 0; z-index: 10; display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; margin: 48rpx -32rpx 0; padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); background: rgba(250,248,254,.9); backdrop-filter: blur(24rpx); box-shadow: 0 -8rpx 48rpx rgba(0,0,0,.06); }
.legal-actions button { display: flex; align-items: center; justify-content: center; gap: 8rpx; box-sizing: border-box; flex: 1; min-width: 0; height: 96rpx; margin: 0; padding: 0 8rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 600; line-height: 40rpx; }
.legal-pdf { color: #737687 !important; background: #efedf3 !important; }
.legal-privacy { color: #fff; background: #1D64F2; box-shadow: 0 16rpx 48rpx -8rpx rgba(29,100,242,.35); }
.legal-action-icon { width: 40rpx; height: 40rpx; flex: none; }
.legal-foot { width: 100%; color: #424655; font-size: 22rpx; text-align: center; line-height: 28rpx; padding-top: 8rpx; }
.legal-large-text .legal-summary-copy, .legal-large-text .legal-section-copy { font-size: 32.4rpx; line-height: 1.7; }
.legal-large-text .legal-info-box, .legal-large-text .legal-request-copy { font-size: 28.08rpx; line-height: 1.7; }

/* Native safe area stays opaque while source-like header sticks below it. */
.legal-status-cover { position: fixed; z-index: 20; top: 0; left: 0; right: 0; background: #faf8fe; pointer-events: none; }
