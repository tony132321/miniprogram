@import "../common.wxss";
/* Preserved Wave60 structure; Wave68 exact source scopes below. */
.privacy-page { padding: 0 16px 40px; background: #faf8fe; color: #1a1b1f; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.privacy-header { position: sticky; z-index: 11; box-sizing: border-box; margin: 0 -16px 12px; padding-left: 16px; background: rgba(250,248,254,.85); height: 56px; box-shadow: 0 1px 8px rgba(0,0,0,.03); gap: 8px; }
.privacy-header .pg10-header-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 17px; line-height: 22px; font-weight: 600; letter-spacing: -.17px; }
.privacy-header-actions { display: flex; flex: none; align-items: center; gap: 4px; }
.privacy-header-more, .privacy-header-avatar { display: block; flex: none; min-width: 0; margin: 0; padding: 0; border: 0; text-align: center; }
.privacy-header-more { width: 44px; height: 44px; background: transparent; color: #171a24; line-height: 27px; font-size: 16px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: -4px; }
.privacy-header-avatar { width: 32px; height: 32px; border-radius: 50%; background: #004cc8; color: #fff; line-height: 27px; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-left: 4px; }
.privacy-header-more::after, .privacy-header-avatar::after, .privacy-header-menu button::after { border: 0; }
.privacy-header-menu { position: absolute; top: 56px; z-index: 12; width: 129px; padding: 4px; border: 0.5px solid #edf0f5; border-radius: 10px; background: #fff; box-shadow: 0 6px 15px rgba(15,23,42,.14); }
.privacy-header-menu button { display: block; box-sizing: border-box; width: 100%; min-width: 0; margin: 0; padding: 6.5px 5px; border-bottom: 0.5px solid #edf0f5; border-radius: 0; background: transparent; color: #334155; text-align: left; line-height: 1.4; font-size: 10px; }
.privacy-header-menu button:last-child { border-bottom: 0; }
.privacy-intro { padding: 16px; border: 0; background: #fff; position: relative; overflow: hidden; }
.intro-head { display: flex; align-items: center; gap: 8px; }
.intro-symbol { width: 40px; height: 40px; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #ebf2fe; color: #1d64f2; font-size: 21px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.intro-title { color: #1a1b1f; font-size: 17px; line-height: 22px; font-weight: 600; letter-spacing: -.17px; }
.intro-subtitle { margin-top: 0; color: #424655; font-size: 11px; font-weight: 700; line-height: 14px; letter-spacing: .22px; }
.privacy-points { margin-top: 12px; padding-left: 4px; }
.privacy-points>view { display: flex; gap: 8px; margin-top: 8px; color: #424655; font-size: 13px; line-height: 1.625; }
.point-dot { flex: none; color: #1d64f2; font-size: 8.5px; line-height: 2.1; width: 6px; height: 6px; margin-top: 8px; border-radius: 50%; background: #1d64f2; }
.block-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin: 16px 4px 8px; }
.block-section-heading>view { display: flex; align-items: center; gap: 4px; font-size: 17px; font-weight: 600; line-height: 22px; }
.block-section-heading>text { color: #737687; font-size: 11px; white-space: nowrap; line-height: 14px; font-weight: 700; }
.block-count { min-width: 0; padding: 2px 8px; border-radius: 49.5px; background: #e9e7ed; color: #424655; text-align: center; font-size: 11px; font-weight: 600; line-height: 14px; }
.block-state { padding: 40px 16px; color: #424655; font-size: 13px; line-height: 18px; text-align: center; }
.state-symbol { margin-bottom: 7.5px; color: #1d64f2; font-size: 23.5px; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; margin: 0 auto 8px; border-radius: 50%; background: #ebf2fe; }
.state-copy { margin-top: 4px; color: #424655; font-size: 13px; line-height: 18px; }
.block-state .pg10-primary { max-width: 175px; margin: 10px auto 0; font-size: 11px; }
.block-card { display: flex; align-items: center; gap: 8.5px; padding: 11px 9.5px; margin-bottom: 7px; }
.block-avatar { width: 48px; height: 48px; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #efedf3; color: #1d64f2; font-size: 19.5px; position: relative; }
.block-copy { flex: 1; min-width: 0; }
.block-title { color: #1a1b1f; font-size: 15px; font-weight: 600; line-height: 20px; }
.block-chip { display: inline-block; margin-top: 4px; padding: 2px 8px; border-radius: 49.5px; background: #fff0f3; color: #ff2d55; font-size: 11px; line-height: 14px; font-weight: 700; }
.block-meta { margin-top: 4px; overflow: hidden; color: #737687; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; line-height: 18px; }
.block-action { flex: none; margin: 0; padding: 6px 14px; border-radius: 49.5px; background: #efedf3; color: #1a1b1f; font-size: 13px; font-weight: 600; line-height: 16px; box-sizing: border-box; min-height: 38px; display: flex; align-items: center; justify-content: center; }
.block-action[disabled] { color: #9098a6; }
.block-action::after { border: 0; }
.privacy-message { margin: 6px 0 10px; padding: 7.5px 9px; border-radius: 8.5px; background: #eaf1ff; color: #1d64f2; font-size: 11px; }
.help-card { display: flex; align-items: center; width: 100%; box-sizing: border-box; gap: 8.5px; margin: 27.5px 0 0; padding: 12.5px; color: #171a24; text-align: left; line-height: 1.4; }
.help-card::after { border: 0; }
.help-icon { width: 32px; height: 32px; flex: none; border-radius: 50%; background: #fff0f3; color: #f13b5d; text-align: center; font-size: 17.5px; font-weight: 800; line-height: 33px; display: flex; align-items: center; justify-content: center; }
.help-copy { flex: 1; min-width: 0; font-size: 13px; color: #424655; line-height: 18px; }
.help-copy text { display: block; margin-top: 0; color: inherit; font-size: inherit; font-weight: inherit; }
.privacy-foot { margin: 14px 2.5px 0; color: #737687; font-size: 11px; line-height: 14px; text-align: center; }
.privacy-header .pg10-back { display: flex; align-items: center; width: 44px; min-width: 44px; height: 44px; margin-left: -4px; }
.back-symbol { width: 24px; height: 24px; }
.more-symbol { width: 22px; height: 22px; }
.person-symbol { width: 18px; height: 18px; }
.privacy-page .pg10-card { border-radius: 12px; margin-bottom: 0; box-shadow: 0 4px 20px -2px rgba(28,41,61,.05), 0 1px 3px rgba(28,41,61,.02); }
.intro-glow { position: absolute; right: -32px; top: -32px; width: 144px; height: 144px; border-radius: 50%; background: rgba(29,100,242,.05); filter: blur(24px); pointer-events: none; }
.intro-head, .privacy-points { position: relative; }
.intro-symbol image { width: 22px; height: 22px; }
.privacy-points>view:first-child { margin-top: 0; }
.state-symbol image { width: 22px; height: 22px; }
.block-empty { background: transparent; }
.empty-symbol { width: 64px; height: 64px; background: #ebf9f0; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.empty-symbol image { width: 32px; height: 32px; }
.empty-title { color: #1a1b1f; font-size: 17px; line-height: 22px; font-weight: 600; }
.privacy-page .block-card { gap: 8px; padding: 12px; margin-bottom: 0; }
.anonymous-symbol { width: 24px; height: 24px; }
.block-badge { position: absolute; right: -2px; bottom: -2px; display: flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; background: #ff2d55; }
.block-badge image { width: 10px; height: 10px; }
.privacy-page .help-card { gap: 8px; margin-top: 28px; padding: 12px; }
.help-icon image { width: 18px; height: 18px; }
.help-link { display: flex; align-items: center; gap: 2px; color: #1d64f2; font-size: 13px; line-height: 16px; font-weight: 600; }
.help-link image { width: 16px; height: 16px; }

/* Native safe area stays opaque while source-like header sticks below it. */
.privacy-status-cover { position: fixed; z-index: 20; top: 0; left: 0; right: 0; background: #faf8fe; pointer-events: none; }

/* Wave68 PG10-D: source px and native header; blocks/revoke/report remain live R1 data. */
