@import "../common.wxss";
/* Wave 60: original PG10-D tokens at 375px (1px = 2rpx). */
.privacy-page { padding: 0 32rpx 80rpx; background: #faf8fe; color: #1a1b1f; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.privacy-header { position: sticky; z-index: 11; box-sizing: border-box; margin: 0 -32rpx 24rpx; padding-left: 32rpx; background: rgba(250,248,254,.85); height: 112rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,.03); gap: 16rpx; }
.privacy-header .pg10-header-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.34rpx; }
.privacy-header-actions { display: flex; flex: none; align-items: center; gap: 8rpx; }
.privacy-header-more, .privacy-header-avatar { display: block; flex: none; min-width: 0; margin: 0; padding: 0; border: 0; text-align: center; }
.privacy-header-more { width: 88rpx; height: 88rpx; background: transparent; color: #171a24; line-height: 54rpx; font-size: 32rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: -8rpx; }
.privacy-header-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #004cc8; color: #fff; line-height: 54rpx; font-size: 28rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-left: 8rpx; }
.privacy-header-more::after, .privacy-header-avatar::after, .privacy-header-menu button::after { border: 0; }
.privacy-header-menu { position: absolute; top: 112rpx; z-index: 12; width: 258rpx; padding: 8rpx; border: 1rpx solid #edf0f5; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(15,23,42,.14); }
.privacy-header-menu button { display: block; box-sizing: border-box; width: 100%; min-width: 0; margin: 0; padding: 13rpx 10rpx; border-bottom: 1rpx solid #edf0f5; border-radius: 0; background: transparent; color: #334155; text-align: left; line-height: 1.4; font-size: 20rpx; }
.privacy-header-menu button:last-child { border-bottom: 0; }
.privacy-intro { padding: 32rpx; border: 0; background: #fff; position: relative; overflow: hidden; }
.intro-head { display: flex; align-items: center; gap: 16rpx; }
.intro-symbol { width: 80rpx; height: 80rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #ebf2fe; color: #1d64f2; font-size: 42rpx; box-shadow: 0 2rpx 4rpx rgba(0,0,0,.05); }
.intro-title { color: #1a1b1f; font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.34rpx; }
.intro-subtitle { margin-top: 0; color: #424655; font-size: 22rpx; font-weight: 700; line-height: 28rpx; letter-spacing: .44rpx; }
.privacy-points { margin-top: 24rpx; padding-left: 8rpx; }
.privacy-points>view { display: flex; gap: 16rpx; margin-top: 16rpx; color: #424655; font-size: 26rpx; line-height: 1.625; }
.point-dot { flex: none; color: #1d64f2; font-size: 17rpx; line-height: 2.1; width: 12rpx; height: 12rpx; margin-top: 16rpx; border-radius: 50%; background: #1d64f2; }
.block-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 32rpx 8rpx 16rpx; }
.block-section-heading>view { display: flex; align-items: center; gap: 8rpx; font-size: 34rpx; font-weight: 600; line-height: 44rpx; }
.block-section-heading>text { color: #737687; font-size: 22rpx; white-space: nowrap; line-height: 28rpx; font-weight: 700; }
.block-count { min-width: 0; padding: 4rpx 16rpx; border-radius: 99rpx; background: #e9e7ed; color: #424655; text-align: center; font-size: 22rpx; font-weight: 600; line-height: 28rpx; }
.block-state { padding: 80rpx 32rpx; color: #424655; font-size: 26rpx; line-height: 36rpx; text-align: center; }
.state-symbol { margin-bottom: 15rpx; color: #1d64f2; font-size: 47rpx; display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; margin: 0 auto 16rpx; border-radius: 50%; background: #ebf2fe; }
.state-copy { margin-top: 8rpx; color: #424655; font-size: 26rpx; line-height: 36rpx; }
.block-state .pg10-primary { max-width: 350rpx; margin: 20rpx auto 0; font-size: 22rpx; }
.block-card { display: flex; align-items: center; gap: 17rpx; padding: 22rpx 19rpx; margin-bottom: 14rpx; }
.block-avatar { width: 96rpx; height: 96rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #efedf3; color: #1d64f2; font-size: 39rpx; position: relative; }
.block-copy { flex: 1; min-width: 0; }
.block-title { color: #1a1b1f; font-size: 30rpx; font-weight: 600; line-height: 40rpx; }
.block-chip { display: inline-block; margin-top: 8rpx; padding: 4rpx 16rpx; border-radius: 99rpx; background: #fff0f3; color: #ff2d55; font-size: 22rpx; line-height: 28rpx; font-weight: 700; }
.block-meta { margin-top: 8rpx; overflow: hidden; color: #737687; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; line-height: 36rpx; }
.block-action { flex: none; margin: 0; padding: 12rpx 28rpx; border-radius: 99rpx; background: #efedf3; color: #1a1b1f; font-size: 26rpx; font-weight: 600; line-height: 32rpx; box-sizing: border-box; min-height: 76rpx; display: flex; align-items: center; justify-content: center; }
.block-action[disabled] { color: #9098a6; }
.block-action::after { border: 0; }
.privacy-message { margin: 12rpx 0 20rpx; padding: 15rpx 18rpx; border-radius: 17rpx; background: #eaf1ff; color: #1d64f2; font-size: 22rpx; }
.help-card { display: flex; align-items: center; width: 100%; box-sizing: border-box; gap: 17rpx; margin: 55rpx 0 0; padding: 25rpx; color: #171a24; text-align: left; line-height: 1.4; }
.help-card::after { border: 0; }
.help-icon { width: 64rpx; height: 64rpx; flex: none; border-radius: 50%; background: #fff0f3; color: #f13b5d; text-align: center; font-size: 35rpx; font-weight: 800; line-height: 66rpx; display: flex; align-items: center; justify-content: center; }
.help-copy { flex: 1; min-width: 0; font-size: 26rpx; color: #424655; line-height: 36rpx; }
.help-copy text { display: block; margin-top: 0; color: inherit; font-size: inherit; font-weight: inherit; }
.privacy-foot { margin: 28rpx 5rpx 0; color: #737687; font-size: 22rpx; line-height: 28rpx; text-align: center; }
.privacy-header .pg10-back { display: flex; align-items: center; width: 88rpx; min-width: 88rpx; height: 88rpx; margin-left: -8rpx; }
.back-symbol { width: 48rpx; height: 48rpx; }
.more-symbol { width: 44rpx; height: 44rpx; }
.person-symbol { width: 36rpx; height: 36rpx; }
.privacy-page .pg10-card { border-radius: 24rpx; margin-bottom: 0; box-shadow: 0 8rpx 40rpx -4rpx rgba(28,41,61,.05), 0 2rpx 6rpx rgba(28,41,61,.02); }
.intro-glow { position: absolute; right: -64rpx; top: -64rpx; width: 288rpx; height: 288rpx; border-radius: 50%; background: rgba(29,100,242,.05); filter: blur(48rpx); pointer-events: none; }
.intro-head, .privacy-points { position: relative; }
.intro-symbol image { width: 44rpx; height: 44rpx; }
.privacy-points>view:first-child { margin-top: 0; }
.state-symbol image { width: 44rpx; height: 44rpx; }
.block-empty { background: transparent; }
.empty-symbol { width: 128rpx; height: 128rpx; background: #ebf9f0; box-shadow: 0 2rpx 4rpx rgba(0,0,0,.05); }
.empty-symbol image { width: 64rpx; height: 64rpx; }
.empty-title { color: #1a1b1f; font-size: 34rpx; line-height: 44rpx; font-weight: 600; }
.privacy-page .block-card { gap: 16rpx; padding: 24rpx; margin-bottom: 0; }
.anonymous-symbol { width: 48rpx; height: 48rpx; }
.block-badge { position: absolute; right: -4rpx; bottom: -4rpx; display: flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; border-radius: 50%; background: #ff2d55; }
.block-badge image { width: 20rpx; height: 20rpx; }
.privacy-page .help-card { gap: 16rpx; margin-top: 56rpx; padding: 24rpx; }
.help-icon image { width: 36rpx; height: 36rpx; }
.help-link { display: flex; align-items: center; gap: 4rpx; color: #1d64f2; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.help-link image { width: 32rpx; height: 32rpx; }

/* Native safe area stays opaque while source-like header sticks below it. */
.privacy-status-cover { position: fixed; z-index: 20; top: 0; left: 0; right: 0; background: #faf8fe; pointer-events: none; }
