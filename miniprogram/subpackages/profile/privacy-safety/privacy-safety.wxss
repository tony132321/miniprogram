.privacy-page .pg10-card{border-radius:12px;background:#fff;box-shadow:0 4px 20px -2px rgba(28,41,61,.05),0 1px 3px 0 rgba(28,41,61,.02)}.privacy-page .privacy-intro{padding:16px}.privacy-page .intro-glow{right:-32px;top:-32px;width:144px;height:144px;background:rgba(29,100,242,.05);filter:blur(40px)}.privacy-page .intro-head{gap:8px}.privacy-page .intro-symbol{width:40px;height:40px;background:#ebf2fe;box-shadow:0 1px 2px rgba(0,0,0,.05)}.privacy-page .intro-symbol image{width:22px;height:22px}.privacy-page .intro-title{font-size:17px;line-height:22px;font-weight:600;letter-spacing:-.01em}.privacy-page .intro-subtitle{font-size:11px;line-height:14px;font-weight:700;letter-spacing:.02em}.privacy-page .privacy-points{margin-top:12px;padding-left:4px}.privacy-page .privacy-points>view{gap:8px;margin-top:8px;font-size:13px;line-height:21.125px;color:#424655}.privacy-page .privacy-points>view:first-child{margin-top:0}.privacy-page .point-dot{width:6px;height:6px;margin-top:8px;background:#1d64f2}
.privacy-page .block-section-heading{gap:6px;margin:16px 4px 8px}.privacy-page .block-section-heading>view{gap:4px;font-size:17px;line-height:22px;font-weight:600;letter-spacing:-.01em}.privacy-page .block-section-heading>text{font-size:11px;line-height:14px;font-weight:700;letter-spacing:.02em;color:#737687}.privacy-page .block-count{padding:2px 8px;border-radius:9999px;background:#e9e7ed;color:#424655;font-size:11px;line-height:14px;font-weight:600;letter-spacing:.02em}.privacy-page .block-state{padding:40px 16px;color:#424655;font-size:13px;line-height:18px}.privacy-page .state-symbol{width:40px;height:40px;margin:0 auto 8px}.privacy-page .state-symbol image{width:22px;height:22px}.privacy-page .empty-symbol{width:64px;height:64px;background:#ebf9f0;box-shadow:0 1px 2px rgba(0,0,0,.05)}.privacy-page .empty-symbol image{width:32px;height:32px}.privacy-page .empty-title{font-size:17px;line-height:22px;font-weight:600;letter-spacing:-.01em}.privacy-page .state-copy{max-width:320px;margin:4px auto 0;font-size:13px;line-height:18px}
.privacy-page .block-card{justify-content:space-between;gap:12px;margin-bottom:0;padding:12px}.privacy-page .block-avatar{width:48px;height:48px;box-shadow:0 1px 2px rgba(0,0,0,.05)}.privacy-page .anonymous-symbol{width:24px;height:24px}.privacy-page .block-badge{right:-2px;bottom:-2px;width:16px;height:16px;background:#ff2d55}.privacy-page .block-badge image{width:10px;height:10px}.privacy-page .block-title{font-size:15px;line-height:20px;font-weight:600}.privacy-page .block-chip{margin-top:4px;padding:2px 8px;border-radius:9999px;font-size:11px;line-height:14px;font-weight:700;letter-spacing:.02em}.privacy-page .block-meta{margin-top:4px;font-size:13px;line-height:18px;color:#737687}.privacy-page .block-action{min-height:38px;padding:6px 14px;border-radius:9999px;background:#efedf3;color:#1a1b1f;font-size:13px;line-height:16px;font-weight:600}.privacy-page .block-action[disabled]{color:#9098a6}
