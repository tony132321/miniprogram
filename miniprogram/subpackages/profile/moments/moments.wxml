<view class="pg10-page moments-page" style="padding-top: {{statusBarHeight}}px">
  <view class="pg10-header"><button class="pg10-back" bindtap="back" aria-label="返回">‹</button><view class="pg10-header-title">Edit Profile</view><view class="pg10-header-spacer"></view></view>
  <scroll-view class="moments-filters" scroll-x="true" show-scrollbar="false"><button wx:for="{{filters}}" wx:key="id" class="moments-filter {{activeFilter === item.id ? 'active' : ''}}" data-filter="{{item.id}}" bindtap="selectFilter">{{item.title}}</button><view class="moments-filter disabled-filter">照片找我 · 待开放</view></scroll-view>
  <view class="moments-summary"><view class="summary-icon">▧</view><view><view class="summary-title">现场高光记忆</view><view class="summary-note">仅展示本人真实活动记录，照片服务尚未启用</view></view><view class="summary-state">{{loadState === 'READY' ? visibleEvents.length + ' 场活动' : '照片待开放'}}</view></view>
  <view wx:if="{{loadState === 'LOADING'}}" class="moments-state">正在读取我的活动…</view>
  <view wx:elif="{{loadState === 'UNAUTHENTICATED'}}" class="moments-state"><view>登录后可查看自己的活动记录</view><button bindtap="goActivities">前往首页　›</button></view>
  <view wx:elif="{{loadState === 'ERROR'}}" class="moments-state"><view>活动加载失败：{{message}}</view><button bindtap="refresh">重试</button></view>
  <view wx:elif="{{loadState === 'READY' && visibleEvents.length === 0}}" class="moments-state"><view>当前分类还没有活动记录</view><button bindtap="goActivities">查看我的活动　›</button></view>
  <view wx:if="{{loadState === 'READY'}}" class="moments-list"><view wx:for="{{visibleEvents}}" wx:key="id" class="moment-card"><view class="moment-card-head"><view class="moment-symbol">✦</view><view class="moment-title-wrap"><view class="moment-title">{{item.title}}</view><view class="moment-meta">{{item.dateLabel}} · {{item.isHost ? '我主办的' : '我参与的'}}</view></view><view class="moment-status">{{item.statusLabel}}</view></view><view class="moment-photo-layout"><view class="photo-large"><image src="{{item.cover}}" mode="aspectFill"/><view class="photo-overlay"><text>示意配图</text><text>活动相册未开放</text></view></view><view class="photo-small"><image src="{{item.sideCover}}" mode="aspectFill"/><text>示意配图</text></view><view class="photo-small second"><image src="{{item.detailCover}}" mode="aspectFill"/><text>示意配图</text></view></view><view class="moment-footer"><text>照片、点赞与打包暂未开放</text><button data-id="{{item.id}}" bindtap="openActivity">查看活动详情　›</button></view></view></view>
  <view class="privacy-banner"><view class="privacy-icon">✧</view><view><view>照片与肖像权</view><text>活动相册及 AI 找图尚未开放；任何拍摄和分享应先征得同意。</text></view><button bindtap="goGuidelines">了解规则　›</button></view>
  <button class="pg10-primary moments-action" bindtap="goActivities">查看我的真实活动</button>
</view>
