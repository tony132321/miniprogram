<view class="pg10-page moments-page" style="padding-top: {{statusBarHeight}}px">
  <view class="pg10-header moments-header" style="padding-right: {{headerPaddingRight}}; top: {{statusBarHeight}}px"><button class="pg10-back" bindtap="back" aria-label="返回">‹</button><view class="pg10-header-title">Edit Profile</view><view class="moments-header-actions"><button class="moments-header-more" bindtap="toggleMore" aria-label="更多页面入口" aria-expanded="{{moreOpen}}">···</button><button class="moments-header-avatar" bindtap="goProfile" aria-label="返回我的页面">人</button></view><view wx:if="{{moreOpen}}" class="moments-more-menu" style="right: {{headerPaddingRight}}"><button bindtap="goPrivacy">隐私与安全　›</button><button bindtap="goGuidelines">社区公约　›</button><button bindtap="goProfile">我的页面　›</button></view></view>
  <scroll-view class="moments-filters" scroll-x="true" show-scrollbar="false"><button wx:for="{{filters}}" wx:key="id" class="moments-filter {{activeFilter === item.id ? 'active' : ''}}" data-filter="{{item.id}}" bindtap="selectFilter"><text class="moments-filter-icon">{{item.icon}}</text>{{item.title}}</button><view class="moments-filter disabled-filter"><text class="moments-filter-icon">▤</text>胶片合影 · 待开放</view></scroll-view>
  <view class="moments-summary"><view class="summary-icon">▧</view><view class="summary-copy"><view class="summary-heading"><text class="summary-title">现场高光记忆</text><text class="summary-badge">R1</text></view><view class="summary-note">{{loadState === 'READY' ? visibleEvents.length + ' 场本人活动记录' : '仅展示本人真实活动记录'}} · 活动相册未开放</view></view><view class="summary-state">照片待开放</view></view>
  <view wx:if="{{loadState === 'LOADING'}}" class="moments-state">正在读取我的活动…</view>
  <view wx:elif="{{loadState === 'UNAUTHENTICATED'}}" class="moments-state"><view>登录后可查看自己的活动记录</view><button bindtap="goActivities">前往首页　›</button></view>
  <view wx:elif="{{loadState === 'ERROR'}}" class="moments-state"><view>活动加载失败：{{message}}</view><button bindtap="refresh">重试</button></view>
  <view wx:elif="{{loadState === 'READY' && visibleEvents.length === 0}}" class="moments-state"><view>当前分类还没有活动记录</view><button wx:if="{{activeFilter !== 'all' && events.length > 0}}" bindtap="showAllActivities">查看全部活动　›</button><button wx:else bindtap="goCreate">发起新活动　›</button></view>
  <view wx:if="{{loadState === 'READY'}}" class="moments-list"><view wx:for="{{visibleEvents}}" wx:key="id" class="moment-card">
    <view class="moment-card-head"><view class="moment-symbol">✦</view><view class="moment-title-wrap"><view class="moment-title">{{item.title}}</view><view class="moment-meta">{{item.dateLabel}} · {{item.venueName || (item.isHost ? '我主办的' : '我参与的')}} · {{item.statusLabel}}</view></view><view class="moment-pack-unavailable">⌄ 打包待开放</view></view>
    <button class="moment-photo-layout" data-id="{{item.id}}" bindtap="openActivity" aria-label="查看{{item.title}}的活动详情，配图仅作示意，相册未开放"><view class="photo-large"><image src="{{item.cover}}" mode="aspectFill"/><view class="photo-overlay"><text>示意配图</text><text>活动相册未开放</text></view></view><view class="photo-stack"><view class="photo-small"><image src="{{item.sideCover}}" mode="aspectFill"/><text>示意配图</text></view><view class="photo-small second"><image src="{{item.detailCover}}" mode="aspectFill"/><view class="photo-small-shade"><text>相册待开放</text><text>查看真实活动 ›</text></view></view></view></button>
    <view class="moment-footer"><view class="moment-footer-state"><text class="moment-footer-mark">♡</text><text>照片、点赞、评论尚未开放</text></view><button data-id="{{item.id}}" bindtap="openActivity">活动详情　›</button></view>
  </view></view>
  <view class="privacy-banner"><view class="privacy-icon">✧</view><view><view>AI 人脸智能找图</view><text>尚未开放；当前不采集或比对人脸，也没有真人活动照片。</text></view><view class="privacy-unavailable">待开放</view></view>
  <view class="moments-privacy-note">照片上传与打包功能尚未开放。拍摄和分享应先征得同意。<button bindtap="goGuidelines">了解规则　›</button></view>
  <button class="pg10-primary moments-action" bindtap="goCreate"><text class="moments-action-icon">▧</text><text>发起新活动</text><text class="moments-action-tag">照片上传待开放</text></button>
</view>
