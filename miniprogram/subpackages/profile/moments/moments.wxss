.moments-page .moment-footer{gap:8px;padding-top:8px;color:#424655;font-size:13px;line-height:18px}.moments-page .moment-footer-state{gap:8px;min-width:0}.moments-page .moment-footer-mark{width:18px;height:18px}.moments-page .moment-footer button{color:#1d64f2;font-size:13px;line-height:16px;font-weight:600}
.moments-page .privacy-banner{justify-content:space-between;gap:8px;margin-top:16px;padding:12px;border-radius:12px;background:linear-gradient(to bottom right,#f2f1fd,#fff,#ebf2fe);box-shadow:0 1px 2px rgba(0,0,0,.05)}.moments-page .privacy-icon{width:40px;height:40px;box-shadow:0 1px 2px rgba(0,0,0,.05)}.moments-page .privacy-icon image{width:22px;height:22px}.moments-page .privacy-banner>view:nth-child(2){color:#1a1b1f;font-size:17px;line-height:22px;font-weight:600;letter-spacing:-.01em}.moments-page .privacy-banner text{color:#424655;font-size:13px;line-height:18px;font-weight:400;letter-spacing:0}.moments-page .privacy-unavailable{padding:6px 12px;border-radius:9999px;background:#5856d6;color:#fff;font-size:11px;line-height:14px;font-weight:600;letter-spacing:.02em;opacity:.55}.moments-page .moments-privacy-note{color:#424655;font-size:11px;line-height:16px}.moments-page .moments-privacy-note button{font-size:11px;line-height:16px}
.moments-page .moments-action-backdrop{position:fixed;bottom:0;left:0;right:0;z-index:9;box-sizing:border-box;padding:16px 16px max(16px,env(safe-area-inset-bottom));background:linear-gradient(to top,#faf8fe,rgba(250,248,254,.95),transparent);pointer-events:none}.moments-page .moments-action-container{max-width:448px;margin:0 auto;pointer-events:auto}.moments-page .moments-action{position:static;display:flex;gap:8px;width:100%;height:52px;min-height:0;margin:0;padding:0;border-radius:9999px;background:#1d64f2;color:#fff;font-size:15px;line-height:20px;font-weight:600;box-shadow:0 10px 15px -3px rgba(29,100,242,.3),0 4px 6px -4px rgba(29,100,242,.3)}.moments-page .moments-action-icon{width:20px;height:20px}.moments-page .moments-action-tag{margin-left:4px;padding:2px 8px;border-radius:9999px;background:#d2f803;color:#1a1b1f;font-size:11px;line-height:14px;font-weight:700;letter-spacing:.02em}
.moments-page .privacy-content{display:flex;align-items:center;gap:12px;flex:1;min-width:0}.moments-page .privacy-banner .privacy-copy{flex:1;min-width:0;color:#1a1b1f;font-size:17px;line-height:22px;font-weight:600;letter-spacing:-.01em}.moments-page .privacy-banner>.privacy-unavailable{flex:none;color:#fff;font-size:11px;line-height:14px;font-weight:600;letter-spacing:.02em}
