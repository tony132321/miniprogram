@import "../common.wxss";
.moments-page { padding-left: 16px; padding-right: 16px; padding-bottom: calc(90px + env(safe-area-inset-bottom)); }
.moments-status-backdrop { position: fixed; top: 0; left: 0; right: 0; z-index: 12; background: #faf8fe; }
.moments-page .pg10-header { position: sticky; z-index: 11; box-sizing: border-box; margin-left: -16px; margin-right: -16px; padding-left: 16px; height: 56px; }
.moments-page .pg10-header-title { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 600; }
.moments-header-actions { display: flex; flex: none; align-items: center; gap: 3px; }
.moments-header-more,.moments-header-avatar { display: block; flex: none; margin: 0; padding: 0; border: 0; text-align: center; }
.moments-header-more { width: 44px; height: 44px; background: transparent; color: #171a24; line-height: 44px; font-size: 16px; font-weight: 800; }
.moments-header-avatar { width: 32px; height: 32px; border-radius: 50%; background: #004cc8; color: #fff; line-height: 27px; font-size: 14px; font-weight: 800; }
.moments-header-more::after,.moments-header-avatar::after,.moments-more-menu button::after { border: 0; }
.moments-more-menu { position: absolute; top: 43px; z-index: 12; width: 122.5px; padding: 4px; border: 0.5px solid #edf0f5; border-radius: 10px; background: #fff; box-shadow: 0 6px 15px rgba(15,23,42,.14); }
.moments-more-menu button { display: block; box-sizing: border-box; width: 100%; margin: 0; padding: 6.5px 5px; border-bottom: 0.5px solid #edf0f5; border-radius: 0; background: transparent; color: #334155; text-align: left; line-height: 1.4; font-size: 10px; }
.moments-more-menu button:last-child { border-bottom: 0; }
.moments-filters { white-space: nowrap; padding-bottom: 7px; }
.moments-filter { display: inline-block; vertical-align: top; width: auto; margin: 0 4px 0 0; padding: 6px 14px; border-radius: 17.5px; background: #eeeef5; color: #3d4657; font-size: 13px; font-weight: 600; line-height: 16px; }
.moments-filter::after,.moment-footer button::after,.privacy-banner button::after,.moments-state button::after { border: 0; }
.moments-filter.active { background: #2164f0; color: white; }
.moments-filter-icon { margin-right: 4px; font-size: 12px; line-height: 1; }
.moments-filter.disabled-filter { color: #959aaa; }
.moments-summary { display: flex; align-items: center; gap: 7.5px; box-sizing: border-box; min-height: 80px; padding: 12px; margin-bottom: 10.5px; border-radius: 12px; background: linear-gradient(115deg,#eaf2ff,#f7f0ff 68%,#fbf5d8); }
.summary-icon { flex: none; width: 40px; height: 40px; border-radius: 50%; background: #fff; color: #1f63ec; line-height: 27.5px; text-align: center; font-size: 13.5px; }
.summary-copy { flex: 1; min-width: 0; }
.summary-heading { display: flex; align-items: center; gap: 4px; }
.summary-title { font-size: 17px; line-height: 22px; font-weight: 600; }
.summary-badge { border-radius: 7px; padding: 0.5px 4px; background: #d2f803; color: #1a1b1f; font-size: 8px; font-weight: 800; }
.summary-note { color: #596579; font-size: 13px; line-height: 18px; }
.summary-state { flex: none; border-radius: 12px; padding: 3px 6px; background: rgba(255,255,255,.86); color: #db315b; font-size: 8.5px; font-weight: 700; }
.moments-state { padding: 40px 10px; margin-bottom: 10px; border-radius: 14px; background: #fff; color: #7a8496; text-align: center; font-size: 11.5px; }
.moments-state button { display: inline-block; width: auto; margin: 7.5px 0 0; padding: 0; background: transparent; color: #1d64f2; font-size: 11px; }
.moment-card { margin-bottom: 11.5px; padding: 12px; border-radius: 12px; background: #fff; box-shadow: 0 2.5px 8px rgba(48,55,104,.04); }
.moment-card-head { display: flex; align-items: center; gap: 6.5px; margin-bottom: 9px; }
.moment-symbol { width: 32px; height: 32px; border-radius: 50%; flex: none; background: #f2f1fd; color: #5856d6; line-height: 32px; text-align: center; font-size: 13px; }
.moment-title-wrap { flex: 1; min-width: 0; }
.moment-title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #141922; font-size: 17px; line-height: 22px; font-weight: 600; }
.moment-meta { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #626d80; font-size: 13px; line-height: 18px; }
.moment-pack-unavailable { flex: none; border-radius: 11px; padding: 2.5px 5px; background: #ebf2fe; color: #1d64f2; font-size: 8.5px; font-weight: 700; }
.moment-photo-layout { display: flex; align-items: flex-start; gap: 4px; box-sizing: border-box; width: 100%; margin: 0; padding: 0; border: 0; background: transparent; text-align: left; line-height: normal; }
.moment-photo-layout::after { border: 0; }
.photo-large,.photo-small { position: relative; overflow: hidden; border-radius: 8px; background: #dce8fc; }
.photo-large { flex: none; width: calc(66.666667% - 2.66667px); height: 0; padding-top: calc(83.333333% - 3.33333px); }
.photo-stack { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4px; }
.photo-small { width: 100%; height: 0; padding-top: 100%; }
.photo-large image,.photo-small image { display: block; width: 100%; height: 100%; }
.photo-overlay { position: absolute; top: 7px; left: 7px; max-width: 90%; border-radius: 10px; padding: 3px 5.5px; background: rgba(15,23,42,.76); color: #fff; }
.photo-overlay text { display: inline; font-size: 9px; font-weight: 750; line-height: 1.45; }
.photo-overlay text:last-child { margin-left: 4px; color: #d2f803; font-size: 8px; font-weight: 600; }
.photo-small text { position: absolute; top: 4px; left: 4px; border-radius: 10px; padding: 1.5px 4.5px; background: rgba(255,255,255,.92); color: #334155; font-size: 7.5px; font-weight: 700; }
.photo-small-shade { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; background: rgba(17,24,39,.52); color: #fff; }
.photo-small-shade text { position: static; padding: 0; background: transparent; color: #fff; font-size: 10.5px; line-height: 1.3; }
.photo-small-shade text:last-child { margin-top: 3.5px; color: rgba(255,255,255,.9); font-size: 8px; font-weight: 500; }
.moment-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 8px; color: #939baa; font-size: 9px; }
.moment-footer-state { display: flex; align-items: center; gap: 4px; min-width: 0; }
.moment-footer-mark { font-size: 12.5px; color: #9aa3b5; }
.moment-footer button { flex: none; width: auto; padding: 0; margin: 0; background: transparent; color: #1c62e7; font-size: 9.5px; line-height: 1.6; }
.privacy-banner { display: flex; align-items: center; gap: 6px; border-radius: 12.5px; padding: 10px; background: linear-gradient(110deg,#f2f1fd,#eef5ff); }
.privacy-icon { flex: none; width: 26.5px; height: 26.5px; border-radius: 50%; background: #fff; color: #5b59d5; line-height: 26.5px; text-align: center; font-size: 16px; }
.privacy-banner > view:nth-child(2) { flex: 1; min-width: 0; color: #242b3b; font-size: 11px; font-weight: 700; }
.privacy-banner text { display: block; color: #6c7486; font-size: 9px; font-weight: 400; line-height: 1.35; }
.privacy-unavailable { flex: none; border-radius: 12.5px; padding: 4px 6.5px; background: #e1e0f8; color: #5856d6; font-size: 9px; font-weight: 700; }
.moments-privacy-note { padding: 8.5px 2px 4px; color: #737c8e; font-size: 9.5px; line-height: 1.5; }
.moments-privacy-note button { display: inline-block; width: auto; margin: 0 0 0 2.5px; padding: 0; border: 0; background: transparent; color: #5856d6; font-size: 9.5px; line-height: 1.5; }
.moments-privacy-note button::after { border: 0; }
.moments-action { position: fixed; left: 16px; right: 16px; bottom: calc(9px + env(safe-area-inset-bottom)); z-index: 9; display: flex; align-items: center; justify-content: center; gap: 6px; box-sizing: border-box; width: auto; margin: 0; height: 52px; padding: 0 12px; font-size: 15px; line-height: 20px; }
.moments-action-icon { font-size: 15px; }
.moments-action-tag { border-radius: 7.5px; padding: 1px 4px; background: #d2f803; color: #1a1b1f; font-size: 8.5px; line-height: 1.6; }

/* Preserved page structure; Wave68 exact source scopes below override old calibration. */
.moments-page .pg10-header-title { font-size: 17px; line-height: 22px; }
.moments-more-menu { top: 52px; }
.moments-filter-icon { display: inline-block; width: 16px; height: 16px; vertical-align: middle; margin-right: 6px; }
.summary-icon,.privacy-icon { display: flex; align-items: center; justify-content: center; }
.summary-icon image,.privacy-icon image { width: 22px; height: 22px; }
.summary-heading { flex-wrap: wrap; }
.moments-summary { position: relative; align-items: flex-start; gap: 10px; padding-bottom: 31px; }
.summary-state { position: absolute; right: 12px; bottom: 8px; font-size: 11px; line-height: 14px; }
.moment-pack-unavailable { display: flex; align-items: center; gap: 2px; font-size: 11px; line-height: 14px; }
.pack-icon { width: 14px; height: 14px; }
.photo-large image,.photo-small image { position: absolute; top: 0; left: 0; }
.moment-footer-mark { width: 18px; height: 18px; flex: none; }
.moments-action-icon { width: 20px; height: 20px; flex: none; }
.moment-symbol.picnic { background: #fff0f3; }
.moment-symbol.boardgame { background: #ebf9f0; }
.moment-card.picnic .moment-photo-layout .photo-large { width: calc(33.333333% - 2.66667px); padding-top: calc(44.444444% - 3.55556px); }
.moment-card.picnic .moment-photo-layout .photo-stack { flex-direction: row; }
.moment-card.picnic .moment-photo-layout .photo-small { flex: 1; width: 0; padding-top: calc(66.666667% - 2.66667px); }
.moment-card.boardgame .moment-photo-layout .photo-large { width: calc(50% - 2px); padding-top: calc(37.5% - 1.5px); }
.moment-card.boardgame .moment-photo-layout .photo-small { padding-top: 75%; }
.moment-card.boardgame .moment-photo-layout .photo-small.second { display: none; }

/* Existing official symbol resources and page-local header. */
.moments-page .pg10-back { display: flex; align-items: center; justify-content: flex-start; width: 44px; min-width: 44px; height: 44px; padding: 0; }
.moments-back-icon { display: block; width: 24px; height: 24px; }
.moments-header-more,.moments-header-avatar { display: flex; align-items: center; justify-content: center; }
.moments-more-icon { display: block; width: 22px; height: 22px; }
.profile-glyph { display: block; width: 18px; height: 18px; }
.summary-state { display: flex; align-items: center; gap: 4px; }
.summary-heart { display: block; flex: none; width: 14px; height: 14px; }
.photo-overlay .photo-sport-icon { position: static; display: inline-block; width: 14px; height: 14px; margin-right: 3px; vertical-align: middle; }

