@import "../common.wxss";

.support-page { background: #faf8fe; padding-left: 30rpx; padding-right: 30rpx; padding-bottom: 60rpx; }
.support-header { margin-left: -30rpx; margin-right: -30rpx; padding-left: 30rpx; padding-right: 30rpx; background: #faf8fe; margin-bottom: 20rpx; }
.support-back, .support-header-space { width: 150rpx; min-width: 150rpx; }
.support-header-space { height: 1rpx; }
.support-header .pg10-header-title { white-space: nowrap; }
.support-page .pg10-card { border-radius: 28rpx; margin-bottom: 28rpx; box-shadow: 0 5rpx 20rpx rgba(35, 39, 76, .035); }

.support-hero { position: relative; padding: 32rpx; background: linear-gradient(135deg, #e9f1ff 0%, #fff 56%, #f2f0ff 100%); overflow: hidden; }
.support-hero-top { display: flex; align-items: flex-start; gap: 22rpx; }
.assistant-mark { width: 96rpx; height: 96rpx; flex: none; border-radius: 50%; background: linear-gradient(145deg, #2468f1, #6158df); box-shadow: 0 9rpx 23rpx rgba(35, 96, 224, .23); display: flex; align-items: center; justify-content: center; }
.assistant-face { width: 53rpx; height: 45rpx; border: 4rpx solid #fff; border-radius: 12rpx; position: relative; box-sizing: border-box; }
.assistant-face::before { content: ''; position: absolute; left: 50%; top: -12rpx; width: 4rpx; height: 9rpx; background: #fff; transform: translateX(-50%); }
.assistant-face::after { content: ''; position: absolute; left: 50%; top: -17rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #fff; transform: translateX(-50%); }
.assistant-eyes { height: 24rpx; display: flex; justify-content: space-evenly; align-items: center; color: #fff; line-height: 1; font-size: 19rpx; }
.assistant-mouth { width: 19rpx; height: 3rpx; background: #fff; margin: 1rpx auto 0; border-radius: 2rpx; }
.support-hero-copy { flex: 1; min-width: 0; }
.support-hero-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; color: #171a24; font-size: 29rpx; font-weight: 700; line-height: 1.35; }
.support-unavailable { padding: 4rpx 10rpx; border-radius: 99rpx; background: #edf0f5; color: #68738a; font-size: 18rpx; font-weight: 700; white-space: nowrap; }
.support-hero-note { color: #525c6c; font-size: 22rpx; line-height: 1.55; margin-top: 7rpx; }
.support-hero-actions { display: flex; gap: 16rpx; margin-top: 27rpx; }
.support-hero-actions button { height: 78rpx; min-height: 78rpx; padding: 0 13rpx; margin: 0; border-radius: 45rpx; display: flex; align-items: center; justify-content: center; font-size: 21rpx; font-weight: 700; line-height: 1.2; box-sizing: border-box; }
.support-hero-actions button::after, .support-faq-trigger::after, .support-report-tag::after, .support-submit::after, .support-report-action::after { border: 0; }
.support-ai-action { flex: 1.25; color: #fff !important; background: #6288df !important; box-shadow: 0 7rpx 17rpx rgba(34, 101, 240, .15); }
.support-human-action { flex: 1; color: #667186 !important; background: #fff !important; box-shadow: 0 5rpx 14rpx rgba(30, 34, 68, .06); }

.support-faq-card { padding: 30rpx; }
.support-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 20rpx; }
.support-section-title { display: flex; align-items: center; gap: 12rpx; color: #161a23; font-size: 29rpx; font-weight: 750; white-space: nowrap; }
.support-section-icon { width: 25rpx; height: 25rpx; display: inline-flex; align-items: center; justify-content: center; border: 3rpx solid #2465ef; border-radius: 4rpx; color: #2465ef; font-size: 18rpx; font-weight: 800; }
.support-section-hint { color: #6d7381; font-size: 19rpx; white-space: nowrap; }
.support-faq-item { background: #f2f1f6; border-radius: 17rpx; margin-bottom: 9rpx; overflow: hidden; }
.support-faq-item:last-child { margin-bottom: 0; }
.support-faq-trigger { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; width: 100%; margin: 0; padding: 20rpx 20rpx 20rpx 22rpx; background: transparent; text-align: left; color: #1e2029; font-size: 24rpx; line-height: 1.4; box-sizing: border-box; }
.support-faq-trigger text:first-child { flex: 1; }
.support-faq-chevron { flex: none; color: #7b8495; font-size: 31rpx; line-height: 1; transform: rotate(0deg); }
.support-faq-chevron.is-open { transform: rotate(180deg); }
.support-faq-answer { padding: 0 22rpx 22rpx; color: #606a7c; font-size: 22rpx; line-height: 1.65; }

.support-feedback-card { padding: 30rpx; }
.support-edit-icon { color: #5754d7; font-size: 30rpx; font-weight: 800; transform: rotate(-15deg); }
.feedback-state { font-size: 18rpx; }
.support-feedback-intro { color: #606a7b; font-size: 22rpx; line-height: 1.55; margin-top: -8rpx; margin-bottom: 24rpx; }
.support-field-label { display: block; color: #1a1d25; font-size: 22rpx; font-weight: 700; line-height: 1.45; margin-bottom: 10rpx; }
.support-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 23rpx; }
.support-tag { height: 52rpx; padding: 0 18rpx; border-radius: 30rpx; background: #f0eff5; color: #586174; font-size: 21rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.support-report-tag { margin: 0; line-height: normal; background: #e8f0ff; color: #175be6; }
.support-field-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-bottom: 10rpx; }
.support-field-row .support-field-label { margin-bottom: 0; }
.support-field-count { color: #858da0; font-size: 20rpx; white-space: nowrap; }
.support-textarea { width: 100%; height: 156rpx; box-sizing: border-box; padding: 21rpx 20rpx; border-radius: 22rpx; background: #f3f2f7; color: #7f8798; font-size: 22rpx; line-height: 1.5; margin-bottom: 24rpx; }
.support-upload-placeholder { width: 141rpx; height: 141rpx; margin-bottom: 24rpx; border-radius: 22rpx; background: #f3f2f7; color: #8a91a1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; font-size: 20rpx; font-weight: 700; }
.support-upload-icon { font-size: 44rpx; line-height: 1; }
.support-contact { height: 77rpx; display: flex; align-items: center; gap: 15rpx; padding: 0 20rpx; box-sizing: border-box; border-radius: 19rpx; background: #f3f2f7; margin-bottom: 26rpx; }
.support-contact-icon { color: #8a91a1; font-size: 27rpx; }
.support-contact input { flex: 1; min-width: 0; color: #737c8d; font-size: 22rpx; }
.support-submit { width: 100%; height: 83rpx; margin: 0; border-radius: 45rpx; background: #a7b9e8 !important; color: #fff !important; font-size: 26rpx; font-weight: 700; line-height: 83rpx; }

.support-safety-card { padding: 26rpx 30rpx; }
.support-safety-row { display: flex; align-items: flex-start; gap: 17rpx; }
.support-safety-icon { width: 53rpx; height: 53rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; background: #fff0f3; color: #e83f59; font-size: 28rpx; font-weight: 800; }
.support-safety-title { color: #20222b; font-size: 25rpx; font-weight: 750; line-height: 1.5; }
.support-safety-note { color: #677185; font-size: 21rpx; line-height: 1.5; margin-top: 4rpx; }
.support-report-action { width: 100%; height: 73rpx; margin: 23rpx 0 0; border-radius: 40rpx; background: #2465ef; color: #fff; font-size: 23rpx; font-weight: 700; line-height: 73rpx; }
.support-footer { padding: 6rpx 0 40rpx; color: #9a9fad; text-align: center; font-size: 19rpx; line-height: 1.5; }
