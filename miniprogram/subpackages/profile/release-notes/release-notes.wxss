@import "../common.wxss";
.release-page { padding: 0 32rpx 64rpx; background: #F5F6F8; color: #1a1b1f; }
.release-status-bar { position: fixed; z-index: 12; top: 0; left: 0; right: 0; background: #faf8fe; pointer-events: none; }
.release-page .release-header { position: sticky; z-index: 11; box-sizing: border-box; height: 112rpx; margin: 0 -32rpx; padding-left: 32rpx; background: rgba(250,248,254,.8); backdrop-filter: blur(48rpx); box-shadow: 0 2rpx 16rpx rgba(0,0,0,.04); }
.release-page .pg10-back, .release-header .pg10-header-share, .release-header .pg10-header-more { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; width: 88rpx; min-width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; line-height: 1; }
.release-page .pg10-back { margin-left: -8rpx; }
.release-page .pg10-back image { display: block; width: 48rpx; height: 48rpx; }
.release-page .pg10-header-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 8rpx; text-align: center; font-size: 34rpx; font-weight: 600; line-height: 44rpx; letter-spacing: -.68rpx; }
.release-header .pg10-header-actions { display: flex; flex: none; align-items: center; gap: 8rpx; }
.release-header .pg10-header-share image, .release-header .pg10-header-more image { display: block; width: 44rpx; height: 44rpx; }
.release-header .pg10-header-avatar { display: flex; flex: none; align-items: center; justify-content: center; min-width: 64rpx; width: 64rpx; height: 64rpx; margin: 0 0 0 8rpx; padding: 0; border-radius: 50%; background: #004cc8; line-height: 1; }
.release-header .pg10-header-avatar image { width: 36rpx; height: 36rpx; }
.release-header button::after, .release-actions button::after { border: 0; }
.release-header .pg10-header-menu { position: absolute; top: 104rpx; z-index: 13; width: 280rpx; padding: 8rpx; border: 1rpx solid #edf0f5; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(15,23,42,.14); }
.release-header .pg10-header-menu button { display: block; box-sizing: border-box; width: 100%; min-width: 0; margin: 0; padding: 16rpx 12rpx; border-bottom: 1rpx solid #edf0f5; border-radius: 0; background: transparent; color: #424655; text-align: left; line-height: 36rpx; font-size: 26rpx; }
.release-header .pg10-header-menu button:last-child { border-bottom: 0; }
.release-content { padding-top: 32rpx; }
.release-page .pg10-card { box-sizing: border-box; position: relative; overflow: hidden; padding: 32rpx; margin-bottom: 24rpx; border-radius: 32rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); }
.release-page .release-intro { margin-bottom: 40rpx; background: #fff; }
.intro-glow { position: absolute; top: -96rpx; right: -96rpx; width: 352rpx; height: 352rpx; border-radius: 50%; background: linear-gradient(135deg,rgba(29,100,242,.15),rgba(88,86,214,.10),rgba(210,248,3,.20)); filter: blur(80rpx); pointer-events: none; }
.release-status { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-bottom: 24rpx; font-size: 22rpx; font-weight: 700; line-height: 28rpx; letter-spacing: -.44rpx; }
.version-chip, .ability-chip { display: flex; align-items: center; flex: none; border-radius: 999rpx; padding: 8rpx 20rpx; }
.version-chip { gap: 12rpx; color: #004cc8; background: #EBF2FE; }
.ability-chip { gap: 8rpx; color: #34C759; background: #EBF9F0; }
.status-dot { width: 16rpx; height: 16rpx; flex: none; border-radius: 50%; background: #34C759; }
.ability-chip image { width: 28rpx; height: 28rpx; }
.whats-new { position: relative; display: inline-block; margin-bottom: 16rpx; border-radius: 999rpx; padding: 4rpx 16rpx; color: #FF2D55; background: #FFF0F3; font-size: 22rpx; font-weight: 700; line-height: 28rpx; letter-spacing: .44rpx; }
.release-title { position: relative; margin-bottom: 8rpx; font-size: 44rpx; font-weight: 700; line-height: 56rpx; letter-spacing: -.88rpx; }
.release-intro-note { position: relative; display: flex; align-items: flex-start; gap: 8rpx; color: #424655; font-size: 26rpx; line-height: 36rpx; }
.release-intro-note image { width: 30rpx; height: 30rpx; margin-top: 3rpx; flex: none; }
.intro-highlight { position: relative; display: flex; align-items: center; gap: 16rpx; margin-top: 32rpx; padding: 16rpx 24rpx; border-radius: 24rpx; background: #f4f3f8; font-size: 26rpx; font-weight: 700; line-height: 32rpx; }
.intro-highlight-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; background: linear-gradient(45deg,#004cc8,#5856D6); }
.intro-highlight-icon image { width: 36rpx; height: 36rpx; }
.release-page .draft-card { background: linear-gradient(90deg,rgba(29,100,242,.05),rgba(88,86,214,.05)),#fff; }
.feature-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 8rpx; margin-bottom: 24rpx; }
.feature-heading-main { display: flex; align-items: center; min-width: 0; gap: 20rpx; }
.feature-heading-copy { min-width: 0; }
.feature-icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; flex: none; border-radius: 24rpx; }
.feature-icon image { width: 48rpx; height: 48rpx; }
.feature-icon.blue { background: #1D64F2; box-shadow: 0 8rpx 32rpx rgba(29,100,242,.3); }
.feature-icon.violet { background: #5856D6; box-shadow: 0 8rpx 32rpx rgba(88,86,214,.3); }
.feature-icon.pink { background: #FF2D55; box-shadow: 0 8rpx 32rpx rgba(255,45,85,.3); }
.feature-kicker { color: #004cc8; font-size: 22rpx; font-weight: 700; line-height: 28rpx; letter-spacing: .44rpx; }
.feature-kicker.violet-text { color: #5856D6; }
.feature-kicker.pink-text { color: #FF2D55; }
.feature-title { color: #1a1b1f; font-size: 34rpx; font-weight: 700; line-height: 44rpx; letter-spacing: -.34rpx; }
.ability-pill { flex: none; border-radius: 999rpx; padding: 4rpx 16rpx; background: #F3FEE7; color: #4d5d00; font-size: 22rpx; font-weight: 700; line-height: 28rpx; letter-spacing: .44rpx; }
.violet-pill { color: #5856D6; background: #F2F1FD; }
.pink-pill { color: #FF2D55; background: #FFF0F3; }
.feature-image { position: relative; overflow: hidden; height: 288rpx; border-radius: 24rpx; margin-bottom: 24rpx; background: #e3e2e7; }
.feature-image .scene-photo { display: block; width: 100%; height: 100%; }
.photo-caption { position: absolute; inset: 0; display: flex; align-items: flex-end; gap: 16rpx; padding: 24rpx; background: linear-gradient(0deg,rgba(26,27,31,.8),transparent 70%); color: #fff; font-size: 22rpx; font-weight: 600; line-height: 28rpx; letter-spacing: .44rpx; }
.photo-dot { flex: none; width: 20rpx; height: 20rpx; margin-bottom: 4rpx; border-radius: 50%; background: #D2F803; }
.photo-label { position: absolute; top: 16rpx; right: 16rpx; display: flex; align-items: center; gap: 12rpx; border-radius: 999rpx; padding: 8rpx 20rpx; background: rgba(255,255,255,.82); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); color: #1a1b1f; font-size: 22rpx; font-weight: 700; line-height: 28rpx; }
.photo-label image { width: 28rpx; height: 28rpx; }
.feature-points { display: flex; flex-direction: column; gap: 20rpx; }
.feature-point { padding: 24rpx; border-radius: 24rpx; background: #f4f3f8; }
.point-heading { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; color: #1a1b1f; font-size: 26rpx; font-weight: 700; line-height: 32rpx; }
.point-heading image { flex: none; width: 36rpx; height: 36rpx; }
.point-body { color: #424655; font-size: 26rpx; font-weight: 400; line-height: 36rpx; }
.feature-triplet { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.triplet-item { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; text-align: center; padding: 20rpx; border-radius: 24rpx; background: #f4f3f8; color: #1a1b1f; font-size: 22rpx; font-weight: 700; line-height: 28rpx; letter-spacing: .44rpx; }
.triplet-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-bottom: 12rpx; border-radius: 50%; }
.triplet-icon image { width: 40rpx; height: 40rpx; }
.triplet-icon.green { background: #EBF9F0; }
.triplet-icon.blue-soft { background: #EBF2FE; }
.triplet-icon.pink-soft { background: #FFF0F3; }
.optimization-heading { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.optimization-heading image { flex: none; width: 40rpx; height: 40rpx; }
.optimization-point { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx; border-radius: 24rpx; background: #f4f3f8; font-size: 26rpx; font-weight: 400; line-height: 36rpx; }
.optimization-dot { flex: none; width: 16rpx; height: 16rpx; margin-top: 12rpx; border-radius: 50%; background: #004cc8; }
.release-page .unavailable-card { background: #fff; }
.unavailable-card .feature-title { margin-bottom: 16rpx; }
.unavailable-card .pg10-note { color: #424655; font-size: 26rpx; line-height: 36rpx; }
.release-footer { display: flex; flex-direction: column; align-items: center; margin-top: 32rpx; padding: 32rpx; border-radius: 32rpx; background: #f4f3f8; }
.footer-icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin-bottom: 16rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); }
.footer-icon image { width: 48rpx; height: 48rpx; }
.release-foot { margin-bottom: 32rpx; color: #424655; text-align: center; font-size: 26rpx; line-height: 42rpx; }
.release-actions { display: flex; width: 100%; gap: 16rpx; }
.release-actions button { flex: 1; min-width: 0; margin: 0; padding: 28rpx 8rpx; border-radius: 999rpx; background: #fff; color: #1a1b1f; font-size: 26rpx; font-weight: 700; line-height: 36rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); }
.release-actions button:first-child { color: #004cc8; }

/* Only the source's explicit typography nodes, rather than its default body. */
.release-page .pg10-header-title, .release-status, .whats-new, .release-title,
.release-intro-note, .intro-highlight, .feature-kicker, .feature-title,
.ability-pill, .photo-caption, .photo-label, .point-heading, .point-body,
.triplet-item, .optimization-point, .release-foot, .release-actions button {
  font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
}
