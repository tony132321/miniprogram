@import "../common.wxss";

.storage-page { background: #faf8fe; padding-left: 32rpx; padding-right: 32rpx; padding-bottom: 55rpx; }
.storage-header { position: sticky; z-index: 11; box-sizing: border-box; margin-left: -32rpx; margin-right: -32rpx; padding-left: 32rpx; background: #faf8fe; margin-bottom: 22rpx; height: 112rpx; }
.storage-back { width: 88rpx; min-width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: flex-start; }
.storage-header .pg10-header-title { font-size: 34rpx; line-height: 44rpx; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.storage-page .pg10-card { border-radius: 25rpx; margin-bottom: 19rpx; box-shadow: 0 5rpx 20rpx rgba(35, 39, 76, .035); }
.storage-summary { padding: 32rpx; }
.storage-summary-head { display: flex; align-items: center; gap: 13rpx; }
.storage-symbol { width: 64rpx; height: 64rpx; min-width: 64rpx; border-radius: 50%; background: #e8f0ff; color: #2465ef; font-size: 34rpx; display: flex; align-items: center; justify-content: center; }
.storage-summary-title { flex: 1; min-width: 0; }
.storage-kicker { color: #81889a; font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx; line-height: 28rpx; }
.storage-heading { color: #1b202b; font-size: 34rpx; font-weight: 600; line-height: 44rpx; }
.storage-size { flex: none; display: flex; align-items: baseline; gap: 4rpx; color: #1257d9; white-space: nowrap; }
.storage-size-number { font-size: 56rpx; font-weight: 800; line-height: 72rpx; letter-spacing: -1.4rpx; }
.storage-size-unit { font-size: 26rpx; font-weight: 700; line-height: 32rpx; }
.storage-bar { height: 24rpx; border-radius: 12rpx; background: #e9eaf1; margin: 29rpx 0 27rpx; overflow: hidden; }
.storage-bar view { height: 24rpx; border-radius: 12rpx; background: linear-gradient(90deg, #2465ef, #6258dc); }
.storage-stat-row { display: flex; gap: 12rpx; }
.storage-stat { flex: 1; min-width: 0; }
.storage-stat-label { display: flex; align-items: center; gap: 7rpx; color: #858b9a; font-size: 22rpx; font-weight: 700; line-height: 28rpx; white-space: nowrap; }
.storage-dot { width: 16rpx; height: 16rpx; min-width: 16rpx; border-radius: 50%; }
.storage-dot.blue { background: #2465ef; }
.storage-dot.violet { background: #6158d8; }
.storage-dot.green { background: #2bc569; }
.storage-stat-value { color: #1c222b; font-size: 30rpx; font-weight: 600; line-height: 40rpx; margin-top: 8rpx; white-space: nowrap; }
.storage-diagnosis { display: flex; align-items: center; gap: 17rpx; margin: 25rpx 0 27rpx; padding: 24rpx; border-radius: 25rpx; background: linear-gradient(120deg, #eaf2ff, #f3f1ff); }
.storage-diagnosis-icon { width: 80rpx; height: 80rpx; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; color: #2465ef; font-size: 28rpx; box-shadow: 0 4rpx 12rpx rgba(36, 101, 239, .07); }
.storage-diagnosis-copy { flex: 1; min-width: 0; }
.storage-diagnosis-title { color: #1c222b; font-size: 26rpx; font-weight: 600; line-height: 32rpx; }
.storage-diagnosis-note { color: #697385; font-size: 26rpx; line-height: 36rpx; margin-top: 3rpx; }
.storage-diagnosis-tag { flex: none; border-radius: 30rpx; background: #e9f8ee; color: #28a55d; padding: 7rpx 10rpx; font-size: 17rpx; font-weight: 700; }
.storage-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin: 0 4rpx 15rpx; }
.storage-list-heading text:first-child { color: #5b6473; font-size: 22rpx; font-weight: 700; }
.storage-list-heading text:last-child { color: #2465ef; font-size: 19rpx; }
.storage-info-card { display: flex; align-items: flex-start; gap: 24rpx; padding: 24rpx; }
.storage-info-icon { width: 80rpx; height: 80rpx; min-width: 80rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 31rpx; }
.storage-info-icon.blue-icon { color: #2465ef; background: #e8f0ff; }
.storage-info-icon.violet-icon { color: #6258d8; background: #f0edff; }
.storage-info-copy { flex: 1; }
.storage-info-title { color: #1c222b; font-size: 30rpx; font-weight: 600; line-height: 40rpx; }
.storage-info-note { color: #687386; font-size: 26rpx; line-height: 36rpx; margin-top: 6rpx; }
.storage-info-pill { display: inline-block; width: auto; height: auto; border-radius: 25rpx; background: #f0eff4; color: #2465ef; font-size: 22rpx; font-weight: 500; line-height: 28rpx; padding: 6rpx 12rpx; margin: 15rpx 0 0; }
.storage-info-pill::after { border: 0; }
.storage-protection { display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx; margin: 22rpx 0 27rpx; border-radius: 23rpx; background: #f0f0f5; color: #5a6476; font-size: 26rpx; line-height: 36rpx; }
.storage-protection-icon { flex: none; width: 40rpx; height: 40rpx; color: #2fbf66; display: flex; align-items: center; justify-content: center; }
.storage-refresh { display: flex; align-items: center; justify-content: center; gap: 16rpx; box-sizing: border-box; width: 100%; height: 96rpx; margin: 0; border-radius: 44rpx; background: #2465ef; color: #fff; font-size: 30rpx; font-weight: 700; line-height: 40rpx; box-shadow: 0 11rpx 24rpx rgba(36, 101, 239, .16); }
.storage-refresh::after { border: 0; }
.storage-read-status { display: flex; align-items: center; justify-content: center; gap: 12rpx; color: #737687; font-size: 22rpx; line-height: 28rpx; text-align: center; margin: 18rpx 0 0; }
.storage-read-status.error { color: #b13f54; }
.storage-footer { color: #939aab; font-size: 26rpx; line-height: 36rpx; text-align: center; margin: 10rpx 0 35rpx; }

/* Official Material Symbols retain source glyph paths; sizes map 1px to 2rpx. */
.storage-status-cover { position: fixed; z-index: 20; top: 0; left: 0; right: 0; background: #faf8fe; pointer-events: none; }
.storage-header .profile-header-more { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.storage-header .profile-header-menu { top: 104rpx; }
.storage-header .profile-header-avatar { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: #004cc8; }
.storage-back-icon { width: 48rpx; height: 48rpx; }
.storage-more-icon { width: 44rpx; height: 44rpx; }
.storage-person-icon, .storage-stack-icon { width: 36rpx; height: 36rpx; }
.storage-device-icon, .storage-session-icon, .storage-document-icon { width: 44rpx; height: 44rpx; }
.storage-shield-icon, .storage-refresh-icon { width: 40rpx; height: 40rpx; flex: none; }
.storage-read-status-icon { width: 28rpx; height: 28rpx; flex: none; }
