@import "../common.wxss";

.storage-page { background: #faf8fe; padding-left: 30rpx; padding-right: 30rpx; padding-bottom: 55rpx; }
.storage-header { margin-left: -30rpx; margin-right: -30rpx; padding-left: 30rpx; padding-right: 30rpx; background: #faf8fe; margin-bottom: 22rpx; }
.storage-back, .storage-header-space { width: 150rpx; min-width: 150rpx; }
.storage-header-space { height: 1rpx; }
.storage-page .pg10-card { border-radius: 25rpx; margin-bottom: 19rpx; box-shadow: 0 5rpx 20rpx rgba(35, 39, 76, .035); }
.storage-summary { padding: 29rpx 28rpx; }
.storage-summary-head { display: flex; align-items: center; gap: 13rpx; }
.storage-symbol { width: 57rpx; height: 57rpx; min-width: 57rpx; border-radius: 50%; background: #e8f0ff; color: #2465ef; font-size: 34rpx; line-height: 57rpx; text-align: center; }
.storage-summary-title { flex: 1; min-width: 0; }
.storage-kicker { color: #81889a; font-size: 18rpx; font-weight: 800; letter-spacing: 1rpx; line-height: 1.25; }
.storage-heading { color: #1b202b; font-size: 26rpx; font-weight: 800; white-space: nowrap; line-height: 1.4; }
.storage-size { flex: none; color: #1257d9; font-size: 35rpx; font-weight: 800; line-height: 1.2; white-space: nowrap; }
.storage-bar { height: 16rpx; border-radius: 12rpx; background: #e9eaf1; margin: 29rpx 0 27rpx; overflow: hidden; }
.storage-bar view { height: 16rpx; border-radius: 12rpx; background: linear-gradient(90deg, #2465ef, #6258dc); }
.storage-stat-row { display: flex; gap: 12rpx; }
.storage-stat { flex: 1; min-width: 0; }
.storage-stat-label { display: flex; align-items: center; gap: 7rpx; color: #858b9a; font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.storage-dot { width: 11rpx; height: 11rpx; min-width: 11rpx; border-radius: 50%; }
.storage-dot.blue { background: #2465ef; }
.storage-dot.violet { background: #6158d8; }
.storage-dot.green { background: #2bc569; }
.storage-stat-value { color: #1c222b; font-size: 25rpx; font-weight: 800; line-height: 1.3; margin-top: 8rpx; white-space: nowrap; }
.storage-diagnosis { display: flex; align-items: center; gap: 17rpx; margin: 25rpx 0 27rpx; padding: 22rpx 23rpx; border-radius: 25rpx; background: linear-gradient(120deg, #eaf2ff, #f3f1ff); }
.storage-diagnosis-icon { width: 58rpx; height: 58rpx; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; color: #2465ef; font-size: 28rpx; box-shadow: 0 4rpx 12rpx rgba(36, 101, 239, .07); }
.storage-diagnosis-copy { flex: 1; min-width: 0; }
.storage-diagnosis-title { color: #1c222b; font-size: 23rpx; font-weight: 800; line-height: 1.4; }
.storage-diagnosis-note { color: #697385; font-size: 20rpx; line-height: 1.4; margin-top: 3rpx; }
.storage-diagnosis-tag { flex: none; border-radius: 30rpx; background: #e9f8ee; color: #28a55d; padding: 7rpx 10rpx; font-size: 17rpx; font-weight: 700; }
.storage-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin: 0 4rpx 15rpx; }
.storage-list-heading text:first-child { color: #5b6473; font-size: 22rpx; font-weight: 700; }
.storage-list-heading text:last-child { color: #2465ef; font-size: 19rpx; }
.storage-info-card { display: flex; align-items: flex-start; gap: 19rpx; padding: 27rpx 23rpx; }
.storage-info-icon { width: 62rpx; height: 62rpx; min-width: 62rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 31rpx; }
.storage-info-icon.blue-icon { color: #2465ef; background: #e8f0ff; }
.storage-info-icon.violet-icon { color: #6258d8; background: #f0edff; }
.storage-info-copy { flex: 1; }
.storage-info-title { color: #1c222b; font-size: 24rpx; font-weight: 800; line-height: 1.4; }
.storage-info-note { color: #687386; font-size: 21rpx; line-height: 1.52; margin-top: 6rpx; }
.storage-info-pill { display: inline-block; border-radius: 25rpx; background: #f0eff4; color: #667083; font-size: 18rpx; font-weight: 700; padding: 6rpx 12rpx; margin-top: 15rpx; }
.storage-protection { display: flex; align-items: flex-start; gap: 18rpx; padding: 25rpx 23rpx; margin: 22rpx 0 27rpx; border-radius: 23rpx; background: #f0f0f5; color: #5a6476; font-size: 20rpx; line-height: 1.55; }
.storage-protection-icon { color: #2fbf66; font-size: 30rpx; font-weight: 800; line-height: 1.15; }
.storage-refresh { width: 100%; height: 78rpx; margin: 0; border-radius: 44rpx; background: #2465ef; color: #fff; font-size: 25rpx; font-weight: 800; line-height: 78rpx; box-shadow: 0 11rpx 24rpx rgba(36, 101, 239, .16); }
.storage-refresh::after { border: 0; }
.storage-footer { color: #939aab; font-size: 19rpx; line-height: 1.5; text-align: center; margin: 18rpx 0 35rpx; }
