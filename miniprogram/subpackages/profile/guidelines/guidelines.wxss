@import "../common.wxss";
.guidelines-page { padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom)); background: #F5F6F8; color: #1a1b1f; }
.guidelines-status-cover { position: fixed; top: 0; right: 0; left: 0; z-index: 10; background: #faf8fe; pointer-events: none; }
.guidelines-page .pg10-header { position: sticky; z-index: 11; box-sizing: border-box; height: 112rpx; margin: 0 -32rpx 24rpx; padding-left: 32rpx; background: rgba(250,248,254,.8); backdrop-filter: blur(48rpx); box-shadow: 0 2rpx 16rpx rgba(0,0,0,.04); }
.guidelines-header .pg10-back, .guidelines-header .pg10-header-share, .guidelines-header .pg10-header-more { display: flex; flex: none; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; min-width: 0; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; line-height: normal; }
.guidelines-header .pg10-back { margin-left: -8rpx; }
.header-back-symbol { width: 48rpx; height: 48rpx; }
.header-action-symbol { width: 44rpx; height: 44rpx; }
.guidelines-page .pg10-header-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 8rpx; color: #1a1b1f; text-align: center; font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.85rpx; }
.guidelines-header .pg10-header-actions { display: flex; flex: none; align-items: center; gap: 8rpx; }
.guidelines-header .pg10-header-avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; min-width: 0; margin: 0 0 0 8rpx; padding: 0; border: 0; border-radius: 50%; background: #004cc8; }
.header-avatar-symbol { width: 36rpx; height: 36rpx; }
.guidelines-header button::after { border: 0; }
.guidelines-header .pg10-header-menu { position: absolute; top: 104rpx; z-index: 12; width: 300rpx; padding: 8rpx; border: 1rpx solid #e3e2e7; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(15,23,42,.14); }
.guidelines-header .pg10-header-menu button { display: block; box-sizing: border-box; width: 100%; min-width: 0; margin: 0; padding: 16rpx 12rpx; border-bottom: 1rpx solid #e3e2e7; border-radius: 0; background: transparent; color: #424655; text-align: left; line-height: 36rpx; font-size: 26rpx; }
.guidelines-header .pg10-header-menu button:last-child { border-bottom: 0; }
.guidelines-page .pg10-card { padding: 32rpx; margin-bottom: 32rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 2rpx 4rpx rgba(0,0,0,.05); }
.guidelines-page .charter-hero { position: relative; overflow: hidden; text-align: center; }
.charter-orb { position: absolute; border-radius: 50%; pointer-events: none; }
.charter-orb-cool { top: -80rpx; right: -80rpx; width: 352rpx; height: 352rpx; background: linear-gradient(135deg,#F2F1FD,#EBF2FE,#F3FEE7); opacity: .8; filter: blur(80rpx); }
.charter-orb-pink { bottom: -80rpx; left: -96rpx; width: 288rpx; height: 288rpx; background: #FFF0F3; opacity: .6; filter: blur(48rpx); }
.charter-intro { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
.charter-mark { position: relative; display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; margin: 0 auto 24rpx; border-radius: 50%; background: linear-gradient(45deg,#1D64F2,#5856D6); box-shadow: 0 20rpx 30rpx -6rpx rgba(29,100,242,.2); }
.charter-handshake { width: 64rpx; height: 64rpx; }
.charter-heart { position: absolute; right: -8rpx; bottom: -8rpx; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 50%; background: #FF2D55; box-shadow: 0 8rpx 12rpx -2rpx rgba(0,0,0,.1); }
.charter-heart image { width: 30rpx; height: 30rpx; }
.charter-kicker { display: inline-flex; align-items: center; gap: 8rpx; padding: 4rpx 16rpx; margin-bottom: 8rpx; border-radius: 999rpx; background: #F3FEE7; color: #4d5d00; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: 1.1rpx; }
.charter-kicker-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #4d5d00; }
.charter-title { margin-bottom: 8rpx; color: #1a1b1f; font-size: 44rpx; line-height: 56rpx; font-weight: 700; letter-spacing: -1.1rpx; }
.charter-subtitle { max-width: 640rpx; color: #424655; font-size: 30rpx; line-height: 48.75rpx; font-weight: 400; }
.charter-values { position: relative; z-index: 1; display: flex; gap: 24rpx; margin-top: 32rpx; padding: 24rpx 16rpx 16rpx; border-radius: 24rpx; background: #f4f3f8; }
.charter-values > view { flex: 1; min-width: 0; color: #004cc8; font-size: 30rpx; line-height: 40rpx; font-weight: 600; }
.charter-values > view:nth-child(2) { color: #34C759; }
.charter-values > view:nth-child(3) { color: #5856D6; }
.charter-values text { display: block; color: #424655; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .44rpx; }
.guideline-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.guidelines-page .guideline-icon { flex: none; width: 80rpx; height: 80rpx; min-width: 80rpx; border-radius: 24rpx; background: #EBF2FE; }
.guideline-icon image { width: 44rpx; height: 44rpx; }
.guidelines-page .guideline-icon.violet { background: #F2F1FD; }
.guidelines-page .guideline-icon.green { background: #EBF9F0; }
.guidelines-page .guideline-icon.lime { background: #F3FEE7; }
.guideline-heading { flex: 1; min-width: 0; color: #1a1b1f; font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.34rpx; }
.guideline-heading text { display: block; color: #424655; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .44rpx; }
.head-tag { flex: none; border-radius: 999rpx; padding: 4rpx 16rpx; font-size: 22rpx; line-height: 28rpx; font-weight: 600; letter-spacing: .44rpx; }
.head-tag.pink { background: #FFF0F3; color: #FF2D55; }
.head-tag.violet-tag { background: #F2F1FD; color: #5856D6; }
.head-tag.green-tag { background: #EBF9F0; color: #34C759; }
.guideline-body { display: flex; flex-direction: column; gap: 16rpx; padding: 24rpx; border-radius: 24rpx; background: #f4f3f8; color: #424655; font-size: 26rpx; line-height: 42.25rpx; font-weight: 400; }
.rule-row { display: flex; align-items: flex-start; gap: 16rpx; }
.rule-dot { display: flex; flex: none; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-top: 4rpx; border-radius: 50%; }
.rule-dot image { width: 28rpx; height: 28rpx; }
.blue-dot { background: rgba(29,100,242,.1); }
.pink-dot { background: #FFF0F3; }
.violet-dot { background: #F2F1FD; }
.error-dot { background: #ffdad6; }
.green-dot { background: #EBF9F0; }
.rule-copy { flex: 1; min-width: 0; }
.rule-title { margin-bottom: 4rpx; color: #1a1b1f; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.rule-title.error-title { color: #ba1a1a; }
.rule-divider { width: 100%; height: 2rpx; background: #e3e2e7; }
.privacy-symbol { flex: none; width: 36rpx; height: 36rpx; margin-top: 4rpx; }
.guidelines-page .guideline-quote { margin-bottom: 0; background: linear-gradient(135deg,#fff,#fff,rgba(242,241,253,.4)); }
.quote-row { display: flex; align-items: flex-start; gap: 16rpx; }
.quote-symbol { flex: none; width: 56rpx; height: 56rpx; opacity: .4; }
.quote-copy { flex: 1; min-width: 0; color: #1a1b1f; font-size: 34rpx; line-height: 46.75rpx; font-weight: 600; font-style: italic; letter-spacing: -.34rpx; }
.quote-copy text { display: block; margin-top: 8rpx; color: #424655; font-size: 26rpx; line-height: 32rpx; font-weight: 600; font-style: normal; letter-spacing: 0; }
.guidelines-report { display: flex; align-items: center; gap: 8rpx; width: 100%; box-sizing: border-box; margin: 32rpx 0 0; padding: 16rpx 24rpx; border-radius: 24rpx; background: #EBF9F0; color: #1a1b1f; text-align: left; font-size: 26rpx; line-height: 32rpx; font-weight: 600; box-shadow: 0 2rpx 4rpx rgba(0,0,0,.05); }
.guidelines-report::after { border: 0; }
.report-check { display: flex; flex: none; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; background: #34C759; }
.report-check image { width: 32rpx; height: 32rpx; }
.report-chevron { margin-left: auto; color: #34C759; }
.guidelines-foot { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 32rpx; padding: 8rpx 0 16rpx; color: #424655; text-align: center; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .44rpx; opacity: .6; }
.guidelines-foot image { flex: none; width: 28rpx; height: 28rpx; }
