@import "../common.wxss";
.guidelines-page { padding: 0 18rpx 80rpx; background: #f4f5f8; }
.guidelines-page .pg10-header { margin: 0 -18rpx 17rpx; padding: 0 22rpx; }
.guidelines-page .pg10-header-title { font-size: 25rpx; font-weight: 600; }
.header-more { width: 46rpx; font-size: 22rpx; text-align: center; }
.header-avatar { width: 42rpx; height: 42rpx; border-radius: 50%; background: #064dca; color: white; line-height: 42rpx; text-align: center; font-size: 24rpx; }
.guidelines-page .pg10-card { padding: 20rpx; margin-bottom: 15rpx; border-radius: 24rpx; box-shadow: none; }
.charter-hero { text-align: center; padding: 31rpx 23rpx !important; background: linear-gradient(145deg,#fff,#f5f9ff); }
.charter-mark { position: relative; width: 77rpx; height: 77rpx; margin: 0 auto 15rpx; border-radius: 50%; background: linear-gradient(135deg,#2468ef,#6456d6); color: #fff; font-size: 48rpx; line-height: 77rpx; box-shadow: 0 9rpx 16rpx rgba(60,81,196,.17); }
.charter-mark view { position: absolute; right: -8rpx; bottom: -4rpx; width: 30rpx; height: 30rpx; border-radius: 50%; background: #fb335e; color: white; font-size: 17rpx; line-height: 30rpx; }
.charter-kicker { display: inline-block; border-radius: 24rpx; padding: 4rpx 12rpx; background: #f1fbdf; color: #5b7916; font-size: 17rpx; font-weight: 700; }
.charter-title { margin: 7rpx 0; color: #161a21; font-size: 30rpx; font-weight: 800; }
.charter-subtitle { color: #4c566b; font-size: 20rpx; line-height: 1.6; }
.charter-values { display: flex; justify-content: space-around; margin-top: 20rpx; padding: 12rpx 0; border-radius: 16rpx; background: #f3f2f8; }
.charter-values view { color: #2161df; font-size: 22rpx; font-weight: 750; }
.charter-values view:nth-child(2) { color: #29b55f; }
.charter-values view:nth-child(3) { color: #6557d5; }
.charter-values text { display: block; color: #8c94a3; font-size: 15rpx; font-weight: 400; }
.guideline-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 13rpx; }
.guideline-head > view:nth-child(2) { flex:1; color:#1d222c; font-size:22rpx; font-weight:750; }
.guideline-head > view:nth-child(2) text { display:block; color:#606a7b; font-size:15rpx; font-weight:400; }
.pg10-icon { width: 43rpx; height: 43rpx; min-width: 43rpx; border-radius: 14rpx; background: #e8f1ff; color:#1d64f2; font-size:27rpx; }
.pg10-icon.violet { background:#f0eeff; color:#6555d9; }
.pg10-icon.green { background:#e7f9ec; color:#20ab54; }
.pg10-icon.lime { background:#f1f9e5; color:#6b8805; }
.head-tag { border-radius:18rpx; padding:4rpx 9rpx; font-size:15rpx; font-weight:700; }
.head-tag.pink { background:#fff0f3; color:#f32d5a; }
.head-tag.violet-tag { background:#f0efff; color:#5e57d7; }
.head-tag.green-tag { background:#e9f8ed; color:#27ab5d; }
.guideline-body { padding: 7rpx 17rpx; border-radius: 17rpx; background: #f3f3f8; color: #4e586b; font-size: 18rpx; line-height: 1.55; }
.guideline-body > view { display:flex; gap:10rpx; padding:12rpx 0; border-bottom:1rpx solid #e5e6ee; }
.guideline-body > view:last-child { border-bottom:0; }
.guideline-body > view > text { flex:none; color:#1e63ec; font-size:22rpx; }
.guideline-body > view:nth-child(2) > text { color:#ef3058; }
.guideline-body > view > view { flex:1; }
.rule-title { color:#202633; font-size:18rpx; font-weight:700; }
.guideline-quote { color:#20242e; font-size:23rpx; font-weight:750; font-style:italic; line-height:1.55; }
.guideline-quote text { display:block; margin-top:8rpx; color:#5e6779; font-size:17rpx; font-weight:400; font-style:normal; }
.guideline-quote button { width:100%; margin:17rpx 0 0; border-radius:17rpx; background:#e8f6ec; color:#209d53; font-size:18rpx; line-height:2.1; font-style:normal; }
.guideline-quote button::after { border:0; }
.guidelines-foot { color:#9ca3b0; text-align:center; font-size:17rpx; margin:27rpx 0; }
