page { background: #faf8fe; color: #1a1b1f; }
.share-page { min-height: 100vh; box-sizing: border-box; background: #faf8fe; padding-bottom: 45rpx; }
.share-page button { margin: 0; line-height: normal; }.share-page button::after { border: 0; }
.share-header { display: flex; align-items: center; gap: 12rpx; min-height: 92rpx; padding: 0 112px 0 28rpx; box-sizing: border-box; background: rgba(250,248,254,.97); }
.header-back { flex: none; width: 48rpx; padding: 0; background: transparent; color: #1a1b1f; font-size: 54rpx; text-align: left; }
.header-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 800; white-space: nowrap; }
.header-profile { flex: none; width: 47rpx; height: 47rpx; border-radius: 50%; background: #1d64f2; color: #fff; font-size: 28rpx; text-align: center; line-height: 47rpx!important; }
.state-panel { margin: 55rpx 28rpx; padding: 36rpx 25rpx; border-radius: 25rpx; background: #fff; color: #5d6878; font-size: 23rpx; text-align: center; }
.state-panel button { margin: 19rpx auto 0; padding: 12rpx 22rpx; border-radius: 99rpx; color: #fff; background: #1d64f2; font-size: 21rpx; }
.share-content { padding: 12rpx 28rpx 55rpx; }
.intro { text-align: center; padding: 10rpx 0 28rpx; }.intro-pill { display: inline-block; padding: 7rpx 16rpx; border-radius: 99rpx; color: #43580a; background: #f2fbdc; font-size: 18rpx; font-weight: 800; letter-spacing: 1rpx; }
.intro-title { margin-top: 15rpx; color: #151923; font-size: 38rpx; font-weight: 900; }.intro-copy { margin-top: 9rpx; color: #6b7280; font-size: 21rpx; line-height: 1.45; }
.ticket { position: relative; overflow: hidden; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(32,39,62,.11); }
.ticket-topline { height: 10rpx; background: linear-gradient(90deg,#1d64f2,#d2f803 50%,#5856d6); }
.ticket-kicker { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 25rpx; color: #394152; background: #f0eff6; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }.ticket-dot { width: 17rpx; height: 17rpx; border-radius: 50%; background: #34c759; }
.ticket-body { padding: 27rpx 26rpx 18rpx; }.ticket-title-row { display: flex; align-items: flex-start; gap: 13rpx; justify-content: space-between; }.ticket-title { flex: 1; min-width: 0; color: #151923; font-size: 31rpx; font-weight: 900; line-height: 1.3; }
.ticket-status { flex: none; padding: 6rpx 11rpx; border-radius: 99rpx; background: #e9f9ef; color: #158a45; font-size: 18rpx; font-weight: 800; }.ticket-facts { margin-top: 24rpx; padding: 0 19rpx; border-radius: 20rpx; background: #f4f5f8; }
.ticket-facts>view { display: flex; align-items: center; gap: 16rpx; min-height: 93rpx; }.ticket-facts>view+view { border-top: 1rpx solid #e1e5ec; }.ticket-facts>view>view { display: flex; flex-direction: column; min-width: 0; }
.fact-icon { flex: none; width: 42rpx; height: 42rpx; border-radius: 12rpx; background: #e9f1ff; color: #1d64f2; font-size: 29rpx; text-align: center; line-height: 42rpx; }.fact-icon.location { color: #5856d6; background: #f0efff; }
.fact-label { color: #5f6b7c; font-size: 17rpx; }.fact-value { margin-top: 3rpx; overflow: hidden; color: #1a1b1f; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.ticket-count { display: flex; gap: 22rpx; margin-top: 17rpx; color: #3e7f52; font-size: 18rpx; font-weight: 750; }.ticket-divider { height: 2rpx; margin: 0 25rpx; border-top: 2rpx dashed #e4e5ec; }
.ticket-invite { display: flex; flex-direction: column; align-items: center; padding: 28rpx 24rpx 30rpx; text-align: center; }.invite-symbol { width: 86rpx; height: 86rpx; border-radius: 24rpx; background: #eaf1ff; color: #1d64f2; font-size: 62rpx; line-height: 86rpx; }
.invite-qr { display: block; width: 200px; height: 200px; padding: 10rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 6rpx 16rpx rgba(25, 44, 73, .12); }
.invite-label { margin-top: 15rpx; color: #455066; font-size: 20rpx; font-weight: 750; }.invite-code { max-width: 100%; margin-top: 7rpx; overflow-wrap: anywhere; color: #172033; font-size: 26rpx; font-weight: 900; letter-spacing: 1rpx; }.invite-hint { margin-top: 9rpx; color: #828a99; font-size: 18rpx; }
.invite-copy { margin-top: 18rpx!important; padding: 12rpx 23rpx; border-radius: 99rpx; background: #1d64f2; color: #fff; font-size: 20rpx; font-weight: 800; }.ticket-invite.unavailable .invite-symbol { color: #7f8796; background: #f1f2f5; }
.info-heading { margin: 31rpx 3rpx 12rpx; color: #6d7788; font-size: 20rpx; font-weight: 800; }.info-card { display: flex; align-items: center; gap: 16rpx; margin-top: 11rpx; padding: 20rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 3rpx 13rpx rgba(20,30,52,.04); }
.info-icon { flex: none; width: 58rpx; height: 58rpx; border-radius: 50%; background: #f3fce5; color: #526c0a; text-align: center; line-height: 58rpx; font-size: 29rpx; }.info-icon.blue { background: #eaf1ff; color: #1d64f2; }.info-icon.violet { background: #f0efff; color: #5856d6; }
.info-card>view view { color: #182335; font-size: 24rpx; font-weight: 850; }.info-card>view text { display: block; margin-top: 5rpx; color: #727e8e; font-size: 18rpx; line-height: 1.45; }
.share-main { width: 100%; margin-top: 30rpx!important; min-height: 83rpx; border-radius: 99rpx; color: #fff; background: linear-gradient(105deg,#1d64f2,#5856d6); font-size: 26rpx; font-weight: 850; box-shadow: 0 8rpx 21rpx rgba(29,100,242,.2); }.share-main.disabled { background: #e6e8ed; color: #4b5563; box-shadow: none; }
.share-message { margin-top: 18rpx; padding: 15rpx 17rpx; border-radius: 16rpx; background: #eaf1ff; color: #1d64f2; font-size: 20rpx; }.share-foot { margin-top: 29rpx; color: #a0a9b7; text-align: center; font-size: 15rpx; letter-spacing: 2rpx; }
.sheet-layer { position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column; justify-content: flex-end; }.sheet-mask { position: absolute; inset: 0; background: rgba(20,24,36,.43); }.sheet { position: relative; z-index: 1; max-height: 87vh; overflow-y: auto; padding: 17rpx 27rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 29rpx 29rpx 0 0; background: #fff; box-sizing: border-box; }
.sheet-handle { width: 42rpx; height: 6rpx; margin: 0 auto 23rpx; border-radius: 99rpx; background: #d9dce4; }.sheet-head { display: flex; justify-content: space-between; align-items: center; }.sheet-head>view { display: flex; flex-direction: column; }.sheet-title { color: #151923; font-size: 31rpx; font-weight: 900; }.sheet-head text { margin-top: 4rpx; color: #667083; font-size: 21rpx; }
.sheet-head button { width: 52rpx; height: 52rpx; border-radius: 50%; background: #f1f2f5; color: #404855; font-size: 37rpx; line-height: 52rpx!important; }.sheet-preview { display: flex; align-items: center; gap: 23rpx; margin-top: 28rpx; padding: 34rpx 27rpx; border: 1rpx solid #e7e8ec; border-radius: 27rpx; background: linear-gradient(105deg,#eaf1ff,#fff 55%,#f3fce5); box-shadow: 0 3rpx 12rpx rgba(28,41,70,.05); }
.sheet-preview-art { position: relative; width: 123rpx; height: 123rpx; flex: none; overflow: hidden; border-radius: 21rpx; }.sheet-preview-art image { display: block; width: 100%; height: 100%; }.sheet-preview-art text { position: absolute; right: 0; bottom: 0; padding: 3rpx 6rpx; border-radius: 5rpx 0 0 0; background: rgba(10,18,31,.7); color: #fff; font-size: 15rpx; line-height: 1.2; }.sheet-preview-details { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; }.sheet-preview-heading { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-width: 0; }.sheet-preview-title { overflow: hidden; min-width: 0; color: #1a1b1f; font-size: 27rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }.sheet-preview-status { flex: none; margin: 0!important; padding: 5rpx 10rpx; border-radius: 99rpx; background: #e8e9ef; color: #4b5563!important; font-size: 17rpx!important; font-weight: 800; }.sheet-preview-status.active { background: #34c759; color: #fff!important; }
.sheet-preview-date { display: block; margin-top: 11rpx; overflow: hidden; color: #596679; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }.sheet-preview-count { display: flex; flex-wrap: wrap; gap: 6rpx 17rpx; margin-top: 14rpx; color: #249b48; font-size: 18rpx; font-weight: 800; }
.sheet-actions { display: flex; justify-content: space-between; gap: 7rpx; margin-top: 27rpx; }.sheet-action { position: relative; width: 24%; min-width: 0; padding: 20rpx 0 0; background: transparent; color: #1d2736; text-align: center; }.sheet-action>text:last-child { display: block; margin-top: 15rpx; font-size: 21rpx; white-space: nowrap; }.sheet-action.inactive { opacity: .52; }
.action-recommend { position: absolute; z-index: 1; top: 0; left: calc(50% + 16rpx); display: block; padding: 5rpx 10rpx; border-radius: 99rpx; background: #ff2d55; color: #fff; font-size: 17rpx; font-weight: 800; line-height: 1.2; white-space: nowrap; }
.action-icon { display: flex; align-items: center; justify-content: center; width: 91rpx; height: 91rpx; margin: 0 auto; border-radius: 24rpx; }.action-glyph { width: 51rpx; height: 51rpx; }.action-icon.green { background: #07c160; }.action-icon.orange { background: linear-gradient(135deg,#ff9500,#ff2d55); }.action-icon.blue { background: #1d64f2; }.action-icon.gray { background: #e8e9ef; }
.sheet-code { display: flex; align-items: center; justify-content: space-between; gap: 9rpx; margin-top: 24rpx; padding: 17rpx; border-radius: 18rpx; background: #f4f3f8; }.sheet-code>view { display: flex; flex-direction: column; min-width: 0; }.sheet-code>view text:first-child { color: #6c7585; font-size: 16rpx; }.sheet-code>view text:last-child { overflow: hidden; color: #172033; font-size: 19rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.sheet-code button { flex: none; padding: 10rpx 16rpx; border-radius: 99rpx; background: #1d64f2; color: #fff; font-size: 18rpx; font-weight: 800; }
.sheet-feedback { margin-top: 15rpx; padding: 12rpx 14rpx; border-radius: 13rpx; background: #eaf1ff; color: #1d64f2; font-size: 18rpx; }
.sheet-note { margin-top: 15rpx; color: #7f8998; font-size: 17rpx; line-height: 1.4; }.sheet-cancel { width: 100%; margin-top: 19rpx!important; min-height: 67rpx; border-radius: 17rpx; color: #1a1b1f; background: #f0eff5; font-size: 22rpx; font-weight: 800; }
