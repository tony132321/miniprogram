  <view wx:if="{{display.isBadminton && isHost}}" class="pgd-host-state"><view><view class="pgd-state-dot"></view><view><text class="pgd-state-primary">主办方视图 · {{display.status}}</text><text wx:if="{{event.stats}}">已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人；报名与现场状态以服务端为准。</text><text wx:else>报名人数待同步；请到报名与成员核对。</text></view></view><button data-section="checkinSection" bindtap="jumpToSection">签到管理 ›</button></view>
  <view class="pgd-hero" aria-label="原稿羽毛球场景示意图"><image class="pgd-hero-photo" src="{{isHost ? './assets/pgd-host-hero.jpg' : './assets/pgd-member-hero.jpg'}}" mode="aspectFill" aria-hidden="true"/><view class="pgd-hero-scrim"></view><view class="pgd-hero-top"><view class="pgd-stickers"><text class="pgd-sticker-lime">{{isHost ? 'MATCH READY!' : 'READY TO PLAY'}}</text><text class="pgd-sticker-blue">{{isHost ? '🏸 BADMINTON TOGETHER' : 'BADMINTON TOGETHER'}}</text></view><view class="pgd-hero-status"><image wx:if="{{!isHost}}" src="./assets/pgd-check_circle-w400-f0-faf8fe.svg" mode="aspectFit" aria-hidden="true"/><view wx:else class="pgd-status-dot"></view><text>{{isHost ? display.status + (event.stats ? ' ' + event.stats.confirmed + '/' + (event.payload.maxParticipants || '待定') + '人' : '') : '已确认报名'}}</text></view></view><view class="pgd-hero-bottom"><view class="pgd-host-strip" data-section="registrationSection" bindtap="jumpToSection"><image wx:if="{{isHost}}" src="./assets/pgd-verified-w400-f1-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text>由 {{hostAlias || '主办方'}} 发起{{isHost ? ' · 主办方视图' : ''}}</text></view><text wx:if="{{!isHost}}" class="pgd-sport-tag">羽毛球活动</text><view class="pgd-hero-title">{{display.title}}</view></view><text class="pgd-photo-credit">原稿场景示意图</text></view>
  <view wx:if="{{!isHost && myRegistration && myRegistration.status === 'CONFIRMED'}}" class="pgd-confirmed-card"><view class="pgd-confirmed-heading"><view><view class="pgd-confirmed-icon"><image src="./assets/pgd-verified-w400-f1-34c759.svg" mode="aspectFit" aria-hidden="true"/></view><view><text>当前报名状态</text><view>已确认席位</view></view></view><text class="pgd-confirmed-pill">已确认</text></view><view class="pgd-pass-row"><view><text>个人电子签到凭证</text><view>尚未开放</view></view><button data-section="checkinSection" bindtap="jumpToSection"><image src="./assets/pgd-qr_code_2-w400-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><text>查看签到 ›</text></button></view></view>
  <view id="aiSuggestionNoticeView" wx:if="{{event.aiSuggestionGenerated}}" class="pgd-info-note">本活动曾生成 AI 草稿建议；请以主办方确认及当前审核通过的活动信息为准。</view>
  <view wx:if="{{event.payload.skillLevel}}" class="pgd-skill">水平要求：{{event.payload.skillLevel}}</view>
  <view class="pgd-facts"><view wx:if="{{!isHost}}" class="pgd-facts-heading"><text>活动信息</text><view><text>运动社交</text><text wx:if="{{event.stats}}">已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人</text></view></view>
    <view class="pgd-fact pd-time"><view class="pgd-fact-icon"><image src="{{isHost ? './assets/pgd-calendar_clock-w400-f1-1d64f2.svg' : './assets/pg04s-calendar_today.svg'}}" mode="aspectFit" aria-hidden="true"/></view><view class="pgd-fact-copy"><text>活动时间{{isHost ? ' · SCHEDULE' : ''}}</text><view>{{display.date}} – {{display.end}}</view><text class="pgd-fact-caption">活动时间以主办方最终确认版本为准</text></view></view>
    <view class="pgd-fact pd-venue"><view class="pgd-fact-icon"><image src="{{isHost ? './assets/pgd-location_on-w400-f1-ff2d55.svg' : './assets/pg04s-location_on.svg'}}" mode="aspectFit" aria-hidden="true"/></view><view class="pgd-fact-copy"><text>场地地点{{isHost ? ' · VENUE' : ''}}</text><view>{{display.location}}</view><text class="pgd-fact-caption">场地状态：{{event.payload.venueStatus === 'HOST_CONFIRMED' ? '主办方已核实' : '待主办方确认'}}</text><button class="pgd-copy-venue" bindtap="copyVenue">复制地点 ›</button></view></view>
    <view id="venueEvidenceView" wx:if="{{event.venueEvidence}}" class="pgd-info-note">场地依据为主办方声明，未由场馆接口锁位。</view>
    <view class="pgd-metric-grid"><view class="pgd-fact pd-fee"><view class="pgd-fact-icon"><image src="{{isHost ? './assets/pgd-payments-w400-f0-34c759.svg' : './assets/pgd-payments-w400-f0-4d5d00.svg'}}" mode="aspectFit" aria-hidden="true"/></view><view class="pgd-fact-copy"><text>费用说明</text><view>{{display.fee}}</view><text class="pgd-fact-caption">取消规则：{{event.payload.cancellationRule || '请查看活动规则'}}</text></view></view><view wx:if="{{event.stats}}" class="pgd-fact pd-members" data-section="registrationSection" bindtap="jumpToSection"><view class="pgd-fact-icon"><image src="./assets/pgd-group-w400-f0-5856d6.svg" mode="aspectFit" aria-hidden="true"/></view><view class="pgd-fact-copy"><text>报名席位</text><view wx:if="{{isHost}}" class="pgd-host-capacity"><text class="pgd-capacity-number">{{event.stats.confirmed}}</text><text class="pgd-capacity-denominator">/ {{event.payload.maxParticipants || '待定'}}</text><text class="pgd-capacity-unit">人已确认</text></view><view wx:else>已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人</view><text class="pgd-fact-caption">主办预留 {{event.stats.reserved}} · 候补 {{event.stats.waitlisted}} · 待审核 {{event.stats.requested}} · 待重新确认 {{event.stats.reconfirmRequired}}</text></view></view></view>
  </view>
  <view class="pgd-map-card"><view class="pgd-map-heading"><view><image wx:if="{{isHost}}" src="./assets/pgd-map-w400-f0-1d64f2.svg" mode="aspectFit" aria-hidden="true"/><text>{{isHost ? '场馆位置与停车指引' : '场馆指引'}}</text></view><text>原稿位置示意图</text></view><view class="pgd-map-frame"><image src="./assets/pgd-map-illustrative.png" mode="aspectFill" aria-hidden="true"/><view wx:if="{{isHost}}" class="pgd-map-closed"><image src="./assets/pgd-near_me-w400-f1-ff2d55.svg" mode="aspectFit" aria-hidden="true"/><text>示意地图不代表本场地点 · 真实导航尚未开放</text></view></view><view class="pgd-map-notice"><image src="./assets/pgd-info-w400-f0-424655.svg" mode="aspectFit" aria-hidden="true"/><text>原稿示意图不表示本场坐标，请以主办方公布地点为准。</text></view></view>
  <view wx:if="{{!isHost}}" class="pgd-host-card"><view class="pgd-host-card-heading"><view class="pgd-host-avatar"><text>主</text><view><image src="./assets/pgd-verified-w400-f0-faf8fe.svg" mode="aspectFit" aria-hidden="true"/></view></view><view><view><text>{{hostAlias || '主办方'}}</text><text>发起人</text></view><view>活动内授权昵称 · 以本场信息为准</view></view></view><view class="pgd-host-note"><text>活动说明</text><view>运动流汗，认识有趣的人！{{event.payload.skillLevel ? '水平要求：' + event.payload.skillLevel : '无论水平高低，都欢迎加入～'}} · {{event.payload.visibility === 'PUBLIC' ? '受控公开' : '仅邀请'}}</view></view></view>
  <view wx:if="{{event.stats && display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="pgd-roster"><view class="pgd-roster-heading"><view><text>活动内已授权昵称</text><view>已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人 · 授权昵称独立展示</view></view><button data-section="registrationSection" bindtap="jumpToSection">查看报名与成员 ›</button></view><view wx:if="{{aliasLoadState === 'READY' && memberCards.length}}" class="pgd-member-grid" data-section="registrationSection" bindtap="jumpToSection"><block wx:for="{{memberCards}}" wx:key="id"><view wx:if="{{index < 6}}" class="pgd-member {{item.isMine ? 'pgd-member-mine' : ''}} {{item.isHost ? 'pgd-member-host' : ''}}"><text class="pgd-member-avatar">{{item.avatarGlyph}}</text><view>{{item.displayName}}</view><text class="pgd-member-role">{{item.roleLabel}}</text></view></block></view><view wx:else class="pgd-roster-empty">{{aliasLoadState === 'READY' ? '暂无成员授权公开本场昵称。' : '昵称列表暂不可用，请到报名与成员核对。'}}</view><view class="pgd-help">仅展示成员自愿公开的本场昵称，可能包含候补；确认席位数以服务端统计为准。</view></view>
  <view class="pgd-rules"><view class="pgd-rules-heading"><image src="{{isHost ? './assets/pgd-sports_score-w400-f0-4d5d00.svg' : './assets/pgd-rule-w400-f0-424655.svg'}}" mode="aspectFit" aria-hidden="true"/><text>行前须知与守则</text></view><view class="pgd-rules-body"><view><text>1</text><view><view>报名方式</view><text>{{event.payload.approvalMode === 'MANUAL' ? '主办方逐一审批' : '自动接受或候补'}}；确认席位数以服务端统计为准。</text></view></view><view><text>2</text><view><view>取消与席位规则</view><text>{{event.payload.cancellationRule || '请查看活动规则'}}；入场以当前报名状态与现场动态签到码为准。</text></view></view><view><text>3</text><view><view>场地与现场安排</view><text>场地状态：{{event.payload.venueStatus === 'HOST_CONFIRMED' ? '主办方已核实' : '待主办方确认'}}。场地依据为主办方声明，未由场馆接口锁位。</text></view></view></view></view>
  <view class="pgd-terminal"><image wx:if="{{!isHost}}" src="./assets/w69-check_circle-w400-f1-34c759.svg" mode="aspectFit" aria-hidden="true"/><view wx:else class="pgd-state-dot"></view><text>{{isHost ? ('主办方视图 · ' + display.status + ' · ' + (event.reviewStatus === 'APPROVED' && event.payload.visibility === 'PUBLIC' ? '受控公开' : event.payload.visibility === 'PUBLIC' ? '公开审核状态以当前信息为准' : '仅邀请')) : '已确认本场报名 · 入场以当前资格及现场动态码为准'}}</text></view>
  <view class="pgd-current-notices">
    <view class="pgd-help">报名方式：{{event.payload.approvalMode === 'MANUAL' ? '主办方逐一审批' : '自动接受或候补'}} · {{event.payload.visibility === 'PUBLIC' ? '受控公开' : '仅邀请'}}</view>
    <view wx:if="{{event.stats && (event.status === 'RECRUITING' || event.status === 'CONFIRMED')}}" class="pgd-seats-note">尚余 {{event.payload.maxParticipants - event.stats.confirmed - event.stats.reserved > 0 ? event.payload.maxParticipants - event.stats.confirmed - event.stats.reserved : 0}} 个非预留名额，报名结果以服务端为准。</view>
    <view wx:if="{{event.updatedAt}}" class="pgd-help">更新时间：{{event.updatedAt}}</view>
    <view wx:if="{{event.visibleContentVersion && event.visibleContentVersion !== event.version}}" class="pgd-info-note">当前展示已审核版本 {{event.visibleContentVersion}} 的活动信息；最新版本仍在审核或未通过审核。</view>
    <view wx:if="{{event.visibleContentVersion === null}}" class="pgd-info-note">活动文字尚无已审核版本，请联系主办方核对安排。</view>
    <view wx:if="{{event.formationRisk}}" class="pgd-alert-note">当前确认人数不足，成局有风险。</view>
    <view wx:if="{{event.reviewStatus === 'PENDING'}}" class="pgd-alert-note">活动内容正在人工审核；通过前不开放新报名或分享。</view>
    <view wx:if="{{event.reviewStatus === 'REJECTED'}}" class="pgd-alert-note">活动内容未通过审核；主办方修改后可重新提交。</view>
    <view wx:if="{{isHost && event.reviewReason}}" class="pgd-alert-note">运营审核意见：{{event.reviewReason}}</view>
    <view wx:if="{{event.riskPaused}}" class="pgd-alert-note">活动因风险核查暂时停止新报名、补位和成局。仍可查看详情或退出；请等待运营处理。</view>
    <view wx:if="{{event.status === 'RECRUITING' && !event.recruiting && (event.reviewStatus === 'APPROVED' || event.reviewStatus === 'NOT_REQUIRED')}}" class="pgd-alert-note">活动变更后已暂停新报名，等待原参与者重新确认。</view>
    <view class="pgd-destinations"><button data-section="contentSection" bindtap="jumpToSection"><text>➤</text>活动公告</button><button data-section="checkinSection" bindtap="jumpToSection"><text>▣</text>签到与反馈</button><button data-section="expenseSection" bindtap="jumpToSection"><text>◉</text>费用记录</button><button wx:if="{{isHost}}" data-section="hostSection" bindtap="jumpToSection"><text>✦</text>主办工作台</button></view>
    <view id="emergencySafetyNotice" class="pgd-safety-note">如遇人身紧急危险，请先离开风险地点并联系当地应急服务；本平台不是救援机构。</view>
    <view class="pgd-safety-actions"><button id="eventReportButton" bindtap="goToReport">举报与求助</button><button id="copySafetyDetailsButton" bindtap="copySafetyDetails">复制活动信息给可信任的人</button></view>

    <view class="pgd-route-actions"><button bindtap="shareCurrentEvent">分享或复制活动信息</button><button bindtap="openEventActions">更多活动操作</button></view>
  </view>
</view>
</block>
<!-- Wave70 member-host detail END -->
<block wx:else>
  <view wx:if="{{!(loadState === 'READY' && activeSection === 'detailsSection' && !successState && display.isBadminton && !isHost && myRegistration.status !== 'CONFIRMED' && !joinConfirmation)}}" class="poster {{activeSection !== 'detailsSection' ? 'section-hidden' : ''}} {{display.isBadminton ? 'poster-badminton' : ''}} {{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED') ? 'poster-live-cover' : ''}}"><image wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="event-cover-photo" src="/assets/stitch/caper_home_badminton.jpg" mode="aspectFill"/><view wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="event-cover-scrim"></view><view wx:if="{{display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')}}" class="event-cover-info"><view class="event-cover-status"><text>{{display.status}}</text><text wx:if="{{event.stats}}">已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants}} 人</text></view><view class="event-cover-title">{{display.title}}</view><view class="event-cover-place">⌖ {{display.location}}</view></view><image wx:if="{{display.isBadminton && !isHost && myRegistration.status !== 'CONFIRMED'}}" class="poster-athlete" src="./assets/pg01-badminton-player.jpg" mode="aspectFill"/><view class="poster-image-fade"></view><view class="poster-court"></view><view class="poster-crown">♛</view><view class="poster-headline" wx:if="{{display.isBadminton}}"><text>BADMINTON</text><text>TOGETHER</text></view><view class="poster-headline poster-headline-generic" wx:else><text>GOOD PEOPLE</text><text>GREAT PLANS</text></view><view class="poster-tagline"><text>{{display.isBadminton ? '运动让生活更好看！' : '线下见面更精彩！'}}</text><text>{{display.isBadminton ? '好球友 总会相遇！' : 'Good People · Great Plans'}}</text></view><view class="poster-bottom"><text>Play More</text><text>Meet Cool People ☺</text></view><view class="poster-badge"><text>{{display.isBadminton ? 'SPORTS,' : 'GOOD'}}</text><text>{{display.isBadminton ? 'FRIENDS' : 'PEOPLE'}}</text><text>GOOD VIBES ☺</text></view></view>
<!-- Wave66 visitor sheet BEGIN -->
  <view wx:if="{{loadState === 'READY' && activeSection === 'detailsSection' && !successState && display.isBadminton && !isHost && myRegistration.status !== 'CONFIRMED' && !joinConfirmation}}" id="detailsSection" class="pg01-sheet">
    <view class="pg01-event-heading"><view class="pg01-title-row"><text class="pg01-event-title">{{display.title}}</text><text class="pg01-status"><text class="pg01-status-dot">●</text>{{display.status}}</text></view>
      <view class="pg01-subtitle"><text>运动流汗，认识有趣的人！</text><text>{{event.payload.skillLevel ? '水平要求：' : '无论水平高低，都欢迎加入～'}}{{event.payload.skillLevel}}</text></view>
      <view class="pg01-tags"><text># {{event.payload.visibility === 'PUBLIC' ? '受控公开' : '仅邀请'}}</text><text class="pg01-highlight"># 羽毛球</text><text wx:if="{{event.payload.city}}"># {{event.payload.city}}</text><text wx:if="{{event.payload.skillLevel}}"># {{event.payload.skillLevel}}</text></view>
    </view>
    <view id="aiSuggestionNoticeView" wx:if="{{event.aiSuggestionGenerated}}" class="info-note">本活动曾生成 AI 草稿建议；请以主办方确认及当前审核通过的活动信息为准。</view>
    <view class="pg01-facts"><view class="pg01-fact-row"><view class="pg01-fact-icon"><image src="./assets/pg01-calendar_today.svg" mode="aspectFit" aria-hidden="true"/></view><view class="pg01-fact-main"><view class="pg01-fact-label">活动时间</view><view class="pg01-fact-value">{{display.date}} – {{display.end}}</view><view class="pg01-fact-help">活动时间以主办方最终确认版本为准</view></view></view>
      <view class="pg01-fact-row pg01-venue-row"><view class="pg01-fact-icon"><image src="./assets/pg01-location_on.svg" mode="aspectFit" aria-hidden="true"/></view><view class="pg01-fact-main pg01-venue-main"><view class="pg01-fact-label">场地地点</view><view class="pg01-fact-value">{{display.location}}</view><view class="pg01-fact-help">场地状态：{{event.payload.venueStatus === 'HOST_CONFIRMED' ? '主办方已核实' : '待主办方确认'}}</view></view><button class="pg01-copy-venue" bindtap="copyVenue"><text>复制地点</text><image src="./assets/pg01-chevron.svg" mode="aspectFit" aria-hidden="true"/></button></view>
    </view>
    <view id="venueEvidenceView" wx:if="{{event.venueEvidence}}" class="info-note">场地依据为主办方声明，未由场馆接口锁位。</view>
    <view class="pg01-host" data-section="registrationSection" bindtap="jumpToSection"><view class="pg01-host-avatar"><text>★</text></view><view class="pg01-host-copy"><view>由 {{hostAlias || '主办方'}} 发起</view><view class="pg01-host-help">活动内授权昵称 · 查看报名与成员</view></view><image class="pg01-host-chevron" src="./assets/pg01-chevron.svg" mode="aspectFit" aria-hidden="true"/></view>
    <view class="pg01-meta"><view wx:if="{{event.payload.skillLevel}}" class="pg01-meta-row"><view class="pg01-meta-label"><image src="./assets/pg01-heart.svg" mode="aspectFit" aria-hidden="true"/><text>活动水平</text></view><text class="pg01-meta-value">{{event.payload.skillLevel}}</text></view>
      <view class="pg01-meta-row"><view class="pg01-meta-label"><image src="./assets/pg01-money.svg" mode="aspectFit" aria-hidden="true"/><text>费用说明</text></view><text class="pg01-meta-value">{{display.fee}}</text></view>
      <view class="pg01-meta-help">取消规则：{{event.payload.cancellationRule || '请查看活动规则'}}</view>
      <view wx:if="{{event.stats}}" class="pg01-seat-row" data-section="registrationSection" bindtap="jumpToSection"><view class="pg01-seat-copy"><image src="./assets/pg01-groups.svg" mode="aspectFit" aria-hidden="true"/><view><view>报名席位</view><view>已确认 {{event.stats.confirmed}} / {{event.payload.maxParticipants || '待定'}} 人</view></view></view><image class="pg01-seat-chevron" src="./assets/pg01-seat-chevron.svg" mode="aspectFit" aria-hidden="true"/></view>
      <view wx:if="{{event.stats}}" class="pg01-meta-help">主办预留 {{event.stats.reserved}} · 候补 {{event.stats.waitlisted}} · 待审核 {{event.stats.requested}} · 待重新确认 {{event.stats.reconfirmRequired}}</view>
    </view>
    <view class="pg01-necessary-details">
    <view wx:if="{{!(display.isBadminton && (isHost || myRegistration.status === 'CONFIRMED')) && aliasLoadState === 'READY' && memberCards.length}}" class="detail-member-preview"><view class="detail-member-preview-title">活动内已授权昵称 <text>点按查看成员 ›</text></view><view class="detail-member-preview-list" data-section="registrationSection" bindtap="jumpToSection"><view wx:for="{{memberCards}}" wx:key="id" class="detail-member-preview-person"><text>{{item.avatarGlyph}}</text><view>{{item.displayName}}</view></view></view><view class="detail-help">仅展示成员自愿公开的本场昵称；确认席位数以服务端统计为准。</view></view>
    <view class="detail-help">报名方式：{{event.payload.approvalMode === 'MANUAL' ? '主办方逐一审批' : '自动接受或候补'}} · {{event.payload.visibility === 'PUBLIC' ? '受控公开' : '仅邀请'}}</view>
    <view wx:if="{{event.stats && (event.status === 'RECRUITING' || event.status === 'CONFIRMED')}}" class="detail-seats-note">尚余 {{event.payload.maxParticipants - event.stats.confirmed - event.stats.reserved > 0 ? event.payload.maxParticipants - event.stats.confirmed - event.stats.reserved : 0}} 个非预留名额，报名结果以服务端为准。</view>
    <view wx:if="{{event.updatedAt}}" class="detail-help">更新时间：{{event.updatedAt}}</view>
    <view wx:if="{{event.visibleContentVersion && event.visibleContentVersion !== event.version}}" class="info-note">当前展示已审核版本 {{event.visibleContentVersion}} 的活动信息；最新版本仍在审核或未通过审核。</view>
    <view wx:if="{{event.visibleContentVersion === null}}" class="info-note">活动文字尚无已审核版本，请联系主办方核对安排。</view>
    <view wx:if="{{event.formationRisk}}" class="alert-note">当前确认人数不足，成局有风险。</view>
