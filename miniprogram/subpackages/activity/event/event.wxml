      <button wx:if="{{answerQuestionId && (event.status === 'RECRUITING' || event.status === 'CONFIRMED' || event.status === 'IN_PROGRESS')}}" bindtap="answerQuestion">提交回答</button>
    </view>
    <view wx:else class="host-work-block muted">活动当前状态不能提交公告或回答，可回看已审核内容。</view>
    <view id="shareMetricsView" wx:if="{{shareMetrics}}" class="host-metric-note">分享意图 {{shareMetrics.shareIntents}} · 带来源的新打开 {{shareMetrics.attributedOpens}} · 来源未知的新打开 {{shareMetrics.unknownSourceOpens}}（均不代表发送或阅读成功）</view>
    <view wx:if="{{shareMetricsLoadState === 'ERROR'}}" class="error">{{shareMetricsError}} <button bindtap="refresh">重新加载分享统计</button></view>
    <view wx:if="{{attentionLoadState === 'ERROR'}}" class="error">{{attentionError}} <button bindtap="refresh">重新加载待跟进提醒</button></view>
    <view wx:if="{{attentionItems.length}}">取消／未成局消息仍未由下列成员打开，请主办方人工跟进；提供方状态不代表送达。</view>
    <view wx:for="{{attentionItems}}" wx:key="notificationId" class="item">{{item.displayName}} · {{item.kindLabel}} · {{item.externalStatusLabel}}</view>
    <view class="host-work-block"><view class="host-work-title">席位与名单 <text>当前 {{event.stats.confirmed || 0}} 人确认</text></view><button wx:if="{{safetyStatus === 'OPEN' && event.recruiting && !event.riskPaused}}" bindtap="rotateInvite">撤销旧邀请并生成新邀请</button>
    <button id="reserveButton" wx:if="{{safetyStatus === 'OPEN' && event.recruiting && !event.riskPaused}}" bindtap="reserve">预留一个球友名额</button>
    <view wx:for="{{reservationTokens}}" wx:key="id">认领口令：{{item.token}}</view>
    <input placeholder="移除参与者前填写活动内原因" value="{{removalReason}}" bindinput="removalReasonInput" />
    <view wx:if="{{registrationsLoadState === 'ERROR'}}" class="error">{{registrationsError}} <button bindtap="refresh">重新加载报名名单</button></view>
    <view wx:for="{{registrations}}" wx:key="id" class="item">
      <text>{{item.displayName}} · {{item.statusLabel}}</text>
      <button wx:if="{{item.user_id !== currentUser && event.status !== 'CANCELLED' && event.status !== 'EXPIRED'}}" data-user="{{item.user_id}}" data-name="{{item.displayName}}" bindtap="selectCohostMember">选择为协办</button>
      <button wx:if="{{safetyStatus === 'OPEN' && event.recruiting && (event.status === 'RECRUITING' || event.status === 'CONFIRMED') && event.reviewStatus === 'APPROVED' && item.status === 'REQUESTED' && !event.riskPaused}}" data-id="{{item.id}}" bindtap="approve">同意申请</button>
      <button wx:if="{{item.user_id !== currentUser && (event.status === 'RECRUITING' || event.status === 'CONFIRMED') && (item.status === 'CONFIRMED' || item.status === 'RECONFIRM_REQUIRED' || item.status === 'WAITLISTED' || item.status === 'OFFERED' || item.status === 'REQUESTED' || item.status === 'INTERESTED')}}"
        data-id="{{item.id}}" data-user="{{item.user_id}}" bindtap="removeParticipant">移除并告知原因</button>
      <button id="manualRequest-{{item.user_id}}" wx:if="{{canRequestManualCheckIn && item.status === 'CONFIRMED'}}" data-user="{{item.user_id}}" bindtap="requestManualCheckIn">申请人工补记到场</button>
    </view>
    <view wx:if="{{event.status === 'COMPLETED' || event.status === 'IN_PROGRESS' || event.status === 'CANCELLED' || event.status === 'EXPIRED'}}" class="muted">报名审批和普通移除已结束；仍可查看历史记录并使用安全处理入口。</view>
    </view>
    <view class="host-work-block"><view class="host-work-title">活动状态与现场</view>
    <button id="confirmEventButton" wx:if="{{safetyStatus === 'OPEN' && event.status === 'RECRUITING' && !event.riskPaused && (event.reviewStatus === 'APPROVED' || event.reviewStatus === 'NOT_REQUIRED')}}" bindtap="confirmEvent">确认人数及场地可用并成局</button>
    <button wx:if="{{event.status === 'RECRUITING' || event.status === 'CONFIRMED'}}" bindtap="cancelEvent">取消活动</button>
    <button id="editPublishedButton" wx:if="{{event.status === 'RECRUITING' || event.status === 'CONFIRMED'}}" bindtap="editPublished">编辑活动规则并预览变更</button>
    <button id="hostTokenButton" wx:if="{{canGenerateCheckInToken}}" bindtap="showCheckInToken">展示动态签到二维码</button>
    <view wx:if="{{!canGenerateCheckInToken && (event.status === 'CONFIRMED' || event.status === 'IN_PROGRESS')}}" class="muted">{{checkInWindowNotice}} 页面按设备时间提示，最终以服务端校验为准。</view>
    <view wx:if="{{displayedCheckInToken}}" class="checkin-qr-display"><view class="qr-brand">See You In Real Life <text>GOOD PEOPLE · BRIGHTER DAYS</text></view>
      <canvas canvas-id="checkinQr" style="width:240px;height:240px" />
      <view class="token-text">当前口令约 {{checkInExpiresIn}} 秒后更新：{{displayedCheckInToken}}</view>
    </view>
    <radio-group id="hostCompletionForm" wx:if="{{canCompleteEvent}}" bindchange="setCompletionHeld">
      <label id="completionHeldYes"><radio value="held" checked="{{completionHeld === true}}" />实际举办</label>
      <label id="completionHeldNo"><radio value="not_held" checked="{{completionHeld === false}}" />未举办</label>
    </radio-group>
    <input id="completionActualCount" wx:if="{{completionHeld === true && canCompleteEvent}}" type="number" placeholder="实际到场人数" value="{{actualCount}}" bindinput="actualCountInput" />
    <textarea id="completionAnomalyInput" class="host-completion-note" wx:if="{{canCompleteEvent}}" placeholder="本场异常（可选；无异常可留空）" value="{{completionAnomaly}}" bindinput="completionAnomalyInput" />
    <textarea id="completionVenueIssueInput" class="host-completion-note" wx:if="{{canCompleteEvent}}" placeholder="场地问题（可选；无问题可留空）" value="{{completionVenueIssue}}" bindinput="completionVenueIssueInput" />
    <button id="completeEventButton" wx:if="{{canCompleteEvent}}" bindtap="complete">活动结项</button>
    <view wx:if="{{!canCompleteEvent && (event.status === 'CONFIRMED' || event.status === 'IN_PROGRESS')}}" class="muted">{{completionAvailability}} 页面按设备时间提示，最终以服务端校验为准。</view>
    </view>
    <view class="host-work-block"><view class="host-work-title">AA 记录与再约一场</view>
    <input id="expenseTotalYuan" wx:if="{{event.payload.feeMode === 'AA'}}" type="digit" placeholder="本场总费用（元）" value="{{totalYuan}}" bindinput="yuanInput" />
    <view wx:if="{{event.payload.feeMode === 'AA'}}" class="muted">费用按记录时已确认成员人数等分，精确到分；无法均分的余下几分按固定成员顺序逐人分配，分到尾差的成员各多分摊 0.01 元，各人份额合计等于总费用。个人金额以当前账单的分摊明细为准。</view>
    <button id="recordExpenseButton" wx:if="{{event.payload.feeMode === 'AA'}}" disabled="{{expenseLoadState !== 'READY' && expenseLoadState !== 'EMPTY'}}" bindtap="expense">{{expenseLoadState === 'READY' ? '修订 AA 分摊（旧确认仅存历史）' : expenseLoadState === 'EMPTY' ? '记录 AA 分摊' : '费用记录暂不可用'}}</button>
    <view class="muted">费用记录不代表平台付款或收款凭证。</view>
    <view id="hostRepeatAnchor" wx:if="{{safetyStatus === 'OPEN' && event.status === 'COMPLETED'}}" class="host-repeat-anchor"></view>
    <button id="repeatDraftButton" wx:if="{{safetyStatus === 'OPEN' && event.status === 'COMPLETED'}}" bindtap="repeat">再约一场草稿</button>
    <view wx:if="{{repeatCandidatesLoadState === 'ERROR'}}" class="error">{{repeatCandidatesError}} <button bindtap="refresh">重新加载可邀请成员</button></view>
    <view wx:if="{{event.status === 'COMPLETED'}}">允许类似活动邀请的旧成员：{{repeatCandidateNames}}。生成草稿不会自动邀请。</view>
    </view>
  </view>
  <view id="cohostApprovalSection" wx:if="{{!isHost && canApproveRegistration}}" class="event-section cohost-section {{activeSection !== 'cohostApprovalSection' ? 'section-hidden' : ''}}">
    <view class="section-kicker">CO-HOST WORKSPACE</view><view class="section-heading">协办报名审批</view>
    <view wx:if="{{registrationsLoadState === 'ERROR'}}" class="error">{{registrationsError}} <button bindtap="refresh">重新加载报名名单</button></view>
    <view wx:for="{{registrations}}" wx:key="id" class="item">
      <view>{{item.displayName}} · {{item.statusLabel}}</view>
      <button wx:if="{{safetyStatus === 'OPEN' && event.recruiting && (event.status === 'RECRUITING' || event.status === 'CONFIRMED') && event.reviewStatus === 'APPROVED' && !event.riskPaused && item.status === 'REQUESTED'}}" data-id="{{item.id}}" bindtap="approve">同意申请</button>
    </view>
  </view>
  <view id="cohostContentSection" wx:if="{{!isHost && canManageAnnouncements}}" class="event-section cohost-section {{activeSection !== 'cohostContentSection' ? 'section-hidden' : ''}}">
    <view class="section-kicker">CO-HOST WORKSPACE</view><view class="section-heading">协办公告与回答</view><view class="section-intro">提交后仍需运营审核。</view>
    <view wx:if="{{event.status === 'RECRUITING' || event.status === 'CONFIRMED' || event.status === 'IN_PROGRESS'}}">
      <input placeholder="活动公告" value="{{announcementText}}" bindinput="announcementInput" />
      <button wx:if="{{event.status === 'RECRUITING' || event.status === 'CONFIRMED' || event.status === 'IN_PROGRESS'}}" bindtap="postAnnouncement">提交公告</button>
      <view class="muted">{{answerQuestionLabel ? '正在回复：' + answerQuestionLabel : '请从活动公告与问答选择要回复的问题'}}</view>
      <input placeholder="问题回答" value="{{answerText}}" focus="{{answerInputFocus}}" bindinput="answerInput" />
      <button wx:if="{{answerQuestionId && (event.status === 'RECRUITING' || event.status === 'CONFIRMED' || event.status === 'IN_PROGRESS')}}" bindtap="answerQuestion">提交回答</button>
    </view>
    <view wx:else class="muted">活动当前状态不能提交公告或回答，可回看已审核内容。</view>
  </view>
  <view id="cohostCheckinSection" wx:if="{{!isHost && canManageCheckins}}" class="event-section cohost-section {{activeSection !== 'cohostCheckinSection' ? 'section-hidden' : ''}}">
    <view class="section-kicker">CO-HOST WORKSPACE</view><view class="section-heading">协办签到管理</view>
    <button id="cohostTokenButton" wx:if="{{canGenerateCheckInToken}}" bindtap="showCheckInToken">展示动态签到二维码</button>
    <view wx:if="{{!canGenerateCheckInToken && (event.status === 'CONFIRMED' || event.status === 'IN_PROGRESS')}}" class="muted">{{checkInWindowNotice}} 页面按设备时间提示，最终以服务端校验为准。</view>
    <view wx:if="{{displayedCheckInToken}}" class="checkin-qr-display"><view class="qr-brand">See You In Real Life <text>GOOD PEOPLE · BRIGHTER DAYS</text></view>
      <canvas canvas-id="checkinQr" style="width:240px;height:240px" />
      <view class="token-text">当前口令约 {{checkInExpiresIn}} 秒后更新：{{displayedCheckInToken}}</view>
    </view>
    <view wx:if="{{registrationsLoadState === 'ERROR'}}" class="error">{{registrationsError}} <button bindtap="refresh">重新加载报名名单</button></view>
    <view wx:for="{{registrations}}" wx:key="id" class="item">
      <view>{{item.displayName}} · {{item.statusLabel}}</view>
      <button id="manualRequest-{{item.user_id}}" wx:if="{{canRequestManualCheckIn && item.status === 'CONFIRMED'}}" data-user="{{item.user_id}}" bindtap="requestManualCheckIn">申请人工补记到场</button>
    </view>
  </view>
  <!-- Wave66 visitor actions BEGIN -->
  <view wx:if="{{loadState === 'READY' && activeSection === 'detailsSection' && !successState && display.isBadminton && !isHost && myRegistration.status !== 'CONFIRMED' && !joinConfirmation}}" class="pg01-visitor-actions"><button id="joinButton" wx:if="{{safetyStatus === 'OPEN' && canJoin && !event.riskPaused && event.recruiting && (event.status === 'RECRUITING' || event.status === 'CONFIRMED')}}" bindtap="openJoinConfirmation"><text class="pg01-join-dot">●</text><text>报名参加</text></button><button wx:else class="pg01-view-registration" data-section="registrationSection" bindtap="jumpToSection">查看报名与成员</button><button class="pg01-copy-info" bindtap="shareCurrentEvent" aria-label="复制活动信息"><image src="./assets/pg01-share-dark.svg" mode="aspectFit" aria-hidden="true"/><text>复制活动信息</text></button></view>
<!-- Wave66 visitor actions END -->
<view class="bottom-actions" wx:if="{{!joinConfirmation && loadState === 'READY' && activeSection === 'detailsSection' && !successState && !(loadState === 'READY' && activeSection === 'detailsSection' && !successState && display.isBadminton && !isHost && myRegistration.status !== 'CONFIRMED' && !joinConfirmation)}}"><button id="joinButton" wx:if="{{safetyStatus === 'OPEN' && canJoin && !event.riskPaused && event.recruiting && (event.status === 'RECRUITING' || event.status === 'CONFIRMED')}}" bindtap="openJoinConfirmation"><text class="join-dot">●</text> 报名参加</button><button wx:else class="view-registration" data-section="registrationSection" bindtap="jumpToSection">查看报名与成员</button><button class="share-event" bindtap="shareCurrentEvent">{{isHost ? '↥ 分享活动' : '↥ 复制活动信息'}}</button></view>
</view>
<view wx:else class="event-load-state"><view class="event-load-card">
  <view class="event-load-mark">✦</view>
  <view wx:if="{{loadState === 'LOADING'}}">正在读取活动当前信息…</view>
  <view wx:if="{{loadState === 'LOGIN_REQUIRED' && inviteSummary}}">
    <view>{{inviteSummary.title}} · {{inviteSummary.startAt}} · {{inviteSummary.city}}</view>
    <view>登录后可查看本人报名状态；名额以活动当前状态为准。</view>
    <button bindtap="retryLogin">登录并返回本活动</button>
  </view>
  <button wx:if="{{loadState === 'ERROR'}}" bindtap="refresh">重新加载活动</button>
  <button bindtap="goToMyActivities">回到我的活动</button>
</view></view>
<view wx:if="{{message}}" class="error">{{message}}</view>
