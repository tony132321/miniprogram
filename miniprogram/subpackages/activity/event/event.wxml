    <view wx:if="{{contentLoadState === 'ERROR'}}" class="pg07-error">{{contentError}} <button id="contentRetryButton" bindtap="refresh">重新加载公告与问答</button></view>
    <view class="pg07-timeline"><view class="pg07-guide"></view>
      <view wx:for="{{contentTimeline}}" wx:for-item="row" wx:key="id" class="pg07-thread">
        <view class="pg07-avatar-wrap"><view class="pg07-avatar {{row.author_id === 'system' ? 'pg07-system-avatar' : ''}}"><image wx:if="{{row.author_id === 'system'}}" src="./assets/pg07-campaign-w400-f1-34c759.svg" mode="aspectFit" aria-hidden="true"/><text wx:else>{{row.avatarGlyph}}</text></view><view wx:if="{{row.author_id === event.hostId}}" class="pg07-host-star"><image src="./assets/pg07-star-w400-f1-181e00.svg" mode="aspectFit" aria-hidden="true"/></view></view>
        <view class="pg07-thread-column"><view class="pg07-entry {{row.author_id === 'system' ? 'pg07-system-entry' : ''}}"><view class="pg07-entry-header"><view><text wx:if="{{row.author_id === event.hostId}}" class="pg07-role-chip">主办方</text><text class="pg07-author">{{row.authorName}}</text></view><text class="pg07-time">{{row.timeLabel}}</text></view>
          <view wx:if="{{row.statusLabel}}" class="pg07-review-state">{{row.statusLabel}}</view>
