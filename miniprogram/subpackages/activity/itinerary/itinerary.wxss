page { background: #faf8fe; color: #1a1b1f; }
.itinerary-page { min-height: 100vh; box-sizing: border-box; background: #faf8fe; }
.status-bar-cover { position: fixed; top: 0; left: 0; right: 0; z-index: 51; background: #faf8fe; pointer-events: none; }
.itinerary-header { position: sticky; top: 24px; z-index: 50; height: 112rpx; padding: 0 112px 0 32rpx; display: flex; align-items: center; justify-content: space-between; background: rgba(250,248,254,.8); backdrop-filter: blur(48rpx); box-shadow: 0 2rpx 16rpx rgba(0,0,0,.04); }
.header-title { display: flex; align-items: center; gap: 8rpx; min-width: 0; font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.01em; }
.header-title>text { min-width: 0; max-width: 400rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.itinerary-header button { margin: 0; padding: 0; border: 0; }
.itinerary-header button::after,.featured-registration::after,.featured-checkin::after,.featured-action::after,.later-card::after { border: 0; }
.back { display: flex; align-items: center; justify-content: center; flex: none; width: 88rpx; height: 88rpx; border-radius: 50%; background: none; }
.back-glyph { width: 44rpx; height: 44rpx; }
.profile-link { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; background: #004cc8; }
.profile-glyph { display: block; width: 36rpx; height: 36rpx; }
.itinerary-content { padding: 24rpx 32rpx 80rpx; }
.intro-pill { display: inline-flex; align-items: center; gap: 12rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: #ebf9f0; color: #34c759; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .02em; }
.intro-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #34c759; }
.intro-title { margin-top: 8rpx; font-size: 44rpx; font-weight: 700; line-height: 56rpx; letter-spacing: -.025em; }
.intro-copy { margin: 8rpx 0 32rpx; font-size: 26rpx; color: #424655; line-height: 36rpx; font-weight: 400; }
.state-card { padding: 56rpx 28rpx; border-radius: 26rpx; background: #fff; text-align: center; color: #737687; font-size: 24rpx; }
.state-card button { margin-top: 24rpx; background: #1d64f2; color: #fff; border-radius: 40rpx; font-size: 23rpx; }
.featured-card { overflow: hidden; border-radius: 32rpx; background: #fff; box-shadow: 0 8rpx 48rpx -8rpx rgba(28,41,61,.08), 0 2rpx 8rpx 0 rgba(28,41,61,.03); }
.featured-cover { height: 352rpx; position: relative; overflow: hidden; }
.featured-cover .featured-photo { width: 100%; height: 100%; }
.cover-shade { position: absolute; inset: 0; background: linear-gradient(to top,#ffffff 0%,rgba(26,27,31,.20) 50%,transparent 100%); }
.countdown { position: absolute; left: 24rpx; top: 24rpx; display: inline-flex; align-items: center; gap: 12rpx; padding: 8rpx 24rpx; background: #fff0f3; color: #ff2d55; border-radius: 999rpx; font-size: 26rpx; line-height: 32rpx; font-weight: 600; backdrop-filter: blur(24rpx); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.1), 0 2rpx 4rpx rgba(0,0,0,.06); }
.countdown-glyph { width: 32rpx; height: 32rpx; flex: none; }
.real-event-badge { position: absolute; right: 24rpx; bottom: 24rpx; display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 20rpx; background: rgba(255,255,255,.9); color: #1a1b1f; border-radius: 999rpx; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .02em; backdrop-filter: blur(24rpx); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.1), 0 2rpx 4rpx rgba(0,0,0,.06); }
.verified-glyph { width: 30rpx; height: 30rpx; flex: none; }
.featured-body { padding: 32rpx; }
.featured-title { font-size: 40rpx; font-weight: 700; line-height: 52rpx; letter-spacing: -.015em; word-break: break-word; }
.featured-subtitle { color: #424655; font-size: 26rpx; line-height: 36rpx; font-weight: 400; margin: 8rpx 0 24rpx; }
.facts { display: flex; flex-direction: column; gap: 20rpx; padding: 24rpx; background: #f4f3f8; border-radius: 24rpx; }
.fact-row { display: flex; align-items: flex-start; gap: 20rpx; }
.fact-content { min-width: 0; flex: 1; word-break: break-word; }
.fact-main { font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
.fact-date-copy { display: block; color: #424655; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .02em; }
.fact-copy { display: block; color: #424655; font-size: 26rpx; line-height: 36rpx; font-weight: 400; }
.fact-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 56rpx; height: 56rpx; border-radius: 16rpx; background: #ebf2fe; }
.fact-icon image { width: 36rpx; height: 36rpx; }
.fact-icon.location { background: #f3fee7; }
.fact-icon.fee { background: #f2f1fd; }
.attendance-heading { margin-top: 24rpx; display: flex; justify-content: space-between; gap: 20rpx; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .02em; color: #424655; }
.attendance-heading text:last-child { color: #34c759; font-weight: 600; text-align: right; }
.featured-links { display: flex; gap: 12rpx; margin-top: 16rpx; }
.featured-links button { flex: 1; min-width: 0; height: 62rpx; line-height: 62rpx; margin: 0; padding: 0 5rpx; border-radius: 17rpx; font-size: 21rpx; font-weight: 700; white-space: nowrap; }
.featured-registration { background: #ebf2fe; color: #1d64f2; }
.featured-checkin { background: #ebf9f0; color: #16843f; }
.venue-note { margin-top: 24rpx; padding: 24rpx; display: flex; align-items: flex-start; gap: 16rpx; border-radius: 24rpx; background: rgba(233,231,237,.6); color: #424655; font-size: 26rpx; font-weight: 400; line-height: 1.625; }
.info-glyph { width: 36rpx; height: 36rpx; margin-top: 4rpx; flex: none; }
.venue-note view { flex: 1; min-width: 0; }
.featured-action { height: 73rpx; line-height: 73rpx; margin: 24rpx 0 0; background: #1d64f2; color: #fff; border-radius: 35rpx; font-size: 23rpx; font-weight: 700; }
.later-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 32rpx 8rpx 16rpx; padding-top: 8rpx; }
.later-heading text:first-child { font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.01em; }
.later-heading text:last-child { flex: none; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .02em; color: #424655; }
.later-card { box-sizing: border-box; width: 100%; display: flex; align-items: center; gap: 24rpx; padding: 24rpx; margin: 0 0 16rpx; background: #fff; text-align: left; border-radius: 32rpx; color: #1a1b1f; box-shadow: 0 4rpx 24rpx -4rpx rgba(28,41,61,.04); }
.later-date { width: 96rpx; height: 96rpx; flex: none; border-radius: 24rpx; background: #fff0f3; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ff2d55; }
.later-date text:first-child { font-size: 20rpx; line-height: 1.25; font-weight: 700; letter-spacing: .02em; }
.later-date text:last-child { font-size: 34rpx; font-weight: 800; line-height: 1; letter-spacing: -.01em; }
.later-date-violet { background: #f2f1fd; color: #5856d6; }
.later-main { flex: 1; min-width: 0; }
.later-title { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.later-title text:first-child { flex: 1; font-size: 34rpx; line-height: 44rpx; font-weight: 600; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.later-state { flex: none; padding: 4rpx 16rpx; border-radius: 999rpx; background: #ebf2fe; color: #1d64f2; font-size: 22rpx; line-height: 28rpx; font-weight: 700; letter-spacing: .02em; }
.later-detail { display: block; margin-top: 4rpx; font-size: 26rpx; line-height: 36rpx; font-weight: 400; color: #424655; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.later-chevron { flex: none; font-size: 30rpx; color: #adb1bf; }
.truth-note { margin-top: 32rpx; padding: 24rpx; display: flex; align-items: flex-start; gap: 24rpx; border-radius: 32rpx; background: #f4f3f8; color: #424655; font-size: 26rpx; font-weight: 400; line-height: 1.625; }
.truth-mark { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.1), 0 2rpx 4rpx rgba(0,0,0,.06); }
.truth-mark image { width: 40rpx; height: 40rpx; }
.truth-note>view:last-child { flex: 1; min-width: 0; }
.truth-note text { display: block; color: #1a1b1f; font-size: 26rpx; line-height: 32rpx; font-weight: 600; margin-bottom: 4rpx; }
.foot { margin: 48rpx 0 0; padding-bottom: 32rpx; text-align: center; color: #737687; font-size: 26rpx; line-height: 32rpx; font-weight: 600; }
