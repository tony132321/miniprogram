.itinerary-page{min-height:100vh;box-sizing:border-box;background:#f8f7fc;color:#111827}.itinerary-header{height:92rpx;padding:0 190rpx 0 28rpx;display:flex;align-items:center;gap:24rpx;background:#fff;font-size:34rpx;font-weight:800}.itinerary-header button{margin:0;border:0}.itinerary-header button::after{border:0}.back{padding:0 12rpx;background:none;color:#111827;font-size:56rpx;line-height:1}.profile-link{margin-left:auto!important;width:64rpx;height:64rpx;padding:0;border-radius:50%;background:#1d64f2;color:#fff;font-size:36rpx;line-height:64rpx}.itinerary-content{padding:30rpx 30rpx 80rpx}.intro-pill{display:inline-block;padding:8rpx 20rpx;border-radius:40rpx;background:#e8fbef;color:#18aa5a;font-size:22rpx;font-weight:700}.intro-title{margin-top:20rpx;font-size:44rpx;font-weight:900}.intro-copy{margin:8rpx 0 30rpx;font-size:24rpx;color:#4b5563}.state-card{padding:56rpx 28rpx;border-radius:30rpx;background:#fff;text-align:center;color:#687386;font-size:26rpx}.state-card button{margin-top:24rpx;background:#1d64f2;color:#fff;border-radius:40rpx;font-size:24rpx}.featured-card{overflow:hidden;border-radius:32rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(32,43,78,.08)}.featured-cover{height:336rpx;position:relative}.featured-cover image{width:100%;height:100%}.countdown{position:absolute;left:22rpx;top:22rpx;padding:10rpx 18rpx;background:#fff;color:#ec315d;border-radius:50rpx;font-size:24rpx;font-weight:800}.featured-body{padding:28rpx}.featured-status{display:inline-block;padding:7rpx 14rpx;border-radius:30rpx;background:#e8f0ff;color:#1d64f2;font-size:21rpx;font-weight:700}.featured-title{font-size:36rpx;font-weight:900;margin:14rpx 0 20rpx}.facts{padding:20rpx;background:#f6f6fb;border-radius:26rpx}.facts>view{display:flex;align-items:flex-start;gap:16rpx;margin:12rpx 0;font-size:25rpx;font-weight:700}.facts>view>view{flex:1}.facts text{display:block;font-size:21rpx;color:#64708a;font-weight:400;margin-top:3rpx}.fact-icon{width:45rpx;height:45rpx;line-height:45rpx;text-align:center;border-radius:12rpx;background:#eaf0ff;color:#1d64f2;font-size:27rpx!important;font-weight:800!important;flex-shrink:0}.fact-icon.location{background:#eef9dc;color:#66991a}.fact-icon.fee{background:#eee9ff;color:#6457c4}.featured-action{margin:24rpx 0 0;background:#1d64f2;color:#fff;border-radius:40rpx;font-size:25rpx;font-weight:700}.later-heading{display:flex;justify-content:space-between;align-items:center;margin:40rpx 6rpx 18rpx}.later-heading text:first-child{font-size:31rpx;font-weight:800}.later-heading text:last-child{font-size:21rpx;color:#69748a}.later-card{width:100%;display:flex;align-items:center;gap:18rpx;padding:20rpx;margin:0 0 14rpx;background:#fff;text-align:left;border-radius:27rpx;color:#111827}.later-card::after{border:0}.later-date{width:114rpx;flex-shrink:0;padding:9rpx;border-radius:20rpx;background:#f1f0ff;text-align:center}.later-date text{display:block;font-size:20rpx;color:#5b54d2;font-weight:700}.later-main{flex:1;min-width:0}.later-main view{font-size:25rpx;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.later-main text{font-size:21rpx;color:#667085;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.later-chevron{font-size:37rpx;color:#b4bbca}.truth-note{margin-top:28rpx;padding:24rpx;border-radius:24rpx;background:#f0f1f7;color:#687386;font-size:22rpx;line-height:1.5}.foot{margin:42rpx 0;text-align:center;color:#8a91a3;font-size:22rpx}
