page { background: #faf8fe; color: #1a1b1f; }
.itinerary-page { min-height: 100vh; box-sizing: border-box; background: #faf8fe; }
.itinerary-header { height: 98rpx; padding: 0 200rpx 0 32rpx; display: flex; align-items: center; justify-content: space-between; background: rgba(250,248,254,.96); box-shadow: 0 2rpx 10rpx rgba(28,41,61,.035); }
.header-title { display: flex; align-items: center; gap: 16rpx; font-size: 30rpx; font-weight: 750; }
.itinerary-header button { margin: 0; padding: 0; border: 0; }
.itinerary-header button::after,.featured-registration::after,.featured-checkin::after,.featured-action::after,.later-card::after { border: 0; }
.back { width: 54rpx; height: 70rpx; background: none; color: #1a1b1f; font-size: 53rpx; line-height: 61rpx; }
.profile-link { width: 62rpx; height: 62rpx; border-radius: 50%; background: #004cc8; color: #fff; font-size: 32rpx; line-height: 62rpx; text-align: center; }
.itinerary-content { padding: 26rpx 32rpx 84rpx; }
.intro-pill { display: inline-flex; align-items: center; gap: 10rpx; padding: 8rpx 20rpx; border-radius: 40rpx; background: #ebf9f0; color: #34c759; font-size: 20rpx; font-weight: 700; }
.intro-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #34c759; }
.intro-title { margin-top: 18rpx; font-size: 43rpx; font-weight: 800; line-height: 1.3; letter-spacing: -1rpx; }
.intro-copy { margin: 6rpx 0 28rpx; font-size: 23rpx; color: #424655; line-height: 1.5; }
.state-card { padding: 56rpx 28rpx; border-radius: 26rpx; background: #fff; text-align: center; color: #737687; font-size: 24rpx; }
.state-card button { margin-top: 24rpx; background: #1d64f2; color: #fff; border-radius: 40rpx; font-size: 23rpx; }
.featured-card { overflow: hidden; border-radius: 32rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(28,41,61,.08); }
.featured-cover { height: 352rpx; position: relative; overflow: hidden; }
.featured-cover image { width: 100%; height: 100%; }
.cover-shade { position: absolute; inset: 0; background: linear-gradient(0deg,rgba(255,255,255,.48),rgba(26,27,31,.05) 48%,transparent); }
.countdown { position: absolute; left: 24rpx; top: 24rpx; padding: 8rpx 20rpx; background: #fff0f3; color: #ff2d55; border-radius: 50rpx; font-size: 22rpx; font-weight: 750; box-shadow: 0 3rpx 14rpx rgba(0,0,0,.08); }
.real-event-badge { position: absolute; right: 20rpx; bottom: 19rpx; padding: 7rpx 18rpx; background: rgba(255,255,255,.93); color: #1a1b1f; border-radius: 50rpx; font-size: 19rpx; font-weight: 700; }
.featured-body { padding: 29rpx 30rpx 30rpx; }
.featured-title { font-size: 33rpx; font-weight: 800; line-height: 1.3; }
.featured-subtitle { color: #424655; font-size: 21rpx; line-height: 1.4; margin: 7rpx 0 23rpx; }
.facts { padding: 18rpx 20rpx; background: #f4f3f8; border-radius: 24rpx; }
.fact-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 8rpx 0; font-size: 23rpx; font-weight: 700; }
.fact-row>view:last-child { min-width: 0; flex: 1; }
.fact-row>view:last-child>view { line-height: 1.35; overflow: hidden; text-overflow: ellipsis; }
.fact-row>view:last-child>text { display: block; margin-top: 4rpx; color: #424655; font-size: 19rpx; font-weight: 400; line-height: 1.35; }
.fact-icon { flex: none; width: 46rpx; height: 46rpx; line-height: 46rpx; text-align: center; border-radius: 13rpx; background: #ebf2fe; color: #1d64f2; font-size: 27rpx; font-weight: 800; }
.fact-icon.location { background: #f3fee7; color: #4d5d00; }
.fact-icon.fee { background: #f2f1fd; color: #5856d6; }
.attendance-heading { margin-top: 23rpx; display: flex; justify-content: space-between; gap: 10rpx; font-size: 20rpx; color: #424655; }
.attendance-heading text:last-child { color: #1eae53; font-weight: 700; }
.featured-links { display: flex; gap: 12rpx; margin-top: 12rpx; }
.featured-links button { flex: 1; min-width: 0; height: 62rpx; line-height: 62rpx; margin: 0; padding: 0 5rpx; border-radius: 17rpx; font-size: 21rpx; font-weight: 700; white-space: nowrap; }
.featured-registration { background: #ebf2fe; color: #1d64f2; }
.featured-checkin { background: #ebf9f0; color: #16843f; }
.venue-note { margin-top: 21rpx; padding: 21rpx; display: flex; gap: 14rpx; border-radius: 21rpx; background: #f4f3f8; color: #424655; font-size: 20rpx; line-height: 1.55; }
.venue-note text { color: #424655; font-size: 25rpx; flex: none; }
.venue-note view { flex: 1; }
.featured-action { height: 73rpx; line-height: 73rpx; margin: 20rpx 0 0; background: #1d64f2; color: #fff; border-radius: 35rpx; font-size: 23rpx; font-weight: 700; }
.later-heading { display: flex; justify-content: space-between; align-items: center; margin: 36rpx 6rpx 16rpx; }
.later-heading text:first-child { font-size: 28rpx; font-weight: 750; }
.later-heading text:last-child { font-size: 19rpx; color: #737687; }
.later-card { width: 100%; display: flex; align-items: center; gap: 18rpx; padding: 19rpx 21rpx; margin: 0 0 14rpx; background: #fff; text-align: left; border-radius: 26rpx; color: #1a1b1f; box-shadow: 0 3rpx 13rpx rgba(28,41,61,.035); }
.later-date { width: 92rpx; height: 90rpx; flex: none; border-radius: 19rpx; background: #fff0f3; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ff2d55; }
.later-date text:first-child { font-size: 18rpx; font-weight: 700; }
.later-date text:last-child { font-size: 31rpx; font-weight: 800; line-height: 1.15; }
.later-card:nth-child(2n) .later-date { background: #f2f1fd; color: #5856d6; }
.later-main { flex: 1; min-width: 0; }
.later-title { display: flex; align-items: center; gap: 7rpx; min-width: 0; }
.later-title text:first-child { font-size: 24rpx; font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.later-state { flex: none; padding: 3rpx 8rpx; border-radius: 7rpx; background: #ebf2fe; color: #1d64f2; font-size: 16rpx; font-weight: 700; }
.later-detail { display: block; margin-top: 5rpx; font-size: 19rpx; color: #424655; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.later-chevron { font-size: 30rpx; color: #adb1bf; }
.truth-note { margin-top: 25rpx; padding: 22rpx; display: flex; align-items: flex-start; gap: 14rpx; border-radius: 24rpx; background: #f4f3f8; color: #424655; font-size: 19rpx; line-height: 1.5; }
.truth-mark { flex: none; width: 48rpx; height: 48rpx; line-height: 48rpx; border-radius: 50%; background: #fff; color: #34c759; text-align: center; font-size: 28rpx; }
.truth-note>view:last-child { flex: 1; }
.truth-note text { display: block; color: #1a1b1f; font-size: 21rpx; font-weight: 700; margin-bottom: 2rpx; }
.foot { margin: 39rpx 0 0; text-align: center; color: #858998; font-size: 20rpx; font-weight: 650; }
