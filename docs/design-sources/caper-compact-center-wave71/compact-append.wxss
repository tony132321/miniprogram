
/* Wave 71 PG02-N2. Independent layout; original INBOX/CHAT/N1 rules untouched.
 * Source normal400; no new font face, mocked payment/group/navigation or people. */
.messages-page.messages-compact-reference{box-sizing:border-box;min-height:max(884px,100vh);margin:0;padding-right:0;padding-bottom:0;padding-left:0;background:#faf8fe;color:#1a1b1f;font-family:"Plus Jakarta Sans",sans-serif;font-size:16px;font-weight:400;line-height:24px;}
.messages-compact-reference .messages-status-shield{background:#faf8fe;}
.messages-compact-reference button{box-sizing:border-box;min-width:0;min-height:0;margin:0;padding:0;border:0;background:transparent;font-family:"Plus Jakarta Sans",sans-serif;}
.messages-compact-reference button::after{border:0;}
.messages-compact-reference .compact-shell{box-sizing:border-box;display:flex;flex-direction:column;width:100%;padding:56px 16px calc(40px + env(safe-area-inset-bottom,0px));}
.messages-compact-reference .compact-header{position:fixed;right:0;left:0;z-index:50;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;height:56px;padding:0 16px;background:rgba(250,248,254,.8);backdrop-filter:blur(24px);box-shadow:0 1px 8px rgba(0,0,0,.04);}
.messages-compact-reference .compact-back,.messages-compact-reference .compact-more{display:flex;flex:none;align-items:center;justify-content:center;width:44px;height:44px;border-radius:9999px;transition:color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1);}
.messages-compact-reference .compact-back image{width:24px;height:24px;}
.messages-compact-reference .compact-more image{width:22px;height:22px;}
.messages-compact-reference .compact-header-title{flex:1;min-width:0;padding:0 8px;overflow:hidden;color:#1a1b1f;font-size:17px;font-weight:600;line-height:22px;letter-spacing:-.17px;text-align:center;text-overflow:ellipsis;white-space:nowrap;}
.messages-compact-reference .compact-header-actions{display:flex;flex:none;align-items:center;gap:4px;}
.messages-compact-reference .compact-person{display:flex;flex:none;align-items:center;justify-content:center;width:32px;height:32px;margin-left:4px;border-radius:9999px;background:#004cc8;}
.messages-compact-reference .compact-person image{width:18px;height:18px;}
.messages-compact-reference .compact-header-pressed{background:#e9e7ed;transform:scale(.95);}
.messages-compact-reference .compact-tabs{width:100%;padding:4px 0 8px;}
.messages-compact-reference .compact-tabs-scroll{width:100%;white-space:nowrap;}
.messages-compact-reference .compact-tabs-row{display:inline-flex;align-items:center;gap:4px;min-width:100%;padding:4px 0;}
.messages-compact-reference .compact-tab{display:inline-flex;flex:none;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border-radius:9999px;background:#e9e7ed;color:#424655;font-size:13px;font-weight:600;line-height:16px;transition:all 150ms cubic-bezier(.4,0,.2,1);}
.messages-compact-reference .compact-tab.compact-selected{background:#1d64f2;color:#fff;box-shadow:0 1px 2px rgba(0,76,200,.2);}
.messages-compact-reference .compact-tab-pressed{background:#e3e2e7;transform:scale(.95);}
.messages-compact-reference .compact-selected.compact-tab-pressed{background:#1d64f2;}
.messages-compact-reference .compact-activity-count{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:16px;height:16px;padding:0 4px;border-radius:9999px;background:#ff2d55;color:#fff;font-size:10px;font-weight:400;line-height:10px;}
.messages-compact-reference .compact-feed,.messages-compact-reference .compact-approvals,.messages-compact-reference .compact-notices{display:flex;flex-direction:column;gap:12px;}
.messages-compact-reference .compact-feed{margin-top:4px;}
.messages-compact-reference .compact-card{position:relative;display:flex;flex-direction:column;gap:8px;margin:0;padding:12px;overflow:hidden;border-radius:12px;background:#fff;box-shadow:0 4px 20px -2px rgba(28,41,61,.06),0 1px 3px rgba(28,41,61,.02);transition:all 150ms cubic-bezier(.4,0,.2,1);}
.messages-compact-reference .compact-card-pressed{transform:scale(.99);}
.messages-compact-reference .compact-ambient{position:absolute;top:0;right:0;left:0;height:4px;background:linear-gradient(to right,#1d64f2,#5856d6,#d2f803);opacity:.8;}
.messages-compact-reference .compact-top{display:flex;align-items:flex-start;gap:8px;}
.messages-compact-reference .compact-icon{display:flex;flex:none;align-items:center;justify-content:center;width:40px;height:40px;margin-top:2px;border-radius:9999px;font-size:20px;font-weight:400;line-height:20px;}
.messages-compact-reference .compact-icon image{width:20px;height:20px;}
.messages-compact-reference .compact-blue{background:#ebf2fe;color:#1d64f2;}
.messages-compact-reference .compact-pink{background:#fff0f3;color:#ff2d55;}
.messages-compact-reference .compact-lime{background:#f3fee7;color:#647700;}
.messages-compact-reference .compact-green{background:#ebf9f0;color:#34c759;}
.messages-compact-reference .compact-violet{background:#f2f1fd;color:#5856d6;}
.messages-compact-reference .compact-gray{background:#efedf3;color:#424655;}
.messages-compact-reference .compact-copy{flex:1;min-width:0;}
.messages-compact-reference .compact-head-row{display:flex;align-items:center;justify-content:space-between;gap:4px;}
.messages-compact-reference .compact-title{flex:1;min-width:0;overflow:hidden;color:#1a1b1f;font-size:17px;font-weight:600;line-height:22px;letter-spacing:-.17px;text-overflow:ellipsis;white-space:nowrap;}
.messages-compact-reference .compact-time{flex:none;color:#737687;font-size:11px;font-weight:700;line-height:14px;letter-spacing:.22px;}
.messages-compact-reference .compact-summary{margin-top:4px;color:#424655;font-size:13px;font-weight:400;line-height:21.125px;}
.messages-compact-reference .compact-external{margin-top:4px;color:#737687;font-size:11px;line-height:14px;}
.messages-compact-reference .compact-thumb{position:relative;flex:none;width:56px;height:56px;overflow:hidden;border-radius:8px;background:#efedf3;}
.messages-compact-reference .compact-thumb image{display:block;width:100%;height:100%;}
.messages-compact-reference .compact-thumb>text{position:absolute;right:0;bottom:0;left:0;padding:1px 2px;background:rgba(0,0,0,.4);color:#fff;font-size:9px;font-weight:400;line-height:12px;text-align:center;}
.messages-compact-reference .compact-reminder-actions{display:flex;align-items:center;gap:4px;margin-top:2px;padding-top:4px;}
.messages-compact-reference .compact-reminder-actions button{display:flex;flex:1;align-items:center;justify-content:center;gap:4px;height:36px;border-radius:9999px;font-size:13px;font-weight:600;line-height:16px;transition:transform 150ms cubic-bezier(.4,0,.2,1);}
.messages-compact-reference .compact-reminder-actions button image{flex:none;width:18px;height:18px;}
.messages-compact-reference .compact-primary{background:#1d64f2;color:#fff;box-shadow:0 1px 2px rgba(0,0,0,.05);}
.messages-compact-reference .compact-reminder-secondary{background:#ebf2fe;color:#1d64f2;}
.messages-compact-reference .compact-secondary{background:#e9e7ed;color:#424655;}
.messages-compact-reference .compact-action-pressed{transform:scale(.95);}
.messages-compact-reference .compact-applicants{display:flex;align-items:center;gap:8px;margin-top:8px;color:#737687;font-size:11px;font-weight:700;line-height:14px;letter-spacing:.22px;}
.messages-compact-reference .compact-applicant-anonymous{display:flex;flex:none;align-items:center;justify-content:center;width:28px;height:28px;border-radius:9999px;background:#efedf3;box-shadow:0 1px 2px rgba(0,0,0,.05);}
.messages-compact-reference .compact-applicant-anonymous image{width:18px;height:18px;}
.messages-compact-reference .compact-approval-actions,.messages-compact-reference .compact-standard-actions{display:flex;align-items:center;justify-content:flex-end;gap:4px;padding-top:4px;}
.messages-compact-reference .compact-standard-actions{justify-content:flex-start;margin-top:8px;padding-top:0;}
.messages-compact-reference .compact-approval-actions button,.messages-compact-reference .compact-standard-actions button{display:flex;align-items:center;justify-content:center;height:32px;padding:0 12px;border-radius:9999px;font-size:13px;font-weight:600;line-height:16px;transition:all 150ms cubic-bezier(.4,0,.2,1);}
.messages-compact-reference .compact-capacity{color:#424655;font-size:11px;line-height:14px;}
.messages-compact-reference .compact-update-link{display:inline-flex;align-items:center;gap:4px;margin-top:8px;padding:2px 8px;border-radius:9999px;background:#f4f3f8;color:#424655;font-size:11px;font-weight:700;line-height:14px;letter-spacing:.22px;}
.messages-compact-reference .compact-update-link image{flex:none;width:14px;height:14px;}
.messages-compact-reference .compact-milestone-link{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:10px;padding:6px 8px;border-radius:8px;background:#f4f3f8;color:#1a1b1f;font-size:11px;font-weight:700;line-height:14px;letter-spacing:.22px;}
.messages-compact-reference .compact-milestone-link>view{display:flex;align-items:center;gap:6px;}
.messages-compact-reference .compact-milestone-link>image{width:16px;height:16px;}
.messages-compact-reference .compact-live-dot{flex:none;width:8px;height:8px;border-radius:9999px;background:#34c759;animation:compact-source-pulse 2s cubic-bezier(.4,0,.6,1) infinite;}
@keyframes compact-source-pulse{0%,100%{opacity:1;}50%{opacity:.5;}}
.messages-compact-reference .compact-empty{padding:12px;border-radius:12px;background:#fff;color:#737687;font-size:13px;line-height:18px;}
.messages-compact-reference .compact-hint{margin-top:4px;}
.messages-compact-reference .compact-inline-status,.messages-compact-reference .compact-message{color:#737687;font-size:13px;line-height:18px;}
.messages-compact-reference .compact-empty button,.messages-compact-reference .compact-retry,.messages-compact-reference .compact-load-more,.messages-compact-reference .compact-inline-status button{align-self:flex-start;min-height:32px;padding:6px 12px;border-radius:9999px;background:#ebf2fe;color:#1d64f2;font-size:13px;font-weight:600;line-height:16px;}
.messages-compact-reference .compact-empty button{margin-top:8px;}
.messages-compact-reference .compact-footer{display:flex;flex-direction:column;align-items:center;justify-content:center;margin:32px 0 16px;text-align:center;}
.messages-compact-reference .compact-footer-handle{width:32px;height:4px;margin-bottom:12px;border-radius:9999px;background:#e3e2e7;}
.messages-compact-reference .compact-footer-title{color:rgba(115,118,135,.6);font-size:17px;font-weight:600;line-height:22px;letter-spacing:.425px;}
.messages-compact-reference .compact-footer-copy{margin-top:4px;color:rgba(115,118,135,.4);font-size:11px;font-weight:700;line-height:14px;letter-spacing:.22px;}
.messages-compact-reference .compact-secondary.compact-action-pressed{background:#e3e2e7;}
