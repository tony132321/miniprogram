  <block wx:elif="{{viewMode === 'CENTER' && centerLayout === 'COMPACT'}}">
    <view class="compact-shell">
      <view class="compact-header" style="top: {{statusBarHeight}}px; padding-right: {{capsuleInset}}px"><button class="compact-back" bindtap="backToInbox" hover-class="compact-header-pressed" aria-label="返回消息"><image src="/pages/messages/assets/wave69-back.svg" mode="aspectFit"/></button><text class="compact-header-title">Event Detail</text><view class="compact-header-actions"><button class="compact-more" bindtap="openCenterOptions" hover-class="compact-header-pressed" aria-label="通知中心布局与设置"><image src="/pages/messages/assets/wave69-more.svg" mode="aspectFit"/></button><view class="compact-person"><image src="/pages/messages/assets/wave69-person-white.svg" mode="aspectFit"/></view></view></view>
      <view class="compact-tabs"><scroll-view scroll-x="true" show-scrollbar="false" class="compact-tabs-scroll"><view class="compact-tabs-row"><button class="compact-tab {{filter === 'ALL' ? 'compact-selected' : ''}}" data-filter="ALL" bindtap="setFilter" hover-class="compact-tab-pressed" aria-role="tab" aria-label="全部通知">全部</button><button class="compact-tab {{filter === 'ACTIVITY' ? 'compact-selected' : ''}}" data-filter="ACTIVITY" bindtap="setFilter" hover-class="compact-tab-pressed" aria-role="tab" aria-label="活动提醒；数字仅为已加载活动通知的未读数"><text>活动提醒</text><text wx:if="{{loadedActivityUnreadCount > 0}}" class="compact-activity-count">{{loadedActivityUnreadCount}}</text></button><button class="compact-tab {{filter === 'INTERACTION' ? 'compact-selected' : ''}}" data-filter="INTERACTION" bindtap="setFilter" hover-class="compact-tab-pressed" aria-role="tab">互动消息</button><button class="compact-tab {{filter === 'SYSTEM' ? 'compact-selected' : ''}}" data-filter="SYSTEM" bindtap="setFilter" hover-class="compact-tab-pressed" aria-role="tab">系统通知</button></view></scroll-view></view>
      <view class="compact-feed">
        <view wx:if="{{message}}" class="compact-message">{{message}}</view>
        <button wx:if="{{loadState === 'ERROR'}}" class="compact-retry" bindtap="refresh">重新加载通知</button>
        <view wx:if="{{loadState === 'UNAUTHENTICATED'}}" class="compact-empty">登录后可查看本人通知<button bindtap="goProfile">前往我的页面</button></view>
        <view wx:if="{{loadState === 'LOADING'}}" class="compact-inline-status">正在加载站内通知…</view>
        <view wx:if="{{(filter === 'ALL' || filter === 'INTERACTION') && approvalLoadState === 'LOADING'}}" class="compact-inline-status">正在核对待审核报名…</view>
        <view wx:if="{{(filter === 'ALL' || filter === 'INTERACTION') && approvalLoadState === 'ERROR'}}" class="compact-inline-status">待审核报名暂时无法加载<button bindtap="loadApprovals">重新加载审核</button></view>
        <view wx:if="{{(filter === 'ALL' || filter === 'INTERACTION') && approvalLoadState === 'READY' && approvals.length > 0}}" class="compact-approvals">
          <view wx:for="{{approvals}}" wx:key="registrationId" class="compact-card compact-approval" hover-class="compact-card-pressed">
            <view class="compact-top"><view class="compact-icon compact-pink"><image src="/pages/messages/assets/wave71-compact-bolt.svg" mode="aspectFit"/></view><view class="compact-copy"><view class="compact-head-row"><text class="compact-title">{{item.eventTitle || '活动'}}有新报名申请</text><text class="compact-time">{{item.timeLabel}}</text></view><view class="compact-summary">请在活动报名截止前确认名额，以服务端审核结果为准。</view><view class="compact-applicants"><view class="compact-applicant-anonymous" aria-label="匿名报名占位；不代表真实头像"><image src="/pages/messages/assets/wave69-person-blue.svg" mode="aspectFit"/></view><text>{{item.canApprove ? '报名待审核' : '名额已满'}}</text></view></view></view>
            <view class="compact-approval-actions"><button class="compact-secondary" data-event-id="{{item.eventId}}" data-is-host="{{item.isHost}}" bindtap="viewApproval" hover-class="compact-action-pressed">查看详情</button><button wx:if="{{item.canApprove}}" class="compact-primary" data-id="{{item.registrationId}}" data-version="{{item.expectedVersion}}" bindtap="approveRequest" disabled="{{approvingId !== ''}}" hover-class="compact-action-pressed">{{approvingId === item.registrationId ? '审核中…' : '一键通过'}}</button><text wx:else class="compact-capacity">名额已满，暂不可通过</text></view>
          </view>
          <button wx:if="{{approvalNextOffset !== null}}" class="compact-load-more" bindtap="loadMoreApprovals" disabled="{{loadingMoreApprovals}}">{{loadingMoreApprovals ? '正在加载…' : '加载更多审核'}}</button>
        </view>
        <view wx:if="{{loadState === 'READY'}}" class="compact-notices"><block wx:for="{{centerItems}}" wx:key="id" wx:for-item="notice">
          <view wx:if="{{notice.visible}}" class="compact-card compact-{{notice.cardVariant}}" hover-class="compact-card-pressed">
            <view wx:if="{{notice.cardVariant === 'reminder'}}" class="compact-ambient"></view>
            <view class="compact-top"><view class="compact-icon compact-{{notice.cardVariant === 'reminder' ? 'blue' : notice.cardVariant === 'update' ? 'lime' : notice.cardVariant === 'milestone' ? 'green' : notice.tone}}"><image wx:if="{{notice.cardVariant === 'reminder'}}" src="/pages/messages/assets/wave71-compact-alarm.svg" mode="aspectFit"/><image wx:elif="{{notice.cardVariant === 'update'}}" src="/pages/messages/assets/wave71-compact-update.svg" mode="aspectFit"/><image wx:elif="{{notice.cardVariant === 'milestone'}}" src="/pages/messages/assets/wave71-compact-confirmed.svg" mode="aspectFit"/><text wx:else>{{notice.icon}}</text></view><view class="compact-copy"><view class="compact-head-row"><text class="compact-title">{{notice.title}}</text><text class="compact-time">{{notice.timeLabel}}</text></view><view class="compact-summary">{{notice.summary}}</view><view wx:if="{{notice.externalHint}}" class="compact-external">{{notice.externalHint}}</view>
              <button wx:if="{{notice.cardVariant === 'update'}}" class="compact-update-link" hover-class="none" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice"><image src="/pages/messages/assets/wave71-compact-location.svg" mode="aspectFit"/><text>{{notice.actionLabel}}</text></button>
              <button wx:if="{{notice.cardVariant === 'milestone'}}" class="compact-milestone-link" hover-class="none" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice"><view><text class="compact-live-dot"></text><text>{{notice.actionLabel}}</text></view><image src="/pages/messages/assets/wave71-compact-chevron.svg" mode="aspectFit"/></button>
              <view wx:if="{{notice.cardVariant === 'standard'}}" class="compact-standard-actions"><button class="compact-primary" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice" hover-class="compact-action-pressed">{{notice.actionLabel}}</button></view>
            </view><view wx:if="{{notice.cardVariant === 'reminder'}}" class="compact-thumb" aria-label="原稿羽毛球示意配图；不是真实活动照片"><image src="/pages/messages/assets/wave71-compact-badminton.jpg" mode="aspectFill"/><text>示意配图</text></view></view>
            <view wx:if="{{notice.cardVariant === 'reminder'}}" class="compact-reminder-actions"><button class="compact-primary" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" data-section="{{notice.actionSection}}" bindtap="openNotice" hover-class="compact-action-pressed"><image src="/pages/messages/assets/wave71-compact-ticket.svg" mode="aspectFit"/><text>{{notice.actionLabel}}</text></button><button wx:if="{{notice.event_id}}" class="compact-reminder-secondary" data-id="{{notice.id}}" data-event-id="{{notice.event_id}}" data-kind="{{notice.kind}}" bindtap="copyReminderVenue" hover-class="compact-action-pressed"><image src="/pages/messages/assets/wave71-compact-near-me.svg" mode="aspectFit"/><text>复制地点</text></button></view>
          </view>
        </block></view>
        <view wx:if="{{loadState === 'READY' && filteredCount === 0 && (filter !== 'ALL' && filter !== 'INTERACTION' || approvalLoadState !== 'LOADING' && approvals.length === 0)}}" class="compact-empty"><view>{{searchQuery ? '当前搜索无匹配通知' : '暂无此类站内通知'}}</view><view class="compact-hint">{{nextOffset !== null ? '当前已加载消息中没有此类通知，可继续加载更多。' : '新通知会显示在这里。'}}</view></view>
        <button wx:if="{{loadState === 'READY' && nextOffset !== null}}" class="compact-load-more" bindtap="loadMore" disabled="{{loadingMore}}">{{loadingMore ? '正在加载…' : '加载更多站内通知'}}</button>
      </view>
      <view class="compact-footer"><view class="compact-footer-handle"></view><text class="compact-footer-title">Stay in the loop. Never miss a game.</text><text class="compact-footer-copy">活动动态与站内通知 · CAPER</text></view>
    </view>
  </block>
