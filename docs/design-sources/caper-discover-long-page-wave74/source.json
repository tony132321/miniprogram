  "nativeAdaptation": "Full protected core/header/category/capsule/status/Tab/invite unchanged. Only ordinary long wrapper cancels old 24rpx native gutter to restore original 16px section edge. No source fake status/device chrome added. Bottom existing native Tab/safe handling remains unchanged.",
  "scopeSelectors": [
    ".d74-long",
    ".d74-cta-scope"
  ],
  "longModuleMap": [
    {
      "original": "ai-recommendations",
      "product": ".d74-recommend-section",
      "truth": "Static existing recommendationCards; same rotation, inspiration, closed favorite actions; no AI claim/time/enrolment/place facts."
    },
    {
      "original": "nearby-events",
      "product": ".d74-nearby-section",
      "truth": "Actual personalState and nearbyPersonalEvents under exact READY/length guards; map is marked non-location illustration; no actual distance/radar/count."
    },
    {
      "original": "campaign-topics",
      "product": ".d74-campaign-scroll",
      "truth": "Existing three openInspiration data-title contracts retained."
    },
    {
      "original": "organizer-list",
      "product": "[data-source=\"organizer-list\"]",
      "truth": "Original eight structural empty decorative slots explicitly not real people/count/certification. No fake avatars/public directory or invented click."
    },
    {
      "original": "friends-attending",
      "product": "[data-source=\"friends-attending\"]",
      "truth": "Real personalEvents list/LOADING/ERROR/READY-empty/READY-populated, IDs, dates, host membership label. No friends/names/avatar/count claims."
    },
    {
      "original": "social-moments",
      "product": "[data-source=\"social-moments\"]",
      "truth": "All six exact original scene photos/stickers illustrative, not community records. Park bytes supplied by root async profile component; no actual activity photo upload claim."
    },
    {
      "original": "user-reviews",
      "product": "[data-source=\"user-reviews\"]",
      "truth": "One explicit closed-state card in original quote/footer geometry. No fake three users/testimonials."
    },
    {
      "original": "weekly-curation",
      "product": "[data-source=\"weekly-curation\"]",
      "truth": "Same six inspiration bindings; source cover/color/card/mini-tag geometry, no actual dates/weekly listings."
    },
    {
      "original": "city-walk-routes",
      "product": "[data-source=\"city-walk-routes\"]",
      "truth": "Original 3 scene/handwriting slots; existing 2 inspiration bindings retained, third non-action illustration. No location count/km/planning claim. The existing second action remains 山野徒步, visibly labelled as its actual inspiration destination while original Wukang scene is illustrative."
    },
    {
      "original": "popular-venues",
      "product": ".d74-place-section",
      "truth": "Four exact original scene photos including profile-loaded park. Existing four data-title contracts preserved; caption explicitly generic scene and action text discloses original actual inspiration target. No merchant name/location/verification/reservation facts."
    },
    {
      "original": "ai-cta-banner",
      "product": ".d74-cta-scope",
      "truth": "Same real goCreate action and original truthful publish copy; source gradient/robot/arrow/gap/blur/geometry; no AI service claim."
    }
  ],
